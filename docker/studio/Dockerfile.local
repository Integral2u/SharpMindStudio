# syntax=docker/dockerfile:1.7
# Local-source build. Context must be the parent folder that contains both
# SharpMind/ and SharpMind.Studio/:
#   docker build -f SharpMind.Studio/docker/studio/Dockerfile.local -t sharpmind-studio:local ..
#
# Copy docker/local-context.dockerignore to that parent folder as `.dockerignore`
# so unrelated repositories are not sent to the Docker daemon.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY SharpMind.Studio/Directory.Build.props \
     SharpMind.Studio/Directory.Packages.props \
     SharpMind.Studio/SharpMind.References.props \
     /src/SharpMind.Studio/

COPY SharpMind/ /src/SharpMind/
COPY SharpMind.Studio/SharpMind.Studio.Core/ /src/SharpMind.Studio/SharpMind.Studio.Core/
COPY SharpMind.Studio/SharpMind.Studio/ /src/SharpMind.Studio/SharpMind.Studio/

RUN dotnet restore /src/SharpMind.Studio/SharpMind.Studio/SharpMind.Studio.csproj
RUN dotnet publish /src/SharpMind.Studio/SharpMind.Studio/SharpMind.Studio.csproj \
    -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_ENVIRONMENT=Production \
    Studio__Root=/data/SharpMind \
    Studio__Url=http://0.0.0.0:5117 \
    Studio__LanUrl=http://0.0.0.0:5118

EXPOSE 5117 5118
VOLUME ["/data/SharpMind"]

ENTRYPOINT ["dotnet", "SharpMind.Studio.dll"]
