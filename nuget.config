<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local development feed for the next (unreleased) engine packages.
         CI checks out the engine beside this repo and packs it here. -->
    <add key="sharpmind-sibling" value="..\SharpMind\nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

