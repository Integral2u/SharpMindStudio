<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- For local package testing, add a feed explicitly (do not commit it):
         dotnet nuget add source ..\local-packages (name it local) -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

