<Project Sdk="Microsoft.NET.Sdk">

  <!-- A real stdio MCP server used by the integration tests. It is built but
       never referenced: the tests launch it as a child process, which is the
       only way to exercise framing, process death and stderr capture. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>SharpMind.Studio.Tests.FakeMcp</AssemblyName>
    <RootNamespace>SharpMind.Studio.Tests.FakeMcp</RootNamespace>
  </PropertyGroup>

</Project>
