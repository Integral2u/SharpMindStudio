@page "/runs/{RunId}"
@implements IDisposable
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Core.Jobs
@using SharpMind.Studio.Core.Runs
@using SharpMind.Studio.Services
@inject StudioWorkspaceService Workspace
@inject ThemeService Theme
@inject StudioCanaryService Canary
@inject InferenceSettingsService Inference
@inject ModelCatalogService Catalog
@inject ModelTuneService ModelTune
@inject StudioChatService ChatService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Run @Short(@RunId)</PageTitle>

<div class="spread" style="margin-bottom: 1.2rem;">
    <a class="back-link" href="/test">&larr; dashboard</a>
    <span class="faint small mono">@RunId</span>
</div>

@if (_error is not null)
{
    <section class="panel">
        <div class="panel-body">
            <div class="error-line">@_error</div>
        </div>
    </section>
}
else if (_summary is null)
{
    <div class="empty">Loading run...</div>
}
else
{
    <section class="hero" style="padding-top: 0;">
        <div class="hero-copy">
            <div class="eyebrow">@(_summary.Kind ?? "run")</div>
            <h1>@(_summary.Subject ?? "Run")</h1>
            <p>@(_summary.Device ?? "Local device")</p>
            <div class="small faint mono">
                @(_summary.Generator ?? "unknown generator") | @(_summary.Cache ?? "unknown cache") | inference @(_summary.InferenceVersion ?? "unknown")
            </div>
        </div>
        <div class="hero-mark">
            <span class="status @StatusClass(_summary.Status)">@_summary.Status</span>
        </div>
    </section>

    <section class="metric-grid">
        <div class="metric">
            <div class="metric-label">Decode</div>
            <div class="metric-value">@(_summary.TokensPerSecond > 0 ? _summary.TokensPerSecond.ToString("F2") : "-")</div>
            <div class="small faint">tok/s</div>
        </div>
        <div class="metric">
            <div class="metric-label">Steps</div>
            <div class="metric-value">@_summary.Steps</div>
            <div class="small faint">measured tokens</div>
        </div>
        <div class="metric">
            <div class="metric-label">Duration</div>
            <div class="metric-value">@FormatDuration(_summary.Duration)</div>
            <div class="small faint">including load</div>
        </div>
        <div class="metric">
            <div class="metric-label">Tool call</div>
            <div class="metric-value">
                @if (_summary.ToolRunId is not null)
                {
                    <a class="run-link" href="/runs/@_summary.ToolRunId">@_summary.ToolStatus</a>
                }
                else
                {
                    @_summary.ToolStatus
                }
            </div>
            <div class="small faint">option-selection probe</div>
        </div>
    </section>

    <div class="row" style="margin-top: 1.2rem;">
        <label class="tool-toggle">
            <input type="checkbox" @bind="_toolProbe" disabled="@Canary.IsRunning" />
            <span>Include tool call probe</span>
        </label>
        <button type="button" class="button primary" @onclick="RerunAsync" disabled="@Canary.IsRunning">
            @(Canary.IsRunning ? "Running..." : "Re-run")
        </button>
        <button type="button" class="button" @onclick="TuneAsync" disabled="@(Canary.IsRunning || _tuning)">
            @(_tuning ? "Tuning..." : "Tune")
        </button>
        <button type="button" class="button" @onclick="() => StartSessionAsync(work: false)"
                disabled="@(Canary.IsRunning || _tuning)">
            Chat
        </button>
        <button type="button" class="button" @onclick="() => StartSessionAsync(work: true)"
                disabled="@(Canary.IsRunning || _tuning)">
            Work
        </button>
        @if (_tuning)
        {
            <button type="button" class="button danger" @onclick="CancelTune">Cancel tune</button>
        }
        @if (Canary.IsRunning)
        {
            <span class="spinner-ring" title="Re-run active"></span>
        }
        <button type="button" class="button danger" @onclick="DeleteAsync" disabled="@(Canary.IsRunning || _tuning)">
            Delete run
        </button>
        <span class="status-line">@_rerunStatus</span>
    </div>
    @if (_tuneStatus.Length > 0)
    {
        <div class="status-line" style="margin-top: .35rem;">@_tuneStatus</div>
    }
    @if (_rerunError is not null)
    {
        <div class="error-line" style="margin-top: .6rem;">@_rerunError</div>
    }

    @if (_summary.Kind == ToolProbeJob.Kind)
    {
        <div class="small faint" style="margin-top: .7rem;">
            Tool probe runs do not decode tokens. Decode and step metrics are recorded on the linked benchmark run.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_summary.ProbeText))
    {
        <section class="panel" style="margin-top: 1.2rem;">
            <div class="panel-head">
                <div>
                    <div class="eyebrow">@(_summary.Kind == ToolProbeJob.Kind ? "Tool call" : "Standard prompt")</div>
                    <h2>@(_summary.Kind == ToolProbeJob.Kind ? "Call JSON" : "Output")</h2>
                </div>
            </div>
            <div class="panel-body">
                <div class="probe">@_summary.ProbeText</div>
            </div>
        </section>
    }

    @if (_summary.Error is not null)
    {
        <section class="panel" style="margin-top: 1.2rem;">
            <div class="panel-body">
                <div class="error-line">@_summary.Error</div>
            </div>
        </section>
    }

    <section class="panel" style="margin-top: 1.2rem;">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Event stream</div>
                <h2>Timeline</h2>
            </div>
            <span class="faint small mono">@_events.Count events</span>
        </div>
        <div class="panel-body">
            <div class="timeline">
                @foreach (var runEvent in _events)
                {
                    <div class="timeline-row">
                        <span class="timeline-time">@runEvent.AtUtc.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                        <span class="timeline-type">@EventType(runEvent)</span>
                        <span class="timeline-body">@EventBody(runEvent)</span>
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string RunId { get; set; } = "";

    private RunSummary? _summary;
    private IReadOnlyList<RunEvent> _events = [];
    private string? _error;
    private bool _toolProbe = true;
    private bool _pendingRerun;
    private bool _wasRunning;

    private bool IsRunning => Canary.IsRunning;
    private string _rerunStatus = "";
    private string? _rerunError;
    private bool _tuning;
    private string _tuneStatus = "";
    private CancellationTokenSource? _tuneCts;
    private bool _disposed;

    protected override void OnInitialized()
    {
        Canary.Changed += OnCanaryChanged;
        _wasRunning = Canary.IsRunning;
        if (Canary.IsRunning) _rerunStatus = Canary.Status;
    }

    public void Dispose()
    {
        _disposed = true;
        Canary.Changed -= OnCanaryChanged;
        _tuneCts?.Cancel();
        _tuneCts?.Dispose();
    }

    private void OnCanaryChanged() => _ = InvokeAsync(() =>
    {
        bool wasRunning = _wasRunning;
        _wasRunning = Canary.IsRunning;
        if (Canary.IsRunning)
        {
            _rerunStatus = Canary.Status;
        }
        else if (_pendingRerun)
        {
            _pendingRerun = false;
            if (Canary.Error is not null)
            {
                _rerunError = Canary.Error;
                _rerunStatus = "Failed.";
            }
            else
            {
                CanaryResult? result = Canary.Results.FirstOrDefault();
                _rerunStatus = "Finished.";
                if (result is not null) Nav.NavigateTo($"/runs/{result.RunId}");
            }
        }
        else if (wasRunning)
        {
            _rerunStatus = Canary.Status;
            if (Canary.Error is not null) _rerunError = Canary.Error;
        }

        StateHasChanged();
    });
    protected override async Task OnParametersSetAsync()
    {
        _summary = null;
        _events = [];
        _error = null;

        try
        {
            RunHandle handle = Workspace.Runs.Open(RunId);
            _summary = await RunCatalog.LoadAsync(handle);
            _events = [.. await ReadAllAsync(handle)];
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task DeleteAsync()
    {
        if (Canary.IsRunning) return;
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete run {Short(RunId)}? This cannot be undone.");
        if (!confirmed) return;

        try
        {
            Workspace.Runs.Delete(RunId);
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _rerunError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }
    private void RerunAsync()
    {
        if (_summary is null || Canary.IsRunning) return;

        CanaryRerunPlanner.Plan plan = CanaryRerunPlanner.Build(
            [_summary], Workspace, Inference, includeToolProbe: _toolProbe);
        if (plan.Request is null)
        {
            _rerunError = $"Could not find the model for {_summary.Subject ?? _summary.RunId}.";
            return;
        }

        _pendingRerun = true;
        _rerunError = null;
        _rerunStatus = "Starting...";
        _ = Canary.StartAsync(plan.Request, Workspace.Runs);
    }

    private ModelDescriptor? ModelForRun()
    {
        if (_summary is null) return null;
        string? path = Workspace.ResolveModelPath(_summary.ModelPath) ??
                       Workspace.ResolveModelPath(_summary.Subject);
        return path is null ? null : Catalog.Find(path);
    }

    private async Task TuneAsync()
    {
        if (_tuning || Canary.IsRunning) return;
        ModelDescriptor? model = ModelForRun();
        if (model is null)
        {
            _rerunError = "Could not find the model for this run.";
            return;
        }

        _tuning = true;
        _tuneStatus = "Starting...";
        _tuneCts = new CancellationTokenSource();
        var progress = new Progress<ModelTuneProgress>(update =>
        {
            if (_disposed) return;
            _tuneStatus = update.Total > 0
                ? $"{update.Message} ({Math.Min(update.Completed + 1, update.Total)}/{update.Total})"
                : update.Message;
            StateHasChanged();
        });

        try
        {
            TuneTarget target = _summary?.ToolStatus is "Yes" or "No"
                ? TuneTarget.Work
                : TuneTarget.Chat;
            await ModelTune.TuneAsync(model, target, progress, _tuneCts.Token);
            _tuneStatus = $"Tuned {target}.";
        }
        catch (OperationCanceledException)
        {
            _tuneStatus = "Tuning cancelled.";
        }
        catch (Exception ex)
        {
            _rerunError = $"{ex.GetType().Name}: {ex.Message}";
            _tuneStatus = "";
        }
        finally
        {
            _tuning = false;
            _tuneCts?.Dispose();
            _tuneCts = null;
            if (!_disposed) StateHasChanged();
        }
    }

    private void CancelTune() => _tuneCts?.Cancel();

    private async Task StartSessionAsync(bool work)
    {
        ModelDescriptor? model = ModelForRun();
        if (model is null)
        {
            _rerunError = "Could not find the model for this run.";
            return;
        }

        TuneTarget target = work ? TuneTarget.Work : TuneTarget.Chat;
        TuneProfile? tune = Inference.TuneProfile(model.Path, target, TunePreset.Balanced);
        await ChatService.NewChatAsync(
            model,
            systemPrompt: null,
            overrides: tune?.Overrides,
            mode: work ? "work" : "chat",
            tunePreset: tune is null ? null : TunePreset.Balanced.ToString(),
            tuneTarget: target.ToString());

        if (ChatService.Document is not null)
        {
            Nav.NavigateTo(work
                ? $"/work/{ChatService.Document.Id}"
                : $"/chat/{ChatService.Document.Id}");
        }
    }

    private static async Task<List<RunEvent>> ReadAllAsync(RunHandle handle)
    {
        var events = new List<RunEvent>();
        await foreach (var runEvent in handle.ReadEventsAsync())
            events.Add(runEvent);
        return events;
    }

    private static string Short(string value) => value.Length <= 18 ? value : value[..18] + "...";

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "running",
    };

    private static string FormatDuration(TimeSpan? duration) =>
        duration is { } value ? $"{value.TotalSeconds:F1}s" : "-";

    private static string EventType(RunEvent runEvent) => runEvent switch
    {
        RunStarted => "start",
        StepLogged => "step",
        EvalCompleted => "eval",
        ExpertStats => "experts",
        CheckpointSaved => "checkpoint",
        ProbeAnswered => "probe",
        ToolProbeCompleted => "tool",
        RunFinished => "finish",
        _ => runEvent.GetType().Name,
    };

    private static string EventBody(RunEvent runEvent) => runEvent switch
    {
        RunStarted e => $"{e.Kind} | {e.Subject}",
        StepLogged e => $"step {e.Step} | {e.TokensPerSecond:F2} tok/s | {e.TokensSeen} tokens",
        EvalCompleted e => $"step {e.Step} | val loss {e.ValLoss:F4} | ppl {e.Perplexity:F2}",
        ExpertStats e => $"step {e.Step} | layer {e.Layer} | entropy {e.RoutingEntropy:F3}",
        CheckpointSaved e => $"step {e.Step} | {e.Path}",
        ProbeAnswered e => e.Text,
        ToolProbeCompleted e => $"{e.Status} | {e.Detail}",
        RunFinished e => $"{e.Status} | {e.DurationMs:F0} ms{(e.Error is null ? "" : $" | {e.Error}")}",
        _ => "",
    };
}














