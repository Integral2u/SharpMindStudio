    private void UpdateLatestRun()
    {
        if (_remoteChat)
        {
            _latestRun = null;
            _toolState = new ToolCapabilityState(ToolCapability.Untested, null, null);
            return;
        }

        string? fileName = SelectedFileName;
        _latestRun = fileName is null
            ? null
            : RunInsights.LatestBench(_runs, _selectedModelPath, fileName);

        TuneMeasurement? work = string.IsNullOrWhiteSpace(_selectedModelPath)
            ? null
            : Inference.TuneProfile(_selectedModelPath, TuneTarget.Work, TunePreset.Balanced)?.Measurement;
        _toolState = RunInsights.ResolveToolCapability(_selectedModelPath, fileName, _runs, work);
    }

    private async Task SendAsync()
    {
        if (_busy) return;

        // Chat sessions live in the default project; work sessions in the open one.
        ChatService.EnsureStoreFor(_mode);

        if (_remoteChat)
        {
            if (_computeProviderId is not null && _mode == "work")
                _mode = "chat";

            if (!RemoteReady)
            {
                _error = _computeProviderId is not null
                    ? "Choose a Compute host with a token and a model first."
                    : $"Choose a {RemotePreset.Name} model and add an API key first.";
                return;
            }

            _busy = true;
            _error = null;
            try
            {
                if (_computeProviderId is { } computeId)
                {
                    await ChatService.NewComputeChatAsync(
                        computeId, _remoteModel.Trim(), systemPrompt: null, mode: _mode);
                }
                else
                {
                    await ChatService.NewRemoteChatAsync(
                        _remoteModel.Trim(),
                        systemPrompt: null,
                        mode: _mode,
                        providerId: _remoteProviderId);
                }

                if (ChatService.Document is null)
                {
                    _error = ChatService.Error ?? ChatService.Status;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(_prompt))
                    ChatService.PendingPrompt = _prompt.Trim();
                ChatService.PendingArtifacts = [.. _pendingArtifacts];
                Nav.NavigateTo(_mode == "work"
                    ? $"/work/{ChatService.Document.Id}"
                    : $"/chat/{ChatService.Document.Id}");
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        if (model is null)
        {
            _error = "Choose a model first.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Theme.SetLastChatModelAsync(model.Path);
            TuneTarget target = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
            if (Inference.HasTune(model.Path, target) && _selectedTunePreset is null)
                _selectedTunePreset = TunePreset.Balanced;
            TuneProfile? tune = _selectedTunePreset is { } selected
                ? Inference.TuneProfile(model.Path, target, selected)
                : null;
            await ChatService.NewChatAsync(model, systemPrompt: null, overrides: tune?.Overrides,
                mode: _mode,
                tunePreset: tune is null ? null : _selectedTunePreset?.ToString(),
                tuneTarget: target.ToString());
            if (ChatService.Document is null || ChatService.Status != "Ready.")
            {
                _error = ChatService.Error ?? ChatService.Status;
                return;
            }

            if (!string.IsNullOrWhiteSpace(_prompt))
                ChatService.PendingPrompt = _prompt.Trim();
            ChatService.PendingArtifacts = [.. _pendingArtifacts];
            Nav.NavigateTo(_mode == "work" ? $"/work/{ChatService.Document.Id}" : $"/chat/{ChatService.Document.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void RefreshTuneSelection()
    {
        if (_remoteChat)
        {
            _selectedTunePreset = null;
            return;
        }

        TuneTarget target = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
        if (string.IsNullOrWhiteSpace(_selectedModelPath) || !Inference.HasTune(_selectedModelPath, target))
        {
            _selectedTunePreset = null;
            return;
        }

        if (_selectedTunePreset is null ||
            Inference.TuneProfile(_selectedModelPath, target, _selectedTunePreset.Value) is null)
            _selectedTunePreset = TunePreset.Balanced;
    }

    private void OpenTune()
    {
        if (_remoteChat) return;
        _tuneModel = _models.FirstOrDefault(model => model.Path == _selectedModelPath);
        if (_tuneModel is null) return;
        _tuneTarget = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
        _showTuneModal = true;
    }

    private void CloseTune() => _showTuneModal = false;

    private void OnTuneSaved()
    {
        _showTuneModal = false;
        RefreshTuneSelection();
        UpdateLatestRun();
    }
    private void OpenTest() => Nav.NavigateTo("/test");

    private void OpenTraining() => Nav.NavigateTo("/training");

    private void OpenRouterSettings() => Nav.NavigateTo("/settings?tab=openrouter");

    /// <summary>
    /// A new session starts on the remote provider used most recently, with that
    /// provider's last selected model. Missing keys fall back to a local model.
    /// </summary>
    private void ApplyLastRemoteProvider()
    {
        string? last = Theme.LastRemoteProvider;
        _remoteChat = RemoteProviders.IsRemote(last) && OpenRouter.HasApiKeyFor(last);
        _remoteProviderId = _remoteChat
            ? RemoteProviders.NormalizeId(last)
            : RemoteProviders.OpenRouter;
        _remoteModel = _remoteChat
            ? OpenRouter.DefaultModelFor(_remoteProviderId) ??
              OpenRouter.ActiveModelsFor(_remoteProviderId).FirstOrDefault() ?? ""
            : "";
    }

    private async Task SetProvider(ChangeEventArgs args)
    {
        string value = args.Value?.ToString() ?? "local";
        if (value.StartsWith("compute:", StringComparison.OrdinalIgnoreCase))
        {
            _computeProviderId = value["compute:".Length..];
            _remoteChat = true;
            _mode = "chat";
            ComputeProvider? host = Compute.Resolve(_computeProviderId);
            _remoteModel = host?.DefaultModel ?? host?.Models.FirstOrDefault() ?? "";
            if (host is { IsUsable: true } && host.Models.Count == 0)
            {
                try
                {
                    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
                    await Compute.RefreshModelsAsync(_computeProviderId, timeout.Token);
                    host = Compute.Resolve(_computeProviderId);
                    _remoteModel = host?.DefaultModel ?? host?.Models.FirstOrDefault() ?? _remoteModel;
                }
                catch
                {
                    // The panel under Settings explains an unreachable host.
                }
            }
        }
        else
        {
            _computeProviderId = null;
            _remoteChat = RemoteProviders.IsRemote(value);
            if (_remoteChat)
            {
                _remoteProviderId = RemoteProviders.NormalizeId(value);
                _remoteModel = OpenRouter.DefaultModelFor(_remoteProviderId) ??
                               OpenRouter.ActiveModelsFor(_remoteProviderId).FirstOrDefault() ?? "";
            }
        }

        UpdateLatestRun();
        RefreshTuneSelection();
        await Theme.SetLastRemoteProviderAsync(
            _remoteChat && _computeProviderId is null ? _remoteProviderId : null);
        await InvokeAsync(StateHasChanged);
        if (_remoteChat && _computeProviderId is null)
            await EnsureActiveModels();
    }

    private async Task EnsureActiveModels()
    {
        if (!_remoteChat || !RemoteHasApiKey) return;

        if (_remoteProviderId == RemoteProviders.OpenRouter &&
            (OpenRouter.ActiveModelsFor(_remoteProviderId).Count == 0 ||
             !OpenRouter.FreeModelsSeededFor(_remoteProviderId)))
        {
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                await OpenRouter.SeedDefaultModelsForAsync(_remoteProviderId, timeout.Token);
            }
            catch
            {
                // The warning/status area explains an empty or failed fetch.
            }
        }

        IReadOnlyList<string> models = OpenRouter.ActiveModelsFor(_remoteProviderId);
        if (!models.Any(model =>
                model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase)))
        {
            _remoteModel = OpenRouter.DefaultModelFor(_remoteProviderId) ??
                           models.FirstOrDefault() ?? "";
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "unknown",
    };

    private static string ToolClass(string status) => status switch
    {
        "Yes" => "ok",
        "No" => "failed",
        _ => "unknown",
    };

    private void RemoveArtifact(ChatArtifact artifact)
    {
        _pendingArtifacts.Remove(artifact);
        if (artifact.SourcePath is { Length: > 0 } source) _contextPaths.Remove(source);
        if (_pendingArtifacts.Count <= 3) _showOverflow = false;
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs args)
    {
        const long maxBytes = 25L * 1024 * 1024;
        foreach (IBrowserFile file in args.GetMultipleFiles(maximumFileCount: 8))
        {
            if (file.Size <= 0 || file.Size > maxBytes) continue;
            try
            {
                await using Stream source = file.OpenReadStream(maxBytes);
                using var buffer = new MemoryStream();
                await source.CopyToAsync(buffer);
                _pendingArtifacts.Add(new ChatArtifact
                {
                    Type = ArtifactType(file.ContentType, file.Name),
                    MimeType = ArtifactMime(file.ContentType, file.Name),
                    Content = buffer.ToArray(),
                    FileName = file.Name,
                });
            }
            catch
            {
                // An unreadable browser file must not take the composer down.
            }
        }
    }

    private static string ArtifactType(string? contentType, string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return "image";
            if (contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)) return "audio";
            if (contentType.Contains("json", StringComparison.OrdinalIgnoreCase)) return "json";
            if (contentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase)) return "text";
        }

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" => "image",
            ".wav" or ".mp3" or ".ogg" or ".m4a" or ".flac" => "audio",
            ".json" => "json",
            ".txt" or ".md" or ".csv" or ".log" => "text",
            _ => "file",
        };
    }

    private static string ArtifactMime(string? contentType, string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType) &&
            contentType.Contains('/', StringComparison.Ordinal))
        {
            return contentType.ToLowerInvariant();
        }

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            ".wav" => "audio/wav",
            ".mp3" => "audio/mpeg",
            ".ogg" => "audio/ogg",
            ".m4a" => "audio/mp4",
            ".flac" => "audio/flac",
            ".pdf" => "application/pdf",
            ".json" => "application/json",
            ".csv" => "text/csv",
            ".md" => "text/markdown",
            ".txt" or ".log" => "text/plain",
            ".zip" => "application/zip",
            ".7z" => "application/x-7z-compressed",
            ".tar" => "application/x-tar",
            ".gz" => "application/gzip",
            _ => "application/octet-stream",
        };
    }
