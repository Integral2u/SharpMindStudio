@page "/"
@implements IDisposable
@using SharpMind.Studio.Core.Runs
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Services
@inject ThemeService Theme
@inject ModelCatalogService Catalog
@inject InferenceSettingsService Inference
@inject OpenRouterSettingsService OpenRouter
@inject StudioChatService ChatService
@inject StudioWorkspaceService Workspace
@inject NavigationManager Nav

<PageTitle>SharpMind Studio</PageTitle>

<div class="welcome">
    <div class="welcome-head">
        <h1>@(_mode == "work" ? "What do you want to work on?" : "What do you want to ask?")</h1>
        <p>@(_mode == "work" ? "Start a project-backed session with tools. Choose local weights or OpenRouter." : "Start a chat with a local model or OpenRouter.")</p>
    </div>

    <div class="welcome-compose">
        <textarea class="welcome-prompt" data-enter-send="welcome-send" onkeydown="studioChat.enterSend(event, 'welcome-send')" @bind="_prompt" @bind:event="oninput"
                  placeholder="@(_mode == "work" ? "Describe the task, or leave this empty and press Send to start a new Work session." : "Ask something, or leave this empty and press Send to start a new chat.")"></textarea>
        <button id="welcome-send" type="button" class="button primary welcome-send" @onclick="SendAsync"
                disabled="@(_busy || ChatService.IsLoading ||
                            (_remoteChat ? !RemoteReady : string.IsNullOrWhiteSpace(_selectedModelPath)) ||
                            (_mode == "work" && !_remoteChat && _toolState.Capability != ToolCapability.Passed && !_allowUnverifiedTools))">
            @(_busy ? "Starting..." : "Send")
        </button>
    </div>

    <div class="welcome-modes">
        <button type="button" class="welcome-mode @(_mode == "chat" ? "selected" : "")" @onclick='() => SetMode("chat")'>
            <span class="welcome-mode-name">Chat</span>
            <span class="welcome-mode-hint">Talk to the selected model</span>
        </button>
        <button type="button" class="welcome-mode @(_mode == "work" ? "selected" : "")" @onclick='() => SetMode("work")'>
            <span class="welcome-mode-name">Work</span>
            <span class="welcome-mode-hint">Start a project-backed session with tools</span>
        </button>
        <button type="button" class="welcome-mode" @onclick="OpenTest">
            <span class="welcome-mode-name">Test</span>
            <span class="welcome-mode-hint">Open the canary dashboard</span>
        </button>
        <button type="button" class="welcome-mode" @onclick="OpenTraining">
            <span class="welcome-mode-name">Train</span>
            <span class="welcome-mode-hint">Open the training lab</span>
        </button>
    </div>

    <div class="welcome-controls">
        <div class="field">
            <label class="field-label" for="welcome-provider">Provider</label>
            <select id="welcome-provider" class="input" @onchange="SetProvider">
                <option value="local" selected="@(!_remoteChat)">Local model</option>
                <option value="openrouter" selected="@_remoteChat">OpenRouter</option>
            </select>
        </div>
        @if (_remoteChat)
        {
            <div class="field welcome-model">
                <label class="field-label" for="welcome-remote-model">OpenRouter model</label>
                <select id="welcome-remote-model" class="input" @bind="_remoteModel"
                        @bind:after="SaveRemoteModelChoice"
                        @onfocus="EnsureActiveModels">
                    @if (OpenRouter.ActiveModels.Count == 0)
                    {
                        <option value="">@(OpenRouter.HasApiKey ? "Loading models..." : "No active models")</option>
                    }
                    @foreach (string model in OpenRouter.ActiveModels)
                    {
                        <option value="@model">@model</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="field welcome-model">
                <label class="field-label" for="welcome-model">Model</label>
                <select id="welcome-model" class="input" @bind="_selectedModelPath" @bind:after="SaveDefaultModelAsync">
                    @if (_models.Count == 0)
                    {
                        <option value="">Scanning models...</option>
                    }
                    @foreach (var model in _models)
                    {
                        <option value="@model.Path">@model.FileName - @model.Family.DisplayName</option>
                    }
                </select>
            </div>
        }

        <div class="field welcome-session">
            <label class="field-label" for="welcome-session">Session</label>
            <select id="welcome-session" class="input" @bind="_selectedSessionId" @bind:after="OpenSessionAsync">
                <option value="">New</option>
                @foreach (var session in _sessions)
                {
                    <option value="@session.Id">@session.Name@(session.Mode == "work" ? " / work" : "")@(session.Provider == "openrouter" ? " / remote" : "")</option>
                }
            </select>
        </div>

        @if (!_remoteChat)
        {
            <div class="welcome-model-status">
                @if (_latestRun is not null)
                {
                    <span class="status @StatusClass(_latestRun.Status)">@_latestRun.Status</span>
                }
                <ModelToolStatus ModelPath="_selectedModelPath" FileName="@SelectedFileName" Runs="_runs" />
            </div>
        }
    </div>
    @if (_remoteChat && !OpenRouter.HasApiKey)
    {
        <div class="tool-warning">
            <div>
                <strong>OpenRouter needs an API key.</strong>
                <span class="small faint">Add it in Settings, then return here.</span>
            </div>
            <div class="row">
                <button type="button" class="button" @onclick="OpenRouterSettings">Open Settings</button>
            </div>
        </div>
    }
    @if (_remoteChat && OpenRouter.HasApiKey)
    {
        <div class="small faint">
            OpenRouter models are inference-only; local tuning is unavailable. Work tools stay on this machine.
        </div>
    }
    <div class="status-line">@(ChatService.IsLoading || _busy ? ChatService.Status : "Ready.")</div>

    @if (ChatService.IsLoading)
    {
        <div class="load-panel">
            <div class="load-panel-row">
                <span class="spinner-ring"></span>
                <span>@ChatService.LoadDetail</span>
                <span class="mono">@LoadPercent</span>
                <button type="button" class="button" @onclick="ChatService.Interrupt">Interrupt</button>
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@LoadPercent"></div>
            </div>
        </div>
    }

    @if (!_remoteChat && !string.IsNullOrWhiteSpace(_selectedModelPath))
    {
        <TunePresetPicker ModelPath="_selectedModelPath"
                          Target="@(_mode == "work" ? TuneTarget.Work : TuneTarget.Chat)"
                          SelectedPreset="_selectedTunePreset"
                          SelectedPresetChanged="p => _selectedTunePreset = p"
                          OnTune="OpenTune" />
    }

    @if (!_remoteChat && _mode == "work" && _toolState.Capability != ToolCapability.Passed)
    {
        <div class="tool-warning">
            <div>
                <strong>Tools are not verified for this model.</strong>
                <span class="small faint">Work mode depends on tool calling. Test it before relying on Work.</span>
            </div>
            <div class="row">
                <button type="button" class="button" @onclick="OpenTune">Test tools</button>
                <label class="tool-toggle">
                    <input type="checkbox" @bind="_allowUnverifiedTools" />
                    <span>Start anyway</span>
                </label>
            </div>
        </div>
    }

    @if (_error is not null)
    {
        <div class="error-line">@_error</div>
    }
</div>

@if (_showTuneModal && _tuneModel is not null)
{
    <div class="tune-modal-backdrop">
        <div class="tune-modal">
            <div class="tune-modal-head">
                <span>@_tuneModel.FileName</span>
                <button type="button" class="button" @onclick="CloseTune">Close</button>
            </div>
            <ModelTunePanel Model="_tuneModel" InitialTarget="_tuneTarget"
                            Generators="Workspace.Builders.Generators"
                            Caches="Workspace.Builders.Caches"
                            OnSaved="OnTuneSaved" />
        </div>
    </div>
}

@code {
    private IReadOnlyList<ModelDescriptor> _models = [];
    private IReadOnlyList<RunSummary> _runs = [];
    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> _sessions = [];
    private string _selectedSessionId = "";
    private TunePreset? _selectedTunePreset;
    private bool _showTuneModal;
    private ModelDescriptor? _tuneModel;
    private TuneTarget _tuneTarget = TuneTarget.Chat;
    private string? _selectedModelPath;
    private bool _remoteChat;
    private string _remoteModel = "";
    private string _prompt = "";
    private string _mode = "chat";
    private RunSummary? _latestRun;
    private ToolCapabilityState _toolState = new(ToolCapability.Untested, null, null);
    private bool _allowUnverifiedTools;
    private bool _busy;
    private string? _error;

    private bool RemoteReady =>
        _remoteChat &&
        !string.IsNullOrWhiteSpace(_remoteModel) &&
        OpenRouter.HasApiKey &&
        OpenRouter.ActiveModels.Any(model =>
            model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase));

    private string? SelectedFileName =>
        _models.FirstOrDefault(model => model.Path == _selectedModelPath)?.FileName;

    private string LoadPercent => ChatService.LoadProgress is { } value
        ? $"{value * 100:F0}%"
        : "0%";

    protected override async Task OnInitializedAsync()
    {
        ChatService.Changed += OnChatChanged;
        _models = await Catalog.RefreshAsync();
        _runs = await Workspace.RecentRunsAsync();
        _sessions = ChatService.Sessions;
        _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
            ? Theme.LastChatModel
            : _models.FirstOrDefault()?.Path;
        _remoteModel = OpenRouter.DefaultModel ?? OpenRouter.ActiveModels.FirstOrDefault() ?? "";
        UpdateLatestRun();
        RefreshTuneSelection();
    }

    public void Dispose() => ChatService.Changed -= OnChatChanged;

    private void OnChatChanged() => _ = InvokeAsync(() =>
    {
        _sessions = ChatService.Sessions;
        StateHasChanged();
    });

    private void SetMode(string mode)
    {
        _mode = mode;
        _error = null;
        _allowUnverifiedTools = false;
        RefreshTuneSelection();
        UpdateLatestRun();
    }

    private void OpenSessionAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedSessionId)) return;
        var session = _sessions.FirstOrDefault(value => value.Id == _selectedSessionId);
        _selectedSessionId = "";
        if (session is null) return;
        Nav.NavigateTo(session.Mode == "work" ? $"/work/{session.Id}" : $"/chat/{session.Id}");
    }

    private async Task SaveDefaultModelAsync()
    {
        await Theme.SetLastChatModelAsync(_selectedModelPath);
        UpdateLatestRun();
        RefreshTuneSelection();
    }

    private void SaveRemoteModelChoice()
    {
        if (!string.IsNullOrWhiteSpace(_remoteModel))
            OpenRouter.SetDefaultModel(_remoteModel);
    }

    private void UpdateLatestRun()
    {
        if (_remoteChat)
        {
            _latestRun = null;
            _toolState = new ToolCapabilityState(ToolCapability.Untested, null, null);
            return;
        }

        string? fileName = SelectedFileName;
        _latestRun = fileName is null
            ? null
            : RunInsights.LatestBench(_runs, _selectedModelPath, fileName);

        TuneMeasurement? work = string.IsNullOrWhiteSpace(_selectedModelPath)
            ? null
            : Inference.TuneProfile(_selectedModelPath, TuneTarget.Work, TunePreset.Balanced)?.Measurement;
        _toolState = RunInsights.ResolveToolCapability(_selectedModelPath, fileName, _runs, work);
    }

    private async Task SendAsync()
    {
        if (_busy) return;

        if (_remoteChat)
        {
            if (!RemoteReady)
            {
                _error = "Choose an OpenRouter model and add an API key first.";
                return;
            }

            _busy = true;
            _error = null;
            try
            {
                await ChatService.NewRemoteChatAsync(_remoteModel.Trim(), systemPrompt: null, mode: _mode);
                if (ChatService.Document is null)
                {
                    _error = ChatService.Error ?? ChatService.Status;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(_prompt))
                    ChatService.PendingPrompt = _prompt.Trim();
                Nav.NavigateTo(_mode == "work"
                    ? $"/work/{ChatService.Document.Id}"
                    : $"/chat/{ChatService.Document.Id}");
            }
            finally
            {
                _busy = false;
            }
            return;
        }

        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        if (model is null)
        {
            _error = "Choose a model first.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Theme.SetLastChatModelAsync(model.Path);
            TuneTarget target = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
            if (Inference.HasTune(model.Path, target) && _selectedTunePreset is null)
                _selectedTunePreset = TunePreset.Balanced;
            TuneProfile? tune = _selectedTunePreset is { } selected
                ? Inference.TuneProfile(model.Path, target, selected)
                : null;
            await ChatService.NewChatAsync(model, systemPrompt: null, overrides: tune?.Overrides,
                mode: _mode,
                tunePreset: tune is null ? null : _selectedTunePreset?.ToString(),
                tuneTarget: target.ToString());
            if (ChatService.Document is null || ChatService.Status != "Ready.")
            {
                _error = ChatService.Error ?? ChatService.Status;
                return;
            }

            if (!string.IsNullOrWhiteSpace(_prompt))
                ChatService.PendingPrompt = _prompt.Trim();
            Nav.NavigateTo(_mode == "work" ? $"/work/{ChatService.Document.Id}" : $"/chat/{ChatService.Document.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private void RefreshTuneSelection()
    {
        if (_remoteChat)
        {
            _selectedTunePreset = null;
            return;
        }

        TuneTarget target = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
        if (string.IsNullOrWhiteSpace(_selectedModelPath) || !Inference.HasTune(_selectedModelPath, target))
        {
            _selectedTunePreset = null;
            return;
        }

        if (_selectedTunePreset is null ||
            Inference.TuneProfile(_selectedModelPath, target, _selectedTunePreset.Value) is null)
            _selectedTunePreset = TunePreset.Balanced;
    }

    private void OpenTune()
    {
        if (_remoteChat) return;
        _tuneModel = _models.FirstOrDefault(model => model.Path == _selectedModelPath);
        if (_tuneModel is null) return;
        _tuneTarget = _mode == "work" ? TuneTarget.Work : TuneTarget.Chat;
        _showTuneModal = true;
    }

    private void CloseTune() => _showTuneModal = false;

    private void OnTuneSaved()
    {
        _showTuneModal = false;
        RefreshTuneSelection();
        UpdateLatestRun();
    }
    private void OpenTest() => Nav.NavigateTo("/test");

    private void OpenTraining() => Nav.NavigateTo("/training");

    private void OpenRouterSettings() => Nav.NavigateTo("/settings?tab=openrouter");

    private async Task SetProvider(ChangeEventArgs args)
    {
        _remoteChat = string.Equals(
            args.Value?.ToString(), "openrouter", StringComparison.OrdinalIgnoreCase);
        await InvokeAsync(StateHasChanged);
        if (_remoteChat)
            await EnsureActiveModels();
    }

    private async Task EnsureActiveModels()
    {
        if (!_remoteChat || !OpenRouter.HasApiKey) return;

        if (OpenRouter.ActiveModels.Count == 0 || !OpenRouter.FreeModelsSeeded)
        {
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                await OpenRouter.SeedDefaultModelsAsync(timeout.Token);
            }
            catch
            {
                // The warning/status area explains an empty or failed fetch.
            }
        }

        if (!OpenRouter.ActiveModels.Any(model =>
                model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase)))
        {
            _remoteModel = OpenRouter.DefaultModel ?? OpenRouter.ActiveModels.FirstOrDefault() ?? "";
        }

        await InvokeAsync(StateHasChanged);
    }

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "unknown",
    };

    private static string ToolClass(string status) => status switch
    {
        "Yes" => "ok",
        "No" => "failed",
        _ => "unknown",
    };
}














