@page "/settings"
@using Microsoft.AspNetCore.Components
@using SharpMind.Studio.Core.Compute
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Core.Storage
@using SharpMind.Studio.Services
@inject ThemeService Theme
@inject StudioWorkspaceService Workspace
@inject InferenceSettingsService Inference
@inject OpenRouterSettingsService OpenRouter
@inject ComputeProviderService Compute
@inject DockerHostService Docker
@inject RunpodService Runpod
@inject SshHostService Ssh
@inject HuggingFaceService HuggingFace
@inject ModelCatalogService Catalog
@inject GatewayService Gateway
@inject PathPickerService Picker
@inject IJSRuntime JS

<PageTitle>Settings - SharpMind Studio</PageTitle>

<div class="hero" style="padding-top: 0;">
    <div class="hero-copy">
        <div class="eyebrow">Settings</div>
        <h1>Make it yours.</h1>
        <p>System defaults flow through model families and models into each chat session. Empty overrides inherit.</p>
    </div>
    <div class="hero-mark">local by default<br />OpenRouter optional</div>
</div>

<div class="settings-tabs">
    <a class="settings-tab @(_tab == "appearance" ? "selected" : "")" href="/settings?tab=appearance" data-enhance-nav="false">Appearance</a>
    <a class="settings-tab @(_tab == "system" ? "selected" : "")" href="/settings?tab=system" data-enhance-nav="false">System</a>
    <a class="settings-tab @(_tab == "families" ? "selected" : "")" href="/settings?tab=families" data-enhance-nav="false">Families</a>
    <a class="settings-tab @(_tab == "models" ? "selected" : "")" href="/settings?tab=models" data-enhance-nav="false">Models</a>
    <a class="settings-tab @(_tab == "openrouter" ? "selected" : "")" href="/settings?tab=openrouter" data-enhance-nav="false">Providers</a>
    <a class="settings-tab @(_tab == "pair" ? "selected" : "")" href="/settings?tab=pair" data-enhance-nav="false">Pair</a>
    <span style="margin-left:auto">
        <WikiGuideLink Page="settings" Label="Settings guide" Class="settings-tab" />
    </span>
</div>

@if (_tab == "system")
{
    <details class="panel settings-collapsible" open>
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Connection</div>
                <h2>Studio server</h2>
            </div>
            <span class="faint small mono">applies on next start</span>
        </summary>
        <div class="panel-body stack">
            <div class="field">
                <label class="field-label" for="studio-provider">Use a Compute host</label>
                <select id="studio-provider" class="input" @onchange="UseProviderStudioAsync">
                    <option value="">Choose a combined server...</option>
                    @foreach (ComputeProviderSettings host in Compute.Providers)
                    {
                        <option value="@host.Id">@host.Name — @(host.StudioUrl ?? "no Studio URL")</option>
                    }
                </select>
                <span class="small faint">
                    A combined SharpMind Server serves Studio on port 5117 and the Compute API on 8080.
                </span>
            </div>
            <div class="server-row">
                <div class="field">
                    <label class="field-label" for="studio-host">Host</label>
                    <input id="studio-host" class="input" @bind="_studioHost" @bind:after="SaveServerAsync" />
                </div>
                <div class="field server-port-field">
                    <label class="field-label" for="studio-port">Port</label>
                    <input id="studio-port" class="input" type="number" min="1" max="65535" @bind="_studioPort" @bind:after="SaveServerAsync" />
                </div>
                <div class="server-actions">
                    <button type="button" class="button" @onclick="ResetServerAsync">Reset local defaults</button>
                </div>
            </div>
            <div class="status-line">@_serverStatus</div>
            <div class="small faint">Used when Studio starts. If the configured server is unreachable, the desktop app asks whether to run locally.</div>
        </div>
    </details>

    <details class="panel settings-collapsible">
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>System defaults</h2>
            </div>
            <span class="faint small mono">root of every chat</span>
        </summary>
        <div class="panel-body stack">
            <div class="field">
                <label class="field-label" for="default-chat-model">Default chat model</label>
                <select id="default-chat-model" class="input" @bind="_defaultModelPath" @bind:after="SaveDefaultModel">
                    @foreach (var model in _models)
                    {
                        <option value="@model.Path">@model.FileName - @model.DisplayName (@model.Family.DisplayName)</option>
                    }
                </select>
                <div class="small faint">Used by the welcome screen until you choose another model there.</div>
            </div>

            <InferenceProfileEditor Value="_system" ValueChanged="SaveSystemFromEditor"
                                    Generators="Workspace.Builders.Generators"
                                    Caches="Workspace.Builders.Caches" />
            <div class="status-line">@_status</div>
        </div>
    </details>

    <SystemSkillsEditor />

    <SystemToolsEditor />

    <PluginComponentsEditor />

    <details class="panel settings-collapsible">
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Storage</div>
                <h2>Where data lives</h2>
            </div>
            <span class="faint small mono">settings vs project</span>
        </summary>
        <div class="panel-body stack small mono">
            <div class="spread"><span class="faint">root</span><span>@StudioPaths.Root</span></div>
            <div class="spread"><span class="faint">settings</span><span>@StudioPaths.Projects</span></div>
            <div class="spread"><span class="faint">project</span><span>@Workspace.Project.Root</span></div>
            <div class="spread"><span class="faint">runs</span><span>@Workspace.Runs.RunsRoot</span></div>
            <div class="spread"><span class="faint">chats</span><span>@Workspace.Project.ChatsDirectory</span></div>
            <div class="row" style="margin-top: .5rem;">
                <button type="button" class="button" @onclick="() => OpenFolder(Workspace.Project.Root)">Open project folder</button>
                <button type="button" class="button" @onclick="() => OpenFolder(Workspace.Runs.RunsRoot)">Open runs folder</button>
                <button type="button" class="button" @onclick="() => OpenFolder(StudioPaths.Projects)">Open settings folder</button>
            </div>
            <div class="small faint">Runs and chats live in the current project. The settings folder holds settings, inference profiles, Gateway data, and shared skills config.</div>
        </div>
    </details>

    <details class="panel settings-collapsible">
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Desktop</div>
                <h2>Window behaviour</h2>
            </div>
            <span class="faint small mono">desktop app only</span>
        </summary>
        <div class="panel-body stack">
            <div class="field">
                <label class="field-label" for="close-to-tray">When I close the window</label>
                <select id="close-to-tray" class="input" @onchange="SetCloseToTray">
                    <option value="true" selected="@_closeToTray">Minimize to tray (default)</option>
                    <option value="false" selected="@(!_closeToTray)">Exit Studio</option>
                </select>
            </div>
            <div class="small faint">
                The desktop shell reads this when the close button is pressed. The browser UI is unaffected.
            </div>
            <div class="status-line">@_closeToTrayStatus</div>
        </div>
    </details>

}

else if (_tab == "openrouter")
{
    <details class="panel settings-collapsible" open>
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Settings</div>
                <h2>Providers</h2>
            </div>
            <span class="faint small mono">@(Compute.Providers.Count + 2) group(s)</span>
        </summary>
        <div class="panel-body stack">
            <SettingsOpenRouterPanel />

            <details class="settings-subgroup">
                <summary class="settings-subgroup-head">
                    <div>
                        <div class="eyebrow">Compute hosts</div>
                        <h3>Compute</h3>
                    </div>
                    <div class="row" style="align-items:center; gap:.45rem;">
                        <span class="provider-dot @(Compute.DefaultProvider?.Healthy == true ? "on" : "off")"></span>
                        <span class="faint small mono">@Compute.Providers.Count host(s)</span>
                    </div>
                </summary>
                <div class="settings-subgroup-body stack">
            <p class="small faint">
                A Compute host is the SharpMind server image: one model, chat completions and
                training jobs. Use <strong>Local Docker</strong> for a container on this PC and
                <strong>Remote host</strong> for Runpod or any other machine. The token is encrypted
                with the same local key box as the other provider secrets.
            </p>

            <div class="row">
                <button type="button" class="button primary" @onclick="NewCompute">Add host</button>
                <span class="small faint">Default host is used by Chat and Training when you pick Compute.</span>
            </div>

            <SettingsRegistryPanel />

            @if (_computeStatus is { Length: > 0 })
            {
                <div class="status-line">@_computeStatus</div>
            }
            @if (_computeError is not null && _computeErrorHostId is null)
            {
                <div class="error-line">@_computeError</div>
            }

            @if (_computeEditing)
            {
                <div class="training-subsection" id="compute-editor">
                    <div class="training-subsection-head">
                        <label class="field-label">@(_editingComputeId is null ? "New Compute host" : "Edit Compute host")</label>
                    </div>
                    <div class="training-form">
                        <div class="field">
                            <label class="field-label" for="compute-name">Name</label>
                            <input id="compute-name" class="input" @bind="_computeName" placeholder="Local Docker" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="compute-prefab">Host type</label>
                            <div class="row" style="align-items:center;">
                                <select id="compute-prefab" class="input" style="flex:1;"
                                        @bind="_computePrefab" @bind:after="SyncPrefab">
                                    @foreach (ComputeProviderPrefab prefab in ComputeProviderPrefabs.All)
                                    {
                                        <option value="@prefab.Id">@prefab.Name</option>
                                    }
                                </select>
                                @if (ComputeProviderPrefabs.Find(_computePrefab) is { ReferralUrl.Length: > 0 } withReferral)
                                {
                                    <a class="button" href="@withReferral.ReferralUrl" target="_blank" rel="sponsored noopener"
                                       title="Open the @withReferral.Name sign-up page.">
                                        Sign up
                                    </a>
                                }
                                @if (ComputeProviderPrefabs.Find(_computePrefab) is { AffiliateCode.Length: > 0 } withCode)
                                {
                                    <span class="small faint">
                                        Code: <strong class="mono">@withCode.AffiliateCode</strong>
                                    </span>
                                }
                            </div>
                            <span class="small faint">@ComputeProviderPrefabs.Find(_computePrefab).Description</span>
                        </div>
                        <div class="field training-form-wide">
                            <label class="field-label" for="compute-url">Base URL</label>
                            <input id="compute-url" class="input" @bind="_computeBaseUrl"
                                   placeholder="http://127.0.0.1:8080" />
                            <span class="small faint">
                                Local Docker: <span class="mono">http://127.0.0.1:8080</span>.
                                Remote: the Runpod proxy URL or your host's address.
                            </span>
                        </div>
                        <div class="field training-form-wide">
                            <label class="field-label" for="compute-token">Token</label>
                            <div class="row">
                                <input id="compute-token" class="input"
                                       type="@(_computeShowToken ? "text" : "password")" @bind="_computeToken"
                                       placeholder="@(_editingComputeId is null ? "Leave blank to generate" : "leave blank to keep")"
                                       autocomplete="off" />
                                <button type="button" class="button" @onclick="GenerateComputeToken"
                                        title="Create a strong bearer token; it is saved with this host.">Generate</button>
                                <button type="button" class="button" @onclick="() => _computeShowToken = !_computeShowToken">
                                    @(_computeShowToken ? "Hide" : "Show")
                                </button>
                            </div>
                            <span class="small faint">
                                The same value as <span class="mono">SHARPMIND_TOKEN</span> on the host.
                                A generated token is saved with this host, so Studio and the container always match.
                            </span>
                        </div>

                        <div class="field training-form-wide">
                            <label class="field-label" for="compute-studio">Studio URL</label>
                            <input id="compute-studio" class="input" @bind="_computeStudioUrl"
                                   placeholder="http://127.0.0.1:5117" />
                            <span class="small faint">
                                Where the combined SharpMind Server serves the Studio UI
                                (port 5117). System → Connection can use it.
                            </span>
                        </div>

                        @if (_computePrefab == ComputeProviderPrefabs.LocalDocker)
                        {
                            <div class="field">
                                <label class="field-label" for="compute-image">Docker image</label>
                                <input id="compute-image" class="input" @bind="_computeImage"
                                       placeholder="@ComputeProviderPresets.DefaultImage" />
                                <span class="small faint">The local image built from <span class="mono">docker/compute</span>.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-port">Port</label>
                                <input id="compute-port" class="input" type="number" min="1" max="65535"
                                       @bind="_computePort" @bind:after="SyncComputeStudioUrl" />
                                <span class="small faint">Studio will connect to <span class="mono">http://127.0.0.1:@_computePort</span>.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-gpu">GPU</label>
                                <label class="small">
                                    <input id="compute-gpu" type="checkbox" @bind="_computeUseGpu" />
                                    Start the container with <span class="mono">--gpus all</span>
                                </label>
                                <span class="small faint">
                                    Only tick this when Docker and the host have an NVIDIA runtime.
                                    The preview image still runs on the CPU until the ILGPU plugin ships.
                                </span>
                            </div>
                        }
                        else if (_computePrefab == ComputeProviderPrefabs.Runpod)
                        {
                            <div class="field training-form-wide">
                                <label class="field-label" for="compute-pod">Runpod Pod ID (optional)</label>
                                <div class="row">
                                    <input id="compute-pod" class="input" @bind="_computePodId"
                                           placeholder="abc123xyz" />
                                    <button type="button" class="button" @onclick="BuildRunpodUrl">Build URL</button>
                                </div>
                                <span class="small faint">
                                    Runpod → Pods → Connect shows the Pod ID and the HTTP port URL.
                                    This helper turns it into <span class="mono">https://&lt;pod&gt;-8080.proxy.runpod.net</span>.
                                </span>
                            </div>
                            <div class="field training-form-wide">
                                <label class="field-label" for="runpod-key">Runpod API key</label>
                                <input id="runpod-key" class="input" type="password" @bind="_runpodKey"
                                       autocomplete="off"
                                       placeholder="@(_editingComputeId is null ? "rpa_..." : "leave blank to keep")" />
                                <span class="small faint">
                                    Optional. With a key, save the host and use <strong>Deploy pod</strong>
                                    on its card; Studio creates and can terminate the pod for you.
                                </span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="runpod-image">Server image</label>
                                <input id="runpod-image" class="input" @bind="_runpodImage"
                                       placeholder="your-name/sharpmind-server:gpu" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="runpod-gpu">GPU type</label>
                                <input id="runpod-gpu" class="input" list="runpod-gpu-options"
                                       @bind="_runpodGpu" />
                                <datalist id="runpod-gpu-options">
                                    @foreach (string gpu in ComputeProviderPresets.RunpodGpuTypes)
                                    {
                                        <option value="@gpu"></option>
                                    }
                                </datalist>
                                <span class="small faint">Pick a common card or type the exact Runpod GPU id.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="runpod-disk">Container disk (GB)</label>
                                <input id="runpod-disk" class="input" type="number" min="1" max="500"
                                       @bind="_runpodDisk" />
                            </div>
                        }
                        else
                        {
                            <div class="field training-form-wide">
                                <label class="field-label" for="compute-remote-image">Server image</label>
                                <div class="row">
                                    <input id="compute-remote-image" class="input" @bind="_computeImage"
                                           placeholder="@ComputeProviderPresets.DefaultServerImage" />
                                    @if (Compute.RegistryImage is { Length: > 0 } published
                                         && !string.Equals(published, _computeImage, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="button"
                                                @onclick="() => _computeImage = published"
                                                title="Use the image last pushed from this panel.">Use published</button>
                                    }
                                </div>
                                <span class="small faint">
                                    A registry name such as <span class="mono">your-name/sharpmind-server:gpu</span>.
                                    The SSH helper pulls this image on the host.
                                </span>
                            </div>

                            <div class="field training-form-wide">
                                <label class="field-label">SSH setup (optional)</label>
                                <span class="small faint">
                                    Lets Studio install Docker, pull the image and start the container on
                                    the host. Without it, set the host up yourself and use Test.
                                </span>
                            </div>

                            <div class="field">
                                <label class="field-label" for="compute-ssh-host">SSH host</label>
                                <input id="compute-ssh-host" class="input" @bind="_computeSshHost"
                                       placeholder="203.0.113.10 or host.example.com" />
                                <span class="small faint">Blank uses the Base URL's host when it is not loopback.</span>
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-ssh-port">SSH port</label>
                                <input id="compute-ssh-port" class="input" type="number" min="1" max="65535"
                                       @bind="_computeSshPort" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-ssh-user">SSH user</label>
                                <input id="compute-ssh-user" class="input" @bind="_computeSshUser"
                                       placeholder="root" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-ssh-container">Container name</label>
                                <input id="compute-ssh-container" class="input" @bind="_computeSshContainer"
                                       placeholder="sharpmind" />
                            </div>

                            <div class="field training-form-wide">
                                <label class="field-label" for="compute-ssh-key">Private key</label>
                                <div class="row">
                                    <input id="compute-ssh-key" class="input" @bind="_computeSshKeyPath"
                                           placeholder="Blank: %USERPROFILE%\.ssh\id_ed25519" />
                                    <button type="button" class="button" @onclick="BrowseSshKey"
                                            title="Choose an OpenSSH or PEM private key.">Browse</button>
                                    <button type="button" class="button" @onclick="CreateSshKey"
                                            title="Create a new ed25519 key pair in %USERPROFILE%\.ssh when none exists.">
                                        Create key
                                    </button>
                                </div>
                                <span class="small faint">
                                    The key is read from this PC and never copied to the host.
                                    A password below can be used instead.
                                </span>
                                @if (_sshKeyStatus.Length > 0)
                                {
                                    <div class="status-line">@_sshKeyStatus</div>
                                }
                                @if (_sshPublicKey.Length > 0)
                                {
                                    <textarea class="input mono" readonly rows="2" style="font-size:.72rem;"
                                              title="Paste this public key into the host's ~/.ssh/authorized_keys.">@_sshPublicKey</textarea>
                                    <div class="row">
                                        <button type="button" class="button"
                                                @onclick="CopySshPublicKey"
                                                title="Copy the public key for the provider's SSH key field or the host console.">
                                            Copy public key
                                        </button>
                                        <span class="small faint">
                                            Add this once to the host (or to the instance at creation), then
                                            press Test SSH.
                                        </span>
                                    </div>
                                }
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-ssh-passphrase">Key passphrase</label>
                                <input id="compute-ssh-passphrase" class="input" type="password"
                                       @bind="_computeSshPassphrase" autocomplete="off"
                                       placeholder="@(_editingComputeId is null ? "if the key is encrypted" : "leave blank to keep")" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="compute-ssh-password">SSH password</label>
                                <input id="compute-ssh-password" class="input" type="password"
                                       @bind="_computeSshPassword" autocomplete="off"
                                       placeholder="@(_editingComputeId is null ? "alternative to a key" : "leave blank to keep")" />
                                <span class="small faint">Stored encrypted with the same local key as the token.</span>
                            </div>
                            <div class="field training-form-wide">
                                <label class="small">
                                    <input type="checkbox" @bind="_computeUseGpu" />
                                    GPU host — run the container with <span class="mono">--gpus all</span>
                                    and install the NVIDIA container toolkit when missing
                                </label>
                                <span class="small faint">
                                    The NVIDIA driver itself must already be on the host; use a GPU image
                                    from the provider or install the driver first. From-scratch pretraining
                                    still runs on the CPU.
                                </span>
                            </div>
                        }
                    </div>
                    <div class="row">
                        <button type="button" class="button primary" @onclick="SaveCompute">Save host</button>
                        <button type="button" class="button" @onclick="CancelCompute">Cancel</button>
                    </div>
                </div>
            }

            @foreach (ComputeProviderSettings provider in Compute.Providers)
            {
                <details class="settings-subgroup">
                    <summary class="settings-subgroup-head">
                        <div class="row" style="align-items:center; gap:.5rem;">
                            <span class="provider-dot @(provider.Healthy == true ? "on" : provider.Healthy == false ? "off" : "off")"></span>
                            <strong>@provider.Name</strong>
                            <span class="faint small mono">@ComputeProviderPrefabs.Find(provider.Prefab).Name</span>
                            @if (string.Equals(provider.Id, Compute.DefaultProviderId, StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="training-chip">default</span>
                            }
                        </div>
                        <div class="row" @onclick:stopPropagation="true">
                            @if (ComputeProviderPrefabs.Find(provider.Prefab).ReferralUrl is { Length: > 0 } referral)
                            {
                                <a class="button" href="@referral" target="_blank" rel="noopener"
                                   title="Open the @ComputeProviderPrefabs.Find(provider.Prefab).Name sign-up page.">
                                    Sign up
                                </a>
                            }
                            @if (!string.Equals(provider.Id, Compute.DefaultProviderId, StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" class="button" @onclick="() => SetDefaultCompute(provider.Id)"
                                        @onclick:preventDefault="true"
                                        title="Use this host by default for Chat and Training.">Make default</button>
                            }
                            <button type="button" class="button" @onclick="() => TestComputeAsync(provider.Id)"
                                    @onclick:preventDefault="true"
                                    disabled="@_computeBusy"
                                    title="Check the host and load its model list.">Test</button>
                            <button type="button" class="button" @onclick="() => EditCompute(provider)"
                                    @onclick:preventDefault="true"
                                    title="Change this host's prefab, URL, token and model settings.">Edit</button>
                            <button type="button" class="button" @onclick="() => DuplicateCompute(provider)"
                                    @onclick:preventDefault="true"
                                    title="Create another host from this one's settings.">Duplicate</button>
                            <button type="button" class="button danger" @onclick="() => RemoveCompute(provider)"
                                    @onclick:preventDefault="true"
                                    title="Remove this host from Studio. The remote pod or container is not affected.">Delete</button>
                        </div>
                    </summary>
                    <div class="settings-subgroup-body stack">
                    <div class="spread small mono">
                        <span>@provider.BaseUrl</span>
                        <span class="row" style="gap:.4rem; align-items:center;">
                            @(Compute.HasToken(provider.Id) ? "token saved" : "no token")
                            @if (Compute.HasToken(provider.Id))
                            {
                                <button type="button" class="button"
                                        style="min-height:1.6rem; padding:.1rem .45rem;"
                                        @onclick="() => CopyProviderTokenAsync(provider.Id)"
                                        title="Copy the bearer token to use as SHARPMIND_TOKEN on the host.">
                                    Copy token
                                </button>
                            }
                        </span>
                    </div>
                    @if (provider.StudioUrl is { Length: > 0 })
                    {
                        <div class="spread small mono"><span>Studio</span><span>@provider.StudioUrl</span></div>
                    }
                    @if (provider.LastStatus is { Length: > 0 })
                    {
                        <div class="small faint">@provider.LastStatus</div>
                    }
                    <div class="small faint">
                        <strong>Setup:</strong>
                        @if (provider.Prefab == ComputeProviderPrefabs.LocalDocker)
                        {
                            <text>1. Start container · 2. Upload a model for Chat · 3. Train (no model needed)</text>
                        }
                        else if (provider.Prefab == ComputeProviderPrefabs.Runpod)
                        {
                            <text>1. Deploy pod · 2. Upload a model for Chat · 3. Train (no model needed)</text>
                        }
                        else if (provider.Prefab == ComputeProviderPrefabs.Vultr)
                        {
                            <text>1. Set up &amp; deploy over SSH · 2. Upload a model for Chat · 3. Train (no model needed)</text>
                        }
                        else
                        {
                            <text>1. Test · 2. Upload a model for Chat · 3. Train (no model needed)</text>
                        }
                    </div>

                    @{
                        bool needsDeploy = provider.Prefab == ComputeProviderPrefabs.Runpod
                            && UndeployedRunpod(provider.Id) is not null;
                    }
                    @if (provider.Prefab == ComputeProviderPrefabs.Vultr)
                    {
                        <div class="small faint">
                            A Vultr instance running the server image.
                        </div>
                    }
                    @if (needsDeploy)
                    {
                        <div class="small faint">
                            Deploy the pod before managing models. Training from scratch does not need a
                            model on the host; a fine-tune's base model is uploaded with the job.
                        </div>
                    }

                    <div class="training-form">
                        <div class="field">
                            <label class="field-label" for="compute-model-@provider.Id">Chat model</label>
                            <select id="compute-model-@provider.Id" class="input"
                                    value="@(provider.DefaultModel ?? "")"
                                    disabled="@needsDeploy"
                                    @onchange="e => UseComputeModel(provider.Id, e.Value?.ToString())">
                                <option value="">None yet (upload one for Chat)</option>
                                @foreach (string model in provider.Models)
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                            <span class="small faint">
                                Chat needs a model. Training from scratch does not, and a fine-tune
                                uploads its base model with the job.
                            </span>
                        </div>
                        <div class="field">
                            <label class="field-label">Refresh</label>
                            <button type="button" class="button" @onclick="() => RefreshComputeModelsAsync(provider.Id)"
                                    disabled="@(_computeBusy || needsDeploy)"
                                    title="Read the model folder from the host and update this list.">Read models on host</button>
                        </div>
                    </div>

                    @if (provider.Models.Count > 0)
                    {
                        <div class="field training-form-wide">
                            <label class="field-label">Models on host</label>
                            @foreach (string model in provider.Models)
                            {
                                <div class="spread">
                                    <span class="mono small">@model</span>
                                    <button type="button" class="button danger"
                                            @onclick="() => DeleteHostModelAsync(provider.Id, model)"
                                            disabled="@(_computeBusy || needsDeploy)"
                                            title="Delete this model file from the host.">Delete</button>
                                </div>
                            }
                            <span class="small faint">Delete removes the file from the host. Your local copy is not touched.</span>
                        </div>
                    }

                    <div class="field">
                        <label class="field-label" for="compute-upload-@provider.Id">Upload a model from this PC</label>
                        <div class="row">
                            <input id="compute-upload-@provider.Id" class="input" @bind="_computeModelPath"
                                   disabled="@needsDeploy"
                                   placeholder="C:\Users\you\SharpMind\Models\model.gguf" />
                            <button type="button" class="button" @onclick="BrowseComputeModel"
                                    title="Choose a local .smm or .gguf file.">Browse</button>
                            <button type="button" class="button primary"
                                    @onclick="() => UploadComputeModelAsync(provider.Id)"
                                    disabled="@(_computeBusy || needsDeploy)"
                                    title="Copy this model to the host and make it the active model.">
                                @(_uploadingId == provider.Id ? "Uploading…" : "Upload and use")
                            </button>
                        </div>
                        <span class="small faint">
                            HuggingFace downloads land in your Models folder; pick one here to copy it to the host.
                            Large models are better placed on the host's network volume.
                        </span>
                        @if (_uploadingId == provider.Id)
                        {
                            <div class="row" style="align-items:center; gap:.5rem;">
                                <span class="spinner-ring"></span>
                                <div class="progress-track" style="flex:1;">
                                    <div class="progress-fill" style="width:@(_computeUploadProgress * 100)%"></div>
                                </div>
                                <span class="mono small">@((_computeUploadProgress * 100).ToString("0"))%</span>
                            </div>
                            <div class="small faint">Uploading @Path.GetFileName(_computeModelPath)…</div>
                        }
                        @if (_computeError is not null && _computeErrorHostId == provider.Id)
                        {
                            <div class="error-line">@_computeError</div>
                        }
                    </div>

                    @if (provider.Prefab == ComputeProviderPrefabs.LocalDocker)
                    {
                        <div class="training-subsection">
                            <div class="training-subsection-head">
                                <label class="field-label">Local Docker</label>
                                <div class="row">
                                    <button type="button" class="button" @onclick="() => CheckDockerAsync(provider.Id)"
                                            disabled="@_dockerBusy"
                                            title="Check that Docker is running and show the container state.">Check</button>
                                    <button type="button" class="button primary"
                                            @onclick="() => StartDockerContainerAsync(provider.Id)"
                                            disabled="@_dockerBusy"
                                            title="Run the image on this PC with the saved token, port and data folder.">Start container</button>
                                    <button type="button" class="button" @onclick="() => StopDockerContainerAsync(provider.Id)"
                                            disabled="@_dockerBusy"
                                            title="Stop the local container. Its data folder is kept.">Stop</button>
                                    <button type="button" class="button" @onclick="() => DockerLogsAsync(provider.Id)"
                                            disabled="@_dockerBusy"
                                            title="Show the last lines from the container log.">Logs</button>
                                    @if (Docker.CanStartDockerDesktop && _dockerEngine is { Available: false })
                                    {
                                        <button type="button" class="button" @onclick="StartDockerDesktop"
                                                title="Launch Docker Desktop, then press Check again.">Start Docker Desktop</button>
                                    }
                                </div>
                            </div>
                            <div class="small faint">@_dockerStatus</div>
                            @if (_dockerError is not null)
                            {
                                <div class="error-line">@_dockerError</div>
                            }
                            @if (_dockerLogs is { Length: > 0 })
                            {
                                <pre class="small mono" style="max-height:12rem;overflow:auto;">@_dockerLogs</pre>
                            }
                            <div class="small faint">
                                Image <span class="mono">@(provider.DockerImage ?? ComputeProviderPresets.DefaultImage)</span>,
                                port <span class="mono">@(provider.DockerPort ?? ComputeProviderPresets.DefaultPort)</span>,
                                data <span class="mono">@DockerHostService.DefaultDataFolder(provider.ContainerName ?? "")</span>.
                                Start recreates the container so its token, port and image match this panel.
                            </div>
                        </div>
                    }
                    else if (provider.Prefab == ComputeProviderPrefabs.Runpod)
                    {
                        <div class="training-subsection">
                            <div class="training-subsection-head">
                                <label class="field-label">Runpod</label>
                                <div class="row">
                                    <span class="small mono">@(provider.RunpodPodStatus ?? "no pod")</span>
                                    <button type="button" class="button primary"
                                            @onclick="() => DeployRunpodAsync(provider.Id)"
                                            disabled="@_runpodBusy"
                                            title="Create a Runpod GPU pod from the server image and wire this host to it.">
                                        @(_runpodBusy ? "Deploying…" : "Deploy pod")
                                    </button>
                                    <button type="button" class="button"
                                            @onclick="() => RefreshRunpodAsync(provider.Id)"
                                            disabled="@_runpodBusy"
                                            title="Read the pod's current status from Runpod.">Refresh</button>
                                    <button type="button" class="button danger"
                                            @onclick="() => TerminateRunpodAsync(provider.Id)"
                                            disabled="@_runpodBusy"
                                            title="Terminate the Runpod pod and stop its billing.">Terminate</button>
                                </div>
                            </div>
                            @if (_runpodStatus is { Length: > 0 })
                            {
                                <div class="status-line">@_runpodStatus</div>
                            }
                            @if (_runpodError is { Length: > 0 })
                            {
                                <div class="error-line">@_runpodError</div>
                            }
                            <div class="field training-form-wide">
                                <label class="field-label" for="runpod-card-image-@provider.Id">Server image</label>
                                <div class="row">
                                    <input id="runpod-card-image-@provider.Id" class="input"
                                           value="@(provider.RunpodImage ?? ComputeProviderPresets.DefaultServerImage)"
                                           @onchange="e => SetRunpodImage(provider.Id, e.Value?.ToString())"
                                           title="The Docker Hub image Runpod pulls, for example name/sharpmind-server:gpu." />
                                    @if (Compute.RegistryImage is { Length: > 0 } published
                                         && !string.Equals(provider.RunpodImage, published, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button" class="button"
                                                @onclick="() => SetRunpodImage(provider.Id, published)"
                                                title="Use the image last pushed from this panel.">Use published</button>
                                    }
                                </div>
                                <span class="small faint">
                                    Runpod pulls this image from Docker Hub. It must be pushed first;
                                    <strong>Publish the server image</strong> above does that.
                                </span>
                            </div>
                            @if (_runpodBusy)
                            {
                                <div class="row" style="align-items:center; gap:.5rem;">
                                    <span class="spinner-ring"></span>
                                    <span class="small faint">Talking to Runpod…</span>
                                </div>
                            }
                            <div class="small faint">
                                @(Runpod.HasApiKey(provider.Id)
                                    ? "Runpod API key saved."
                                    : "Add a Runpod API key in Edit to deploy from here.")
                                Pod <span class="mono">@(provider.RunpodPodId ?? "none")</span>.
                                Image <span class="mono">@(provider.RunpodImage ?? ComputeProviderPresets.DefaultServerImage)</span>,
                                GPU <span class="mono">@(provider.RunpodGpuType ?? ComputeProviderPresets.DefaultGpuType)</span>,
                                @(provider.RunpodDiskGb ?? ComputeProviderPresets.DefaultRunpodDiskGb) GB disk.
                            </div>
                            <div class="small faint">
                                Deploy uses the saved API key and image; if you just typed them, press
                                <strong>Edit → Save host</strong> first. When the pod reports RUNNING,
                                Studio fills the API and Studio URLs and tests the host.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="training-subsection">
                            <div class="training-subsection-head">
                                <label class="field-label">SSH setup</label>
                                <div class="row">
                                    <button type="button" class="button"
                                            @onclick="() => TestSshAsync(provider.Id)"
                                            disabled="@_sshBusy"
                                            title="Connect over SSH and show the OS, Docker and NVIDIA state.">
                                        Test SSH
                                    </button>
                                    <button type="button" class="button primary"
                                            @onclick="() => SetupSshAsync(provider.Id)"
                                            disabled="@_sshBusy"
                                            title="Install Docker (and the NVIDIA toolkit on a GPU host), pull the image and start the container.">
                                        @SshBusyLabel(provider.Id, "Set up & deploy")
                                    </button>
                                    <button type="button" class="button"
                                            @onclick="() => SshLogsAsync(provider.Id)"
                                            disabled="@_sshBusy"
                                            title="Show the last lines from the container on the host.">
                                        Container logs
                                    </button>
                                    <button type="button" class="button"
                                            @onclick="() => SshStopAsync(provider.Id)"
                                            disabled="@_sshBusy"
                                            title="Stop the container on the host. Its data folder is kept.">
                                        Stop
                                    </button>
                                </div>
                            </div>
                            <div class="small faint">@Compute.DescribeSsh(provider.Id)</div>
                            @if (SshSetupScript.LooksUnpublished(Compute.SshImage(provider.Id)))
                            {
                                <div class="error-line">
                                    The server image <span class="mono">@Compute.SshImage(provider.Id)</span>
                                    has no registry prefix, so the host cannot pull it. Press
                                    <strong>Edit</strong> and enter the full name, for example
                                    <span class="mono">your-name/sharpmind-server:gpu</span>.
                                </div>
                            }
                            @if (_sshHostId == provider.Id)
                            {
                                @if (_sshStage is { Length: > 0 })
                                {
                                    <div class="status-line">@_sshStage</div>
                                }
                                @if (_sshError is { Length: > 0 })
                                {
                                    <div class="error-line">@_sshError</div>
                                }
                                @if (_sshLog.Length > 0)
                                {
                                    <pre class="small mono" style="max-height:14rem;overflow:auto;">@_sshLog</pre>
                                }
                            }
                            <div class="small faint">
                                Setup needs TCP 22 open to this PC, plus 8080 and 5117 for the
                                container. The SSH password/passphrase is stored encrypted; the
                                host key is trusted on first use. If the provider firewall blocks
                                the ports, start it and open them on the instance page.
                            </div>
                        </div>
                    }
                    </div>
                </details>
            }
        </div>
            </details>

            <SettingsHuggingFacePanel />
        </div>
    </details>
}
else if (_tab == "pair")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Device access</div>
                <h2>Phone pairing</h2>
            </div>
            <span class="faint small mono">loopback admin only</span>
        </div>
        <div class="panel-body stack">
            <label class="tool-toggle">
                <input type="checkbox" checked="@_lanEnabled" @onchange="SetLanEnabled" />
                <span>Allow LAN device pairing</span>
            </label>
            <div class="small faint">Lets phones on this network connect. Takes effect immediately; no restart needed. Pairing setup stays loopback-only.</div>
            <div class="status-line">@_lanStatus</div>

            <GatewayAdminPanel LanEnabled="_lanEnabled" />
        </div>
    </section>
}
else if (_tab == "families")
{
    <details class="panel settings-collapsible" open>
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>Model families</h2>
            </div>
            <span class="faint small mono">detected from metadata</span>
        </summary>
        <div class="panel-body stack">
            <div class="row">
                <select class="input" style="max-width: 22rem;" @bind="_selectedFamilyId" @bind:after="LoadFamilyDraft">
                    @foreach (var family in _families)
                    {
                        <option value="@family.Id">@family.DisplayName (@family.Id)</option>
                    }
                </select>
                <button type="button" class="button danger" @onclick="DeleteFamily" disabled="@(_selectedFamilyId is null)">
                    Clear family overrides
                </button>
                <span class="status-line">@_status</span>
            </div>

            @if (_selectedFamilyId is not null)
            {
                <InferenceProfileEditor Value="_familyDraft" ValueChanged="SaveFamilyFromEditor"
                                        AllowInherit="true"
                                        Sources="_familySources"
                                        Effective="_familyResolved"
                                        Generators="Workspace.Builders.Generators"
                                        Caches="Workspace.Builders.Caches" />
                <span class="small faint">Unset fields inherit from System. Changes apply immediately.</span>
            }
        </div>
    </details>
}
else if (_tab == "models")
{
    <details class="panel settings-collapsible">
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>Models</h2>
            </div>
            <span class="faint small mono">@_models.Count detected</span>
        </summary>
        <div class="panel-body stack">
            <div class="row">
                <select class="input" style="max-width: 30rem;" @bind="_selectedModelPath" @bind:after="LoadModelDraft">
                    @foreach (var model in _models)
                    {
                        <option value="@model.Path" title="@model.Path">@model.FileName — @model.DisplayName (@model.Family.DisplayName)</option>
                    }
                </select>
                <button type="button" class="button" @onclick="RefreshModels">Rescan</button>
                <button type="button" class="button danger" @onclick="DeleteModel" disabled="@(_selectedModelPath is null)">
                    Clear model overrides
                </button>
                <span class="status-line">@_status</span>
            </div>

            @if (_selectedModelPath is not null)
            {
                <div class="small faint mono">@_selectedModelPath</div>
                <InferenceProfileEditor Value="_modelDraft" ValueChanged="SaveModelFromEditor"
                                        AllowInherit="true"
                                        Sources="_modelSources"
                                        Effective="_modelResolved"
                                        Generators="Workspace.Builders.Generators"
                                        Caches="Workspace.Builders.Caches" />
                <span class="small faint">Unset fields inherit from the model family, then System. Changes apply immediately.</span>
            }
        </div>
    </details>

    <details class="panel settings-collapsible">
        <summary class="panel-head">
            <div>
                <div class="eyebrow">Tuning</div>
                <h2>Model tuning</h2>
            </div>
            <span class="faint small mono">presets for the selected model</span>
        </summary>
        <div class="panel-body stack">
            @if (_models.FirstOrDefault(model => model.Path == _selectedModelPath) is { } tunedModel)
            {
                <ModelTunePanel @key="tunedModel.Path" Model="tunedModel"
                                Generators="Workspace.Builders.Generators"
                                Caches="Workspace.Builders.Caches" />
            }
            else
            {
                <div class="small faint">Select a model in the Models group above to tune it.</div>
            }
        </div>
    </details>
}
else
{
    <SettingsAppearancePanel />
}


