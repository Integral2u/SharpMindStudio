@page "/settings"
@using Microsoft.AspNetCore.Components
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Services
@inject ThemeService Theme
@inject StudioWorkspaceService Workspace
@inject InferenceSettingsService Inference
@inject ModelCatalogService Catalog

<PageTitle>Settings - SharpMind Studio</PageTitle>

<div class="hero" style="padding-top: 0;">
    <div class="hero-copy">
        <div class="eyebrow">Settings</div>
        <h1>Make it yours.</h1>
        <p>System defaults flow through model families and models into each chat session. Empty overrides inherit.</p>
    </div>
    <div class="hero-mark">local preferences<br />no cloud, no account</div>
</div>

<div class="settings-tabs">
    <a class="settings-tab @(_tab == "appearance" ? "selected" : "")" href="/settings?tab=appearance" data-enhance-nav="false">Appearance</a>
    <a class="settings-tab @(_tab == "system" ? "selected" : "")" href="/settings?tab=system" data-enhance-nav="false">System</a>
    <a class="settings-tab @(_tab == "families" ? "selected" : "")" href="/settings?tab=families" data-enhance-nav="false">Families</a>
    <a class="settings-tab @(_tab == "models" ? "selected" : "")" href="/settings?tab=models" data-enhance-nav="false">Models</a></div>

@if (_tab == "system")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>System defaults</h2>
            </div>
            <span class="faint small mono">root of every chat</span>
        </div>
        <div class="panel-body stack">
            <div class="field">
                <label class="field-label" for="default-chat-model">Default chat model</label>
                <select id="default-chat-model" class="input" @bind="_defaultModelPath" @bind:after="SaveDefaultModel">
                    @foreach (var model in _models)
                    {
                        <option value="@model.Path">@model.FileName - @model.DisplayName (@model.Family.DisplayName)</option>
                    }
                </select>
                <div class="small faint">Used by the welcome screen until you choose another model there.</div>
            </div>

            <InferenceProfileEditor Value="_system" ValueChanged="v => _system = v"
                                    Generators="Workspace.Builders.Generators"
                                    Caches="Workspace.Builders.Caches" />
            <div class="row">
                <button type="button" class="button primary" @onclick="SaveSystem">Save system defaults</button>
                <span class="status-line">@_status</span>
            </div>
        </div>
    </section>
}
else if (_tab == "families")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>Model families</h2>
            </div>
            <span class="faint small mono">detected from metadata</span>
        </div>
        <div class="panel-body stack">
            <div class="row">
                <select class="input" style="max-width: 22rem;" @bind="_selectedFamilyId" @bind:after="LoadFamilyDraft">
                    @foreach (var family in _families)
                    {
                        <option value="@family.Id">@family.DisplayName (@family.Id)</option>
                    }
                </select>
                <button type="button" class="button danger" @onclick="DeleteFamily" disabled="@(_selectedFamilyId is null)">
                    Clear family overrides
                </button>
                <span class="status-line">@_status</span>
            </div>

            @if (_selectedFamilyId is not null)
            {
                <InferenceProfileEditor Value="_familyDraft" ValueChanged="v => _familyDraft = v"
                                        AllowInherit="true"
                                        Sources="_familySources"
                                        Effective="_familyResolved"
                                        Generators="Workspace.Builders.Generators"
                                        Caches="Workspace.Builders.Caches" />
                <div class="row">
                    <button type="button" class="button primary" @onclick="SaveFamily">Save family overrides</button>
                    <span class="small faint">Unset fields inherit from System.</span>
                </div>
            }
        </div>
    </section>
}
else if (_tab == "models")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Inference</div>
                <h2>Models</h2>
            </div>
            <span class="faint small mono">@_models.Count detected</span>
        </div>
        <div class="panel-body stack">
            <div class="row">
                <select class="input" style="max-width: 30rem;" @bind="_selectedModelPath" @bind:after="LoadModelDraft">
                    @foreach (var model in _models)
                    {
                        <option value="@model.Path" title="@model.Path">@model.FileName — @model.DisplayName (@model.Family.DisplayName)</option>
                    }
                </select>
                <button type="button" class="button" @onclick="RefreshModels">Rescan</button>
                <button type="button" class="button danger" @onclick="DeleteModel" disabled="@(_selectedModelPath is null)">
                    Clear model overrides
                </button>
                <span class="status-line">@_status</span>
            </div>

            @if (_selectedModelPath is not null)
            {
                <div class="small faint mono">@_selectedModelPath</div>
                <InferenceProfileEditor Value="_modelDraft" ValueChanged="v => _modelDraft = v"
                                        AllowInherit="true"
                                        Sources="_modelSources"
                                        Effective="_modelResolved"
                                        Generators="Workspace.Builders.Generators"
                                        Caches="Workspace.Builders.Caches" />
                <div class="row">
                    <button type="button" class="button primary" @onclick="SaveModel">Save model overrides</button>
                    <span class="small faint">Unset fields inherit from the model family, then System.</span>
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Appearance</div>
                <h2>Accent colour</h2>
            </div>
            <span class="faint small mono">@ThemeService.Label(Theme.Theme)</span>
        </div>
        <div class="panel-body stack">
            <div class="theme-grid">
                @foreach (string theme in new[] { "green", "blue", "purple", "red" })
                {
                    <a class="theme-option @(Theme.Theme == theme ? "selected" : "")"
                       href="/settings?tab=appearance&theme=@theme"
                       data-enhance-nav="false">
                        <span class="theme-swatch @theme"></span>
                        <span>@ThemeService.Label(theme)</span>
                    </a>
                }

                <a class="theme-option theme-option-custom @(Theme.Theme == "custom" ? "selected" : "")"
                   href="/settings?tab=appearance&theme=custom"
                   data-enhance-nav="false">
                    <span class="theme-swatch custom" style="background:@Theme.CustomColor"></span>
                    <span>Custom</span>
                </a>
            </div>

            <form method="get" action="/settings" data-enhance="false">
                <input type="hidden" name="tab" value="appearance" />
                <input type="hidden" name="theme" value="custom" />
                <div class="custom-color-row">
                    <div class="field">
                        <label class="field-label" for="custom-color">Custom accent</label>
                        <input id="custom-color" class="color-input" type="color"
                               name="color" value="@Theme.CustomColor" title="Custom accent" />
                    </div>
                    <button class="button" type="submit">Apply custom</button>
                </div>
            </form>

            <div class="panel-head" style="padding: .8rem 0 0; border-top: 1px solid var(--line);">
                <div>
                    <div class="eyebrow">Connection</div>
                    <h2>Studio server</h2>
                </div>
            </div>
            <div class="row">
                <div class="field" style="flex: 1; min-width: 12rem;">
                    <label class="field-label" for="studio-host">Host</label>
                    <input id="studio-host" class="input" @bind="_studioHost" />
                </div>
                <div class="field" style="width: 8rem;">
                    <label class="field-label" for="studio-port">Port</label>
                    <input id="studio-port" class="input" type="number" min="1" max="65535" @bind="_studioPort" />
                </div>
                <button type="button" class="button primary" @onclick="SaveServerAsync">Save connection</button>
                <button type="button" class="button" @onclick="ResetServerAsync">Reset local defaults</button>
            </div>
            <div class="status-line">@_serverStatus</div>
            <div class="small faint">Used when Studio starts. If the configured server is unreachable, the desktop app asks whether to run locally.</div>

            <div class="row" style="margin-top: .4rem;">
                <a class="button" href="/test" data-enhance-nav="false">Back to dashboard</a>
                <span class="small faint mono">changes are saved locally</span>
            </div>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    [SupplyParameterFromQuery(Name = "theme")]
    public string? ThemeQuery { get; set; }

    [SupplyParameterFromQuery(Name = "color")]
    public string? ColorQuery { get; set; }

    private string _tab = "appearance";
    private string _status = "";
    private string? _defaultModelPath;
    private string? _lastApplied;
    private string _studioHost = ThemeService.DefaultHost;
    private int _studioPort = ThemeService.DefaultPort;
    private string _serverStatus = "";
    private InferenceOverrides _system = new();
    private IReadOnlyList<ModelFamily> _families = [];
    private IReadOnlyList<ModelDescriptor> _models = [];
    private string? _selectedFamilyId;
    private string? _selectedModelPath;
    private InferenceOverrides _familyDraft = new();
    private InferenceOverrides _modelDraft = new();
    private IReadOnlyDictionary<string, string>? _familySources;
    private IReadOnlyDictionary<string, string>? _modelSources;
    private ResolvedInference? _familyResolved;
    private ResolvedInference? _modelResolved;

    protected override async Task OnParametersSetAsync()
    {
        _tab = TabQuery is "system" or "families" or "models" ? TabQuery : "appearance";
        _system = Inference.System;
        _studioHost = Theme.StudioHost;
        _studioPort = Theme.StudioPort;
        if (_tab != "appearance") await LoadCatalogAsync();

        if (!string.IsNullOrWhiteSpace(ThemeQuery))
        {
            string? normalized = ThemeService.AvailableThemes.FirstOrDefault(
                value => value.Equals(ThemeQuery, StringComparison.OrdinalIgnoreCase));
            if (normalized is not null)
            {
                string? custom = ThemeService.NormalizeColor(ColorQuery);
                string key = $"{normalized}|{custom}";
                if (key != _lastApplied)
                {
                    await Theme.SetThemeAsync(normalized, custom ?? Theme.CustomColor);
                    _lastApplied = key;
                    _status = $"{ThemeService.Label(Theme.Theme)} applied.";
                }
            }
        }

        if (_defaultModelPath is null || _models.All(model => model.Path != _defaultModelPath))
            _defaultModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path;

        if (_selectedFamilyId is null || _families.All(f => f.Id != _selectedFamilyId))
        {
            _selectedFamilyId = _families.FirstOrDefault()?.Id;
            LoadFamilyDraft();
        }

        if (_selectedModelPath is null || _models.All(m => m.Path != _selectedModelPath))
        {
            _selectedModelPath = _models.FirstOrDefault()?.Path;
            LoadModelDraft();
        }
    }

    private async Task LoadCatalogAsync()
    {
        _models = await Catalog.RefreshAsync();
        var families = Catalog.Families.ToList();
        foreach (string key in Inference.Families.Keys)
        {
            if (families.All(family => family.Id != key))
                families.Add(new ModelFamily(key, key));
        }
        _families = [.. families.OrderBy(family => family.DisplayName, StringComparer.OrdinalIgnoreCase)];
    }

    private async Task RefreshModels()
    {
        await Catalog.RefreshAsync(force: true);
        await LoadCatalogAsync();
        _status = $"Found {_models.Count} model(s).";
    }

    private void LoadFamilyDraft()
    {
        if (_selectedFamilyId is null) return;
        _familyDraft = Inference.FamilyOverrides(_selectedFamilyId) ?? new InferenceOverrides();
        _familyResolved = Inference.Resolve(_selectedFamilyId, null, null);
        _familySources = _familyResolved.Sources;
    }

    private void LoadModelDraft()
    {
        if (_selectedModelPath is null) return;
        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        _modelDraft = Inference.ModelOverrides(_selectedModelPath) ?? new InferenceOverrides();
        _modelResolved = Inference.Resolve(model?.Family.Id, _selectedModelPath, null);
        _modelSources = _modelResolved.Sources;
    }

    private async Task SaveDefaultModel()
    {
        if (string.IsNullOrWhiteSpace(_defaultModelPath)) return;
        await Theme.SetLastChatModelAsync(_defaultModelPath);
        _status = "Default chat model saved.";
    }
    private async Task SaveServerAsync()
    {
        if (string.IsNullOrWhiteSpace(_studioHost) || _studioPort is < 1 or > 65535)
        {
            _serverStatus = "Enter a valid host and port.";
            return;
        }

        await Theme.SetServerAsync(_studioHost, _studioPort);
        _studioHost = Theme.StudioHost;
        _studioPort = Theme.StudioPort;
        _serverStatus = $"Connection saved: {_studioHost}:{_studioPort}";
    }

    private async Task ResetServerAsync()
    {
        await Theme.ResetServerAsync();
        _studioHost = Theme.StudioHost;
        _studioPort = Theme.StudioPort;
        _serverStatus = "Local defaults restored: 127.0.0.1:5117";
    }
    private void SaveSystem()
    {
        Inference.SetSystem(_system);
        _status = "System defaults saved.";
    }

    private void SaveFamily()
    {
        if (_selectedFamilyId is null) return;
        Inference.SetFamily(_selectedFamilyId, _familyDraft);
        _familyResolved = Inference.Resolve(_selectedFamilyId, null, null);
        _familySources = _familyResolved.Sources;
        _status = "Family overrides saved.";
    }

    private void DeleteFamily()
    {
        if (_selectedFamilyId is null) return;
        Inference.DeleteFamily(_selectedFamilyId);
        _familyDraft = new InferenceOverrides();
        _familyResolved = Inference.Resolve(_selectedFamilyId, null, null);
        _familySources = _familyResolved.Sources;
        _status = "Family overrides cleared.";
    }

    private void SaveModel()
    {
        if (_selectedModelPath is null) return;
        Inference.SetModel(_selectedModelPath, _modelDraft);
        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        _modelResolved = Inference.Resolve(model?.Family.Id, _selectedModelPath, null);
        _modelSources = _modelResolved.Sources;
        _status = "Model overrides saved.";
    }

    private void DeleteModel()
    {
        if (_selectedModelPath is null) return;
        Inference.DeleteModel(_selectedModelPath);
        _modelDraft = new InferenceOverrides();
        _status = "Model overrides cleared.";
    }
}











