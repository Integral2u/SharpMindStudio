    private async Task PublishImageAsync()
    {
        _registryBusy = true;
        _registryStatus = "Publishing the image...";
        _registryLog = null;
        _registryProgress = null;
        StateHasChanged();
        try
        {
            var progress = new Progress<DockerPublishProgress>(value =>
            {
                _registryStatus = value.Message;
                if (value.Fraction is { } fraction) _registryProgress = fraction;
                _ = InvokeAsync(StateHasChanged);
            });

            await Docker.PublishAsync(new DockerPublishRequest
            {
                DockerHubUser = _registryUser.Trim(),
                AccessToken = _registryToken,
                SourceImage = _registrySource.Trim(),
                TargetImage = _registryTarget.Trim(),
            }, progress);

            _registryStatus = "Image published. Use it as the host's Server image.";
            _registryProgress = 1;
            _runpodImage = _registryTarget.Trim();
            _registryLog = $"Target: {_runpodImage}";

            // Point remote hosts that still carry the default image at what was just pushed.
            foreach (ComputeProviderSettings host in Compute.Providers)
            {
                if (host.NormalizedKind != ComputeProviderKinds.Remote) continue;
                if (!string.IsNullOrWhiteSpace(host.RunpodImage)
                    && !string.Equals(
                        host.RunpodImage,
                        ComputeProviderPresets.DefaultServerImage,
                        StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                Compute.SetRunpod(host.Id, null, _runpodImage, null, null);
            }
        }
        catch (Exception ex)
        {
            _registryStatus = null;
            _registryLog = ex.Message;
        }
        finally
        {
            _registryBusy = false;
        }
    }

    private async Task DeployRunpodAsync(string id)
    {
        _runpodBusy = true;
        _computeError = null;
        _runpodError = null;
        _runpodStatus = "Creating the pod...";
        StateHasChanged();
        try
        {
            RunpodPod pod = await Runpod.DeployAsync(id);
            _runpodStatus = $"Pod {pod.Id} is {pod.Status}.";
            StateHasChanged();

            for (int attempt = 0; attempt < 90; attempt++)
            {
                await Task.Delay(TimeSpan.FromSeconds(5));
                pod = await Runpod.RefreshAsync(id);
                _runpodStatus = $"Pod {pod.Id} is {pod.Status}.";
                StateHasChanged();
                if (pod.Status is "RUNNING" or "ERROR" or "EXITED" or "TERMINATED")
                    break;
            }

            if (pod.Status == "RUNNING")
            {
                _runpodStatus = "Pod running. Waiting for the API...";
                StateHasChanged();
                for (int attempt = 0; attempt < 30; attempt++)
                {
                    await Task.Delay(TimeSpan.FromSeconds(5));
                    try
                    {
                        await Compute.TestAsync(id);
                        await Compute.RefreshModelsAsync(id);
                        _runpodStatus = "Pod running and the API answered. Upload a model to start.";
                        break;
                    }
                    catch
                    {
                        _runpodStatus = $"Pod running; API not ready yet ({attempt + 1}/30)...";
                        StateHasChanged();
                    }
                }
            }
            else
            {
                _runpodStatus = pod.Status == "RUNNING"
                    ? $"Pod {pod.Id} is running."
                    : $"Pod {pod.Id} is still {pod.Status}. Press Refresh to check again.";
            }
        }
        catch (Exception ex)
        {
            _computeError = ex.Message;
            _runpodError = ex.Message;
            _runpodStatus = null;
        }
        finally
        {
            _runpodBusy = false;
        }
    }

