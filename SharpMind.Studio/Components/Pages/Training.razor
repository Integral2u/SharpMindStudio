                        </div>
                    }
                </div>
            }

            @if (Comparable.Count >= 2)
            {
                <div class="training-compare-picker">
                    <div class="field">
                        <label class="field-label" for="compare-a">Run A</label>
                        <select id="compare-a" class="input" @bind="_compareA">
                            @foreach (TrainingRunSummary run in Comparable)
                            {
                                <option value="@run.Path">@OptionLabel(run)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label" for="compare-b">Run B</label>
                        <select id="compare-b" class="input" @bind="_compareB">
                            @foreach (TrainingRunSummary run in Comparable)
                            {
                                <option value="@run.Path">@OptionLabel(run)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (CompareA is { } a && CompareB is { } b)
                {
                    <table class="training-compare">
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>@a.Name</th>
                                <th>@b.Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Method</td>
                                <td>@Method(a)</td>
                                <td>@Method(b)</td>
                            </tr>
                            <tr>
                                <td>Steps</td>
                                <td>@a.FinalStep / @a.TotalSteps</td>
                                <td>@b.FinalStep / @b.TotalSteps</td>
                            </tr>
                            <tr>
                                <td>Final loss</td>
                                <td class="@(Lower(a.FinalLoss, b.FinalLoss))">@Fmt(a.FinalLoss)</td>
                                <td class="@(Lower(b.FinalLoss, a.FinalLoss))">@Fmt(b.FinalLoss)</td>
                            </tr>
                            <tr>
                                <td>Best val</td>
                                <td class="@(Lower(a.BestValLoss, b.BestValLoss))">
                                    @Fmt(a.BestValLoss)@StepAt(a.BestValStep)
                                </td>
                                <td class="@(Lower(b.BestValLoss, a.BestValLoss))">
                                    @Fmt(b.BestValLoss)@StepAt(b.BestValStep)
                                </td>
                            </tr>
                            <tr>
                                <td>Exam loss</td>
                                <td class="@(Lower(a.ExamLoss, b.ExamLoss))">
                                    @Fmt(a.ExamLoss)@PerplexityAt(a.ExamPerplexity)
                                </td>
                                <td class="@(Lower(b.ExamLoss, a.ExamLoss))">
                                    @Fmt(b.ExamLoss)@PerplexityAt(b.ExamPerplexity)
                                </td>
                            </tr>
                            <tr>
                                <td>Validation split</td>
                                <td>@a.ValidationPercent.ToString("0.#")%</td>
                                <td>@b.ValidationPercent.ToString("0.#")%</td>
                            </tr>
                            <tr>
                                <td>Elapsed</td>
                                <td class="@(Lower(b.ElapsedSeconds, a.ElapsedSeconds))">@Duration(a.ElapsedSeconds)</td>
                                <td class="@(Lower(a.ElapsedSeconds, b.ElapsedSeconds))">@Duration(b.ElapsedSeconds)</td>
                            </tr>
                            <tr>
                                <td>Model</td>
                                <td>@ModelSize(a)</td>
                                <td>@ModelSize(b)</td>
                            </tr>
                            <tr>
                                <td>Profile</td>
                                <td>H@(a.HiddenDim) - batch @a.BatchSize - seq @a.SeqLen</td>
                                <td>H@(b.HiddenDim) - batch @b.BatchSize - seq @b.SeqLen</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="grid-2">
                        <TrainingLossChart Title="@a.Name" Points="@a.Curve"
                                           BestStep="@a.BestValStep" BestLoss="@a.BestValLoss" />
                        <TrainingLossChart Title="@b.Name" Points="@b.Curve"
                                           BestStep="@b.BestValStep" BestLoss="@b.BestValLoss" />
                    </div>

                    <div class="training-actions">
                        <button type="button" class="button primary" @onclick="Promote"
                                disabled="@(!CanPromote)">
                            @PromotionLabel
                        </button>
                        <span class="small faint">
                            Both runs need a held-out exam. The report records the verdict even when A
                            does not win.
                        </span>
                    </div>

                    @if (_promotionSummary is { } promotionSummary)
                    {
                        <div class="small">@promotionSummary</div>
                    }
                    @if (_promotionPath is { } promotionPath)
                    {
                        <div class="small faint mono">Report: @promotionPath</div>
                    }
                }
            }
            else if (Lab.RunHistory.Count >= 2)
            {
                <div class="small faint">
                    Comparison needs two runs that logged at least two curve points.
                </div>
            }
        </div>
    </section>
}
else if (_tab == "models")
{
    <section class="panel training-convert">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Convert</div>
                <h2>Between .smm and GGUF</h2>
            </div>
            <span class="faint small mono">tensors copied verbatim</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                SMM to GGUF exports a SharpMind model for another runtime. GGUF to SMM packages
                a downloaded model so Studio can load it. Nothing is re-quantised: the tensor
                bytes and the tokenizer move across unchanged.
            </p>

            <div class="training-form">
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-pick">Known model files</label>
                    <select id="convert-pick" class="input" value="@_convertSource" @onchange="PickSource">
                        <option value="">Choose a model file…</option>
                        @foreach (FileInfo file in ConvertibleModels)
                        {
                            <option value="@file.FullName">@file.Name - @file.Directory?.Name</option>
                        }
                    </select>
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-source">Source file</label>
                    <input id="convert-source" class="input" @bind="_convertSource" @bind:after="SuggestDestination"
                           placeholder="C:\path\to\model.smm or C:\path\to\model.gguf" />
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-destination">Destination file</label>
                    <input id="convert-destination" class="input" @bind="_convertDestination"
                           placeholder="Leave blank to write beside the source" />
                </div>
            </div>

            <div class="training-actions">
                <span class="training-chip live">@DirectionLabel</span>
                <button type="button" class="button primary" @onclick="StartConversion"
                        disabled="@(Convert.IsRunning || !CanConvert || (DestinationExists && !_allowOverwrite))">
                    @(Convert.IsRunning ? "Converting..." : "Convert")
                </button>
                @if (Convert.IsRunning)
                {
                    <button type="button" class="button danger" @onclick="Convert.Cancel">Cancel</button>
                }
                <label class="small faint training-check">
                    <input type="checkbox" @bind="_allowOverwrite" />
                    Overwrite the destination if it exists
                </label>
            </div>

            @if (DestinationExists && !_allowOverwrite)
            {
                <div class="small faint">
                    <span class="mono">@_convertDestination</span> already exists. Tick overwrite to replace it.
                </div>
            }

            @if (Convert.IsRunning || Convert.Result is not null)
            {
                <div class="progress-track">
                    <div class="progress-fill" style="width:@ConvertPercent"></div>
                </div>
                <div class="small faint">@Convert.Status</div>
            }

            @if (Convert.Result is { Success: true } done)
            {
                <div class="small">
                    Saved <span class="mono">@done.DestinationPath</span>
                    - @Megabytes(done.DestinationBytes) MB in @done.Elapsed.TotalSeconds.ToString("0.0")s,
                    validated as @done.Label.
                </div>
            }
            else if (Convert.Error is { } conversionError)
            {
                <div class="error-line">@conversionError</div>
            }

            @if (_convertError is { } localError)
            {
                <div class="error-line">@localError</div>
            }
        </div>
    </section>

    <section class="panel training-section">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Model files</div>
                <h2>Models</h2>
            </div>
            <a class="button" href="/settings?tab=models">Model settings</a>
        </div>
        <div class="panel-body stack">
            @if (Models.Count == 0)
            {
                <div class="empty">No model files yet. Finished runs export an <span class="mono">.smm</span> or <span class="mono">.smlora</span> here, and conversions land beside their source.</div>
            }
            else
            {
                <div class="training-jobs">
                    @foreach (FileInfo file in Models)
                    {
                        <div class="training-job">
                            <div>
                                <strong class="mono">@file.Name</strong>
                                <div class="small faint">@file.FullName</div>
                            </div>
                            <div class="row">
                                <span class="training-chip">@file.Extension.TrimStart('.').ToUpperInvariant()</span>
                                <span class="small faint mono">@Megabytes(file.Length) MB</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <p class="small faint">
                A model version is a float master plus derived quant builds per device profile.
                Quantised builds are outputs and never training roots.
            </p>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string _tab = "new";
    private TrainingJobSettings _job = null!;
    private string _selectedJobPath = "";
    private string? _error;
    private bool _starting;

    private string _convertSource = "";
    private string _convertDestination = "";
    private bool _allowOverwrite;
    private string? _convertError;

    private string _tuneBase = "";
    private string _tuneCorpusPath = "";
    private bool _tuneSft;
    private string _tuneSftFormatter = "auto";
    private bool _sftPreviewing;
    private CancellationTokenSource? _sftPreviewCancel;
    private SftDatasetPreview? _sftPreview;
    private string? _sftPreviewError;
    private string _sftPreviewStatus = "";
    private string _tuneName = "";
    private string _tuneExport = "";
    private int _tuneRank = 8;
    private float _tuneAlpha = 16f;
    private int _tuneSteps = 100;
    private double _tuneValidationPercent = 10;
    private double _tuneTestPercent = 10;
    private float _tuneLr = 2e-4f;
    private string _tuneOutput = "merged";
    private string _tuneAdapterPath = "";
    private string _tuneResume = "";
    private bool _tuneStartFresh = true;
    private string? _tuneError;
    private bool _tuning;
    private string _compareA = "";
    private string _compareB = "";
    private string? _promotionSummary;
    private string? _promotionPath;
    private string? _runNotice;
    private string? _planId;
    private string? _ruleSetVersion;
    private string _playbookStatus = "";
    private string _mergeSource = "";
    private string _mergeOutput = "";
    private string _mergeFormat = "jsonl";
    private string _mergeLayout = "auto";
    private string _mergeSeparator = "";
    private string _mergeDropPattern = "";
    private bool _mergeStripHtml = true;
    private bool _mergeNormalizeText = true;
    private bool _mergeDeduplicate = true;
    private string _mergeStatus = "";
    private string? _mergeError;
    private bool _merging;
    private IReadOnlyList<string>? _resumeOptions;
    private readonly HashSet<string> _tuneTargets =
        ["q_proj", "k_proj", "v_proj", "o_proj", "up_proj", "down_proj"];

    private static readonly (string Id, string Label)[] LoraTargets =
    [
        ("q_proj", "Attention Q"),
        ("k_proj", "Attention K"),
        ("v_proj", "Attention V"),
        ("o_proj", "Attention O"),
        ("gate_proj", "FFN gate"),
        ("up_proj", "FFN up"),
        ("down_proj", "FFN down"),
    ];

    private IReadOnlyList<FileInfo> Models
    {
        get
        {
            try
            {
                var found = new List<FileInfo>();
                foreach (string folder in new[] { Lab.Folder, StudioPaths.Models }.Distinct(StringComparer.OrdinalIgnoreCase))
                {
                    if (!Directory.Exists(folder)) continue;
                    var directory = new DirectoryInfo(folder);
                    found.AddRange(directory.GetFiles("*.smm", SearchOption.TopDirectoryOnly));
                    found.AddRange(directory.GetFiles("*.gguf", SearchOption.TopDirectoryOnly));
                    found.AddRange(directory.GetFiles("*" + TrainingJobSettings.AdapterExtension, SearchOption.TopDirectoryOnly));
                }

                return [.. found
                    .OrderByDescending(file => file.LastWriteTimeUtc)
                    .Take(50)];
            }
            catch
            {
                return [];
            }
        }
    }

    private IReadOnlyList<FileInfo> SmmModels =>
        [.. Models.Where(file => file.Extension.Equals(".smm", StringComparison.OrdinalIgnoreCase))];

    private IReadOnlyList<TrainingPlaybook> AllPlaybooks =>
        [.. TrainingPlaybooks.All, .. Lab.Playbooks.List().Select(TrainingPlaybookStore.ToPlaybook)];

    private TrainingCorpusEstimate CorpusEstimate => TrainingCorpusFacts.Estimate(_job);

    private static bool IsCustomPlaybook(TrainingPlaybook playbook) =>
        playbook.Id.StartsWith("custom:", StringComparison.Ordinal);

    /// <summary>Model files the converter understands; adapters are not convertible.</summary>
    private IReadOnlyList<FileInfo> ConvertibleModels =>
        [.. Models.Where(file => !file.Extension.Equals(TrainingJobSettings.AdapterExtension, StringComparison.OrdinalIgnoreCase))];

    private ModelConversionDirection? Direction => ModelConverter.Detect(_convertSource);

    private string DirectionLabel => Direction switch
    {
        ModelConversionDirection.SmmToGguf => "SMM to GGUF",
        ModelConversionDirection.GgufToSmm => "GGUF to SMM",
        _ => "Pick a .smm or .gguf source",
    };

    private bool CanConvert => Direction is not null && !string.IsNullOrWhiteSpace(_convertSource);

    private bool DestinationExists
    {
        get
        {
            string destination = _convertDestination.Trim();
            return destination.Length > 0 && File.Exists(destination);
        }
    }

    private string ConvertPercent => (Convert.Progress * 100).ToString("0") + "%";

    protected override void OnInitialized()
    {
        _job = Lab.Draft ?? CreateDefaultJob();
        Lab.Draft = _job;
        _mergeOutput = Path.Combine(StudioPaths.Corpus, "merged.jsonl");
        _mergeSource = _job.Sources
            .Select(source => source.Component.Args.GetValueOrDefault("path"))
            .FirstOrDefault(path => !string.IsNullOrWhiteSpace(path)) ?? "";

        Lab.Changed += OnTrainingChanged;
        Convert.Changed += OnTrainingChanged;
        Exam.Changed += OnExamChanged;
    }

    protected override void OnParametersSet()
    {
        _tab = TabQuery is "new" or "improve" or "playbooks" or "data" or "runs" or "models"
            ? TabQuery
            : "new";
        if (_tab == "runs") EnsureCompareSelection();
    }

    public void Dispose()
    {
        Lab.Changed -= OnTrainingChanged;
        Convert.Changed -= OnTrainingChanged;
        Exam.Changed -= OnExamChanged;
        _sftPreviewCancel?.Cancel();
        _sftPreviewCancel?.Dispose();
    }

    private void OnTrainingChanged() => _ = InvokeAsync(() =>
    {
        if (_tab == "runs") EnsureCompareSelection();
        // A finished run may have written a new adapter checkpoint; the resume
        // picker should see it next time the Improve tab renders.
        if (!Lab.IsRunning) _resumeOptions = null;
        StateHasChanged();
    });

    private void OnExamChanged() => _ = InvokeAsync(StateHasChanged);

    private void PickSource(ChangeEventArgs args)
    {
        _convertSource = args.Value as string ?? "";
        SuggestDestination();
    }

    private void SuggestDestination()
    {
        _convertError = null;
        if (ModelConverter.Detect(_convertSource) is null)
        {
            _convertDestination = "";
            return;
        }

        _convertDestination = ModelConverter.SuggestDestination(_convertSource.Trim());
        _allowOverwrite = false;
    }

    private void StartConversion()
    {
        _convertError = null;
        if (Convert.IsRunning) return;

        string source = _convertSource.Trim();
        if (ModelConverter.Detect(source) is null)
        {
            _convertError = "Pick a .smm or .gguf source file.";
            return;
        }
        if (!File.Exists(source))
        {
            _convertError = $"Source model not found: {source}";
            return;
        }

        string destination = string.IsNullOrWhiteSpace(_convertDestination)
            ? ModelConverter.SuggestDestination(source)
            : _convertDestination.Trim();

        if (!Convert.Start(source, destination, _allowOverwrite))
            _convertError = "A conversion is already running.";
    }

