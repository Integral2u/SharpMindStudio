                                }
                                @if (run.Record.RecipeHash is { } recipeHash)
                                {
                                    <span class="small faint mono">recipe @ShortHash(recipeHash)</span>
                                }
                                @if (run.Record.PlanId is { } planId)
                                {
                                    <span class="small faint mono">plan @planId @run.Record.RuleSetVersion</span>
                                }
                                <span class="small faint mono">loss @Fmt(run.Record.FinalLoss)</span>
                                @if (run.Record.BestValLoss is { } bestVal)
                                {
                                    <span class="small faint mono">
                                        val @Fmt(bestVal) @@ @run.Record.BestValStep
                                    </span>
                                }
                                @if (run.Record.ExamLoss is { } examLoss)
