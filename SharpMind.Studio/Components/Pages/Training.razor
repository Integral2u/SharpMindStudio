@page "/training"
@implements IDisposable
@using SharpMind.Data.Sources
@using SharpMind.Model.Format
@using SharpMind.Studio.Core.Compute
@using SharpMind.Studio.Core.Storage
@using SharpMind.Studio.Core.Training
@using SharpMind.Studio.Services
@using SharpMind.Training
@inject StudioTrainingService Lab
@inject StudioConversionService Convert
@inject StudioExamService Exam
@inject StudioRehearsalService Rehearsal
@inject ComputeProviderService Compute
@inject StudioWorkspaceService Workspace
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PathPickerService Picker

<PageTitle>Training - SharpMind Studio</PageTitle>

<div class="hero">
    <div class="hero-copy">
        <div class="eyebrow">Training lab</div>
        <h1>Teach the machine.</h1>
        <p>
            Build a model from a corpus, or fine-tune a packaged <span class="mono">.smm</span>
            with LoRA. Both end in a tested export you can run on this machine.
        </p>
    </div>
    <div class="hero-mark">
        corpus to export<br />
        LoRA to merged model
    </div>
</div>

<div class="settings-tabs training-tabs">
    <a class="settings-tab @(_tab == "new" ? "selected" : "")" href="/training?tab=new" data-enhance-nav="false">New model</a>
    <a class="settings-tab @(_tab == "improve" ? "selected" : "")" href="/training?tab=improve" data-enhance-nav="false">Improve</a>
    <a class="settings-tab @(_tab == "playbooks" ? "selected" : "")" href="/training?tab=playbooks" data-enhance-nav="false">Playbooks</a>
    <a class="settings-tab @(_tab == "data" ? "selected" : "")" href="/training?tab=data" data-enhance-nav="false">Data</a>
    <a class="settings-tab @(_tab == "runs" ? "selected" : "")" href="/training?tab=runs" data-enhance-nav="false">Runs</a>
    <a class="settings-tab @(_tab == "models" ? "selected" : "")" href="/training?tab=models" data-enhance-nav="false">Models</a>
</div>

@if (_tab == "new")
{
    @if (Lab.IsRunning || Lab.Result is not null || Lab.Error is not null)
    {
        <TrainingRunPanel />
    }

    <section class="panel training-saved">
        <div class="panel-body stack">
            <div class="row">
                <div class="field training-form-wide">
                    <label class="field-label" for="training-saved">Saved jobs</label>
                    <select id="training-saved" class="input" @bind="_selectedJobPath">
                        <option value="">Choose a saved job...</option>
                        @foreach (string path in Lab.SavedJobs)
                        {
                            <option value="@path">@Path.GetFileNameWithoutExtension(path)</option>
                        }
                    </select>
                </div>
                <button type="button" class="button" @onclick="LoadLatestJob"
                        disabled="@(Lab.IsRunning || Lab.SavedJobs.Count == 0)">
                    Load latest
                </button>
                <button type="button" class="button" @onclick="LoadSelectedJob"
                        disabled="@(Lab.IsRunning || string.IsNullOrWhiteSpace(_selectedJobPath))">
                    Load selected
                </button>
                <button type="button" class="button primary" @onclick="RunSelectedJob"
                        disabled="@(Lab.IsRunning || string.IsNullOrWhiteSpace(_selectedJobPath))">
                    Run selected
                </button>
            </div>
            <div class="small faint">
                Jobs are saved under <span class="mono">@Lab.Folder</span>.
                @if (Lab.SavedJobs.Count == 0) { <span> No saved jobs yet.</span> }
            </div>
        </div>
    </section>

    <TrainingPlannerPanel Job="_job" UsePlan="ApplyPlan" FocusMove="FocusPlannerMove" />

    <TrainingEstimatorPanel Job="_job" />

    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">From a corpus</div>
                <h2>New model</h2>
            </div>
            <span class="faint small mono">tokenizer - weights - checkpoints - .smm</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                The editor covers sources and stage chains, the tokenizer, architecture, device,
                precision, optimizer, checkpoints and splits. A run exports a packaged model and
                resumes from its latest checkpoint unless you start fresh.
            </p>

            <TrainingJobEditor Job="_job"
                               IsRemoteTarget="_computeProviderId is not null"
                               RemoteAccelerators="_remoteAccelerators" />

            <div class="training-actions">
                <div class="field" style="min-width: 16rem;">
                    <label class="field-label" for="training-compute">Run on</label>
                    <select id="training-compute" class="input" @bind="_computeProviderId"
                            @bind:after="LoadRunTargetAsync"
                            disabled="@(Lab.IsRunning || Rehearsal.IsRunning)">
                        <option value="">This PC</option>
                        @foreach (ComputeProviderSettings host in Compute.Providers)
                        {
                            <option value="@host.Id">@host.Name (@ComputeProviderPrefabs.Find(host.Prefab).Name)</option>
                        }
                    </select>
                    @if (_computeProviderId is not null)
                    {
                        <span class="small faint">
                            Saved jobs and <strong>Run selected</strong> use this target too.
                            Training from scratch needs no model on the host; a fine-tune uploads its
                            base model with the job. Sources and checkpoints are uploaded first, then
                            the export is downloaded back here.
                        </span>
                        @if (_remoteAcceleratorError is not null)
                        {
                            <div class="error-line">@_remoteAcceleratorError</div>
                        }
                    }
                </div>
                <button type="button" class="button primary" @onclick="StartTraining"
                        disabled="@(Lab.IsRunning || Rehearsal.IsRunning || _starting)">
                    @(Lab.IsRunning ? "Training..." : "Start training")
                </button>
                <button type="button" class="button" @onclick="StartNewJob"
                        disabled="@Lab.IsRunning">
                    New job
                </button>
                <button type="button" class="button" @onclick="SaveJob"
                        disabled="@Lab.IsRunning">
                    Save job
                </button>
                <span class="small faint">Saved jobs are at the top of this tab.</span>
            </div>

            @if (_error is not null)
            {
                <div class="error-line">@_error</div>
            }
            @if (Lab.Error is { } runError)
            {
                <div class="error-line">Run failed: @runError</div>
            }
        </div>
    </section>
}
else if (_tab == "improve")
{
    @if (Lab.IsRunning || Lab.Result is not null || Lab.Error is not null)
    {
        <TrainingRunPanel />
    }

    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Fine-tune</div>
                <h2>Improve a base model</h2>
            </div>
            <span class="faint small mono">LoRA - base stays frozen</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                Pick a packaged <span class="mono">.smm</span> and a corpus of new or corrective text.
                Only small LoRA adapters train. Export a merged <span class="mono">.smm</span> that
                loads like any other model, save the adapters as a <span class="mono">.smlora</span>
                file, or both. Tick <span class="mono">SFT</span> to train on chat JSONL with
                assistant-only loss masks. A run can resume the weights from an adapter checkpoint
                and continue with a fresh optimizer. A <span class="mono">.gguf</span> base can be
                converted first on Models.
            </p>

            <div class="training-form">
                <div class="field training-form-wide">
                    <label class="field-label" for="tune-pick">Base model</label>
                    <select id="tune-pick" class="input" value="@_tuneBase" @onchange="PickBase">
                        <option value="">Choose an .smm file...</option>
                        @foreach (FileInfo file in SmmModels)
                        {
                            <option value="@file.FullName">@file.Name</option>
                        }
                    </select>
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="tune-base">Base file</label>
                    <input id="tune-base" class="input" @bind="_tuneBase"
                           placeholder="C:\path\to\base.smm" />
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="tune-corpus">@(_tuneSft ? "Chat JSONL corpus" : "New corpus")</label>
                    <div class="row">
                        <input id="tune-corpus" class="input" @bind="_tuneCorpusPath"
                               placeholder="@(_tuneSft ? "C:\\path\\to\\chats.jsonl or C:\\path\\**\\*.jsonl" : "C:\\path\\to\\new-text or C:\\path\\**\\*.txt")" />
                        <button type="button" class="button" @onclick="BrowseTuneCorpus"
                                title="@(_tuneSft ? "Choose a chat JSONL file." : "Choose a text file.")">
                            Browse
                        </button>
                    </div>
                    <label class="small faint training-check">
                        <input type="checkbox" @bind="_tuneSft" />
                        Instruction tuning (SFT) - train only on assistant tokens from chat JSONL
                    </label>
                </div>
                @if (_tuneSft)
                {
                    <div class="field training-form-wide">
                        <label class="field-label" for="tune-sft-formatter">Chat formatter</label>
                        <select id="tune-sft-formatter" class="input" @bind="_tuneSftFormatter">
                            <option value="auto">Auto - the base model's chat template</option>
                            <option value="chatml">ChatML</option>
                            <option value="jinja">Jinja template</option>
                            <option value="simple">Simple (user:/assistant:)</option>
                            <option value="llama3">Llama 3 headers</option>
                            <option value="alpaca">Alpaca</option>
                            <option value="questionanswer">Question / answer</option>
                            <option value="raw">Raw text</option>
                        </select>
                        <span class="small faint">
                            Each line may use <span class="mono">messages</span>,
                            <span class="mono">conversations</span>,
                            <span class="mono">prompt/response</span> or
                            <span class="mono">instruction/output</span>. Loss is masked to the assistant reply.
                        </span>
                    </div>
                    <div class="field">
                        <label class="field-label" for="tune-sft-seq">SFT sequence length</label>
                        <input id="tune-sft-seq" class="input" type="number" min="16" max="8192" step="16"
                               @bind="_tuneSftSeqLen" />
                        <span class="small faint">Longer conversations are truncated.</span>
                    </div>
                    <div class="field training-form-wide">
                        <div class="training-subsection-head">
                            <label class="field-label">SFT data preflight</label>
                            <div class="row">
                                <button type="button" class="button" @onclick="PreviewSftData"
                                        disabled="@(_sftPreviewing || Lab.IsRunning || Rehearsal.IsRunning)">
                                    @(_sftPreviewing ? "Analyzing..." : "Preview data")
                                </button>
                                @if (_sftPreviewing)
                                {
                                    <button type="button" class="button danger" @onclick="CancelSftPreview">Cancel</button>
                                }
                            </div>
                        </div>
                        @if (_sftPreviewStatus is { Length: > 0 })
                        {
                            <span class="small faint">@_sftPreviewStatus</span>
                        }
                        @if (_sftPreviewError is not null)
                        {
                            <div class="error-line">@_sftPreviewError</div>
                        }
                        @if (_sftPreview is { } preview)
                        {
                            <div class="training-source-card">
                                <div class="small faint">
                                    Snapshot of the current fields. Re-run after changing the corpus,
                                    formatter or split percentages.
                                </div>
                                <div class="training-metrics">
                                    <div>
                                        <span class="faint small">Records</span>
                                        <strong>@preview.Records.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Skipped</span>
                                        <strong>@preview.Skipped.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Files</span>
                                        <strong>@preview.Files.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Train / Val / Exam</span>
                                        <strong>@preview.TrainRecords / @preview.ValidationRecords / @preview.ExamRecords</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Avg @(preview.Tokenized ? "tokens" : "chars") / reply</span>
                                        <strong>@preview.AverageTokens.ToString("0.#") / @preview.AverageAssistantTokens.ToString("0.#")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Max @(preview.Tokenized ? "tokens" : "chars")</span>
                                        <strong>@preview.MaxTokens.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Over @preview.SeqLen</span>
                                        <strong>@preview.TruncatedRecords.ToString("N0")</strong>
                                    </div>
                                    <div>
                                        <span class="faint small">Formatter</span>
                                        <strong>@preview.Formatter</strong>
                                    </div>
                                </div>
                                @if (preview.Layouts.Count > 0)
                                {
                                    <div class="small faint">
                                        Layouts:
                                        @foreach (var pair in preview.Layouts)
                                        {
                                            <span class="mono">@pair.Key</span> @pair.Value.ToString("N0")<text>&nbsp; </text>
                                        }
                                    </div>
                                }
                                @if (preview.LimitedScan)
                                {
                                    <div class="small faint">
                                        Sampled the first @preview.Records.ToString("N0") records.
                                    </div>
                                }
                                @foreach (string warning in preview.Warnings)
                                {
                                    <div class="small" style="color: var(--warn);">@warning</div>
                                }
                                @foreach (SftPreviewExample example in preview.Examples)
                                {
                                    <div class="training-source-card">
                                        <div class="small faint">
                                            <span class="mono">@example.Layout</span> &middot;
                                            @example.Turns turn(s) &middot;
                                            @example.Tokens @(preview.Tokenized ? "tokens" : "chars") &middot;
                                            @example.AssistantTokens reply
                                            @if (example.Truncated)
                                            {
                                                <text> &middot; truncated</text>
                                            }
                                        </div>
                                        <pre class="sft-preview-text">@example.Rendered</pre>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                <div class="field">
                    <label class="field-label" for="tune-rank">LoRA rank</label>
                    <input id="tune-rank" class="input" type="number" min="1" max="256" @bind="_tuneRank" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-alpha">LoRA alpha</label>
                    <input id="tune-alpha" class="input" type="number" min="1" step="1" @bind="_tuneAlpha" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-steps">Steps</label>
                    <input id="tune-steps" class="input" type="number" min="1" @bind="_tuneSteps" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-val">Validation split (%)</label>
                    <input id="tune-val" class="input" type="number" min="0" max="90" step="5"
                           @bind="_tuneValidationPercent" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-exam">Held-out exam (%)</label>
                    <input id="tune-exam" class="input" type="number" min="0" max="45" step="5"
                           @bind="_tuneTestPercent" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-lr">Learning rate</label>
                    <input id="tune-lr" class="input" type="number" min="0.000001" step="0.00001" @bind="_tuneLr" />
                </div>
                <div class="field training-form-wide">
                    <label class="field-label">Adapted projections</label>
                    <div class="training-targets">
                        @foreach ((string id, string label) in LoraTargets)
                        {
                            <label class="training-target">
                                <input type="checkbox" checked="@_tuneTargets.Contains(id)"
                                       @onchange="args => ToggleTarget(id, args)" />
                                @label
                            </label>
                        }
                    </div>
                </div>
                <div class="field">
                    <label class="field-label" for="tune-name">Job name</label>
                    <input id="tune-name" class="input" @bind="_tuneName" placeholder="base-lora" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-export">Merged model (optional)</label>
                    <input id="tune-export" class="input" @bind="_tuneExport"
                           placeholder="Leave blank to save in the Training folder" />
                </div>
                <div class="field">
                    <label class="field-label" for="tune-output">Output</label>
                    <select id="tune-output" class="input" @bind="_tuneOutput">
                        <option value="merged">Merged .smm</option>
                        <option value="adapter">Adapter only .smlora</option>
                        <option value="both">Merged + adapter</option>
                    </select>
                </div>
                @if (_tuneOutput != "merged")
                {
                    <div class="field training-form-wide">
                        <label class="field-label" for="tune-adapter">Adapter file (optional)</label>
                        <input id="tune-adapter" class="input" @bind="_tuneAdapterPath"
                               placeholder="Beside the model, extension .smlora" />
                    </div>
                }
                <div class="field training-form-wide">
                    <label class="field-label" for="tune-resume">Resume from</label>
                    <select id="tune-resume" class="input" value="@_tuneResume" @onchange="PickResume"
                            disabled="@_tuneStartFresh">
                        <option value="">Latest checkpoint for this job</option>
                        @foreach (string path in AdapterResumeOptions)
                        {
                            <option value="@path">@ResumeLabel(path)</option>
                        }
                    </select>
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="tune-resume-path">Adapter file or checkpoint folder</label>
                    <input id="tune-resume-path" class="input" @bind="_tuneResume"
                           placeholder="C:\...\adapters.smlora or a checkpoint folder" />
                    <label class="small faint training-check">
                        <input type="checkbox" @bind="_tuneStartFresh" />
                        Start fresh, ignore adapter checkpoints
                    </label>
                </div>
            </div>

            <div class="training-actions">
                <div class="field" style="min-width: 16rem;">
                    <label class="field-label" for="tune-compute">Run on</label>
                    <select id="tune-compute" class="input" @bind="_computeProviderId"
                            @bind:after="LoadRunTargetAsync"
                            disabled="@(Lab.IsRunning || Rehearsal.IsRunning)">
                        <option value="">This PC</option>
                        @foreach (ComputeProviderSettings host in Compute.Providers)
                        {
                            <option value="@host.Id">@host.Name (@ComputeProviderPrefabs.Find(host.Prefab).Name)</option>
                        }
                    </select>
                    @if (_computeProviderId is not null)
                    {
                        <span class="small faint">
                            Uploads the base model and corpus, runs the fine-tune on the host,
                            then downloads the export back here. The host needs no chat model.
                        </span>
                        @if (_remoteAcceleratorError is not null)
                        {
                            <div class="error-line">@_remoteAcceleratorError</div>
                        }
                    }
                </div>
                <button type="button" class="button primary" @onclick="StartFineTune"
                        disabled="@(Lab.IsRunning || Rehearsal.IsRunning || _tuning)">
                    @(Lab.IsRunning ? "Training..." : _tuneSft ? "Start SFT" : "Start fine-tune")
                </button>
                <button type="button" class="button" @onclick="RehearseFineTune"
                        disabled="@(Lab.IsRunning || Rehearsal.IsRunning || _tuning)">
                    Rehearse 30 steps
                </button>
                @if (Rehearsal.IsRunning)
                {
                    <button type="button" class="button danger" @onclick="Rehearsal.Cancel">Cancel</button>
                }
                <span class="small faint">
                    Checkpoints save adapters alongside the optimizer state; resume reuses the
                    weights and restarts the schedule.
                </span>
            </div>

            @if (Rehearsal.IsRunning || Rehearsal.Result is not null || Rehearsal.Error is not null)
            {
                <div class="small faint">@Rehearsal.Status</div>
                @if (Rehearsal.Result is { } rehearsal)
                {
                    <div class="small">
                        Rehearsed @rehearsal.StepsRun step(s): @rehearsal.MedianStepSeconds.ToString("0.00")s/step,
                        @rehearsal.TokensPerSecond.ToString("0.0") tok/s, peak
                        @((rehearsal.PeakWorkingSetBytes / (1024d * 1024 * 1024)).ToString("0.00")) GiB.
                        Full @rehearsal.TotalSteps steps would take about
                        @(rehearsal.EstimatedTotalHours >= 1
                            ? $"{rehearsal.EstimatedTotalHours:0.0} h"
                            : $"{(int)rehearsal.EstimatedTotalTime.TotalMinutes} min").
                    </div>
                }
                @if (Rehearsal.Error is { } rehearsalError)
                {
                    <div class="error-line">@rehearsalError</div>
                }
            }

            @if (_tuneError is not null)
            {
                <div class="error-line">@_tuneError</div>
            }
            @if (Lab.Error is { } tuneRunError)
            {
                <div class="error-line">Run failed: @tuneRunError</div>
            }
        </div>
    </section>

    <section class="panel training-section">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Diagnosis loop</div>
                <h2>After the fine-tune</h2>
            </div>
            <span class="faint small mono">curves, exam and promotion live</span>
        </div>
        <div class="panel-body stack">
            <div class="training-flow">
                <span>Diagnose</span>
                <span class="training-flow-arrow">&#8594;</span>
                <span>Hypothesise</span>
                <span class="training-flow-arrow">&#8594;</span>
                <span>Experiment</span>
                <span class="training-flow-arrow">&#8594;</span>
                <span>Compare</span>
                <span class="training-flow-arrow">&#8594;</span>
                <span>Promote</span>
            </div>

            <div class="training-grid">
                <div class="training-card">
                    <div class="eyebrow">Read</div>
                    <h3>Curves and evaluations</h3>
                    <p>Under-training, overfit, unstable steps and forgetting each point at a different first experiment.</p>
                </div>
                <div class="training-card">
                    <div class="eyebrow">Experiment</div>
                    <h3>Short, comparable trials</h3>
                    <p>Same seed and validation set. Data experiments come before hyperparameter tuning.</p>
                </div>
                <div class="training-card">
                    <div class="eyebrow">Promote</div>
                    <h3>A new version with a report</h3>
                    <p>The held-out exam stays untouched until promotion, so the comparison is honest.</p>
                </div>
            </div>
        </div>
    </section>
}
else if (_tab == "playbooks")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Reusable recipes</div>
                <h2>Playbooks</h2>
            </div>
            <span class="faint small mono">@AllPlaybooks.Count starting points</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                Prefab editor values for common goals. Each one fills the form; you still
                supply the corpus (and, for a fine-tune, the base model). They are starting
                points, not measured results. Save the current New model job or Improve LoRA
                settings below to add your own.
            </p>

            <div class="row">
                <button type="button" class="button" @onclick="SaveJobAsPlaybookAsync">
                    Save current job as playbook
                </button>
                <button type="button" class="button" @onclick="SaveLoraAsPlaybookAsync">
                    Save current LoRA as playbook
                </button>
                <span class="status-line">@_playbookStatus</span>
            </div>

            <div class="training-grid">
                @foreach (TrainingPlaybook playbook in AllPlaybooks)
                {
                    <div class="training-card">
                        <div class="eyebrow">@playbook.Eyebrow</div>
                        <h3>@playbook.Name</h3>
                        <p>@playbook.Description</p>
                        <div class="small faint">@playbook.Outcome</div>
                        <div class="training-actions">
                            <button type="button" class="button primary"
                                    @onclick="() => ApplyPlaybook(playbook)">
                                @(playbook.Kind == TrainingPlaybookKind.FineTune
                                    ? "Open in Improve"
                                    : "Use in New model")
                            </button>
                            @if (IsCustomPlaybook(playbook))
                            {
                                <button type="button" class="button danger"
                                        @onclick="() => DeletePlaybook(playbook)">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
else if (_tab == "data")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Configured pipeline</div>
                <h2>Sources and stages</h2>
            </div>
            <a class="button" href="/training?tab=new">Edit in New model</a>
        </div>
        <div class="panel-body stack">
            @if (_job.Sources.Count == 0)
            {
                <div class="empty">
                    No sources yet. Add a corpus in <a href="/training?tab=new">New model</a>.
                </div>
            }
            else
            {
                <div class="training-jobs">
                    @foreach (JobSource source in _job.Sources)
                    {
                        <div class="training-job">
                            <div>
                                <strong>@(source.Component.DisplayName ?? "Source")</strong>
                                <div class="small faint mono">@SourcePath(source)</div>
                            </div>
                            <div class="row">
                                <span class="training-chip">@source.Stages.Count stage(s)</span>
                            </div>
                        </div>
                    }
                </div>
                <div class="small faint">
                    Global stages: @_job.GlobalStages.Count - incremental:
                    @(_job.IncrementalMode ? "on" : "off")
                </div>
                <div class="small faint">
                    @CorpusEstimate.Files file(s), @Megabytes(CorpusEstimate.Bytes) MB,
                    about @(CorpusEstimate.Tokens?.ToString("N0") ?? "unknown") tokens.
                </div>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Corpus tools</div>
                <h2>Merge text files</h2>
            </div>
            <span class="faint small mono">one JSONL document per line</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                Walks a folder, optionally strips HTML, normalises paragraphs, removes exact
                duplicates, and writes one document per line as JSONL. JSONL preserves document
                boundaries without assuming a tokenizer or an end-of-text token. Add the output
                as a <span class="mono">JSONL</span> source with text field <span class="mono">text</span>.
                Training inserts the tokenizer's EOS between documents, so do not add an
                end-of-text marker to the text. Use the optional regex for corpus-specific
                boilerplate, or a cleaning stage.
            </p>
            <div class="training-form">
                <div class="field training-form-wide">
                    <label class="field-label" for="merge-source">Source folder</label>
                    <div class="row">
                        <input id="merge-source" class="input" @bind="_mergeSource"
                               placeholder="C:\path\to\books" />
                        <button type="button" class="button" @onclick="BrowseMergeSourceAsync">Browse</button>
                    </div>
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="merge-output">Output file</label>
                    <div class="row">
                        <input id="merge-output" class="input" @bind="_mergeOutput"
                               placeholder="C:\path\to\merged.jsonl" />
                        <button type="button" class="button" @onclick="BrowseMergeOutputAsync">Browse</button>
                    </div>
                </div>
                <div class="field">
                    <label class="field-label" for="merge-format">Output format</label>
                    <select id="merge-format" class="input" @bind="_mergeFormat" @bind:after="OnMergeFormatChanged">
                        <option value="jsonl">JSONL - one document per line</option>
                        <option value="text">Plain text - one generated file</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field-label" for="merge-layout">Document layout</label>
                    <select id="merge-layout" class="input" @bind="_mergeLayout">
                        <option value="auto">Auto - detect Q&amp;A, otherwise whole file</option>
                        <option value="whole">Whole file - one document per file</option>
                        <option value="blank">Blank-line separated</option>
                        <option value="qa">Q&amp;A pairs (Q:/Question:)</option>
                        <option value="html">HTML blocks - one per paragraph</option>
                        <option value="separator">Custom separator</option>
                    </select>
                    <div class="small faint">
                        Blank-line works for files where a clear double newline separates entries.
                        Q&amp;A keeps each question and its answer together.
                    </div>
                </div>
                @if (_mergeLayout == "separator")
                {
                    <div class="field training-form-wide">
                        <label class="field-label" for="merge-separator">Custom separator</label>
                        <input id="merge-separator" class="input mono" @bind="_mergeSeparator"
                               placeholder="e.g. <|endoftext|> or ###" />
                        <div class="small faint">
                            Literal text between documents; it is removed from the output.
                        </div>
                    </div>
                }
                <div class="field training-form-wide">
                    <label class="field-label" for="merge-drop">Drop documents matching regex (optional)</label>
                    <input id="merge-drop" class="input mono" @bind="_mergeDropPattern"
                           placeholder="Leave blank to keep every cleaned document" />
                </div>
                <div class="row training-form-wide">
                    <label class="tool-toggle">
                        <input type="checkbox" @bind="_mergeStripHtml" />
                        <span>Strip HTML from .html/.htm</span>
                    </label>
                    <label class="tool-toggle">
                        <input type="checkbox" @bind="_mergeNormalizeText" />
                        <span>Normalise text</span>
                    </label>
                    <label class="tool-toggle">
                        <input type="checkbox" @bind="_mergeDeduplicate" />
                        <span>Remove exact duplicates</span>
                    </label>
                </div>
            </div>
            <div class="training-actions">
                <button type="button" class="button primary" @onclick="MergeCorpusAsync"
                        disabled="@(_merging || string.IsNullOrWhiteSpace(_mergeSource) || string.IsNullOrWhiteSpace(_mergeOutput))">
                    @(_merging ? "Merging..." : "Merge")
                </button>
                <span class="status-line">@_mergeStatus</span>
            </div>
            @if (_mergeError is not null)
            {
                <div class="error-line">@_mergeError</div>
            }
        </div>
    </section>

    <section class="panel training-section">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Dataset pipeline</div>
                <h2>Data Factory</h2>
            </div>
            <span class="faint small mono">source - clean - provider - review - export</span>
        </div>
        <DataFactoryPanel />
    </section>
}
else if (_tab == "runs")
{
    @if (Lab.IsRunning || Lab.Result is not null || Lab.Error is not null)
    {
        <TrainingRunPanel />
    }

    <TrainingSavedJobsPanel OnLoad="path => LoadJob(path)" />

    <section class="panel training-section">
        <div class="panel-head">
            <div>
                <div class="eyebrow">History</div>
                <h2>Experiments</h2>
            </div>
            <div class="row">
                <span class="faint small mono">@Lab.RunHistory.Count kept</span>
                <button type="button" class="button" @onclick="Lab.RefreshRunHistory"
                        disabled="@Lab.IsRunning">
                    Refresh
                </button>
            </div>
        </div>
        <div class="panel-body stack">
            @if (Exam.IsRunning || Exam.Status != "No exam run yet.")
            {
                <div class="small faint">@Exam.Status</div>
            }
            @if (Exam.Error is { } examError)
            {
                <div class="error-line">@examError</div>
            }
            @if (_runNotice is not null)
            {
                <div class="status-line">@_runNotice</div>
            }

            @if (Lab.RunHistory.Count == 0)
            {
                <div class="empty">
                    Finished runs are kept here with their curves, so two experiments can be
                    compared after the live panel is gone.
                </div>
            }
            else
            {
                <div class="training-jobs">
                    @foreach (TrainingRunSummary run in Lab.RunHistory)
                    {
                        <div class="training-job">
                            <div>
                                <strong class="mono">@run.Record.Name</strong>
                                <div class="small faint">
                                    @Method(run.Record)
                                    - @run.Record.FinishedUtc.ToLocalTime().ToString("dd MMM HH:mm")
                                    - step @run.Record.FinalStep / @run.Record.TotalSteps
                                    @if (run.Record.ElapsedSeconds > 0)
                                    {
                                        <span> - @Duration(run.Record.ElapsedSeconds)</span>
                                    }
                                </div>
                                <div class="small faint mono">@run.Path</div>
                                @if (run.Record.AdapterPath is { } adapterPath)
                                {
                                    <div class="small faint mono">adapters: @adapterPath</div>
                                }
                            </div>
                            <div class="row">
                                <span class="training-chip @(run.Record.Success ? "live" : "")">
                                    @(run.Record.Success ? "ok" : "failed")
                                </span>
                                @if (run.Record.Cached)
                                {
                                    <span class="training-chip live">
                                        cached@(run.Record.CachedPhase is { Length: > 0 } phase ? $" ({phase})" : "")
                                    </span>
                                }
                                @if (run.Record.RecipeHash is { } recipeHash)
                                {
                                    <span class="small faint mono">recipe @ShortHash(recipeHash)</span>
                                }
                                @if (run.Record.PlanId is { } planId)
                                {
                                    <span class="small faint mono">plan @planId @run.Record.RuleSetVersion</span>
                                }
                                <span class="small faint mono">loss @Fmt(run.Record.FinalLoss)</span>
                                @if (run.Record.BestValLoss is { } bestVal)
                                {
                                    <span class="small faint mono">
                                        val @Fmt(bestVal) @@ @run.Record.BestValStep
                                    </span>
                                }
                                @if (run.Record.ExamLoss is { } examLoss)
                                {
                                    <span class="small faint mono">
                                        exam @Fmt(examLoss)
                                        @if (run.Record.ExamPerplexity is { } perplexity)
                                        {
                                            <span> / ppl @perplexity.ToString("0.00")</span>
                                        }
                                        @if (run.Record.ExamBitsPerByte is { } bpb)
                                        {
                                            <span> / bpb @bpb.ToString("0.0000")</span>
                                        }
                                    </span>
                                }
                                @if (ForkLabel(run.Record) is { } forkLabel)
                                {
                                    <span class="training-chip">@forkLabel</span>
                                }
                                <button type="button" class="button" @onclick="() => StartExam(run)"
                                        disabled="@(!CanExamine(run) || Exam.IsRunning)">
                                    Exam
                                </button>
                                <button type="button" class="button" @onclick="() => ForkRun(run)"
                                        disabled="@(!CanFork(run) || Lab.IsRunning || Rehearsal.IsRunning)">
                                    Fork
                                </button>
                                <button type="button" class="button" @onclick="() => UseAsBase(run)"
                                        disabled="@(!CanUseAsBase(run))">
                                    Use as base
                                </button>
                                <button type="button" class="button" @onclick="() => DeleteRun(run)"
                                        disabled="@Lab.IsRunning">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Comparable.Count >= 2)
            {
                <div class="training-compare-picker">
                    <div class="field">
                        <label class="field-label" for="compare-a">Run A</label>
                        <select id="compare-a" class="input" @bind="_compareA">
                            @foreach (TrainingRunSummary run in Comparable)
                            {
                                <option value="@run.Path">@OptionLabel(run)</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label" for="compare-b">Run B</label>
                        <select id="compare-b" class="input" @bind="_compareB">
                            @foreach (TrainingRunSummary run in Comparable)
                            {
                                <option value="@run.Path">@OptionLabel(run)</option>
                            }
                        </select>
                    </div>
                </div>

                @if (CompareA is { } a && CompareB is { } b)
                {
                    <table class="training-compare">
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>@a.Name</th>
                                <th>@b.Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Method</td>
                                <td>@Method(a)</td>
                                <td>@Method(b)</td>
                            </tr>
                            <tr>
                                <td>Steps</td>
                                <td>@a.FinalStep / @a.TotalSteps</td>
                                <td>@b.FinalStep / @b.TotalSteps</td>
                            </tr>
                            <tr>
                                <td>Final loss</td>
                                <td class="@(Lower(a.FinalLoss, b.FinalLoss))">@Fmt(a.FinalLoss)</td>
                                <td class="@(Lower(b.FinalLoss, a.FinalLoss))">@Fmt(b.FinalLoss)</td>
                            </tr>
                            <tr>
                                <td>Best val</td>
                                <td class="@(Lower(a.BestValLoss, b.BestValLoss))">
                                    @Fmt(a.BestValLoss)@StepAt(a.BestValStep)
                                </td>
                                <td class="@(Lower(b.BestValLoss, a.BestValLoss))">
                                    @Fmt(b.BestValLoss)@StepAt(b.BestValStep)
                                </td>
                            </tr>
                            <tr>
                                <td>Exam loss</td>
                                <td class="@(Lower(a.ExamLoss, b.ExamLoss))">
                                    @Fmt(a.ExamLoss)@PerplexityAt(a.ExamPerplexity)
                                </td>
                                <td class="@(Lower(b.ExamLoss, a.ExamLoss))">
                                    @Fmt(b.ExamLoss)@PerplexityAt(b.ExamPerplexity)
                                </td>
                            </tr>
                            <tr>
                                <td>Exam bits/byte</td>
                                <td class="@(Lower(a.ExamBitsPerByte, b.ExamBitsPerByte))">@Fmt(a.ExamBitsPerByte)</td>
                                <td class="@(Lower(b.ExamBitsPerByte, a.ExamBitsPerByte))">@Fmt(b.ExamBitsPerByte)</td>
                            </tr>
                            <tr>
                                <td>Validation split</td>
                                <td>@a.ValidationPercent.ToString("0.#")%</td>
                                <td>@b.ValidationPercent.ToString("0.#")%</td>
                            </tr>
                            <tr>
                                <td>Elapsed</td>
                                <td class="@(Lower(b.ElapsedSeconds, a.ElapsedSeconds))">@Duration(a.ElapsedSeconds)</td>
                                <td class="@(Lower(a.ElapsedSeconds, b.ElapsedSeconds))">@Duration(b.ElapsedSeconds)</td>
                            </tr>
                            <tr>
                                <td>Model</td>
                                <td>@ModelSize(a)</td>
                                <td>@ModelSize(b)</td>
                            </tr>
                            <tr>
                                <td>Profile</td>
                                <td>H@(a.HiddenDim) - batch @a.BatchSize - seq @a.SeqLen</td>
                                <td>H@(b.HiddenDim) - batch @b.BatchSize - seq @b.SeqLen</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="grid-2">
                        <TrainingLossChart Title="@a.Name" Points="@a.Curve"
                                           BestStep="@a.BestValStep" BestLoss="@a.BestValLoss" />
                        <TrainingLossChart Title="@b.Name" Points="@b.Curve"
                                           BestStep="@b.BestValStep" BestLoss="@b.BestValLoss" />
                    </div>

                    <div class="training-actions">
                        <button type="button" class="button primary" @onclick="Promote"
                                disabled="@(!CanPromote)">
                            @PromotionLabel
                        </button>
                        <span class="small faint">
                            Both runs need a held-out exam. The report records the verdict even when A
                            does not win.
                        </span>
                    </div>

                    @if (_promotionSummary is { } promotionSummary)
                    {
                        <div class="small">@promotionSummary</div>
                    }
                    @if (_promotionPath is { } promotionPath)
                    {
                        <div class="small faint mono">Report: @promotionPath</div>
                    }
                }
            }
            else if (Lab.RunHistory.Count >= 2)
            {
                <div class="small faint">
                    Comparison needs two runs that logged at least two curve points.
                </div>
            }
        </div>
    </section>
}
else if (_tab == "models")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">HuggingFace</div>
                <h2>Find GGUF models</h2>
            </div>
            <span class="faint small mono">download to Models</span>
        </div>
        <HuggingFaceBrowser OnDownloaded="OnModelDownloaded" />
    </section>

    <section class="panel training-convert">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Convert</div>
                <h2>Between .smm and GGUF</h2>
            </div>
            <span class="faint small mono">tensors copied verbatim</span>
        </div>
        <div class="panel-body stack">
            <p class="small faint">
                SMM to GGUF exports a SharpMind model for another runtime. GGUF to SMM packages
                a downloaded model so Studio can load it. Nothing is re-quantised: the tensor
                bytes and the tokenizer move across unchanged.
            </p>

            <div class="training-form">
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-pick">Known model files</label>
                    <select id="convert-pick" class="input" value="@_convertSource" @onchange="PickSource">
                        <option value="">Choose a model file...</option>
                        @foreach (FileInfo file in ConvertibleModels)
                        {
                            <option value="@file.FullName">@file.Name - @file.Directory?.Name</option>
                        }
                    </select>
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-source">Source file</label>
                    <input id="convert-source" class="input" @bind="_convertSource" @bind:after="SuggestDestination"
                           placeholder="C:\path\to\model.smm or C:\path\to\model.gguf" />
                </div>
                <div class="field training-form-wide">
                    <label class="field-label" for="convert-destination">Destination file</label>
                    <input id="convert-destination" class="input" @bind="_convertDestination"
                           placeholder="Leave blank to write beside the source" />
                </div>
            </div>

            <div class="training-actions">
                <span class="training-chip live">@DirectionLabel</span>
                <button type="button" class="button primary" @onclick="StartConversion"
                        disabled="@(Convert.IsRunning || !CanConvert || (DestinationExists && !_allowOverwrite))">
                    @(Convert.IsRunning ? "Converting..." : "Convert")
                </button>
                @if (Convert.IsRunning)
                {
                    <button type="button" class="button danger" @onclick="Convert.Cancel">Cancel</button>
                }
                <label class="small faint training-check">
                    <input type="checkbox" @bind="_allowOverwrite" />
                    Overwrite the destination if it exists
                </label>
            </div>

            @if (DestinationExists && !_allowOverwrite)
            {
                <div class="small faint">
                    <span class="mono">@_convertDestination</span> already exists. Tick overwrite to replace it.
                </div>
            }

            @if (Convert.IsRunning || Convert.Result is not null)
            {
                <div class="progress-track">
                    <div class="progress-fill" style="width:@ConvertPercent"></div>
                </div>
                <div class="small faint">@Convert.Status</div>
            }

            @if (Convert.Result is { Success: true } done)
            {
                <div class="small">
                    Saved <span class="mono">@done.DestinationPath</span>
                    - @Megabytes(done.DestinationBytes) MB in @done.Elapsed.TotalSeconds.ToString("0.0")s,
                    validated as @done.Label.
                </div>
            }
            else if (Convert.Error is { } conversionError)
            {
                <div class="error-line">@conversionError</div>
            }

            @if (_convertError is { } localError)
            {
                <div class="error-line">@localError</div>
            }
        </div>
    </section>

    <section class="panel training-section">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Model files</div>
                <h2>Models</h2>
            </div>
            <a class="button" href="/settings?tab=models">Model settings</a>
        </div>
        <div class="panel-body stack">
            @if (Models.Count == 0)
            {
                <div class="empty">No model files yet. Finished runs export an <span class="mono">.smm</span> or <span class="mono">.smlora</span> here, and conversions land beside their source.</div>
            }
            else
            {
                <div class="training-jobs">
                    @foreach (FileInfo file in Models)
                    {
                        <div class="training-job">
                            <div>
                                <strong class="mono">@file.Name</strong>
                                <div class="small faint">@file.FullName</div>
                            </div>
                            <div class="row">
                                <span class="training-chip">@file.Extension.TrimStart('.').ToUpperInvariant()</span>
                                <span class="small faint mono">@Megabytes(file.Length) MB</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <p class="small faint">
                A model version is a float master plus derived quant builds per device profile.
                Quantised builds are outputs and never training roots.
            </p>
        </div>
    </section>
}

