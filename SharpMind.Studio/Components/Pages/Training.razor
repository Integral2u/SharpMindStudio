                                <strong class="mono">@run.Record.Name</strong>
                                <div class="small faint">
                                    @Method(run.Record)
                                    - @run.Record.FinishedUtc.ToLocalTime().ToString("dd MMM HH:mm")
                                    - step @run.Record.FinalStep / @run.Record.TotalSteps
                                    @if (run.Record.ElapsedSeconds > 0)
                                    {
                                        <span> - @Duration(run.Record.ElapsedSeconds)</span>
                                    }
                                </div>
                                <div class="small faint mono">@run.Path</div>
