    private async Task SwitchModelAsync(ChangeEventArgs args)
    {
        string? choice = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(choice)
            || string.Equals(choice, CurrentModelChoice, StringComparison.Ordinal)
            || ChatService.IsStreaming || ChatService.IsLoading)
        {
            return;
        }

        if (ChatService.Document?.Provider == "local")
        {
            ModelDescriptor? model = _models.FirstOrDefault(value =>
                value.Path == choice);
            if (model is null) return;

            await ChatService.SwitchLocalModelAsync(model);
            _selectedModelPath = model.Path;
            await Theme.SetLastChatModelAsync(model.Path);
        }
        else
        {
            await ChatService.SwitchRemoteModelAsync(choice);
            _remoteModel = choice;
        }

        SyncFromChat();
        RefreshTuneSelection();
        UpdateLatestModelRun();
    }

    private IReadOnlyList<(string Value, string Label)> ModelChoices()
    {
        var choices = new List<(string Value, string Label)>();
        if (ChatService.Document?.Provider == "local")
        {
            foreach (ModelDescriptor model in _models)
                choices.Add((model.Path, $"{model.DisplayName} ({model.FileName})"));
        }
        else if (_computeProviderId is { } hostId)
        {
            ComputeProvider? host = Compute.Resolve(hostId);
            foreach (string model in host?.Models ?? [])
                choices.Add((model, model));
        }
        else
        {
            foreach (string model in RemoteActiveModels)
                choices.Add((model, model));
        }

        string current = CurrentModelChoice;
        if (current.Length > 0 && choices.All(choice => choice.Value != current))
            choices.Insert(0, (current, current));
        return choices;
    }

