    private void SaveRemoteModelChoice()
    {
        if (string.IsNullOrWhiteSpace(_remoteModel)) return;
        if (_computeProviderId is { } id)
            Compute.RememberModel(id, _remoteModel);
        else
            OpenRouter.SetDefaultModelFor(_remoteProviderId, _remoteModel);
    }

    private void UpdateLatestModelRun()
    {
        if (_remoteChat)
        {
            _latestModelRun = null;
            _toolState = new ToolCapabilityState(ToolCapability.Untested, null, null);
            return;
        }

        string? fileName = SelectedFileName;
        _latestModelRun = fileName is null
            ? null
            : RunInsights.LatestBench(_runs, _selectedModelPath, fileName);

        TuneMeasurement? work = string.IsNullOrWhiteSpace(_selectedModelPath)
            ? null
            : Inference.TuneProfile(_selectedModelPath, TuneTarget.Work, TunePreset.Balanced)?.Measurement;
        _toolState = RunInsights.ResolveToolCapability(_selectedModelPath, fileName, _runs, work);
    }

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "unknown",
    };

    private static string ToolClass(string status) => status switch
    {
        "Yes" => "ok",
        "No" => "failed",
        _ => "unknown",
    };

    private string FormatCost(decimal cost)
    {
        string? currency = ChatService.LastCostCurrency;
        if (string.IsNullOrWhiteSpace(currency) && ChatService.IsOpenRouter)
            currency = RemoteProviders.Find(ChatService.RemoteProviderId).Currency;

        return string.IsNullOrWhiteSpace(currency)
            ? cost.ToString("0.000000")
            : $"{cost:0.000000} {currency}";
    }
    /// <summary>
    /// Starts a blank session on a clean route. Closing the open document and
    /// leaving the /chat/{id} or /work/{id} URL is what makes the session links
    /// in the sidebar work again; keeping the old URL meant clicking the current
    /// chat changed nothing.
    /// </summary>
    private async Task BeginNewChatAsync()
    {
        if (ChatService.IsStreaming || ChatService.IsLoading) return;

        _startingNew = true;
        _focusPending = true;
        _showOptions = false;
        _input = "";
        _pendingArtifacts.Clear();
        _contextPaths.Clear();
        _commandPaletteOpen = false;
        _commandCandidates = [];
        _commandError = null;
        _commandStatus = null;
        _contextPaletteOpen = false;
        _contextCandidates = [];
        _contextFromToken = false;

        if (ChatService.Document is { } current &&
            string.Equals(current.Provider, "openrouter", StringComparison.OrdinalIgnoreCase))
        {
            _remoteChat = true;
            _computeProviderId = null;
            _remoteProviderId = ChatService.RemoteProviderId ?? RemoteProviders.OpenRouter;
            _remoteModel = current.RemoteModel ?? _remoteModel;
            await Theme.SetLastRemoteProviderAsync(_remoteProviderId);
        }
        else if (ChatService.Document is { } local)
        {
            _remoteChat = false;
            _computeProviderId = null;
            _selectedModelPath = local.ModelPath;
        }
        else
        {
            ApplyLastRemoteProvider();
        }

        if (string.IsNullOrWhiteSpace(_selectedModelPath) || _selectedModelPath == "openrouter")
        {
            _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path;
        }

        ChatService.Stop();
        await ChatService.CloseAsync();
        Nav.NavigateTo(_workMode ? "/work" : "/chat");
        UpdateLatestModelRun();
    }

    /// <summary>
    /// New chats open on the remote provider used most recently, with that
    /// provider's last selected model. A provider whose key was deleted falls
    /// back to a local model instead of an unusable remote form.
    /// </summary>
    private void ApplyLastRemoteProvider()
    {
        string? last = Theme.LastRemoteProvider;
        _remoteChat = RemoteProviders.IsRemote(last) && OpenRouter.HasApiKeyFor(last);
        _remoteProviderId = _remoteChat
            ? RemoteProviders.NormalizeId(last)
            : RemoteProviders.OpenRouter;
        _remoteModel = _remoteChat
            ? OpenRouter.DefaultModelFor(_remoteProviderId) ??
              OpenRouter.ActiveModelsFor(_remoteProviderId).FirstOrDefault() ?? ""
            : "";
    }

    private void OpenRouterSettings() => Nav.NavigateTo("/settings?tab=openrouter");

    private async Task SetProvider(ChangeEventArgs args)
    {
        string value = args.Value?.ToString() ?? "local";
        if (value.StartsWith("compute:", StringComparison.OrdinalIgnoreCase))
        {
            _computeProviderId = value["compute:".Length..];
            _remoteChat = true;
            _workMode = false;
            ComputeProvider? host = Compute.Resolve(_computeProviderId);
            _remoteModel = host?.DefaultModel ?? host?.Models.FirstOrDefault() ?? "";
            if (host is { IsUsable: true } && host.Models.Count == 0)
            {
                try
                {
                    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(20));
                    await Compute.RefreshModelsAsync(_computeProviderId, timeout.Token);
                    host = Compute.Resolve(_computeProviderId);
                    _remoteModel = host?.DefaultModel ?? host?.Models.FirstOrDefault() ?? _remoteModel;
                }
                catch
                {
                    // The Settings provider panel explains an unreachable host.
                }
            }
        }
        else
        {
            _computeProviderId = null;
            _remoteChat = RemoteProviders.IsRemote(value);
            if (_remoteChat)
            {
                _remoteProviderId = RemoteProviders.NormalizeId(value);
                _remoteModel = OpenRouter.DefaultModelFor(_remoteProviderId) ??
                               OpenRouter.ActiveModelsFor(_remoteProviderId).FirstOrDefault() ?? "";
            }
        }

        UpdateLatestModelRun();
        RefreshTuneSelection();
        await Theme.SetLastRemoteProviderAsync(
            _remoteChat && _computeProviderId is null ? _remoteProviderId : null);
        await InvokeAsync(StateHasChanged);
        if (_remoteChat && _computeProviderId is null)
            await EnsureActiveModels();
    }

    private async Task EnsureActiveModels()
    {
        if (!_remoteChat || !RemoteHasApiKey) return;

        // Only OpenRouter seeds free models. The other routers start with the
        // default model from their preset and the user adds the rest in Settings.
        if (_remoteProviderId == RemoteProviders.OpenRouter &&
            (OpenRouter.ActiveModelsFor(_remoteProviderId).Count == 0 ||
             !OpenRouter.FreeModelsSeededFor(_remoteProviderId)))
        {
            try
            {
                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                await OpenRouter.SeedDefaultModelsForAsync(_remoteProviderId, timeout.Token);
            }
            catch
            {
                // The status/error area below explains an empty or failed fetch.
            }
        }

        IReadOnlyList<string> models = OpenRouter.ActiveModelsFor(_remoteProviderId);
        if (!models.Any(model =>
                model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase)))
        {
            _remoteModel = OpenRouter.DefaultModelFor(_remoteProviderId) ??
                           models.FirstOrDefault() ?? "";
        }

        await InvokeAsync(StateHasChanged);
    }


    private void RefreshTuneSelection()
    {
        if (_remoteChat)
        {
            _selectedTunePreset = null;
            return;
        }

        TuneTarget target = _workMode ? TuneTarget.Work : TuneTarget.Chat;
        if (string.IsNullOrWhiteSpace(_selectedModelPath) || !Inference.HasTune(_selectedModelPath, target))
        {
            _selectedTunePreset = null;
            return;
        }

        if (_selectedTunePreset is null ||
            Inference.TuneProfile(_selectedModelPath, target, _selectedTunePreset.Value) is null)
            _selectedTunePreset = TunePreset.Balanced;
    }

