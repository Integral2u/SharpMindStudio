@page "/chat"
@page "/chat/{ChatId}"
@implements IDisposable
@using SharpMind.Inference.Chat
@using SharpMind.Studio.Core.Chat
@using SharpMind.Studio.Core.Compute
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Core.Runs
@using SharpMind.Studio.Core.Training
@using SharpMind.Studio.Core.Work
@using SharpMind.Studio.Services
@using System.Text
@inject StudioChatService ChatService
@inject InferenceSettingsService Inference
@inject OpenRouterSettingsService OpenRouter
@inject ComputeProviderService Compute
@inject ModelCatalogService Catalog
@inject MarkdownService Markdown
@inject StudioWorkspaceService Workspace
@inject StudioWorkService Work
@inject StudioSafetyService Safety
@inject StudioDeviceAccess DeviceAccess
@inject ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PathPickerService Picker

<PageTitle>@(_workMode ? "Work" : "Chat") - SharpMind Studio</PageTitle>

@if (_workMode)
{
    <WorkProjectPanel />
}

    <section class="panel chat-main">
        @if (ChatService.IsLoading)
        {
            <div class="load-panel" style="margin: 1rem 1.2rem 0;">
                <div class="load-panel-row">
                    <span class="spinner-ring"></span>
                    <span>@ChatService.LoadDetail</span>
                    <span class="mono">@LoadPercent</span>
                    <button type="button" class="button" @onclick="ChatService.Interrupt">Interrupt</button>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width:@LoadPercent"></div></div>
            </div>
        }

        @if (_startingNew || ChatService.Document is null)
        {
            <div class="panel-head">
                <div>
                    <div class="eyebrow">@(_workMode ? "New work conversation" : "New conversation")</div>
                    <h2>@(_workMode ? "What should we work on?" : "What do you want to ask?")</h2>
                </div>
                <div class="row">
                    <span class="faint small mono">@(_workMode ? "local or remote" : "local, remote or Compute")</span>
                    <WikiGuideLink Page="inference" Label="Chat guide" />
                </div>
            </div>
            <div class="panel-body stack">
                <div class="composer-shell">
                    @if (_pendingArtifacts.Count > 0)
                    {
                        <div class="composer-chip-row">
                            @foreach (ChatArtifact artifact in _pendingArtifacts.Take(3))
                            {
                                <span class="composer-chip" title="@(artifact.FileName ?? artifact.Type)">
                                    <span class="name">@(artifact.FileName ?? artifact.Type)</span>
                                    <button type="button" title="Remove attachment"
                                            @onclick="() => RemoveArtifact(artifact)">&times;</button>
                                </span>
                            }
                            @if (_pendingArtifacts.Count > 3)
                            {
                                <button type="button" class="composer-overflow"
                                        @onclick="() => _showOverflow = !_showOverflow"
                                        title="More attachments">
                                    @(_showOverflow ? "−" : "…")
                                </button>
                            }
                        </div>
                        @if (_showOverflow && _pendingArtifacts.Count > 3)
                        {
                            <div class="composer-chip-row composer-overflow-list">
                                @foreach (ChatArtifact artifact in _pendingArtifacts.Skip(3))
                                {
                                    <span class="composer-chip" title="@(artifact.FileName ?? artifact.Type)">
                                        <span class="name">@(artifact.FileName ?? artifact.Type)</span>
                                        <button type="button" title="Remove attachment"
                                                @onclick="() => RemoveArtifact(artifact)">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                    }
                    @if (_commandPaletteOpen)
                    {
                        <div class="command-palette" role="listbox" aria-label="Chat commands">
                            @if (_commandCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No command matches. Type /help for the list.</div>
                            }
                            else
                            {
                                @for (int index = 0; index < _commandCandidates.Count; index++)
                                {
                                    int itemIndex = index;
                                    ChatCommandDefinition command = _commandCandidates[index];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _commandIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _commandIndex)"
                                            @onmouseenter="() => _commandIndex = itemIndex"
                                            @onclick="() => SelectCommandAsync(command)">
                                        <span class="command-palette-name">@command.Usage</span>
                                        <span class="command-palette-description">@command.Description</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (_contextPaletteOpen)
                    {
                        <div class="command-palette context-palette" role="listbox" aria-label="Add context">
                            @if (_contextCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No context option matches.</div>
                            }
                            else
                            {
                                @for (int contextIndex = 0; contextIndex < _contextCandidates.Count; contextIndex++)
                                {
                                    int itemIndex = contextIndex;
                                    ContextChoice contextChoice = _contextCandidates[contextIndex];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _contextIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _contextIndex)"
                                            @onmouseenter="() => _contextIndex = itemIndex"
                                            @onclick="() => SelectContextAsync(contextChoice)">
                                        <span class="command-palette-name">@contextChoice.Label</span>
                                        <span class="command-palette-description">@contextChoice.Description</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (_skillPaletteOpen)
                    {
                        <div class="command-palette context-palette" role="listbox" aria-label="Add a skill">
                            @if (_skillCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No enabled skills are available.</div>
                            }
                            else
                            {
                                @for (int skillIndex = 0; skillIndex < _skillCandidates.Count; skillIndex++)
                                {
                                    int itemIndex = skillIndex;
                                    SkillChoice skillChoice = _skillCandidates[skillIndex];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _skillIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _skillIndex)"
                                            @onmouseenter="() => _skillIndex = itemIndex"
                                            @onclick="() => SelectSkillAsync(skillChoice)">
                                        <span class="command-palette-name">@skillChoice.Skill.Name</span>
                                        <span class="command-palette-description">@skillChoice.Source</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    <textarea id="chat-new-input" class="welcome-prompt chat-new-prompt"
                              value="@_input"
                              @oninput="OnComposerInput"
                              @onkeydown="OnComposerKeyDown"
                              placeholder="@(_workMode ? "Describe the task, or leave this empty to start a blank Work chat. Type / for commands or @ for context." : "Ask something, or leave this empty to start a blank chat. Type / for commands or @ for context.")"></textarea>
                    <div class="composer-actions">
                        @if (_computeProviderId is null && !ChatService.IsStreaming && !ChatService.IsLoading)
                        {
                            <label class="button chat-attach-button" title="Attach an image, audio file or document">
                                Attach
                                <InputFile OnChange="OnFilesSelected" multiple class="chat-attach-input" />
                            </label>
                        }
                        <button id="chat-start" type="button" class="button primary composer-send"
                                @onclick="SendCommandOrMessageAsync"
                                disabled="@(ChatService.IsStreaming || ChatService.IsLoading ||
                                            (_workMode && !_remoteChat && _toolState.Capability != ToolCapability.Passed && !_allowUnverifiedTools))">
                            Send
                        </button>
                    </div>
                </div>

                @if (_commandError is not null)
                {
                    <div class="error-line command-result">@_commandError</div>
                }
                else if (_commandStatus is not null)
                {
                    <div class="small faint command-result">@_commandStatus</div>
                }

                <div class="welcome-controls chat-welcome-controls">
                    <div class="field">
                        <label class="field-label" for="chat-provider">Provider</label>
                        <select id="chat-provider" class="input" @onchange="SetProvider">
                            <option value="local" selected="@(!_remoteChat)">Local model</option>
                            @{
                                List<RemoteProviderPreset> configuredProviders =
                                    [.. RemoteProviders.All.Where(provider => OpenRouter.HasApiKeyFor(provider.Id))];
                                List<RemoteProviderPreset> availableProviders =
                                    [.. RemoteProviders.All.Where(provider => !OpenRouter.HasApiKeyFor(provider.Id))];
                            }
                            @if (configuredProviders.Count > 0)
                            {
                                <optgroup label="Configured">
                                    @foreach (RemoteProviderPreset provider in configuredProviders)
                                    {
                                        <option value="@provider.Id"
                                                selected="@(_remoteChat && _computeProviderId is null && _remoteProviderId == provider.Id)">
                                            @provider.Name@(provider.Beta ? " (beta)" : "")
                                        </option>
                                    }
                                </optgroup>
                            }
                            @if (availableProviders.Count > 0)
                            {
                                <optgroup label="Available">
                                    @foreach (RemoteProviderPreset provider in availableProviders)
                                    {
                                        <option value="@provider.Id"
                                                selected="@(_remoteChat && _computeProviderId is null && _remoteProviderId == provider.Id)">
                                            @provider.Name@(provider.Beta ? " (beta)" : "")
                                        </option>
                                    }
                                </optgroup>
                            }
                            @if (Compute.Providers.Count > 0)
                            {
                                <optgroup label="Compute hosts">
                                    @foreach (ComputeProviderSettings host in Compute.Providers)
                                    {
                                        <option value="@($"compute:{host.Id}")" selected="@(_computeProviderId == host.Id)"
                                                title="@ComputeProviderPrefabs.Find(host.Prefab).Description">
                                            @host.Name
                                        </option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    @if (!_remoteChat)
                    {
                        @if (_loadingModels)
                        {
                            <div class="field"><span class="status-line">Scanning model folder...</span></div>
                        }
                        else if (_models.Count == 0)
                        {
                            <div class="field"><span class="status-line">No models found under @Workspace.ModelsFolder.</span></div>
                        }
                        else
                        {
                            <div class="field">
                                <div class="field-label-row">
                                    <label class="field-label" for="chat-model">Model</label>
                                    <a class="small" href="/training?tab=models"
                                       title="Find GGUF models on HuggingFace">Find models</a>
                                </div>
                                <select id="chat-model" class="input" @bind="_selectedModelPath" @bind:after="SaveModelChoiceAsync">
                                    @foreach (var model in _models)
                                    {
                                        <option value="@model.Path" title="@model.Path">@model.DisplayName (@model.FileName) - @model.Family.DisplayName (@FileSize(model.SizeBytes))</option>
                                    }
                                </select>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="field">
                            <div class="field-label-row">
                                <label class="field-label" for="chat-remote-model">Model</label>
                                @if (_computeProviderId is null && RemotePreset.Beta)
                                {
                                    <span class="beta-pill">beta</span>
                                }
                            </div>
                            @if (_computeProviderId is not null)
                            {
                                ComputeProvider? host = Compute.Resolve(_computeProviderId);
                                <select id="chat-remote-model" class="input" @bind="_remoteModel"
                                        @bind:after="SaveRemoteModelChoice">
                                    @if (host is null || host.Models.Count == 0)
                                    {
                                        <option value="">@(host is null ? "No host selected" : "No models on this host")</option>
                                    }
                                    @foreach (string model in host?.Models ?? [])
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                                <a class="small" href="/settings?tab=openrouter">Manage hosts and models</a>
                            }
                            else
                            {
                                <select id="chat-remote-model" class="input" @bind="_remoteModel"
                                        @bind:after="SaveRemoteModelChoice"
                                        @onfocus="EnsureActiveModels">
                                    @if (RemoteActiveModels.Count == 0)
                                    {
                                        <option value="">@(RemoteHasApiKey ? "Loading models..." : "No active models")</option>
                                    }
                                    @foreach (string model in RemoteActiveModels)
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </select>
                                @if (RemoteActiveModels.Count == 0)
                                {
                                    <a class="small" href="/settings?tab=openrouter">Add models in Settings</a>
                                }
                            }
                        </div>
                    }
                </div>

                @if (_remoteChat && _computeProviderId is null)
                {
                    <div class="welcome-model-status">
                        <span class="small faint">
                            @(RemoteHasApiKey ? $"{RemotePreset.Name} key configured" : $"No {RemotePreset.Name} key")
                        </span>
                    </div>
                    @if (!RemoteHasApiKey)
                    {
                        <div class="tool-warning">
                            <div>
                                <strong>@RemotePreset.Name needs an API key.</strong>
                                <span class="small faint">Add it in Settings, then return here.</span>
                            </div>
                            <div class="row">
                                <button type="button" class="button" @onclick="OpenRouterSettings">Open Settings</button>
                                @if (RemotePreset.HasSignup)
                                {
                                    <a class="button" href="@RemotePreset.SignupUrl" target="_blank"
                                       rel="sponsored noopener">Sign up</a>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="small faint">
                            Chat uses the selected remote model. Work keeps the local project tools;
                            only the model runs remotely. @RemotePreset.Name models are inference-only, so
                            local tuning is unavailable.
                        </div>
                    }
                }
                else if (_remoteChat && _computeProviderId is { } hostId)
                {
                    ComputeProvider? host = Compute.Resolve(hostId);
                    <div class="welcome-model-status">
                        <span class="small faint">
                            @(host is { IsUsable: true } ? $"{host.Name} ready" : "This host needs a token")
                        </span>
                    </div>
                    @if (host is null || !host.IsUsable)
                    {
                        <div class="tool-warning">
                            <div>
                                <strong>This Compute host needs a token.</strong>
                                <span class="small faint">Open Settings to set its URL and token.</span>
                            </div>
                            <div class="row">
                                <button type="button" class="button" @onclick="OpenRouterSettings">Manage hosts</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="small faint">
                            Inference runs on @host.Name. Work tools need a local model or a remote provider; Compute is inference-only.
                        </div>
                    }
                }
                else if (!_loadingModels && _models.Count > 0)
                {
                    <div class="welcome-model-status">
                        @if (_latestModelRun is not null)
                        {
                            <span class="status @StatusClass(_latestModelRun.Status)">@_latestModelRun.Status</span>
                        }
                        <ModelToolStatus ModelPath="_selectedModelPath" FileName="@SelectedFileName" Runs="_runs" />
                    </div>
                    <div class="status-line">@ChatService.Status</div>
                    @if (!string.IsNullOrWhiteSpace(_selectedModelPath))
                    {
                        <TunePresetPicker ModelPath="_selectedModelPath"
                                          Target="@(_workMode ? TuneTarget.Work : TuneTarget.Chat)"
                                          SelectedPreset="_selectedTunePreset"
                                          SelectedPresetChanged="p => _selectedTunePreset = p"
                                          OnTune="OpenTune" />
                    }
                    @if (_workMode && _toolState.Capability != ToolCapability.Passed)
                    {
                        <div class="tool-warning">
                            <div>
                                <strong>Tools are not verified for this model.</strong>
                                <span class="small faint">Work mode depends on tool calling. Test it before relying on Work.</span>
                            </div>
                            <div class="row">
                                <button type="button" class="button" @onclick="OpenTune">Test tools</button>
                                <label class="tool-toggle">
                                    <input type="checkbox" @bind="_allowUnverifiedTools" />
                                    <span>Start anyway</span>
                                </label>
                            </div>
                        </div>
                    }
                }
                @if (ChatService.Error is not null)
                {
                    <div class="error-line">@ChatService.Error</div>
                }
            </div>
        }        else
        {
            <div class="panel-head chat-head">
                <div>
                    <div class="eyebrow">
                        @if (ChatService.IsRemote)
                        {
                            <text>@ChatService.RemoteProviderName | @ChatService.RemoteModel</text>
                        }
                        else
                        {
                            <text>@ChatService.Model?.Family.DisplayName | @ChatService.Model?.FileName</text>
                        }
                    </div>
                    <h2>@if (DeviceAccess.IsMobile)
{
    @ChatService.Document.Name
}
else
{
    <button type="button" class="chat-title-button" @onclick="RenameCurrentChatAsync"
            title="Rename chat">@ChatService.Document.Name <span class="faint">&#9998;</span></button>
}</h2>
                    @if (!ChatService.IsRemote)
                    {
                        <div class="row" style="margin-top: .35rem;">
                            <ModelToolStatus ModelPath="_selectedModelPath" FileName="@SelectedFileName" Runs="_runs" />
                        </div>
                    }
                    else
                    {
                        <div class="row" style="margin-top: .35rem; gap: .5rem; align-items: center;">
                            <span class="provider-dot @(ChatService.OpenRouterConfigured ? "on" : "off")"></span>
                            <span class="small faint mono">@ChatService.RemoteModel</span>
                            @if (ChatService.LastTokensPerSecond is { } tps)
                            {
                                <span class="small faint">@tps.ToString("F1") tok/s</span>
                            }
                            @if (ChatService.LastToolCalls is > 0 and var toolCalls)
                            {
                                <span class="small faint">@toolCalls tool call(s)</span>
                            }
                            @if (ChatService.LastCost is { } cost)
                            {
                                <span class="small faint">@FormatCost(cost)</span>
                            }
                        </div>
                    }
                </div>
                @if (!DeviceAccess.IsMobile)
                {
                    <div class="row">
                        <select class="input chat-model-select" @onchange="SwitchModelAsync"
                                disabled="@(ChatService.IsStreaming || ChatService.IsLoading)"
                                title="Switch model. The transcript stays; the next turn uses the new model.">
                            @foreach (var (value, label) in ModelChoices())
                            {
                                <option value="@value" selected="@(value == CurrentModelChoice)">@label</option>
                            }
                        </select>
                        @if (!ChatService.IsRemote)
                        {
                            <button type="button" class="button" @onclick="ToggleOptions">
                                @(_showOptions ? "Hide options" : "Options")
                            </button>
                        }
                        @if (!_workMode)
                        {
                            <button type="button" class="button" @onclick="BeginNewChatAsync">New chat</button>
                        }
                    </div>
                }
            </div>

            <div id="chat-transcript" class="chat-transcript">
                @if (_messages.Count == 0)
                {
                    <div class="empty">
                        @(ChatService.IsRemote
                            ? "Send the first message. Only the model runs remotely."
                            : "Send the first message. The model stays on this machine.")
                    </div>
                }
                else
                {
                    @for (int i = 0; i < _messages.Count; i++)
                    {
                        ChatMessage message = _messages[i];
                        bool streaming = ChatService.IsStreaming && i == _messages.Count - 1 && message.Role == ChatRole.Agent;
                        <div class="chat-message @message.Role.ToString().ToLowerInvariant()">
                            <div class="chat-message-meta">
                                <span>@(message.Role == ChatRole.User ? "You" : message.Name ?? "Model")</span>
                                <span>@message.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                @if (message.Role == ChatRole.Agent && !streaming && i == _messages.Count - 1 && ChatService.LastTokensPerSecond is { } tps)
                                {
                                    <span>@tps.ToString("F1") tok/s</span>
                                }
                            </div>
                            @if (message.Role == ChatRole.Agent)
                            {
                                @if (streaming)
                                {
                                    <div class="chat-text chat-streaming">@message.Content</div>
                                }
                                else if (ShowAgentText(message) || message.Artifacts is { Length: > 0 })
                                {
                                    <div class="chat-text markdown">
                                        @if (!string.IsNullOrWhiteSpace(message.Content))
                                        {
                                            <button type="button" class="chat-copy"
                                                    data-copy="@message.Content"
                                                    onclick="studioChat.copyFrom(this)"
                                                    title="Copy message"
                                                    aria-label="Copy message">
                                                <svg class="copy-glyph" viewBox="0 0 16 16" width="14" height="14"
                                                     fill="none" stroke="currentColor" stroke-width="1.3"
                                                     stroke-linecap="round" stroke-linejoin="round"
                                                     aria-hidden="true">
                                                    <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                                                    <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
                                                </svg>
                                                <span class="copy-done" aria-hidden="true">&#10003;</span>
                                            </button>
                                        }
                                        @if (message.Artifacts is { Length: > 0 })
                                        {
                                            <ChatArtifacts Artifacts="message.Artifacts" />
                                        }
                                        @if (ShowAgentText(message))
                                        {
                                            @((MarkupString)Markdown.ToHtml(message.Content))
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="chat-text">
                                    @if (!string.IsNullOrWhiteSpace(message.Content))
                                    {
                                        <button type="button" class="chat-copy"
                                                data-copy="@message.Content"
                                                onclick="studioChat.copyFrom(this)"
                                                title="Copy message"
                                                aria-label="Copy message">
                                            <svg class="copy-glyph" viewBox="0 0 16 16" width="14" height="14"
                                                 fill="none" stroke="currentColor" stroke-width="1.3"
                                                 stroke-linecap="round" stroke-linejoin="round"
                                                 aria-hidden="true">
                                                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                                                <path d="M10.5 5.5V3.5A1.5 1.5 0 0 0 9 2H3.5A1.5 1.5 0 0 0 2 3.5V9a1.5 1.5 0 0 0 1.5 1.5h2" />
                                            </svg>
                                            <span class="copy-done" aria-hidden="true">&#10003;</span>
                                        </button>
                                    }
                                    @if (message.Artifacts is { Length: > 0 })
                                    {
                                        <ChatArtifacts Artifacts="message.Artifacts" />
                                    }
                                    @message.Content
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            @if (_showOptions && !DeviceAccess.IsMobile && !ChatService.IsRemote)
            {
                <div class="chat-options">
                    <div class="panel-head">
                        <div>
                            <div class="eyebrow">Session options</div>
                            <h2>Overrides</h2>
                        </div>
                        <span class="faint small mono">empty fields inherit</span>
                    </div>
                    <div class="panel-body stack">
                        <InferenceProfileEditor Value="_sessionDraft" ValueChanged="v => _sessionDraft = v"
                                                AllowInherit="true"
                                                Sources="ChatService.Resolved?.Sources"
                                                Effective="ChatService.Resolved"
                                                Generators="Workspace.Builders.Generators"
                                                Caches="Workspace.Builders.Caches" />

                        <div class="panel-head" style="margin-top:.75rem">
                            <div>
                                <div class="eyebrow">Tools</div>
                                <h2>Tool permissions</h2>
                            </div>
                            <span class="faint small mono">empty rows inherit</span>
                        </div>
                        <ToolPermissionEditor Value="_sessionToolsDraft"
                                              ValueChanged="v => _sessionToolsDraft = v"
                                              AllowInherit="true"
                                              Effective="SessionToolsEffective" />

                        <CommandAccessEditor Scope="session"
                                             FamilyId="@ChatService.Document?.FamilyId"
                                             ModelPath="@ChatService.Document?.ModelPath" />

                        @if (_embeddedTools.Count > 0)
                        {
                            <div class="panel-head" style="margin-top:.75rem">
                                <div>
                                    <div class="eyebrow">Embedded</div>
                                    <h2>Tools in this model</h2>
                                </div>
                                <span class="faint small mono">off by default, remembered per model</span>
                            </div>
                            <p class="small faint">
                                These tools live inside the .smm. A different model has its own
                                entries, so enabling one here never turns on a tool in another file.
                                Loading an assembly runs its code in Studio and cannot be undone
                                until Studio restarts; the safety inspector still checks every call.
                            </p>
                            @foreach (IGrouping<string, EmbeddedToolInfo> group in _embeddedTools.GroupBy(tool => tool.Assembly))
                            {
                                <div class="work-tool-group">
                                    <div class="spread work-tool-group-head">
                                        <div class="eyebrow">@group.Key</div>
                                        <span class="tool-badge is-embedded">embedded</span>
                                    </div>
                                    <div class="work-tools">
                                        @foreach (EmbeddedToolInfo tool in group)
                                        {
                                            <div class="work-tool-row">
                                                <span class="work-tool-name">
                                                    @tool.Tool
                                                    @if (tool.StartsProcesses)
                                                    {
                                                        <span class="tool-badge is-process">process</span>
                                                    }
                                                </span>
                                                <div class="segmented" role="group" aria-label="@tool.Tool">
                                                    <button type="button"
                                                            class="segmented-option is-off @(IsEmbeddedToolOn(tool.Tool) ? "" : "active")"
                                                            @onclick="() => SetEmbeddedTool(tool.Tool, false)">
                                                        Off
                                                    </button>
                                                    <button type="button"
                                                            class="segmented-option is-always @(IsEmbeddedToolOn(tool.Tool) ? "active" : "")"
                                                            @onclick="() => SetEmbeddedTool(tool.Tool, true)">
                                                        On
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }

                        <div class="panel-head" style="margin-top:.75rem">
                            <div>
                                <div class="eyebrow">Speech</div>
                                <h2>LFM3-Audio TTS</h2>
                            </div>
                            <span class="faint small mono">empty fields use the checkpoint defaults</span>
                        </div>
                        <div class="row">
                            <div class="field">
                                <label class="field-label">Voice</label>
                                <select class="input" value="@(_sessionDraft.TtsVoice ?? "female")"
                                        @onchange="e => _sessionDraft = _sessionDraft with { TtsVoice = e.Value?.ToString() }">
                                    <option value="female">female</option>
                                    <option value="male">male</option>
                                </select>
                            </div>
                            <div class="field grow">
                                <label class="field-label">Language</label>
                                <input class="input" value="@(_sessionDraft.TtsLanguage ?? "American English")"
                                       @onchange="e => _sessionDraft = _sessionDraft with { TtsLanguage = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }" />
                            </div>
                            <div class="field">
                                <label class="field-label">Max frames (80 ms each)</label>
                                <input class="input" type="number" min="1" max="512"
                                       value="@(_sessionDraft.TtsMaxFrames ?? 128)"
                                       @onchange="e => _sessionDraft = _sessionDraft with { TtsMaxFrames = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="field">
                                <label class="field-label">Temperature</label>
                                <input class="input" type="number" min="0.1" max="3" step="0.05"
                                       value="@(_sessionDraft.TtsTemperature ?? 1.0f)"
                                       @onchange="e => _sessionDraft = _sessionDraft with { TtsTemperature = float.TryParse(e.Value?.ToString(), out float value) ? value : null }" />
                            </div>
                            <div class="field">
                                <label class="field-label">Top-k</label>
                                <input class="input" type="number" min="1" max="1024"
                                       value="@(_sessionDraft.TtsTopK ?? 128)"
                                       @onchange="e => _sessionDraft = _sessionDraft with { TtsTopK = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                            </div>
                            <div class="field">
                                <label class="field-label">Seed (blank = random)</label>
                                <input class="input" type="number"
                                       value="@_sessionDraft.TtsSeed"
                                       @onchange="e => _sessionDraft = _sessionDraft with { TtsSeed = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                            </div>
                        </div>
                        <div class="small faint">
                            The LFM3-Audio checkpoint is trained on a female voice; male is
                            available but less consistently covered. Empty fields keep the
                            checkpoint defaults (female, American English, 128 frames).
                        </div>

                        <div class="panel-head" style="margin-top:.75rem">
                            <div>
                                <div class="eyebrow">Vision</div>
                                <h2>LFM3-VL</h2>
                            </div>
                            <span class="faint small mono">only when an mmproj is present</span>
                        </div>
                        <div class="row">
                            <div class="field">
                                <label class="field-label">Image max side (px)</label>
                                <input class="input" type="number" min="128" max="1536" step="32"
                                       value="@(_sessionDraft.VisionMaxSide ?? 512)"
                                       @onchange="e => _sessionDraft = _sessionDraft with { VisionMaxSide = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                            </div>
                            <div class="field">
                                <label class="field-label">Answer max tokens</label>
                                <input class="input" type="number" min="16" max="1024"
                                       value="@(_sessionDraft.VisionMaxTokens ?? 128)"
                                       @onchange="e => _sessionDraft = _sessionDraft with { VisionMaxTokens = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                            </div>
                        </div>
                        <div class="small faint">
                            The image is resized to this longest side (rounded to 32 px). More
                            pixels mean more image tokens and a slower encode.
                        </div>

                        <div class="row">
                            <button type="button" class="button primary" @onclick="ApplyOptionsAsync"
                                    disabled="@ChatService.IsStreaming">
                                Apply options
                            </button>
                            <button type="button" class="button" @onclick="ResetOptions"
                                    disabled="@ChatService.IsStreaming">
                                Reset to inherited
                            </button>
                            <button type="button" class="button danger" @onclick="DeleteCurrentChatAsync"
                                    disabled="@ChatService.IsStreaming">
                                Delete chat
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (Work.PendingPermission is { } permission)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body">
                        <div>
                            <div class="eyebrow">@(permission.Escalation ? "Agent permission request" : "Permission requested")</div>
                            @if (permission.Escalation)
                            {
                                <strong>@permission.Access.Tool is asking to work beyond the session policy</strong>
                                <span class="small faint">
                                    The agent asks for @permission.Wanted; the session allows @permission.Inherited.
                                    This call needs your approval and is never remembered.
                                </span>
                            }
                            else
                            {
                                <strong>@permission.Access.Tool wants @permission.Access.Category access</strong>
                            }
                            <span class="work-permission-path">@permission.Access.Path</span>
                            @if (!string.IsNullOrWhiteSpace(permission.Access.Detail))
                            {
                                <span class="work-permission-command mono">@permission.Access.Detail</span>
                            }
                        </div>
                        <div class="row">
                            <button type="button" class="button danger"
                                    @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.Deny)">
                                Deny
                            </button>
                            <button type="button" class="button"
                                    @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.AllowOnce)">
                                Allow once
                            </button>
                            @if (permission.CanRemember)
                            {
                                <button type="button" class="button primary"
                                        @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.Always)">
                                    Always allow
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Safety.Pending is { } safetyReview)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body">
                        <div>
                            <div class="eyebrow">Safety check</div>
                            <strong>@safetyReview.Finding.Message</strong>
                            @if (!string.IsNullOrWhiteSpace(safetyReview.Finding.Detail))
                            {
                                <span class="work-permission-path">@safetyReview.Finding.Detail</span>
                            }
                            <span class="small faint">
                                @safetyReview.Tool · @safetyReview.Finding.Rule · @safetyReview.Finding.Severity
                            </span>
                        </div>
                        <div class="row">
                            <button type="button" class="button danger"
                                    @onclick="() => ResolveSafetyAsync(SafetyDecision.Deny)">
                                Deny
                            </button>
                            <button type="button" class="button"
                                    @onclick="() => ResolveSafetyAsync(SafetyDecision.DenyAlways)">
                                Deny always
                            </button>
                            <button type="button" class="button"
                                    @onclick="() => ResolveSafetyAsync(SafetyDecision.AllowOnce)">
                                Allow
                            </button>
                            <button type="button" class="button primary"
                                    @onclick="() => ResolveSafetyAsync(SafetyDecision.AllowAlways)">
                                Allow always
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (Safety.PendingProcess is { } process)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body">
                        <div>
                            <div class="eyebrow">Process started</div>
                            <strong>
                                @process.Name (PID @process.ProcessId)@(process.Plugin is null
                                    ? ""
                                    : $" by the plugin tool {process.Plugin}")@(process.Tool is null
                                    ? ""
                                    : $" · tool {process.Tool}")
                            </strong>
                            <span class="small faint">
                                It started underneath Studio while a tool was running. This warning
                                closes automatically when the process exits. Allow always keeps this
                                tool quiet for the rest of the session.
                            </span>
                        </div>
                        <div class="row">
                            <button type="button" class="button danger"
                                    @onclick="DisableProcessAsync">
                                Disable
                            </button>
                            <button type="button" class="button"
                                    @onclick="() => Safety.AskAboutProcessAgain(process)">
                                Ask
                            </button>
                            <button type="button" class="button"
                                    @onclick="Safety.DismissPendingProcess">
                                Allow
                            </button>
                            <button type="button" class="button primary"
                                    @onclick="() => Safety.AllowProcessForSession(process)">
                                Allow always@(process.Tool is null ? "" : $" ({process.Tool})")
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_workMode && Work.PendingChoice is { } choice)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body stack">
                        <div>
                            <div class="eyebrow">Agent question</div>
                            <strong>@choice.Prompt</strong>
                        </div>
                        <div class="work-choice-options">
                            @foreach (string option in choice.Options)
                            {
                                <button type="button" class="button"
                                        @onclick="() => ResolveChoiceAsync(option)">
                                    @option
                                </button>
                            }
                        </div>
                        @if (choice.AllowFreeText)
                        {
                            <div class="row">
                                <input class="input" @bind="_choiceFreeText" placeholder="Type an answer" />
                                <button type="button" class="button primary"
                                        @onclick="() => ResolveChoiceAsync(_choiceFreeText)"
                                        disabled="@string.IsNullOrWhiteSpace(_choiceFreeText)">
                                    Answer
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (_workMode && _toolState.Capability == ToolCapability.Failed)
            {
                <div class="tool-warning chat-tool-warning">
                    <div>
                        <strong>Tool calls failed for this model.</strong>
                        <span class="small faint">Work may not be able to read or change files. Try another model or re-tune.</span>
                    </div>
                    <div class="row">
                        <button type="button" class="button" @onclick="OpenTune">Tune</button>
                        <label class="tool-toggle">
                            <input type="checkbox" @bind="_allowFailedTools" />
                            <span>Send anyway</span>
                        </label>
                    </div>
                </div>
            }
            @if (ToolHint is { } toolHint)
            {
                <div class="tool-warning chat-tool-warning">
                    <div>
                        <strong>@(ChatService.IsCompute
                            ? "Compute cannot run tools."
                            : "The model printed a tool call instead of running it.")</strong>
                        <span class="small faint">@toolHint</span>
                    </div>
                </div>
            }
            <div class="chat-composer">
                <div class="composer-shell">
                    @if (_pendingArtifacts.Count > 0)
                    {
                        <div class="composer-chip-row">
                            @foreach (ChatArtifact artifact in _pendingArtifacts.Take(3))
                            {
                                <span class="composer-chip" title="@(artifact.FileName ?? artifact.Type)">
                                    <span class="name">@(artifact.FileName ?? artifact.Type)</span>
                                    <button type="button" title="Remove attachment"
                                            @onclick="() => RemoveArtifact(artifact)">&times;</button>
                                </span>
                            }
                            @if (_pendingArtifacts.Count > 3)
                            {
                                <button type="button" class="composer-overflow"
                                        @onclick="() => _showOverflow = !_showOverflow"
                                        title="More attachments">
                                    @(_showOverflow ? "−" : "…")
                                </button>
                            }
                        </div>
                        @if (_showOverflow && _pendingArtifacts.Count > 3)
                        {
                            <div class="composer-chip-row composer-overflow-list">
                                @foreach (ChatArtifact artifact in _pendingArtifacts.Skip(3))
                                {
                                    <span class="composer-chip" title="@(artifact.FileName ?? artifact.Type)">
                                        <span class="name">@(artifact.FileName ?? artifact.Type)</span>
                                        <button type="button" title="Remove attachment"
                                                @onclick="() => RemoveArtifact(artifact)">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                    }
                    @if (_commandPaletteOpen)
                    {
                        <div class="command-palette" role="listbox" aria-label="Chat commands">
                            @if (_commandCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No command matches. Type /help for the list.</div>
                            }
                            else
                            {
                                @for (int index = 0; index < _commandCandidates.Count; index++)
                                {
                                    int itemIndex = index;
                                    ChatCommandDefinition command = _commandCandidates[index];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _commandIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _commandIndex)"
                                            @onmouseenter="() => _commandIndex = itemIndex"
                                            @onclick="() => SelectCommandAsync(command)">
                                        <span class="command-palette-name">@command.Usage</span>
                                        <span class="command-palette-description">@command.Description</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (_contextPaletteOpen)
                    {
                        <div class="command-palette context-palette" role="listbox" aria-label="Add context">
                            @if (_contextCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No context option matches.</div>
                            }
                            else
                            {
                                @for (int contextIndex = 0; contextIndex < _contextCandidates.Count; contextIndex++)
                                {
                                    int itemIndex = contextIndex;
                                    ContextChoice contextChoice = _contextCandidates[contextIndex];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _contextIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _contextIndex)"
                                            @onmouseenter="() => _contextIndex = itemIndex"
                                            @onclick="() => SelectContextAsync(contextChoice)">
                                        <span class="command-palette-name">@contextChoice.Label</span>
                                        <span class="command-palette-description">@contextChoice.Description</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    @if (_skillPaletteOpen)
                    {
                        <div class="command-palette context-palette" role="listbox" aria-label="Add a skill">
                            @if (_skillCandidates.Count == 0)
                            {
                                <div class="command-palette-empty">No enabled skills are available.</div>
                            }
                            else
                            {
                                @for (int skillIndex = 0; skillIndex < _skillCandidates.Count; skillIndex++)
                                {
                                    int itemIndex = skillIndex;
                                    SkillChoice skillChoice = _skillCandidates[skillIndex];
                                    <button type="button"
                                            class="command-palette-item @(itemIndex == _skillIndex ? "selected" : "")"
                                            role="option"
                                            aria-selected="@(itemIndex == _skillIndex)"
                                            @onmouseenter="() => _skillIndex = itemIndex"
                                            @onclick="() => SelectSkillAsync(skillChoice)">
                                        <span class="command-palette-name">@skillChoice.Skill.Name</span>
                                        <span class="command-palette-description">@skillChoice.Source</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                    <textarea id="chat-input" class="textarea"
                              value="@_input"
                              @oninput="OnComposerInput"
                              @onkeydown="OnComposerKeyDown"
                              placeholder="Message the model. Enter sends; Shift+Enter adds a line. Type / for commands."
                              disabled="@(ChatService.IsStreaming || ChatService.IsLoading)"></textarea>
                    <div class="composer-actions">
                        @if (!ChatService.IsStreaming && !ChatService.IsLoading && !ChatService.IsCompute)
                        {
                            <label class="button chat-attach-button" title="Attach an image, audio file or document">
                                Attach
                                <InputFile OnChange="OnFilesSelected" multiple class="chat-attach-input" />
                            </label>
                        }
                        @if (ChatService.SupportsAudio)
                        {
                            <button type="button"
                                    class="button chat-mic-button @(_recording ? "recording" : "")"
                                    @onclick="ToggleMicAsync"
                                    disabled="@(_transcribing || ChatService.IsStreaming || ChatService.IsLoading)"
                                    title="@(_recording ? "Stop and transcribe" : "Record audio")">
                                @(_recording ? "Stop" : "Mic")
                            </button>
                        }
                        @if (ChatService.IsLoading)
                        {
                            <button type="button" class="button danger" @onclick="ChatService.Interrupt">Interrupt</button>
                        }
                        else if (ChatService.IsStreaming)
                        {
                            <span class="spinner-ring"></span>
                            <button type="button" class="button danger" @onclick="Stop">Interrupt</button>
                        }
                        <button id="chat-send" type="button" class="button primary composer-send" @onclick="SendCommandOrMessageAsync"
                                disabled="@(ChatService.IsStreaming || ChatService.IsLoading ||
                                            (_workMode && !_remoteChat && _toolState.Capability == ToolCapability.Failed && !_allowFailedTools))">
                            Send
                        </button>
                    </div>
                </div>
                <div class="composer-foot small faint">
                    <span class="status-line">@ChatService.Status</span>
                    @if (_transcribing)
                    {
                        <span>Transcribing...</span>
                    }
                    @if (ChatService.SupportsVision)
                    {
                        <span>@(HasVisionImage ? "The attached image is included in the next turn." : "Attach an image to include it in the next turn.")</span>
                    }
                    @if (ChatService.SupportsTts)
                    {
                        <span>Audio model: a text prompt generates speech automatically; an attached audio file is transcribed.</span>
                    }
                    else if (ChatService.SupportsAudio)
                    {
                        <span>Audio model: an attached audio file is transcribed.</span>
                    }
                </div>
                @if (ChatService.CacheWarning is not null)
                {
                    <div class="small faint">@ChatService.CacheWarning</div>
                }
                @if (ChatService.Error is not null)
                {
                    <div class="error-line">@ChatService.Error</div>
                }
                @if (_commandError is not null)
                {
                    <div class="error-line command-result">@_commandError</div>
                }
                else if (_commandStatus is not null)
                {
                    <div class="small faint command-result">@_commandStatus</div>
                }
                @if (_voiceError is not null)
                {
                    <div class="error-line">@_voiceError</div>
                }
            </div>
        }
    </section>

@if (_showTuneModal && _tuneModel is not null)
{
    <div class="tune-modal-backdrop">
        <div class="tune-modal">
            <div class="tune-modal-head">
                <span>@_tuneModel.FileName</span>
                <button type="button" class="button" @onclick="CloseTune">Close</button>
            </div>
            <ModelTunePanel Model="_tuneModel" InitialTarget="_tuneTarget"
                            Generators="Workspace.Builders.Generators"
                            Caches="Workspace.Builders.Caches"
                            OnSaved="OnTuneSaved" />
        </div>
    </div>
}

@code {
    [Parameter] public string? ChatId { get; set; }
    [Parameter] public bool WorkMode { get; set; }

    private IReadOnlyList<ModelDescriptor> _models = [];
    private IReadOnlyList<RunSummary> _runs = [];
    private IReadOnlyList<ChatMessage> _messages = [];
    private RunSummary? _latestModelRun;
    private ToolCapabilityState _toolState = new(ToolCapability.Untested, null, null);
    private bool _allowUnverifiedTools;
    private bool _allowFailedTools;
    private bool _remoteChat;
    private string? _computeProviderId;
    private string _remoteProviderId = RemoteProviders.OpenRouter;
    private string _remoteModel = "";
    private string? _selectedModelPath;
    private string _input = "";
    private readonly List<ChatArtifact> _pendingArtifacts = [];
    private bool _showOverflow;
    private bool _commandPaletteOpen;
    private IReadOnlyList<ChatCommandDefinition> _commandCandidates = [];
    private int _commandIndex;
    private string? _commandError;
    private string? _commandStatus;
    private bool _contextPaletteOpen;
    private IReadOnlyList<ContextChoice> _contextCandidates = [];
    private int _contextIndex;
    private bool _contextFromToken;
    private bool _skillPaletteOpen;
    private IReadOnlyList<SkillChoice> _skillCandidates = [];
    private int _skillIndex;
    private readonly HashSet<string> _contextPaths = new(StringComparer.OrdinalIgnoreCase);

    private RemoteProviderPreset RemotePreset => RemoteProviders.Find(_remoteProviderId);
    private IReadOnlyList<string> RemoteActiveModels => OpenRouter.ActiveModelsFor(_remoteProviderId);
    private bool RemoteHasApiKey => OpenRouter.HasApiKeyFor(_remoteProviderId);

    private bool RemoteReady => _remoteChat
        && !string.IsNullOrWhiteSpace(_remoteModel)
        && (_computeProviderId is { } computeId
            ? Compute.Resolve(computeId) is { IsUsable: true } host
              && (host.Models.Count == 0
                  || host.Models.Any(model => model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase)))
            : RemoteHasApiKey
              && RemoteActiveModels.Any(model =>
                  model.Equals(_remoteModel, StringComparison.OrdinalIgnoreCase)));

    private string? SelectedFileName =>
        _models.FirstOrDefault(model => model.Path == _selectedModelPath)?.FileName;

    /// <summary>
    /// A tool-call-shaped message that produced no call usually means the model
    /// printed the schema, or a Compute host has no tool loop.
    /// </summary>
    private string? ToolHint
    {
        get
        {
            if (ChatService.LastToolCalls is not 0) return null;
            ChatMessage? last = ChatService.Document?.Messages
                .LastOrDefault(message => message.Role == ChatRole.Agent);
            if (!ToolCallText.LooksUnparsed(last?.Content)) return null;

            return ChatService.IsCompute
                ? "A Compute host is inference-only; use a local model or OpenRouter to run tools and agents."
                : "It may not support this tool format. Open Options, set Tool-call recovery to Loose, or choose a model with a tool template.";
        }
    }

    private string LoadPercent => ChatService.LoadProgress is { } value
        ? $"{value * 100:F0}%"
        : "0%";
    private bool _startingNew = true;
    private bool _loadingModels = true;
    private bool _showOptions;

    private string CurrentModelChoice => ChatService.Document?.Provider == "local"
        ? ChatService.Document.ModelPath ?? ""
        : ChatService.RemoteModel ?? "";    private bool _wasStreaming;
    private bool _initialized;
    private bool _workMode;
    private bool _recording;
    private bool _transcribing;
    private string? _voiceError;
    private TunePreset? _selectedTunePreset;
    private bool _showTuneModal;
    private ModelDescriptor? _tuneModel;
    private TuneTarget _tuneTarget = TuneTarget.Chat;
    private string _choiceFreeText = "";
    private bool _focusPending = true;
    private InferenceOverrides _sessionDraft = new();
    private ToolPermissionSet _sessionToolsDraft = new();
    private IReadOnlyList<EmbeddedToolInfo> _embeddedTools = [];
    private ToolPermissionSet _embeddedPermissions = new();

    private sealed record ContextChoice(string Kind, string Label, string Description);

    private sealed record SkillChoice(WorkSkill Skill, string Source);

    private static readonly HashSet<string> ContextSkippedDirectories = new(StringComparer.OrdinalIgnoreCase)
    {
        ".git", ".vs", ".idea", "bin", "obj", "node_modules", "dist", "build",
    };

    private static readonly HashSet<string> ContextTextExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".txt", ".md", ".markdown", ".rst", ".cs", ".razor", ".cshtml", ".json", ".csv",
        ".log", ".xml", ".xaml", ".html", ".htm", ".css", ".scss", ".js", ".mjs", ".ts",
        ".tsx", ".jsx", ".py", ".sql", ".yaml", ".yml", ".toml", ".ini", ".csproj",
        ".slnx", ".sln", ".props", ".targets", ".sh", ".ps1", ".bat", ".cmd", ".java",
        ".go", ".rs", ".cpp", ".cc", ".c", ".h", ".hpp", ".fs", ".fsx", ".vb",
    };

    private const string ContextFilePattern =
        "*.txt;*.md;*.markdown;*.rst;*.cs;*.razor;*.cshtml;*.json;*.csv;*.log;*.xml;" +
        "*.xaml;*.html;*.htm;*.css;*.scss;*.js;*.mjs;*.ts;*.tsx;*.jsx;*.py;*.sql;*.yaml;" +
        "*.yml;*.toml;*.ini;*.csproj;*.slnx;*.sln;*.props;*.targets;*.sh;*.ps1;*.bat;" +
