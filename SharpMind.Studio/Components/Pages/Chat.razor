    private void ResetOptions()
    {
        _sessionDraft = new InferenceOverrides();
        _sessionToolsDraft = new ToolPermissionSet();
        _embeddedPermissions = new ToolPermissionSet();
    }

    /// <summary>
    /// An embedded tool is either not loaded or loaded. A tool that runs its own
    /// code cannot be asked per call, so offering Ask here would be a promise
    /// Studio cannot keep; the safety inspector still reviews every call.
    /// </summary>
    private bool IsEmbeddedToolOn(string tool) =>
        _embeddedPermissions.TryTool(tool, out WorkToolPermission value) &&
        value != WorkToolPermission.Off;

    private void SetEmbeddedTool(string tool, bool enabled)
    {
        var tools = new Dictionary<string, WorkToolPermission>(
            _embeddedPermissions.Tools, StringComparer.OrdinalIgnoreCase);
        if (enabled) tools[tool] = WorkToolPermission.Always;
        else tools.Remove(tool);

        _embeddedPermissions = new ToolPermissionSet
        {
            Tools = tools,
            Groups = _embeddedPermissions.Groups,
        };
    }

    /// <summary>
    /// What a session override would inherit from: the project, family, model
    /// and System layers.
    /// </summary>
    private ToolPermissionValue SessionToolsEffective(string tool, string? group) =>
        ToolPermissionResolver.Resolve(
            tool,
            group,
            system: Inference.SystemTools,
            family: Inference.FamilyTools(ChatService.Document?.FamilyId),
            project: Work.ProjectToolLayer(),
            model: Inference.ModelTools(ChatService.Document?.ModelPath));


