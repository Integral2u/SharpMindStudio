    private void OnComposerInput(ChangeEventArgs args)
    {
        _input = args.Value?.ToString() ?? "";
        _commandError = null;
        _commandStatus = null;
        _skillPaletteOpen = false;
        _skillCandidates = [];
        UpdateCommandPalette();
        UpdateContextPalette();
    }

    private void UpdateCommandPalette()
    {
        if (!ChatCommandParser.IsCommandAttempt(_input))
        {
            _commandPaletteOpen = false;
            _commandCandidates = [];
            _commandIndex = 0;
            return;
        }

        string trimmed = _input.TrimStart();
        if (trimmed.Any(char.IsWhiteSpace))
        {
            _commandPaletteOpen = false;
            _commandCandidates = [];
            return;
        }

        string query = trimmed.Length <= 1 ? "" : trimmed[1..];
        _commandCandidates = ChatCommands.Match(query);
        _commandPaletteOpen = true;
        _commandIndex = 0;
        _contextPaletteOpen = false;
        _contextCandidates = [];
        _contextFromToken = false;
    }

    private void UpdateContextPalette()
    {
        if (_commandPaletteOpen || !TryGetContextQuery(out string query))
        {
            _contextPaletteOpen = false;
            _contextCandidates = [];
            _contextFromToken = false;
            return;
        }

        _contextCandidates =
        [
            .. BuildContextChoices().Where(choice =>
                choice.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                choice.Description.Contains(query, StringComparison.OrdinalIgnoreCase))
        ];
        _contextPaletteOpen = true;
        _contextFromToken = true;
        _contextIndex = 0;
    }

    private bool TryGetContextQuery(out string query)
        => ChatContextParser.TryGetToken(_input, out query);

    private IReadOnlyList<ContextChoice> BuildContextChoices()
    {
        var choices = new List<ContextChoice>
        {
            new("file", "@file", "Attach a text file as context for this turn."),
        };

        if (_workMode)
        {
            choices.Add(new("folder", "@folder", "Attach a folder manifest and its text files."));
            if (!string.IsNullOrWhiteSpace(Work.Memory))
                choices.Add(new("memory", "@memory", "Attach the Work project memory."));
            choices.Add(new("skill", "@skill", "Attach an enabled system or project skill."));
        }

        return choices;
    }

    private IReadOnlyList<SkillChoice> EnabledSkills()
    {
        var choices = new List<SkillChoice>();
        foreach (WorkSkill skill in Work.SystemSkills
                     .Where(Work.IsSystemSkillEnabled)
                     .OrderBy(skill => skill.Name, StringComparer.OrdinalIgnoreCase))
        {
            choices.Add(new SkillChoice(skill, "System skill"));
        }

        foreach (WorkSkill skill in Work.ProjectSkills
                     .Where(Work.IsProjectSkillEnabled)
                     .OrderBy(skill => skill.Name, StringComparer.OrdinalIgnoreCase))
        {
            choices.Add(new SkillChoice(skill, "Project skill"));
        }

        return choices;
    }

    private async Task SelectContextAsync(ContextChoice choice)
    {
        _contextPaletteOpen = false;
        _contextCandidates = [];
        if (_contextFromToken) RemoveContextToken();
        _contextFromToken = false;

        switch (choice.Kind)
        {
            case "folder":
                await AddFolderContextAsync();
                break;
            case "memory":
                AddMemoryContext();
                break;
            case "skill":
                OpenSkillPalette();
                return;
            default:
                await AddFileContextAsync();
                break;
        }

        await FocusComposerAsync();
    }

    private void OpenSkillPalette()
    {
        _contextPaletteOpen = false;
        _contextCandidates = [];
        _skillCandidates = EnabledSkills();
        _skillIndex = 0;
        _skillPaletteOpen = true;
        if (_skillCandidates.Count == 0)
        {
            _skillPaletteOpen = false;
            _commandStatus = "No enabled skills are available for this project.";
        }
    }

    private async Task SelectSkillAsync(SkillChoice choice)
    {
        _skillPaletteOpen = false;
        _skillCandidates = [];

        string key = $"skill:{choice.Skill.Id}";
        if (!_contextPaths.Add(key))
        {
            _commandStatus = $"{choice.Skill.Name} is already attached.";
            await FocusComposerAsync();
            return;
        }

        AddContextArtifact(
            $"{SafeContextName(choice.Skill.Name)}.md",
            $"Skill: {choice.Skill.Name}\n\n{choice.Skill.Content.Trim()}",
            key);
        await FocusComposerAsync();
    }

    private static string SafeContextName(string name)
    {
        string safe = string.IsNullOrWhiteSpace(name) ? "skill" : name.Trim();
        foreach (char bad in Path.GetInvalidFileNameChars())
            safe = safe.Replace(bad, '_');
        return safe;
    }

    private void RemoveContextToken()
    {
        int index = _input.LastIndexOf('@');
        if (index >= 0) _input = _input[..index].TrimEnd();
    }

    private async Task AddFileContextAsync()
    {
        string? start = _workMode ? Workspace.Project.Root : null;
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.File, start, "Add file context", ContextFilePattern);
        if (selection?.Path is not { Length: > 0 } path) return;
        if (!ValidateContextPath(path, out string? reason))
        {
            _commandError = reason;
            return;
        }

        if (!_contextPaths.Add(path))
        {
            _commandStatus = $"{Path.GetFileName(path)} is already attached.";
            return;
        }

        try
        {
            var info = new FileInfo(path);
            if (info.Length > 1_000_000)
            {
                _contextPaths.Remove(path);
                _commandError = $"{info.Name} is larger than 1 MB.";
                return;
            }

            string text = await File.ReadAllTextAsync(path);
            if (text.Contains('\0'))
            {
                _contextPaths.Remove(path);
                _commandError = $"{info.Name} does not look like a text file.";
                return;
            }

            AddContextArtifact(
                info.Name,
                $"File: {path}\n\n{text}",
                path);
        }
        catch (Exception ex)
        {
            _contextPaths.Remove(path);
            _commandError = $"Could not read {Path.GetFileName(path)}: {ex.Message}";
        }
    }

    private async Task AddFolderContextAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.Folder, Workspace.Project.Root, "Add folder context");
        if (selection?.Path is not { Length: > 0 } folder) return;
        if (!ValidateContextPath(folder, out string? reason))
        {
            _commandError = reason;
            return;
        }

        if (!_contextPaths.Add(folder))
        {
            _commandStatus = $"{Path.GetFileName(folder)} is already attached.";
            return;
        }

        var contents = new StringBuilder();
        int included = 0;
        int skipped = 0;
        long total = 0;
        foreach (string file in EnumerateContextFiles(folder))
        {
            if (included >= MaxContextFiles || total >= MaxContextTotalBytes)
            {
                skipped++;
                continue;
            }

            try
            {
                var info = new FileInfo(file);
                if (info.Length == 0 || info.Length > MaxContextFileBytes)
                {
                    skipped++;
                    continue;
                }

                string text = await File.ReadAllTextAsync(file);
                if (text.Contains('\0'))
                {
                    skipped++;
                    continue;
                }

                string relative = Path.GetRelativePath(folder, file);
                contents.AppendLine($"### {relative}");
                contents.AppendLine(text.TrimEnd());
                contents.AppendLine();
                included++;
                total += Encoding.UTF8.GetByteCount(text);
            }
            catch
            {
                skipped++;
            }
        }

        if (included == 0)
        {
            _contextPaths.Remove(folder);
            _commandError = "No readable text files were found in that folder.";
            return;
        }

        var header = new StringBuilder();
        header.AppendLine($"Folder: {folder}");
        header.AppendLine($"Files included: {included}" + (skipped > 0 ? $"; skipped: {skipped}" : ""));
        header.AppendLine();
        header.Append(contents);
        AddContextArtifact(
            $"{Path.GetFileName(folder)} (folder context)",
            header.ToString(),
            folder);
    }

    private void AddMemoryContext()
    {
        string memory = Work.Memory.Trim();
        if (memory.Length == 0)
        {
            _commandStatus = "Project memory is empty.";
            return;
        }

        if (!_contextPaths.Add("memory:project"))
        {
            _commandStatus = "Project memory is already attached.";
            return;
        }

        AddContextArtifact("project-memory", memory, "memory:project");
    }

    private void AddContextArtifact(string name, string text, string? sourceKey)
    {
        _commandError = null;
        _commandStatus = null;

        byte[] content = Encoding.UTF8.GetBytes(text);
        if (content.Length > 400_000)
        {
            if (sourceKey is not null) _contextPaths.Remove(sourceKey);
            _commandError = $"The context for {name} is larger than the 400 KB limit.";
            return;
        }

        if (_pendingArtifacts.Count >= 12)
        {
            if (sourceKey is not null) _contextPaths.Remove(sourceKey);
            _commandError = "Remove an attachment before adding more context.";
            return;
        }

        _pendingArtifacts.Add(new ChatArtifact
        {
            Type = "text",
            MimeType = "text/plain",
            Content = content,
            FileName = name,
            SourcePath = sourceKey,
        });

        _commandStatus = ChatService.IsRemote
            ? $"Added {name}. It will be sent to the remote provider with the next message."
            : $"Added {name}.";
    }

    private bool ValidateContextPath(string path, out string? reason)
    {
        if (!_workMode)
        {
            reason = null;
            return true;
        }

        return Work.CanAttachContextPath(path, out reason);
    }

    private static IEnumerable<string> EnumerateContextFiles(string root)
    {
        var pending = new Stack<string>();
        pending.Push(root);
        int visited = 0;
        while (pending.Count > 0 && visited < 2_000)
        {
            string directory = pending.Pop();
            visited++;

            string[] files;
            string[] directories;
            try
            {
                files = Directory.GetFiles(directory);
                directories = Directory.GetDirectories(directory);
            }
            catch
            {
                continue;
            }

            foreach (string file in files)
            {
                if (IsContextTextFile(file)) yield return file;
            }

            foreach (string child in directories)
            {
                if (!ContextSkippedDirectories.Contains(Path.GetFileName(child)))
                    pending.Push(child);
            }
        }
    }

    private static bool IsContextTextFile(string path)
    {
        string extension = Path.GetExtension(path);
        if (extension.Length == 0) return true;
        return ContextTextExtensions.Contains(extension);
    }

    private async Task OnComposerKeyDown(KeyboardEventArgs args)
    {
        if (_skillPaletteOpen)
        {
            if (args.Key == "ArrowDown")
            {
                if (_skillCandidates.Count > 0)
                    _skillIndex = (_skillIndex + 1) % _skillCandidates.Count;
                return;
            }

            if (args.Key == "ArrowUp")
            {
                if (_skillCandidates.Count > 0)
                    _skillIndex = (_skillIndex - 1 + _skillCandidates.Count) % _skillCandidates.Count;
                return;
            }

            if (args.Key == "Escape")
            {
                _skillPaletteOpen = false;
                return;
            }

            if (args.Key == "Enter" && !args.ShiftKey)
            {
                await SendCommandOrMessageAsync();
                return;
            }

            if (args.Key == "Tab" && !args.ShiftKey)
            {
                if (_skillCandidates.Count > 0)
                    await SelectSkillAsync(_skillCandidates[_skillIndex]);
                else
                    _skillPaletteOpen = false;
                return;
            }

            return;
        }

        if (_contextPaletteOpen)
        {
            if (args.Key == "ArrowDown")
            {
                if (_contextCandidates.Count > 0)
                    _contextIndex = (_contextIndex + 1) % _contextCandidates.Count;
                return;
            }

            if (args.Key == "ArrowUp")
            {
                if (_contextCandidates.Count > 0)
                    _contextIndex = (_contextIndex - 1 + _contextCandidates.Count) % _contextCandidates.Count;
                return;
            }

            if (args.Key == "Escape")
            {
                _contextPaletteOpen = false;
                return;
            }

            if (args.Key == "Enter" && !args.ShiftKey)
            {
                await SendCommandOrMessageAsync();
                return;
            }

            if (args.Key == "Tab" && !args.ShiftKey)
            {
                await SyncComposerFromDomAsync();
                if (_contextCandidates.Count > 0)
                    await SelectContextAsync(_contextCandidates[_contextIndex]);
                else
                    _contextPaletteOpen = false;
                return;
            }

            return;
        }

        if (_commandPaletteOpen)
        {
            if (args.Key == "ArrowDown")
            {
                if (_commandCandidates.Count > 0)
                    _commandIndex = (_commandIndex + 1) % _commandCandidates.Count;
                return;
            }

            if (args.Key == "ArrowUp")
            {
                if (_commandCandidates.Count > 0)
                    _commandIndex = (_commandIndex - 1 + _commandCandidates.Count) % _commandCandidates.Count;
                return;
            }

            if (args.Key == "Escape")
            {
                _commandPaletteOpen = false;
                return;
            }

            if (args.Key == "Enter" && !args.ShiftKey)
            {
                await SendCommandOrMessageAsync();
                return;
            }

            if (args.Key == "Tab" && !args.ShiftKey)
            {
                await SyncComposerFromDomAsync();
                if (_commandCandidates.Count == 0)
                {
                    _commandPaletteOpen = false;
                    return;
                }

                await SelectCommandAsync(_commandCandidates[_commandIndex], completeOnly: true);
                return;
            }

            return;
        }

        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await SendCommandOrMessageAsync();
        }
    }

    private string ComposerId => ChatService.Document is null || _startingNew
        ? "chat-new-input"
        : "chat-input";

    private async Task SyncComposerFromDomAsync()
    {
        try
        {
            string value = await JS.InvokeAsync<string>("studioChat.value", ComposerId) ?? "";
            if (string.Equals(value, _input, StringComparison.Ordinal)) return;

            _input = value;
            _commandError = null;
            _commandStatus = null;
            UpdateCommandPalette();
            UpdateContextPalette();
        }
        catch
        {
            // If the DOM cannot be read, the last synced state is still usable.
        }
    }

    private async Task SendCommandOrMessageAsync()
    {
        await SyncComposerFromDomAsync();

        if (_skillPaletteOpen)
        {
            if (_skillCandidates.Count > 0)
                await SelectSkillAsync(_skillCandidates[_skillIndex]);
            else
                _skillPaletteOpen = false;
            return;
        }

        if (_contextPaletteOpen)
        {
            if (_contextCandidates.Count > 0)
            {
                await SelectContextAsync(_contextCandidates[_contextIndex]);
            }
            else
            {
                _contextPaletteOpen = false;
            }
            return;
        }

        if (_commandPaletteOpen && _commandCandidates.Count > 0)
        {
            // A partial command accepts the highlighted item; a fully typed
            // command runs as written.
            ChatCommandLine? typed = ChatCommandParser.Parse(_input);
            bool exact = typed is not null &&
                string.Equals(
                    typed.Name,
                    _commandCandidates[_commandIndex].Name,
                    StringComparison.OrdinalIgnoreCase);
            if (!exact)
            {
                await SelectCommandAsync(_commandCandidates[_commandIndex]);
                return;
            }
        }

        if (ChatCommandParser.Parse(_input) is { } line)
        {
            _input = "";
            _commandPaletteOpen = false;
            _commandCandidates = [];
            await ExecuteCommandAsync(line.Name, line.Argument);
            return;
        }

        if (ChatCommandParser.IsCommandAttempt(_input))
        {
            // A bare slash is an incomplete command, not a prompt for the model.
            UpdateCommandPalette();
            return;
        }

        if (ChatService.Document is null || _startingNew)
            await StartNewChatAsync();
        else
            await SendAsync();
    }

    private async Task SelectCommandAsync(ChatCommandDefinition command, bool completeOnly = false)
    {
        _commandPaletteOpen = false;

        if (completeOnly || command.ArgumentHint is not null)
        {
            _input = command.ArgumentHint is null
                ? command.Invocation
                : command.Invocation + " ";
            _commandStatus = null;
            await FocusComposerAsync();
            return;
        }

        _input = "";
        await ExecuteCommandAsync(command.Name, "");
    }

    private async Task ExecuteCommandAsync(string name, string argument)
    {
        _commandError = null;
        _commandStatus = null;

        ChatCommandDefinition? command = ChatCommands.Find(name);
        if (command is null)
        {
            _commandError = $"Unknown command /{name}. Type /help.";
            return;
        }

        switch (command.Name)
        {
            case "help":
                _commandCandidates = ChatCommands.All;
                _commandIndex = 0;
                _commandPaletteOpen = true;
                _commandStatus = "Chat commands. Enter runs, Esc closes.";
                await FocusComposerAsync();
                return;

            case "new":
                await BeginNewChatAsync();
                return;

            case "model":
                await CommandModelAsync(argument);
                break;

            case "system":
                await CommandSystemAsync(argument);
                break;

            case "rename":
                await CommandRenameAsync(argument);
                break;

            case "delete":
                await DeleteCurrentChatAsync();
                return;

            case "options":
                if (ChatService.IsRemote)
                {
                    _commandStatus = "Inference options are available for local chats only.";
                    break;
                }

                if (DeviceAccess.IsMobile)
                {
                    _commandStatus = "Inference options are hidden on this device.";
                    break;
                }

                _showOptions = true;
                SyncFromChat();
                _commandStatus = "Options opened.";
                break;

            case "stop":
                if (ChatService.IsStreaming || ChatService.IsLoading)
                {
                    ChatService.Interrupt();
                    _commandStatus = "Stopping...";
                }
                else
                {
                    _commandStatus = "Nothing is running.";
                }
                break;
        }

        await FocusComposerAsync();
    }

    private async Task CommandModelAsync(string argument)
    {
        if (ChatService.Document is null)
        {
            _commandError = "Start or open a chat first.";
            return;
        }

        IReadOnlyList<(string Value, string Label)> choices = ModelChoices();
        if (string.IsNullOrWhiteSpace(argument))
        {
            string current = CurrentModelChoice;
            string label = choices.FirstOrDefault(choice => choice.Value == current).Label ?? current;
            _commandStatus = label.Length == 0 ? "No model is selected." : $"Current model: {label}";
            return;
        }

        string needle = argument.Trim();
        var matches = choices
            .Where(choice =>
                choice.Value.Contains(needle, StringComparison.OrdinalIgnoreCase) ||
                choice.Label.Contains(needle, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (matches.Count == 0)
        {
            _commandError = $"No model matches \"{needle}\".";
            return;
        }

        if (matches.Count > 1)
        {
            string names = string.Join(", ", matches.Take(5).Select(match => match.Label));
            _commandError = $"Several models match: {names}" +
                (matches.Count > 5 ? " ..." : "") + ". Use a longer name.";
            return;
        }

        if (ChatService.IsStreaming || ChatService.IsLoading)
        {
            _commandError = "Stop the current reply first.";
            return;
        }

        await SwitchModelAsync(new ChangeEventArgs { Value = matches[0].Value });
        _commandStatus = $"Switched to {matches[0].Label}.";
    }

    private async Task CommandSystemAsync(string argument)
    {
        if (ChatService.Document is null)
        {
            _commandError = "Start or open a chat first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(argument))
        {
            string current = ChatService.Document.SystemPrompt ?? "";
            _commandStatus = current.Length == 0
                ? "No system prompt is set."
                : $"System prompt: {current}";
            return;
        }

        string value = argument.Trim();
        bool clear = value.Equals("clear", StringComparison.OrdinalIgnoreCase) ||
                     value.Equals("off", StringComparison.OrdinalIgnoreCase) ||
                     value.Equals("none", StringComparison.OrdinalIgnoreCase);
        bool applied = await ChatService.UpdateSystemPromptAsync(clear ? null : value);
        if (!applied)
        {
            _commandError = "The system prompt could not be changed right now.";
            return;
        }

        SyncFromChat();
        _commandStatus = clear ? "System prompt cleared." : "System prompt updated.";
    }

    private async Task CommandRenameAsync(string argument)
    {
        if (ChatService.Document is null)
        {
            _commandError = "Start or open a chat first.";
            return;
        }

        if (string.IsNullOrWhiteSpace(argument))
        {
            await RenameCurrentChatAsync();
            return;
        }

        await ChatService.RenameAsync(ChatService.Document.Id, argument.Trim());
        SyncFromChat();
        _commandStatus = "Chat renamed.";
    }

    private async Task SendAsync()
    {
        _commandPaletteOpen = false;
        _commandCandidates = [];
        _commandError = null;
        _commandStatus = null;
        _contextPaletteOpen = false;
        _contextCandidates = [];
        _contextFromToken = false;
        string text = _input;
        if (string.IsNullOrWhiteSpace(text))
        {
            if (HasVisionImage)
            {
                text = "Describe this image.";
            }
            else if (!HasAudioInput && _pendingArtifacts.Count > 0)
            {
                text = "Use the attached context.";
            }
            else if (!HasAudioInput)
            {
                return;
            }
        }
        _input = "";
        ChatArtifact[] artifacts = [.. _pendingArtifacts];
        _pendingArtifacts.Clear();
        _contextPaths.Clear();
        await ChatService.SendAsync(text, artifacts);
        await FocusComposerAsync();
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs args)
    {
        const long maxBytes = 25L * 1024 * 1024;
        foreach (IBrowserFile file in args.GetMultipleFiles(maximumFileCount: 8))
        {
            if (file.Size <= 0 || file.Size > maxBytes) continue;
            try
            {
                await using Stream source = file.OpenReadStream(maxBytes);
                using var buffer = new MemoryStream();
                await source.CopyToAsync(buffer);
                _pendingArtifacts.Add(new ChatArtifact
                {
                    Type = ArtifactType(file.ContentType, file.Name),
                    MimeType = ArtifactMime(file.ContentType, file.Name),
                    Content = buffer.ToArray(),
                    FileName = file.Name,
                });
            }
            catch
            {
                // An unreadable browser file must not take the composer down.
            }
        }
    }

    private static string ArtifactType(string? contentType, string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType))
        {
            if (contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) return "image";
            if (contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)) return "audio";
            if (contentType.Contains("json", StringComparison.OrdinalIgnoreCase)) return "json";
            if (contentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase)) return "text";
        }

        string ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext switch
        {
            ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp" or ".bmp" => "image",
            ".wav" or ".mp3" or ".ogg" or ".m4a" or ".flac" => "audio",
            ".json" => "json",
            ".txt" or ".md" or ".csv" or ".log" => "text",
            _ => "file",
        };
    }

    private void RemoveArtifact(ChatArtifact artifact)
    {
        _pendingArtifacts.Remove(artifact);
        if (artifact.SourcePath is { Length: > 0 } source) _contextPaths.Remove(source);
        if (_pendingArtifacts.Count <= 3) _showOverflow = false;
    }

    private static string ArtifactMime(string? contentType, string fileName)
    {
        if (!string.IsNullOrWhiteSpace(contentType) &&
            contentType.Contains('/', StringComparison.Ordinal))
        {
            return contentType.ToLowerInvariant();
        }

        return Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            ".wav" => "audio/wav",
            ".mp3" => "audio/mpeg",
            ".ogg" => "audio/ogg",
            ".m4a" => "audio/mp4",
            ".flac" => "audio/flac",
            ".pdf" => "application/pdf",
            ".json" => "application/json",
            ".csv" => "text/csv",
            ".md" => "text/markdown",
            ".txt" or ".log" => "text/plain",
            ".zip" => "application/zip",
            ".7z" => "application/x-7z-compressed",
            ".tar" => "application/x-tar",
            ".gz" => "application/gzip",
            _ => "application/octet-stream",
        };
    }

    private void TrySendPendingPrompt()
    {
        string? pending = ChatService.TakePendingPrompt();
        IReadOnlyList<ChatArtifact> artifacts = ChatService.TakePendingArtifacts();
        if (pending is null && artifacts.Count == 0) return;
        _ = InvokeAsync(async () =>
        {
            await ChatService.SendAsync(pending ?? "", artifacts);
            await FocusComposerAsync();
        });
    }

