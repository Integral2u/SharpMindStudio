@page "/chat"
@page "/chat/{ChatId}"
@implements IDisposable
@using SharpMind.Inference.Chat
@using SharpMind.Studio.Core.Inference
@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Core.Runs
@using SharpMind.Studio.Services
@inject StudioChatService ChatService
@inject InferenceSettingsService Inference
@inject OpenRouterSettingsService OpenRouter
@inject ModelCatalogService Catalog
@inject MarkdownService Markdown
@inject StudioWorkspaceService Workspace
@inject StudioWorkService Work
@inject StudioDeviceAccess DeviceAccess
@inject ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_workMode ? "Work" : "Chat") - SharpMind Studio</PageTitle>

@if (_workMode)
{
    <WorkProjectPanel />
}

    <section class="panel chat-main">
        @if (ChatService.IsLoading)
        {
            <div class="load-panel" style="margin: 1rem 1.2rem 0;">
                <div class="load-panel-row">
                    <span class="spinner-ring"></span>
                    <span>@ChatService.LoadDetail</span>
                    <span class="mono">@LoadPercent</span>
                    <button type="button" class="button" @onclick="ChatService.Interrupt">Interrupt</button>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width:@LoadPercent"></div></div>
            </div>
        }

        @if (_startingNew || ChatService.Document is null)
        {
            <div class="panel-head">
                <div>
                    <div class="eyebrow">@(_workMode ? "New work conversation" : "New conversation")</div>
                    <h2>@(_workMode ? "What should we work on?" : "What do you want to ask?")</h2>
                </div>
                <span class="faint small mono">local or OpenRouter</span>
            </div>
            <div class="panel-body stack">
                <div class="welcome-compose">
                    <textarea id="chat-new-input" class="welcome-prompt chat-new-prompt" data-enter-send="chat-start"
                              onkeydown="studioChat.enterSend(event, 'chat-start')"
                              @bind="_input" @bind:event="oninput"
                              placeholder="@(_workMode ? "Describe the task, or leave this empty to start a blank Work chat." : "Ask something, or leave this empty to start a blank chat.")"></textarea>
                    <button id="chat-start" type="button" class="button primary welcome-send"
                            @onclick="StartNewChatAsync"
                            disabled="@(ChatService.IsStreaming || ChatService.IsLoading ||
                                        (_remoteChat ? !RemoteReady : string.IsNullOrWhiteSpace(_selectedModelPath)) ||
                                        (_workMode && !_remoteChat && _toolState.Capability != ToolCapability.Passed && !_allowUnverifiedTools))">
                        Send
                    </button>
                </div>

                <div class="welcome-controls chat-welcome-controls">
                    <div class="field">
                        <label class="field-label" for="chat-provider">Provider</label>
                        <select id="chat-provider" class="input" @bind="_remoteChat">
                            <option value="false">Local model</option>
                            <option value="true">OpenRouter</option>
                        </select>
                    </div>
                    @if (!_remoteChat)
                    {
                        @if (_loadingModels)
                        {
                            <div class="field"><span class="status-line">Scanning model folder...</span></div>
                        }
                        else if (_models.Count == 0)
                        {
                            <div class="field"><span class="status-line">No models found under @Workspace.ModelsFolder.</span></div>
                        }
                        else
                        {
                            <div class="field">
                                <label class="field-label" for="chat-model">Model</label>
                                <select id="chat-model" class="input" @bind="_selectedModelPath" @bind:after="SaveModelChoiceAsync">
                                    @foreach (var model in _models)
                                    {
                                        <option value="@model.Path" title="@model.Path">@model.DisplayName (@model.FileName) - @model.Family.DisplayName (@FileSize(model.SizeBytes))</option>
                                    }
                                </select>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="field">
                            <label class="field-label" for="chat-remote-model">Model id</label>
                            <input id="chat-remote-model" class="input" @bind="_remoteModel"
                                   list="remote-model-options" placeholder="openai/gpt-4o-mini" />
                            <datalist id="remote-model-options">
                                @foreach (string model in OpenRouter.RecentModels)
                                {
                                    <option value="@model"></option>
                                }
                            </datalist>
                        </div>
                    }
                </div>

                @if (_remoteChat)
                {
                    <div class="welcome-model-status">
                        <span class="small faint">
                            @(OpenRouter.HasApiKey ? "OpenRouter key configured" : "No OpenRouter key")
                        </span>
                    </div>
                    @if (!OpenRouter.HasApiKey)
                    {
                        <div class="tool-warning">
                            <div>
                                <strong>OpenRouter needs an API key.</strong>
                                <span class="small faint">Add it in Settings, then return here.</span>
                            </div>
                            <div class="row">
                                <button type="button" class="button" @onclick="OpenRouterSettings">Open Settings</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="small faint">
                            Chat uses the selected remote model. Work keeps the local project tools;
                            only the model runs remotely.
                        </div>
                    }
                }
                else if (!_loadingModels && _models.Count > 0)
                {
                    <div class="welcome-model-status">
                        @if (_latestModelRun is not null)
                        {
                            <span class="status @StatusClass(_latestModelRun.Status)">@_latestModelRun.Status</span>
                        }
                        <ModelToolStatus ModelPath="_selectedModelPath" FileName="@SelectedFileName" Runs="_runs" />
                    </div>
                    <div class="status-line">@ChatService.Status</div>
                    @if (!string.IsNullOrWhiteSpace(_selectedModelPath))
                    {
                        <TunePresetPicker ModelPath="_selectedModelPath"
                                          Target="@(_workMode ? TuneTarget.Work : TuneTarget.Chat)"
                                          SelectedPreset="_selectedTunePreset"
                                          SelectedPresetChanged="p => _selectedTunePreset = p"
                                          OnTune="OpenTune" />
                    }
                    @if (_workMode && _toolState.Capability != ToolCapability.Passed)
                    {
                        <div class="tool-warning">
                            <div>
                                <strong>Tools are not verified for this model.</strong>
                                <span class="small faint">Work mode depends on tool calling. Test it before relying on Work.</span>
                            </div>
                            <div class="row">
                                <button type="button" class="button" @onclick="OpenTune">Test tools</button>
                                <label class="tool-toggle">
                                    <input type="checkbox" @bind="_allowUnverifiedTools" />
                                    <span>Start anyway</span>
                                </label>
                            </div>
                        </div>
                    }
                }
                @if (ChatService.Error is not null)
                {
                    <div class="error-line">@ChatService.Error</div>
                }
            </div>
        }        else
        {
            <div class="panel-head chat-head">
                <div>
                    <div class="eyebrow">
                        @if (ChatService.IsRemote)
                        {
                            <text>OpenRouter | @ChatService.RemoteModel</text>
                        }
                        else
                        {
                            <text>@ChatService.Model?.Family.DisplayName | @ChatService.Model?.FileName</text>
                        }
                    </div>
                    <h2>@if (DeviceAccess.IsMobile)
{
    @ChatService.Document.Name
}
else
{
    <button type="button" class="chat-title-button" @onclick="RenameCurrentChatAsync"
            title="Rename chat">@ChatService.Document.Name <span class="faint">&#9998;</span></button>
}</h2>
                    @if (!ChatService.IsRemote)
                    {
                        <div class="row" style="margin-top: .35rem;">
                            <ModelToolStatus ModelPath="_selectedModelPath" FileName="@SelectedFileName" Runs="_runs" />
                        </div>
                    }
                </div>
                @if (!DeviceAccess.IsMobile)
                {
                    <div class="row">
                        @if (!ChatService.IsRemote)
                        {
                            <button type="button" class="button" @onclick="ToggleOptions">
                                @(_showOptions ? "Hide options" : "Options")
                            </button>
                        }
                        <button type="button" class="button" @onclick="BeginNewChat">New chat</button>
                    </div>
                }
            </div>

            <div id="chat-transcript" class="chat-transcript">
                @if (_messages.Count == 0)
                {
                    <div class="empty">
                        @(ChatService.IsRemote
                            ? "Send the first message. Only the model runs remotely."
                            : "Send the first message. The model stays on this machine.")
                    </div>
                }
                else
                {
                    @for (int i = 0; i < _messages.Count; i++)
                    {
                        ChatMessage message = _messages[i];
                        bool streaming = ChatService.IsStreaming && i == _messages.Count - 1 && message.Role == ChatRole.Agent;
                        <div class="chat-message @message.Role.ToString().ToLowerInvariant()">
                            <div class="chat-message-meta">
                                <span>@(message.Role == ChatRole.User ? "You" : "Model")</span>
                                <span>@message.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                @if (message.Role == ChatRole.Agent && !streaming && i == _messages.Count - 1 && ChatService.LastTokensPerSecond is { } tps)
                                {
                                    <span>@tps.ToString("F1") tok/s</span>
                                }
                            </div>
                            @if (message.Role == ChatRole.Agent)
                            {
                                @if (streaming)
                                {
                                    <div class="chat-text chat-streaming">@message.Content</div>
                                }
                                else
                                {
                                    <div class="chat-text markdown">@((MarkupString)Markdown.ToHtml(message.Content))</div>
                                }
                            }
                            else
                            {
                                <div class="chat-text">@message.Content</div>
                            }
                        </div>
                    }
                }
            </div>

            @if (_showOptions && !DeviceAccess.IsMobile && !ChatService.IsRemote)
            {
                <div class="chat-options">
                    <div class="panel-head">
                        <div>
                            <div class="eyebrow">Session options</div>
                            <h2>Overrides</h2>
                        </div>
                        <span class="faint small mono">empty fields inherit</span>
                    </div>
                    <div class="panel-body stack">
                        <InferenceProfileEditor Value="_sessionDraft" ValueChanged="v => _sessionDraft = v"
                                                AllowInherit="true"
                                                Sources="ChatService.Resolved?.Sources"
                                                Effective="ChatService.Resolved"
                                                Generators="Workspace.Builders.Generators"
                                                Caches="Workspace.Builders.Caches" />
                        <div class="row">
                            <button type="button" class="button primary" @onclick="ApplyOptionsAsync"
                                    disabled="@ChatService.IsStreaming">
                                Apply options
                            </button>
                            <button type="button" class="button" @onclick="ResetOptions"
                                    disabled="@ChatService.IsStreaming">
                                Reset to inherited
                            </button>
                            <button type="button" class="button danger" @onclick="DeleteCurrentChatAsync"
                                    disabled="@ChatService.IsStreaming">
                                Delete chat
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_workMode && Work.PendingPermission is { } permission)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body">
                        <div>
                            <div class="eyebrow">Permission requested</div>
                            <strong>@permission.Access.Tool wants @permission.Access.Category access</strong>
                            <span class="work-permission-path">@permission.Access.Path</span>
                        </div>
                        <div class="row">
                            <button type="button" class="button danger"
                                    @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.Deny)">
                                Deny
                            </button>
                            <button type="button" class="button"
                                    @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.AllowOnce)">
                                Allow once
                            </button>
                            <button type="button" class="button primary"
                                    @onclick="() => ResolvePermissionAsync(WorkPermissionDecision.Always)">
                                Always allow
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (_workMode && Work.PendingChoice is { } choice)
            {
                <div class="panel work-permission-prompt">
                    <div class="panel-body stack">
                        <div>
                            <div class="eyebrow">Agent question</div>
                            <strong>@choice.Prompt</strong>
                        </div>
                        <div class="row">
                            @foreach (string option in choice.Options)
                            {
                                <button type="button" class="button"
                                        @onclick="() => ResolveChoiceAsync(option)">
                                    @option
                                </button>
                            }
                        </div>
                        @if (choice.AllowFreeText)
                        {
                            <div class="row">
                                <input class="input" @bind="_choiceFreeText" placeholder="Type an answer" />
                                <button type="button" class="button primary"
                                        @onclick="() => ResolveChoiceAsync(_choiceFreeText)"
                                        disabled="@string.IsNullOrWhiteSpace(_choiceFreeText)">
                                    Answer
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (_workMode && _toolState.Capability == ToolCapability.Failed)
            {
                <div class="tool-warning chat-tool-warning">
                    <div>
                        <strong>Tool calls failed for this model.</strong>
                        <span class="small faint">Work may not be able to read or change files. Try another model or re-tune.</span>
                    </div>
                    <div class="row">
                        <button type="button" class="button" @onclick="OpenTune">Tune</button>
                        <label class="tool-toggle">
                            <input type="checkbox" @bind="_allowFailedTools" />
                            <span>Send anyway</span>
                        </label>
                    </div>
                </div>
            }
            <div class="chat-composer">
                <textarea id="chat-input" class="textarea" data-enter-send="chat-send" onkeydown="studioChat.enterSend(event, 'chat-send')" @bind="_input" @bind:event="oninput"
                          placeholder="Message the model. Enter sends; Shift+Enter adds a line."
                          disabled="@(ChatService.IsStreaming || ChatService.IsLoading)"></textarea>
                <div class="chat-composer-actions">
                    <span class="status-line">@ChatService.Status</span>
                    @if (ChatService.IsLoading)
                    {
                        <button type="button" class="button danger" @onclick="ChatService.Interrupt">Interrupt</button>
                    }
                    else if (ChatService.IsStreaming)
                    {
                        <span class="spinner-ring"></span>
                        <button type="button" class="button danger" @onclick="Stop">Interrupt</button>
                    }
                    <button id="chat-send" type="button" class="button primary" @onclick="SendAsync"
                            disabled="@(ChatService.IsStreaming || ChatService.IsLoading || string.IsNullOrWhiteSpace(_input) ||
                                        (_workMode && !_remoteChat && _toolState.Capability == ToolCapability.Failed && !_allowFailedTools))">
                        Send
                    </button>
                </div>
                @if (ChatService.CacheWarning is not null)
                {
                    <div class="small faint">@ChatService.CacheWarning</div>
                }
                @if (ChatService.Error is not null)
                {
                    <div class="error-line">@ChatService.Error</div>
                }
            </div>
        }
    </section>

@if (_showTuneModal && _tuneModel is not null)
{
    <div class="tune-modal-backdrop">
        <div class="tune-modal">
            <div class="tune-modal-head">
                <span>@_tuneModel.FileName</span>
                <button type="button" class="button" @onclick="CloseTune">Close</button>
            </div>
            <ModelTunePanel Model="_tuneModel" InitialTarget="_tuneTarget"
                            Generators="Workspace.Builders.Generators"
                            Caches="Workspace.Builders.Caches"
                            OnSaved="OnTuneSaved" />
        </div>
    </div>
}

@code {
    [Parameter] public string? ChatId { get; set; }
    [Parameter] public bool WorkMode { get; set; }

    private IReadOnlyList<ModelDescriptor> _models = [];
    private IReadOnlyList<RunSummary> _runs = [];
    private IReadOnlyList<ChatMessage> _messages = [];
    private RunSummary? _latestModelRun;
    private ToolCapabilityState _toolState = new(ToolCapability.Untested, null, null);
    private bool _allowUnverifiedTools;
    private bool _allowFailedTools;
    private bool _remoteChat;
    private string _remoteModel = "";
    private string? _selectedModelPath;
    private string _input = "";

    private bool RemoteReady =>
        _remoteChat &&
        !string.IsNullOrWhiteSpace(_remoteModel) &&
        OpenRouter.HasApiKey;

    private string? SelectedFileName =>
        _models.FirstOrDefault(model => model.Path == _selectedModelPath)?.FileName;

    private string LoadPercent => ChatService.LoadProgress is { } value
        ? $"{value * 100:F0}%"
        : "0%";
    private bool _startingNew = true;
    private bool _loadingModels = true;
    private bool _showOptions;
    private bool _wasStreaming;
    private bool _initialized;
    private bool _workMode;
    private TunePreset? _selectedTunePreset;
    private bool _showTuneModal;
    private ModelDescriptor? _tuneModel;
    private TuneTarget _tuneTarget = TuneTarget.Chat;
    private string _choiceFreeText = "";
    private bool _focusPending = true;
    private InferenceOverrides _sessionDraft = new();

    protected override async Task OnInitializedAsync()
    {
        UpdateRouteMode();
        ChatService.Changed += OnChatChanged;
        Work.Changed += OnWorkChanged;
        _runs = await Workspace.RecentRunsAsync();

        if (string.IsNullOrWhiteSpace(ChatId) && ChatService.Document is { } current &&
            !string.Equals(current.Mode, _workMode ? "work" : "chat", StringComparison.OrdinalIgnoreCase))
        {
            ChatService.Stop();
            await ChatService.CloseAsync();
        }

        if (!string.IsNullOrWhiteSpace(ChatId))
        {
            await ChatService.OpenAsync(ChatId);
            _ = RefreshModelsAsync();
        }
        else
        {
            _models = await Catalog.RefreshAsync();
            _loadingModels = false;
            _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path;
            UpdateLatestModelRun();
        }

        _startingNew = ChatService.Document is null;
        SyncFromChat();
        RefreshTuneSelection();
        _wasStreaming = ChatService.IsStreaming;
        _initialized = true;

        TrySendPendingPrompt();
    }

    private async Task RefreshModelsAsync()
    {
        try
        {
            _models = await Catalog.RefreshAsync();
            if (_selectedModelPath is null)
                _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                    ? Theme.LastChatModel
                    : _models.FirstOrDefault()?.Path;
            UpdateLatestModelRun();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
        finally { _loadingModels = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        UpdateRouteMode();
        RefreshTuneSelection();
        if (!_initialized) return;

        if (string.IsNullOrWhiteSpace(ChatId))
        {
            if (ChatService.Document is { } current &&
                !string.Equals(current.Mode, _workMode ? "work" : "chat", StringComparison.OrdinalIgnoreCase))
            {
                ChatService.Stop();
                await ChatService.CloseAsync();
                SyncFromChat();
            }
            return;
        }

        if (ChatService.Document?.Id.Equals(ChatId, StringComparison.OrdinalIgnoreCase) != true)
        {
            await ChatService.OpenAsync(ChatId);
            SyncFromChat();
        }

        TrySendPendingPrompt();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        string id = ChatService.Document is null || _startingNew ? "chat-new-input" : "chat-input";
        try { await JS.InvokeVoidAsync("studioChat.focus", id); } catch { }
    }

    public void Dispose()
    {
        ChatService.Changed -= OnChatChanged;
        Work.Changed -= OnWorkChanged;
    }

    private void UpdateRouteMode() => _workMode = WorkMode;

    private void OnWorkChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnChatChanged() => _ = InvokeAsync(async () =>
    {
        _wasStreaming = ChatService.IsStreaming;
        SyncFromChat();
        try { await JS.InvokeVoidAsync("studioChat.scrollToBottom", "chat-transcript"); }
        catch { }

        StateHasChanged();
    });

    private void SyncFromChat()
    {
        _messages = ChatService.DisplayMessages;
        _startingNew = ChatService.Document is null;
        if (ChatService.Document is not null)
        {
            _remoteChat = ChatService.IsRemote;
            if (_remoteChat)
                _remoteModel = ChatService.RemoteModel ?? _remoteModel;
            else
                _selectedModelPath = ChatService.Document.ModelPath;
            _sessionDraft = ChatService.Document.Overrides;
            _selectedTunePreset = Enum.TryParse(ChatService.Document.TunePreset, out TunePreset preset)
                ? preset
                : null;
            UpdateLatestModelRun();
        }
    }

    private async Task StartNewChatAsync()
    {
        if (_remoteChat)
        {
            if (!RemoteReady) return;

            string remotePrompt = _input.Trim();
            _input = "";
            StateHasChanged();
            await ChatService.NewRemoteChatAsync(
                _remoteModel.Trim(),
                systemPrompt: null,
                mode: _workMode ? "work" : "chat");

            if (ChatService.Document is not null)
            {
                ChatService.PendingPrompt = remotePrompt.Length > 0 ? remotePrompt : null;
                _startingNew = false;
                _focusPending = true;
                Nav.NavigateTo(_workMode ? $"/work/{ChatService.Document.Id}" : $"/chat/{ChatService.Document.Id}");
                TrySendPendingPrompt();
            }

            SyncFromChat();
            return;
        }

        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        if (model is null) return;

        string prompt = _input.Trim();
        _input = "";
        StateHasChanged();
        await Theme.SetLastChatModelAsync(model.Path);
        TuneTarget target = _workMode ? TuneTarget.Work : TuneTarget.Chat;
        if (Inference.HasTune(model.Path, target) && _selectedTunePreset is null)
            _selectedTunePreset = TunePreset.Balanced;
        TuneProfile? tune = _selectedTunePreset is { } selected
            ? Inference.TuneProfile(model.Path, target, selected)
            : null;
        await ChatService.NewChatAsync(model, systemPrompt: null, overrides: tune?.Overrides,
            mode: _workMode ? "work" : "chat",
            tunePreset: tune is null ? null : _selectedTunePreset?.ToString(),
            tuneTarget: target.ToString());
        if (ChatService.Document is not null)
        {
            ChatService.PendingPrompt = prompt.Length > 0 ? prompt : null;
            _startingNew = false;
            _focusPending = true;
            Nav.NavigateTo(_workMode ? $"/work/{ChatService.Document.Id}" : $"/chat/{ChatService.Document.Id}");
            TrySendPendingPrompt();
        }
        UpdateLatestModelRun();
        SyncFromChat();
    }

    private async Task SaveModelChoiceAsync()
    {
        await Theme.SetLastChatModelAsync(_selectedModelPath);
        _allowUnverifiedTools = false;
        _allowFailedTools = false;
        UpdateLatestModelRun();
        RefreshTuneSelection();
    }

    private void UpdateLatestModelRun()
    {
        if (_remoteChat)
        {
            _latestModelRun = null;
            _toolState = new ToolCapabilityState(ToolCapability.Untested, null, null);
            return;
        }

        string? fileName = SelectedFileName;
        _latestModelRun = fileName is null
            ? null
            : RunInsights.LatestBench(_runs, _selectedModelPath, fileName);

        TuneMeasurement? work = string.IsNullOrWhiteSpace(_selectedModelPath)
            ? null
            : Inference.TuneProfile(_selectedModelPath, TuneTarget.Work, TunePreset.Balanced)?.Measurement;
        _toolState = RunInsights.ResolveToolCapability(_selectedModelPath, fileName, _runs, work);
    }

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "unknown",
    };

    private static string ToolClass(string status) => status switch
    {
        "Yes" => "ok",
        "No" => "failed",
        _ => "unknown",
    };
    private void BeginNewChat()
    {
        _startingNew = true;
        _focusPending = true;
        _showOptions = false;
        _input = "";
        _remoteChat = ChatService.Document is { } current &&
                      string.Equals(current.Provider, "openrouter", StringComparison.OrdinalIgnoreCase);
        if (_remoteChat)
        {
            _remoteModel = ChatService.Document?.RemoteModel ?? _remoteModel;
        }
        else if (ChatService.Document is { } local)
        {
            _selectedModelPath = local.ModelPath;
        }

        if (string.IsNullOrWhiteSpace(_selectedModelPath) || _selectedModelPath == "openrouter")
        {
            _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path;
        }
        UpdateLatestModelRun();
    }

    private void OpenRouterSettings() => Nav.NavigateTo("/settings?tab=openrouter");


    private void RefreshTuneSelection()
    {
        TuneTarget target = _workMode ? TuneTarget.Work : TuneTarget.Chat;
        if (string.IsNullOrWhiteSpace(_selectedModelPath) || !Inference.HasTune(_selectedModelPath, target))
        {
            _selectedTunePreset = null;
            return;
        }

        if (_selectedTunePreset is null ||
            Inference.TuneProfile(_selectedModelPath, target, _selectedTunePreset.Value) is null)
            _selectedTunePreset = TunePreset.Balanced;
    }

    private void OpenTune()
    {
        _tuneModel = _models.FirstOrDefault(model => model.Path == _selectedModelPath);
        if (_tuneModel is null) return;
        _tuneTarget = _workMode ? TuneTarget.Work : TuneTarget.Chat;
        _showTuneModal = true;
    }

    private void CloseTune() => _showTuneModal = false;

    private void OnTuneSaved()
    {
        _showTuneModal = false;
        RefreshTuneSelection();
        UpdateLatestModelRun();
    }
    private async Task SendAsync()
    {
        string text = _input;
        if (string.IsNullOrWhiteSpace(text)) return;
        _input = "";
        await ChatService.SendAsync(text);
        await FocusComposerAsync();
    }

    private void TrySendPendingPrompt()
    {
        if (ChatService.TakePendingPrompt() is not { } pending) return;
        _ = InvokeAsync(async () =>
        {
            await ChatService.SendAsync(pending);
            await FocusComposerAsync();
        });
    }

    private async Task FocusComposerAsync()
    {
        try { await JS.InvokeVoidAsync("studioChat.focus", "chat-input"); }
        catch { }
    }
    private void Stop() => ChatService.Stop();

    private async Task ResolvePermissionAsync(WorkPermissionDecision decision)
    {
        await Work.ResolvePermissionAsync(decision);
    }

    private async Task ResolveChoiceAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        _choiceFreeText = "";
        await Work.ResolveChoiceAsync(value);
    }

    private void ToggleOptions()
    {
        _showOptions = !_showOptions;
        if (_showOptions) SyncFromChat();
    }

    private async Task ApplyOptionsAsync()
    {
        await ChatService.ApplyOptionsAsync(_sessionDraft);
        SyncFromChat();
    }

    private void ResetOptions()
    {
        _sessionDraft = new InferenceOverrides();
    }


    private async Task RenameCurrentChatAsync()
    {
        if (ChatService.Document is null) return;
        string? name = await JS.InvokeAsync<string?>("prompt", "Rename chat", ChatService.Document.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        await ChatService.RenameAsync(ChatService.Document.Id, name);
        SyncFromChat();
    }
    private async Task DeleteCurrentChatAsync()
    {
        if (ChatService.Document is null) return;
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete chat \"{ChatService.Document.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.DeleteAsync(ChatService.Document.Id);
        _startingNew = true;
        Nav.NavigateTo("/chat");
    }



    private static string FileSize(long bytes) =>
        bytes >= 1024L * 1024 * 1024
            ? $"{bytes / (1024.0 * 1024 * 1024):F1} GB"
            : $"{bytes / (1024.0 * 1024):F0} MB";
}


















































