@page "/chat"
@page "/chat/{ChatId}"
@implements IDisposable
@using SharpMind.Inference.Chat
@using SharpMind.Studio.Core.Runs
@using SharpMind.Studio.Services
@inject StudioChatService ChatService
@inject ModelCatalogService Catalog
@inject MarkdownService Markdown
@inject StudioWorkspaceService Workspace
@inject ThemeService Theme
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Chat - SharpMind Studio</PageTitle>

    <section class="panel chat-main">
        @if (ChatService.IsLoading)
        {
            <div class="load-panel" style="margin: 1rem 1.2rem 0;">
                <div class="load-panel-row">
                    <span class="spinner-ring"></span>
                    <span>@ChatService.LoadDetail</span>
                    <span class="mono">@LoadPercent</span>
                    <button type="button" class="button" @onclick="ChatService.Interrupt">Interrupt</button>
                </div>
                <div class="progress-track"><div class="progress-fill" style="width:@LoadPercent"></div></div>
            </div>
        }

        @if (_startingNew || ChatService.Document is null)
        {
            <div class="panel-head">
                <div>
                    <div class="eyebrow">New conversation</div>
                    <h2>What do you want to ask?</h2>
                </div>
                <span class="faint small mono">local weights only</span>
            </div>
            <div class="panel-body stack">
                <div class="welcome-compose">
                    <textarea id="chat-new-input" class="welcome-prompt chat-new-prompt" data-enter-send="chat-start"
                              onkeydown="studioChat.enterSend(event, 'chat-start')"
                              @bind="_input" @bind:event="oninput"
                              placeholder="Ask something, or leave this empty to start a blank chat."></textarea>
                    <button id="chat-start" type="button" class="button primary welcome-send"
                            @onclick="StartNewChatAsync"
                            disabled="@(ChatService.IsStreaming || ChatService.IsLoading || string.IsNullOrWhiteSpace(_selectedModelPath))">
                        Send
                    </button>
                </div>

                @if (_loadingModels)
                {
                    <div class="row"><span class="spinner-ring"></span><span class="status-line">Scanning model folder...</span></div>
                }
                else if (_models.Count == 0)
                {
                    <div class="empty">No models found under @Workspace.ModelsFolder.</div>
                }
                else
                {
                    <div class="welcome-controls" style="grid-template-columns: minmax(16rem, 2fr) minmax(16rem, 1fr);">
                        <div class="field">
                            <label class="field-label" for="chat-model">Model</label>
                            <select id="chat-model" class="input" @bind="_selectedModelPath" @bind:after="SaveModelChoiceAsync">
                                @foreach (var model in _models)
                                {
                                    <option value="@model.Path" title="@model.Path">@model.DisplayName (@model.FileName) - @model.Family.DisplayName (@FileSize(model.SizeBytes))</option>
                                }
                            </select>
                        </div>
                        <div class="welcome-model-status">
                            @if (_latestModelRun is null)
                            {
                                <span class="status unknown">unknown</span>
                                <span class="small faint mono">no canary result</span>
                            }
                            else
                            {
                                <span class="status @StatusClass(_latestModelRun.Status)">@_latestModelRun.Status</span>
                                <span class="small faint mono">@(_latestModelRun.TokensPerSecond > 0 ? $"{_latestModelRun.TokensPerSecond:F2} tok/s" : "-")</span>
                                <span class="status @ToolClass(_latestModelRun.ToolStatus)">tool @_latestModelRun.ToolStatus</span>
                            }
                        </div>
                    </div>
                    <div class="status-line">@ChatService.Status</div>
                    @if (ChatService.Error is not null)
                    {
                        <div class="error-line">@ChatService.Error</div>
                    }
                }
            </div>
        }        else
        {
            <div class="panel-head chat-head">
                <div>
                    <div class="eyebrow">@ChatService.Model?.Family.DisplayName | @ChatService.Model?.FileName</div>
                    <h2><button type="button" class="chat-title-button" @onclick="RenameCurrentChatAsync"
                            title="Rename chat">@ChatService.Document.Name <span class="faint">&#9998;</span></button></h2>
                </div>
                <div class="row">
                    <button type="button" class="button" @onclick="ToggleOptions">
                        @(_showOptions ? "Hide options" : "Options")
                    </button>
                    <button type="button" class="button" @onclick="BeginNewChat">New chat</button>
                </div>
            </div>

            <div id="chat-transcript" class="chat-transcript">
                @if (_messages.Count == 0)
                {
                    <div class="empty">Send the first message. The model stays on this machine.</div>
                }
                else
                {
                    @for (int i = 0; i < _messages.Count; i++)
                    {
                        ChatMessage message = _messages[i];
                        bool streaming = ChatService.IsStreaming && i == _messages.Count - 1 && message.Role == ChatRole.Agent;
                        <div class="chat-message @message.Role.ToString().ToLowerInvariant()">
                            <div class="chat-message-meta">
                                <span>@(message.Role == ChatRole.User ? "You" : "Model")</span>
                                <span>@message.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                                @if (message.Role == ChatRole.Agent && !streaming && i == _messages.Count - 1 && ChatService.LastTokensPerSecond is { } tps)
                                {
                                    <span>@tps.ToString("F1") tok/s</span>
                                }
                            </div>
                            @if (message.Role == ChatRole.Agent)
                            {
                                @if (streaming)
                                {
                                    <div class="chat-text chat-streaming">@message.Content</div>
                                }
                                else
                                {
                                    <div class="chat-text markdown">@((MarkupString)Markdown.ToHtml(message.Content))</div>
                                }
                            }
                            else
                            {
                                <div class="chat-text">@message.Content</div>
                            }
                        </div>
                    }
                }
            </div>

            @if (_showOptions)
            {
                <div class="chat-options">
                    <div class="panel-head">
                        <div>
                            <div class="eyebrow">Session options</div>
                            <h2>Overrides</h2>
                        </div>
                        <span class="faint small mono">empty fields inherit</span>
                    </div>
                    <div class="panel-body stack">
                        <InferenceProfileEditor Value="_sessionDraft" ValueChanged="v => _sessionDraft = v"
                                                AllowInherit="true"
                                                Sources="ChatService.Resolved?.Sources"
                                                Effective="ChatService.Resolved"
                                                Generators="Workspace.Builders.Generators"
                                                Caches="Workspace.Builders.Caches" />
                        <div class="row">
                            <button type="button" class="button primary" @onclick="ApplyOptionsAsync"
                                    disabled="@ChatService.IsStreaming">
                                Apply options
                            </button>
                            <button type="button" class="button" @onclick="ResetOptions"
                                    disabled="@ChatService.IsStreaming">
                                Reset to inherited
                            </button>
                            <button type="button" class="button danger" @onclick="DeleteCurrentChatAsync"
                                    disabled="@ChatService.IsStreaming">
                                Delete chat
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="chat-composer">
                <textarea id="chat-input" class="textarea" data-enter-send="chat-send" onkeydown="studioChat.enterSend(event, 'chat-send')" @bind="_input" @bind:event="oninput"
                          placeholder="Message the model. Enter sends; Shift+Enter adds a line."
                          disabled="@(ChatService.IsStreaming || ChatService.IsLoading)"></textarea>
                <div class="chat-composer-actions">
                    <span class="status-line">@ChatService.Status</span>
                    @if (ChatService.IsLoading)
                    {
                        <button type="button" class="button danger" @onclick="ChatService.Interrupt">Interrupt</button>
                    }
                    else if (ChatService.IsStreaming)
                    {
                        <span class="spinner-ring"></span>
                        <button type="button" class="button danger" @onclick="Stop">Interrupt</button>
                    }
                    <button id="chat-send" type="button" class="button primary" @onclick="SendAsync"
                            disabled="@(ChatService.IsStreaming || ChatService.IsLoading || string.IsNullOrWhiteSpace(_input))">
                        Send
                    </button>
                </div>
                @if (ChatService.CacheWarning is not null)
                {
                    <div class="small faint">@ChatService.CacheWarning</div>
                }
                @if (ChatService.Error is not null)
                {
                    <div class="error-line">@ChatService.Error</div>
                }
            </div>
        }
    </section>

@code {
    [Parameter] public string? ChatId { get; set; }

    private IReadOnlyList<ModelDescriptor> _models = [];
    private IReadOnlyList<RunSummary> _runs = [];
    private IReadOnlyList<ChatMessage> _messages = [];
    private RunSummary? _latestModelRun;
    private string? _selectedModelPath;
    private string _input = "";

    private string LoadPercent => ChatService.LoadProgress is { } value
        ? $"{value * 100:F0}%"
        : "0%";
    private bool _startingNew = true;
    private bool _loadingModels = true;
    private bool _showOptions;
    private bool _wasStreaming;
    private bool _initialized;
    private bool _focusPending = true;
    private InferenceOverrides _sessionDraft = new();

    protected override async Task OnInitializedAsync()
    {
        ChatService.Changed += OnChatChanged;
        _runs = await Workspace.RecentRunsAsync();

        if (!string.IsNullOrWhiteSpace(ChatId))
        {
            await ChatService.OpenAsync(ChatId);
            _ = RefreshModelsAsync();
        }
        else
        {
            _models = await Catalog.RefreshAsync();
            _loadingModels = false;
            _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path;
            UpdateLatestModelRun();
        }

        _startingNew = ChatService.Document is null;
        SyncFromChat();
        _wasStreaming = ChatService.IsStreaming;
        _initialized = true;

        TrySendPendingPrompt();
    }

    private async Task RefreshModelsAsync()
    {
        try
        {
            _models = await Catalog.RefreshAsync();
            if (_selectedModelPath is null)
                _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
                    ? Theme.LastChatModel
                    : _models.FirstOrDefault()?.Path;
            UpdateLatestModelRun();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
        finally { _loadingModels = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || string.IsNullOrWhiteSpace(ChatId)) return;

        if (ChatService.Document?.Id.Equals(ChatId, StringComparison.OrdinalIgnoreCase) != true)
        {
            await ChatService.OpenAsync(ChatId);
            SyncFromChat();
        }

        TrySendPendingPrompt();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        string id = ChatService.Document is null || _startingNew ? "chat-new-input" : "chat-input";
        try { await JS.InvokeVoidAsync("studioChat.focus", id); } catch { }
    }

    public void Dispose() => ChatService.Changed -= OnChatChanged;

    private void OnChatChanged() => _ = InvokeAsync(async () =>
    {
        _wasStreaming = ChatService.IsStreaming;
        SyncFromChat();
        try { await JS.InvokeVoidAsync("studioChat.scrollToBottom", "chat-transcript"); }
        catch { }

        StateHasChanged();
    });

    private void SyncFromChat()
    {
        _messages = ChatService.DisplayMessages;
        if (ChatService.Document is not null)
        {
            _selectedModelPath = ChatService.Document.ModelPath;
            _sessionDraft = ChatService.Document.Overrides;
            _startingNew = false;
        }
    }

    private async Task StartNewChatAsync()
    {
        ModelDescriptor? model = _models.FirstOrDefault(value => value.Path == _selectedModelPath);
        if (model is null) return;

        string prompt = _input.Trim();
        _input = "";
        StateHasChanged();
        await Theme.SetLastChatModelAsync(model.Path);
        await ChatService.NewChatAsync(model, systemPrompt: null);
        if (ChatService.Document is not null)
        {
            ChatService.PendingPrompt = prompt.Length > 0 ? prompt : null;
            _startingNew = false;
            _focusPending = true;
            Nav.NavigateTo($"/chat/{ChatService.Document.Id}");
            TrySendPendingPrompt();
        }
        UpdateLatestModelRun();
        SyncFromChat();
    }

    private async Task SaveModelChoiceAsync()
    {
        await Theme.SetLastChatModelAsync(_selectedModelPath);
        UpdateLatestModelRun();
    }

    private void UpdateLatestModelRun()
    {
        string? fileName = _models.FirstOrDefault(model => model.Path == _selectedModelPath)?.FileName;
        _latestModelRun = fileName is null
            ? null
            : _runs.FirstOrDefault(run =>
                run.Kind == "model-bench" &&
                string.Equals(run.Subject, fileName, StringComparison.OrdinalIgnoreCase));
    }

    private static string StatusClass(string status) => status switch
    {
        "succeeded" => "ok",
        "failed" or "cancelled" => "failed",
        _ => "unknown",
    };

    private static string ToolClass(string status) => status switch
    {
        "Yes" => "ok",
        "No" => "failed",
        _ => "unknown",
    };
    private void BeginNewChat()
    {
        _startingNew = true;
        _focusPending = true;
        _showOptions = false;
        _input = "";
        _selectedModelPath = ChatService.Document?.ModelPath ??
            (_models.Any(model => model.Path == Theme.LastChatModel)
                ? Theme.LastChatModel
                : _models.FirstOrDefault()?.Path);
        UpdateLatestModelRun();
    }


    private async Task SendAsync()
    {
        string text = _input;
        if (string.IsNullOrWhiteSpace(text)) return;
        _input = "";
        await ChatService.SendAsync(text);
        await FocusComposerAsync();
    }

    private void TrySendPendingPrompt()
    {
        if (ChatService.TakePendingPrompt() is not { } pending) return;
        _ = InvokeAsync(async () =>
        {
            await ChatService.SendAsync(pending);
            await FocusComposerAsync();
        });
    }

    private async Task FocusComposerAsync()
    {
        try { await JS.InvokeVoidAsync("studioChat.focus", "chat-input"); }
        catch { }
    }
    private void Stop() => ChatService.Stop();

    private void ToggleOptions()
    {
        _showOptions = !_showOptions;
        if (_showOptions) SyncFromChat();
    }

    private async Task ApplyOptionsAsync()
    {
        await ChatService.ApplyOptionsAsync(_sessionDraft);
        SyncFromChat();
    }

    private void ResetOptions()
    {
        _sessionDraft = new InferenceOverrides();
    }


    private async Task RenameCurrentChatAsync()
    {
        if (ChatService.Document is null) return;
        string? name = await JS.InvokeAsync<string?>("prompt", "Rename chat", ChatService.Document.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        await ChatService.RenameAsync(ChatService.Document.Id, name);
        SyncFromChat();
    }
    private async Task DeleteCurrentChatAsync()
    {
        if (ChatService.Document is null) return;
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete chat \"{ChatService.Document.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.DeleteAsync(ChatService.Document.Id);
        _startingNew = true;
        Nav.NavigateTo("/chat");
    }



    private static string FileSize(long bytes) =>
        bytes >= 1024L * 1024 * 1024
            ? $"{bytes / (1024.0 * 1024 * 1024):F1} GB"
            : $"{bytes / (1024.0 * 1024):F0} MB";
}







































