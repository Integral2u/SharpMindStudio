    private async Task ToggleMicAsync()
    {
        if (_transcribing) return;
        _voiceError = null;

        if (!_recording)
        {
            try
            {
                await JS.InvokeVoidAsync("studioAudio.start");
                _recording = true;
            }
            catch (Exception ex)
            {
                _voiceError = ex.Message;
            }
            return;
        }

        _recording = false;
        string? base64 = null;
        try
        {
            base64 = await JS.InvokeAsync<string>("studioAudio.stop");
        }
        catch (Exception ex)
        {
            _voiceError = ex.Message;
        }
        if (string.IsNullOrWhiteSpace(base64)) return;

        _transcribing = true;
        StateHasChanged();
        try
        {
            var artifact = new ChatArtifact
            {
                Type = "audio",
                FileName = "microphone.wav",
                Content = Convert.FromBase64String(base64),
            };
            string transcript = await ChatService.TranscribeAsync(artifact);
            if (!string.IsNullOrWhiteSpace(transcript))
                _input = string.IsNullOrWhiteSpace(_input) ? transcript : _input.TrimEnd() + " " + transcript;
        }
        catch (Exception ex)
        {
            _voiceError = ex.Message;
        }
        finally
        {
            _transcribing = false;
            StateHasChanged();
            await FocusComposerAsync();
        }
    }

    /// <summary>
    /// The audio backbone answers a bare ":" when it has no text to give. Hide a
    /// punctuation-only agent turn (code and normal prose still show); an audio
    /// turn carries its artifact instead.
    /// </summary>
    private static bool ShowAgentText(ChatMessage message) =>
        !string.IsNullOrWhiteSpace(message.Content) &&
        message.Content.Any(char.IsLetterOrDigit);

