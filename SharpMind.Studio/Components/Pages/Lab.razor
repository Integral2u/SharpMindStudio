@page "/lab"
@using SharpMind.Studio.Services
@implements IDisposable

<PageTitle>Labs - SharpMind Studio</PageTitle>

<div class="hero">
    <div class="hero-copy">
        <div class="eyebrow">Labs</div>
        <h1>Look inside the model.</h1>
        <p>
            Model analysis that does not change the weights: per-layer importance, quantization
            sensitivity, activation views, latent structure and agent traces. Each lab loads the
            model on this machine.
        </p>
    </div>
    <div class="hero-mark">
        measure first<br />
        change later
    </div>
</div>

<div class="settings-tabs training-tabs">
    <a class="settings-tab @(_tab == "layers" ? "selected" : "")" href="/lab?tab=layers" data-enhance-nav="false">Layer importance</a>
    <a class="settings-tab @(_tab == "quantization" ? "selected" : "")" href="/lab?tab=quantization" data-enhance-nav="false">Quantization</a>
    <a class="settings-tab @(_tab == "visualizer" ? "selected" : "")" href="/lab?tab=visualizer" data-enhance-nav="false">Model visualizer</a>
    <a class="settings-tab @(_tab == "latent" ? "selected" : "")" href="/lab?tab=latent" data-enhance-nav="false">Latent space</a>
    <a class="settings-tab @(_tab == "agents" ? "selected" : "")" href="/lab?tab=agents" data-enhance-nav="false">Agents</a>
</div>

@if (_tab == "layers")
{
    <LayerImportanceLab />
}
else if (_tab == "quantization")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Coming next</div>
                <h2>Quantization lab</h2>
            </div>
        </div>
        <div class="panel-body">
            <p class="faint">
                Compare GGUF quantizations of the same model: per-tensor weight error, output
                divergence and layer sensitivity, so a smaller file is chosen on evidence rather
                than file size alone.
            </p>
        </div>
    </section>
}
else if (_tab == "visualizer")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Coming next</div>
                <h2>Model visualizer</h2>
            </div>
        </div>
        <div class="panel-body">
            <p class="faint">
                Inspect attention, embeddings and per-layer activations for a loaded model. The
                activation hook that drives the layer lab already records the branch outputs this
                view needs.
            </p>
        </div>
    </section>
}
else if (_tab == "latent")
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Coming next</div>
                <h2>Latent space</h2>
            </div>
        </div>
        <div class="panel-body">
            <p class="faint">
                Project embeddings and layer activations to two dimensions, inspect nearest
                neighbours and cluster structure, and compare the same prompt across checkpoints
                or quantizations.
            </p>
        </div>
    </section>
}
else
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Coming next</div>
                <h2>Agents</h2>
            </div>
        </div>
        <div class="panel-body">
            <p class="faint">
                Trace agent turns, tool calls and delegation: which agent produced which artifact,
                how deep the delegation went, and where a run spent its tokens. Replay a saved run
                from the transcript.
            </p>
        </div>
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string _tab = "layers";

    protected override void OnParametersSet()
    {
        _tab = TabQuery is "quantization" or "visualizer" or "latent" or "agents" ? TabQuery : "layers";
    }

    public void Dispose()
    {
        // The tab page owns no subscriptions; the layer component owns its own.
    }
}
