@page "/lab"
@using SharpMind.Studio.Services
@implements IDisposable

<PageTitle>Labs - SharpMind Studio</PageTitle>

<div class="hero">
    <div class="hero-copy">
        <div class="eyebrow">Labs</div>
        <h1>Look inside the model.</h1>
        <p>
            Model analysis that does not change the weights: per-layer importance, quantization
            sensitivity, activation views, latent structure and agent traces. Each lab loads the
            model on this machine.
        </p>
    </div>
    <div class="hero-mark">
        measure first<br />
        change later
    </div>
</div>

<div class="settings-tabs training-tabs">
    <a class="settings-tab @(_tab == "layers" ? "selected" : "")" href="/lab?tab=layers" data-enhance-nav="false">Layer importance</a>
    <a class="settings-tab @(_tab == "quantization" ? "selected" : "")" href="/lab?tab=quantization" data-enhance-nav="false">Quantization</a>
    <a class="settings-tab @(_tab == "visualizer" ? "selected" : "")" href="/lab?tab=visualizer" data-enhance-nav="false">Model visualizer</a>
    <a class="settings-tab @(_tab == "latent" ? "selected" : "")" href="/lab?tab=latent" data-enhance-nav="false">Latent space</a>
    <a class="settings-tab @(_tab == "agents" ? "selected" : "")" href="/lab?tab=agents" data-enhance-nav="false">Agents</a>
    <a class="settings-tab" style="margin-left:auto"
       href="https://integral2u.github.io/SharpMindStudio/docs/wiki/labs.html"
       target="_blank" rel="noopener">Wiki guide</a>
</div>

@if (_tab == "layers")
{
    <LayerImportanceLab />
}
else if (_tab == "quantization")
{
    <QuantizationLab />
}
else if (_tab == "visualizer")
{
    <ModelVisualizerLab />
}
else if (_tab == "latent")
{
    <LatentSpaceLab />
}
else
{
    <AgentsLab />
}

@code {
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    private string _tab = "layers";

    protected override void OnParametersSet()
    {
        _tab = TabQuery is "quantization" or "visualizer" or "latent" or "agents" ? TabQuery : "layers";
    }

    public void Dispose()
    {
        // The tab page owns no subscriptions; the layer component owns its own.
    }
}
