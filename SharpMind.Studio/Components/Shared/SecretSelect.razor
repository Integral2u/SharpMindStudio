@using SharpMind.Studio.Core.Vault
@inject VaultStore Vault

<select class="input" value="@Value" @onchange="OnChange" title="@Title">
    <option value="">@EmptyLabel</option>
    @foreach (VaultSecretInfo secret in Vault.Secrets)
    {
        <option value="@secret.Name">@secret.Name</option>
    }
</select>
@if (Vault.Secrets.Count == 0)
{
    <div class="small faint">
        No secrets yet. <a href="/settings?tab=vault">Add one in Vault</a>.
    </div>
}

@code {
    /// <summary>The selected secret name, or null to use an inline value.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string EmptyLabel { get; set; } = "Type a key";

    [Parameter] public string? Title { get; set; }

    private Task OnChange(ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();
        return ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(value) ? null : value);
    }
}
