@using SharpMind.Model.Config
@using SharpMind.Model.Analysis
@using SharpMind.Studio.Core.Storage
@using SharpMind.Studio.Core.Training
@using SharpMind.Studio.Services
@inject ModelCatalogService Catalog
@inject StudioVisualizerService Visual
@inject StudioTrainingService Training
@inject ThemeService Theme
@inject PathPickerService Picker
@inject NavigationManager Nav
@implements IDisposable

<div class="page-head">
    <div>
        <div class="eyebrow">Model analysis</div>
        <h1>Model visualizer</h1>
        <p class="faint">
            One forward pass with the activation hook. Rows are layers, columns are prompt
            tokens; the colour is the branch RMS on a log scale.
        </p>
    </div>
</div>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Architecture template</div>
            <h2>Build a model shape</h2>
        </div>
        <span class="faint small mono">@_template.NumLayers layers - H@_template.HiddenDim - FFN @_template.FfnDim</span>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            Design the width, depth and layer plan without loading or capturing a model. The
            template can be seeded from the selected model, then sent to <strong>Training &gt; New
            model</strong>. Sliding-window layers train with the selected window; full layers keep
            full causal attention.
        </p>

        <div class="row">
            <div class="field grow">
                <label class="field-label">Template name</label>
                <input class="input" value="@_template.Name"
                       @onchange="e => SetTemplateName(e.Value?.ToString())" />
            </div>
            <div class="field grow">
                <label class="field-label">Architecture family</label>
                <select class="input" value="@(_template.ArchitecturePreset ?? string.Empty)"
                        @onchange="e => _template = _template with { ArchitecturePreset = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }">
                    <option value="">Custom / manual</option>
                    @foreach (TrainingPreset preset in TrainingModelOptions.Presets)
                    {
                        <option value="@preset.ArchitecturePresetKey">@preset.DisplayName</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label">Seed from model</label>
                <button type="button" class="button" @onclick="SeedFromModel"
                        disabled="@string.IsNullOrWhiteSpace(_selectedModelPath)">
                    Use selected model
                </button>
            </div>
        </div>

        <div class="training-form">
            <div class="field">
                <label class="field-label">Hidden width</label>
                <input class="input" type="number" min="8" step="8" value="@_template.HiddenDim"
                       @onchange="e => _template = _template with { HiddenDim = ParseInt(e.Value, _template.HiddenDim) }" />
            </div>
            <div class="field">
                <label class="field-label">Layers</label>
                <input class="input" type="number" min="1" max="128" value="@_template.NumLayers"
                       @onchange="e => SetLayerCount(ParseInt(e.Value, _template.NumLayers))" />
            </div>
            <div class="field">
                <label class="field-label">Heads</label>
                <input class="input" type="number" min="1" value="@_template.NumHeads"
                       @onchange="e => _template = _template with { NumHeads = ParseInt(e.Value, _template.NumHeads) }" />
            </div>
            <div class="field">
                <label class="field-label">KV heads</label>
                <input class="input" type="number" min="1" value="@_template.NumKvHeads"
                       @onchange="e => _template = _template with { NumKvHeads = ParseInt(e.Value, _template.NumKvHeads) }" />
            </div>
            <div class="field">
                <label class="field-label">FFN width</label>
                <input class="input" type="number" min="8" step="8" value="@_template.FfnDim"
                       @onchange="e => _template = _template with { FfnDim = ParseInt(e.Value, _template.FfnDim) }" />
            </div>
            <div class="field">
                <label class="field-label">Context length</label>
                <input class="input" type="number" min="8" step="8" value="@_template.MaxSeqLen"
                       @onchange="e => _template = _template with { MaxSeqLen = ParseInt(e.Value, _template.MaxSeqLen) }" />
            </div>
            <div class="field">
                <label class="field-label">Sliding window</label>
                <input class="input" type="number" min="0" step="8" value="@_template.SlidingWindowSize"
                       @onchange="e => _template = _template with { SlidingWindowSize = ParseInt(e.Value, 0) }" />
            </div>
        </div>

        <div class="spread">
            <div>
                <div class="eyebrow">Layer plan</div>
                <span class="faint small">Full, sliding, linear or recurrent, in order. Add, insert or remove blocks.</span>
            </div>
            <button type="button" class="button" @onclick="AddLayer">Add layer</button>
        </div>
        <div class="agent-layer-plan">
            @for (int index = 0; index < _template.LayerTypes.Count; index++)
            {
                int layerIndex = index;
                <div class="agent-layer-row">
                    <span class="mono faint">@(layerIndex + 1)</span>
                    <select class="input" value="@_template.LayerTypes[layerIndex]"
                            @onchange="e => SetLayerType(layerIndex, e.Value?.ToString())">
                        <option value="Full">Full attention</option>
                        <option value="Sliding">Sliding window</option>
                        <option value="Linear">Linear / no attention</option>
                        <option value="Recurrent">Recurrent (DeltaNet)</option>
                    </select>
                    <button type="button" class="button" title="Insert a layer after this one"
                            @onclick="() => InsertLayerAfter(layerIndex)">Insert</button>
                    <button type="button" class="button danger" title="Remove this layer"
                            @onclick="() => RemoveLayer(layerIndex)"
                            disabled="@(_template.LayerTypes.Count <= 1)">Remove</button>
                </div>
            }
        </div>

        @if (_template.HasUnsupportedTrainingLayers)
        {
            <div class="small faint">
                Linear and recurrent layers are kept in the visual plan. The current training
                kernel trains them as full attention; only Full/Sliding are applied at training time.
            </div>
        }
        <div class="row">
            <button type="button" class="button" @onclick="OpenTemplateAsync">Open template...</button>
            <button type="button" class="button" @onclick="SaveTemplateAsync">Save template...</button>
            <button type="button" class="button primary" @onclick="ApplyTemplateToTraining">
                Use in New model
            </button>
            <button type="button" class="button" @onclick="ResetTemplate">New blank template</button>
            @if (_templateStatus is { } templateStatus)
            {
                <span class="status-line">@templateStatus</span>
            }
        </div>
    </div>
</details>

<section class="panel">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Activation capture</div>
            <h2>One prompt, one forward pass</h2>
        </div>
        <span class="faint small mono">load - capture - release</span>
    </div>
    <div class="panel-body stack">
        @if (Visual.IsRunning)
        {
            <div class="load-panel">
                <div class="load-panel-row">
                    <span class="spinner-ring"></span>
                    <span>@Visual.Status</span>
                    <button type="button" class="button" @onclick="Visual.Cancel">Interrupt</button>
                </div>
            </div>
        }
        <div class="row">
            <div class="field grow">
                <label class="field-label">Model</label>
                <select class="input" @bind="_selectedModelPath" @bind:after="RememberModelAsync" disabled="@Visual.IsRunning">
                    @foreach (ModelDescriptor model in _models)
                    {
                        <option value="@model.Path">@model.DisplayName (@model.FileName)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label">Max tokens</label>
                <input class="input" type="number" min="1" max="256" @bind="_maxTokens" disabled="@Visual.IsRunning" />
            </div>
        </div>

        <div class="field">
            <label class="field-label">Prompt</label>
            <textarea class="input" rows="4" @bind="_prompt" disabled="@Visual.IsRunning"></textarea>
        </div>

        <div class="row">
            <button type="button" class="button primary" @onclick="RunAsync"
                    disabled="@(Visual.IsRunning || _models.Count == 0 || string.IsNullOrWhiteSpace(_selectedModelPath))">
                @(Visual.IsRunning ? "Capturing..." : "Capture")
            </button>
            <button type="button" class="button" @onclick="Visual.Cancel" disabled="@(!Visual.IsRunning)">
                Cancel
            </button>
            <span class="status-line">@Visual.Status</span>
        </div>

        @if (Visual.Error is { } error)
        {
            <div class="error-line">@error</div>
        }
    </div>
</section>

@if (Visual.Map is { } map)
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Activation map</div>
                <h2>@Visual.ModelName</h2>
            </div>
            <span class="faint small mono">
                @map.Layers layers · @map.Tokens tokens · attention max @map.MaxAttention.ToString("F3") ·
                FFN max @map.MaxFeedForward.ToString("F3")
            </span>
        </div>
        <div class="panel-body stack">
            <div>
                <div class="eyebrow">Attention RMS</div>
                <div class="lab-heatmap-row">
                    <div class="lab-heatmap" style="grid-template-columns:repeat(@map.Tokens, 12px)">
                        @for (int layer = 0; layer < map.Layers; layer++)
                        {
                            @for (int token = 0; token < map.Tokens; token++)
                            {
                                <span class="lab-cell"
                                      style="background:rgba(var(--accent-rgb), @(Alpha(map.Attention(layer, token), map.MaxAttention)))"
                                      title="layer @layer · @TokenLabel(token) · @map.Attention(layer, token).ToString("F3")"></span>
                            }
                        }
                    </div>
                    <div class="lab-layer-types">
                        @for (int layer = 0; layer < map.Layers; layer++)
                        {
                            <span class="lab-layer-type">@LayerType(layer)</span>
                        }
                    </div>
                </div>
            </div>
            <div>
                <div class="eyebrow">Feed-forward RMS</div>
                <div class="lab-heatmap-row">
                    <div class="lab-heatmap" style="grid-template-columns:repeat(@map.Tokens, 12px)">
                        @for (int layer = 0; layer < map.Layers; layer++)
                        {
                            @for (int token = 0; token < map.Tokens; token++)
                            {
                                <span class="lab-cell"
                                      style="background:rgba(var(--accent-rgb), @(Alpha(map.FeedForward(layer, token), map.MaxFeedForward)))"
                                      title="layer @layer · @TokenLabel(token) · @map.FeedForward(layer, token).ToString("F3")"></span>
                            }
                        }
                    </div>
                    <div class="lab-layer-types">
                        @for (int layer = 0; layer < map.Layers; layer++)
                        {
                            <span class="lab-layer-type">@LayerType(layer)</span>
                        }
                    </div>
                </div>
            </div>
            <div class="small faint">
                Log scale from the per-map maximum. Hover a cell for the layer, token and value.
                The right-hand column is the layer type from the model config: full/sliding
                attention, linear (no attention) or recurrent (DeltaNet). The early large FFN
                spikes are the same outliers the layer lab reports.
            </div>
        </div>
    </section>
}

@code {
    private IReadOnlyList<ModelDescriptor> _models = [];
    private string _selectedModelPath = "";
    private string _prompt = "The quick brown fox jumps over the lazy dog.";
    private int _maxTokens = 64;
    private ModelArchitectureTemplate _template = new();
    private string? _templateStatus;

    protected override async Task OnInitializedAsync()
    {
        Visual.Changed += OnVisualChanged;
        if (_template.LayerTypes.Count != _template.NumLayers)
            SetLayerCount(_template.NumLayers);
        await LoadModelsAsync();
    }

    public void Dispose() => Visual.Changed -= OnVisualChanged;

    private void OnVisualChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadModelsAsync()
    {
        _models = [.. (await Catalog.RefreshAsync()).Where(model => model.Path.EndsWith(".gguf", StringComparison.OrdinalIgnoreCase))];
        _selectedModelPath = _models.Any(model => model.Path == Theme.LastChatModel)
            ? Theme.LastChatModel!
            : _models.FirstOrDefault()?.Path ?? "";
    }

    private async Task RememberModelAsync()
    {
        if (!string.IsNullOrWhiteSpace(_selectedModelPath))
            await Theme.SetLastChatModelAsync(_selectedModelPath);
    }

    private async Task RunAsync()
    {
        ModelDescriptor? model = _models.FirstOrDefault(item => item.Path == _selectedModelPath);
        if (model is null) return;
        await Visual.RunAsync(model, _prompt, Math.Clamp(_maxTokens, 1, 256));
    }

    private void SetTemplateName(string? name)
    {
        _template = _template with
        {
            Name = string.IsNullOrWhiteSpace(name) ? "visualizer-template" : name.Trim(),
        };
    }

    private void SeedFromModel()
    {
        ModelDescriptor? model = _models.FirstOrDefault(item => item.Path == _selectedModelPath);
        if (model is null) return;
        _template = ModelArchitectureTemplate.FromDescriptor(model, model.DisplayName);
        _templateStatus = $"Seeded from {model.FileName}.";
    }

    private void ResetTemplate()
    {
        _template = new ModelArchitectureTemplate();
        _templateStatus = "Blank template.";
    }

    private void AddLayer()
    {
        List<string> layers = [.. _template.LayerTypes, "Full"];
        _template = _template with { LayerTypes = layers, NumLayers = layers.Count };
    }

    private void InsertLayerAfter(int index)
    {
        List<string> layers = [.. _template.LayerTypes];
        layers.Insert(Math.Clamp(index + 1, 0, layers.Count), "Full");
        _template = _template with { LayerTypes = layers, NumLayers = layers.Count };
    }

    private void RemoveLayer(int index)
    {
        if (_template.LayerTypes.Count <= 1) return;
        List<string> layers = [.. _template.LayerTypes];
        if ((uint)index < (uint)layers.Count) layers.RemoveAt(index);
        _template = _template with { LayerTypes = layers, NumLayers = layers.Count };
    }

    private void SetLayerType(int index, string? type)
    {
        List<string> layers = [.. _template.LayerTypes];
        if ((uint)index >= (uint)layers.Count) return;
        layers[index] = ModelArchitectureTemplate.Normalize(type);
        _template = _template with { LayerTypes = layers };
    }

    private void SetLayerCount(int count)
    {
        int target = Math.Clamp(count, 1, 128);
        List<string> layers = [.. _template.LayerTypes];
        while (layers.Count < target) layers.Add("Full");
        if (layers.Count > target) layers.RemoveRange(target, layers.Count - target);
        _template = _template with { NumLayers = target, LayerTypes = layers };
    }

    private async Task OpenTemplateAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.File,
            StudioPaths.Training,
            "Open architecture template",
            "*.json");
        string? path = selection?.All.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(path)) return;
        try
        {
            _template = ModelArchitectureTemplate.Load(path);
            _templateStatus = $"Opened {Path.GetFileName(path)}.";
        }
        catch (Exception ex)
        {
            _templateStatus = $"Could not open template: {ex.Message}";
        }
    }

    private async Task SaveTemplateAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.SaveFile,
            StudioPaths.Training,
            "Save architecture template",
            "*.json");
        string? path = selection?.All.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(path)) return;
        if (!path.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            path += ".json";
        try
        {
            _template.Save(path);
            _templateStatus = $"Saved {Path.GetFileName(path)}.";
        }
        catch (Exception ex)
        {
            _templateStatus = $"Could not save template: {ex.Message}";
        }
    }

    private void ApplyTemplateToTraining()
    {
        TrainingJobSettings job = Training.Draft?.Clone() ?? new TrainingJobSettings();
        _template.ApplyTo(job);
        Training.Draft = job;
        Training.PendingTemplate = _template;
        _templateStatus = "Sent to Training > New model.";
        Nav.NavigateTo("/training?tab=new");
    }

    private static int ParseInt(object? value, int fallback) =>
        int.TryParse(value?.ToString(), out int parsed) ? parsed : fallback;

    private string TokenLabel(int token) =>
        token < Visual.TokenText.Length ? Visual.TokenText[token] : "";

    private string LayerType(int layer)
    {
        ModelConfig? config = Visual.Config;
        if (config is null) return "";
        if (config.LayerKvHeads is { } kv && layer < kv.Length && kv[layer] == 0)
            return "linear";
        if (config.IsRecurrentLayer(layer))
            return "recurrent";
        if (config.SwaLayers is { } swa && layer < swa.Length)
            return swa[layer] ? "sliding" : "full";
        if (config.SlidingWindowSize > 0 && config.IsHybridSlidingWindow &&
            config.SlidingWindowPattern is { } period && period > 0)
        {
            return layer % period == period - 1 ? "full" : "sliding";
        }
        return config.SlidingWindowSize > 0 ? "sliding" : "attention";
    }

    private static string Alpha(float value, float max)
    {
        double maxLog = Math.Log10(1 + max);
        double normalized = maxLog <= 1e-9 ? 0 : Math.Log10(1 + value) / maxLog;
        return Math.Clamp(normalized * 0.9, 0.03, 0.95).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }
}
