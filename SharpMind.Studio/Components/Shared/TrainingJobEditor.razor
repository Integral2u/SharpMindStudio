        }
    }

    private void ApplyPreset(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            Job.ArchitecturePreset = null;
            return;
        }

        TrainingPreset? preset = TrainingModelOptions.Presets
            .FirstOrDefault(p => p.ArchitecturePresetKey == key);
        if (preset is not null) TrainingModelOptions.Apply(Job, preset);
    }

    private void ApplySize(int hidden, int layers, int heads, int kvHeads, int ffn, int seqLen)
    {
        Job.HiddenDim = hidden;
        Job.NumLayers = layers;
        Job.NumHeads = heads;
        Job.NumKvHeads = kvHeads;
        Job.FfnDim = ffn;
        Job.MaxSeqLen = seqLen;
        Job.LayerTypes = [.. Enumerable.Repeat("Full", layers)];
    }

    private string LayerPlanText =>
        Job.LayerTypes.Count == 0 ? "" : string.Join(", ", Job.LayerTypes);

    private void SetLayerPlanText(string? text)
    {
        string[] parts = (text ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        Job.LayerTypes = parts.Length == 0
            ? []
            : [.. parts.Select(ModelArchitectureTemplate.Normalize)];
        if (Job.LayerTypes.Count > 0)
            Job.NumLayers = Job.LayerTypes.Count;
    }

    private string? _templateError;

    private async Task OpenTemplateAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.File,
            StudioPaths.Training,
            "Open architecture template",
            "*.json");
        string? path = selection?.All.FirstOrDefault();
        if (string.IsNullOrWhiteSpace(path)) return;
        try
        {
            ModelArchitectureTemplate template = ModelArchitectureTemplate.Load(path);
            template.ApplyTo(Job);
            Training.PendingTemplate = template;
            _templateError = null;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _templateError = $"Could not open template: {ex.Message}";
        }
    }

    private void ApplyVisualizerTemplate()
    {
        Training.PendingTemplate?.ApplyTo(Job);
        StateHasChanged();
    }
