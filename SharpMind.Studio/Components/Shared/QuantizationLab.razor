@using SharpMind.Model.Analysis
@using SharpMind.Studio.Services
@inject ModelCatalogService Catalog
@inject StudioQuantizationLabService Quant
@inject ThemeService Theme
@implements IDisposable

<div class="page-head">
    <div>
        <div class="eyebrow">Model analysis</div>
        <h1>Quantization</h1>
        <p class="faint">
            Compare a reference GGUF with a smaller quantization tensor by tensor. The relative L2
            and cosine are weight-level; no forward pass or model load is needed.
        </p>
    </div>
</div>

<section class="panel">
    <div class="panel-body stack">
        <div class="row">
            <div class="field grow">
                <label class="field-label">Reference (usually Q8_0 / F16)</label>
                <select class="input" @bind="_referencePath" @bind:after="OnReferenceChangedAsync" disabled="@Quant.IsRunning">
                    @foreach (ModelDescriptor model in _models)
                    {
                        <option value="@model.Path">@model.DisplayName (@model.FileName)</option>
                    }
                </select>
            </div>
            <div class="field grow">
                <label class="field-label">Candidate quantization</label>
                <select class="input" @bind="_candidatePath" @bind:after="CheckCompatibilityAsync" disabled="@Quant.IsRunning">
                    @foreach (ModelDescriptor model in _models)
                    {
                        <option value="@model.Path">@model.DisplayName (@model.FileName)</option>
                    }
                </select>
            </div>
        </div>

        @if (_checkingCompatibility)
        {
            <div class="small faint">Checking the pair...</div>
        }
        else if (_compatibility is { } compatibility)
        {
            @if (compatibility.SameModel)
            {
                <div class="small faint">
                    Same model: every tensor name and shape matches, so this is a valid
                    quantization pair.
                </div>
            }
            else
            {
                <div class="error-line">
                    Different model: @(compatibility.Note ?? "the tensor layouts differ.")
                </div>
                <div class="small faint">
                    The weight metrics still run, but the forward loss is disabled until both
                    files are the same model at two quantizations.
                </div>
            }
        }

        <div class="row">
            <div class="field grow">
                <label class="field-label">Tensor filter (optional)</label>
                <input class="input" @bind="_filter" placeholder="blk.0 or ffn_down" disabled="@Quant.IsRunning" />
            </div>
            <div class="field">
                <label class="field-label">Max tensors (0 = all)</label>
                <input class="input" type="number" min="0" @bind="_maxTensors" disabled="@Quant.IsRunning" />
            </div>
        </div>

        <div class="row">
            <button type="button" class="button primary" @onclick="RunAsync"
                    disabled="@(Quant.IsRunning || Quant.IsQuantizing || _models.Count < 2 ||
                                string.IsNullOrWhiteSpace(_referencePath) ||
                                string.IsNullOrWhiteSpace(_candidatePath) || _referencePath == _candidatePath)">
                @(Quant.IsRunning ? "Comparing..." : "Compare")
            </button>
            <button type="button" class="button" @onclick="Quant.Cancel"
                    disabled="@(!(Quant.IsRunning || Quant.IsQuantizing))">
                Cancel
            </button>
            <span class="status-line">@Quant.Status</span>
        </div>

        @if (Quant.Error is { } error)
        {
            <div class="error-line">@error</div>
        }
        @if (_models.Count < 2)
        {
            <div class="small faint">Add at least two GGUF models to compare quantizations.</div>
        }
        @if (_referencePath == _candidatePath && _models.Count >= 2)
        {
            <div class="small faint">Pick two different files.</div>
        }
    </div>
</section>

@if (Quant.Report is { } report)
{
    <section class="panel">
        <div class="panel-head">
            <div>
                <div class="eyebrow">Result</div>
                <h2>@Path.GetFileName(report.ReferencePath) → @Path.GetFileName(report.CandidatePath)</h2>
            </div>
            <span class="faint small mono">
                global L2 @report.GlobalRelativeL2.ToString("F4") · cosine @report.MeanCosine.ToString("F5") ·
                @report.Compared compared / @report.Skipped skipped · @Quant.ElapsedSeconds.ToString("F0")s
            </span>
        </div>
        <div class="panel-body">
            @if (report.SameModel)
            {
                <div class="small faint">
                    Same model: every tensor name and shape matches, so this is a valid
                    quantization pair.
                </div>
            }
            else
            {
                <div class="error-line">
                    Not the same model: @(report.CompatibilityNote ?? "the tensor layouts differ.")
                </div>
                <div class="small faint">
                    The weight metrics above are still shown, but the forward-loss comparison
                    is disabled until both files are the same model at two quantizations.
                </div>
            }
            <table class="table">
                <thead>
                    <tr>
                        <th>Tensor</th>
                        <th>Reference</th>
                        <th>Candidate</th>
                        <th>Rel. L2</th>
                        <th>Cosine</th>
                        <th>Max abs</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TensorQuantizationError tensor in report.Worst(40))
                    {
                        <tr>
                            <td class="mono">@tensor.Name</td>
                            <td class="mono">@tensor.ReferenceDtype</td>
                            <td class="mono">@tensor.CandidateDtype</td>
                            <td class="mono">@tensor.RelativeL2.ToString("F4")</td>
                            <td class="mono">@tensor.Cosine.ToString("F5")</td>
                            <td class="mono">@tensor.MaxAbsError.ToString("F5")</td>
                            <td class="lab-bar-cell">
                                <div class="lab-bar" style="width:@(BarWidth(tensor.RelativeL2))%"></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="small faint">
                Worst tensors first. The calibration-loss section below measures the actual
                next-token loss, but it has to load both models in turn.
            </div>
        </div>
    </section>
}

<section class="panel">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Forward comparison</div>
            <h2>Calibration loss</h2>
        </div>
        <span class="faint small mono">loads each model sequentially</span>
    </div>
    <div class="panel-body stack">
        <div class="field">
            <label class="field-label">Calibration text</label>
            <textarea class="input" rows="3" @bind="_calibration" disabled="@(Quant.IsRunning || Quant.IsQuantizing)"></textarea>
        </div>
        <div class="row">
            <div class="field">
                <label class="field-label">Max tokens</label>
                <input class="input" type="number" min="8" max="512" @bind="_lossTokens" disabled="@(Quant.IsRunning || Quant.IsQuantizing)" />
            </div>
            <button type="button" class="button" @onclick="RunLossAsync"
                    disabled="@(Quant.IsRunning || Quant.IsQuantizing || Quant.Report?.SameModel == false || _models.Count < 2 ||
                                string.IsNullOrWhiteSpace(_referencePath) ||
                                string.IsNullOrWhiteSpace(_candidatePath) || _referencePath == _candidatePath)">
                @(Quant.IsRunning ? "Running..." : "Compare loss")
            </button>
            <span class="status-line">@Quant.Status</span>
        </div>

        @if (Quant.Error is { } lossError)
        {
            <div class="error-line">@lossError</div>
        }

        @if (Quant.ReferenceLoss is { } referenceLoss && Quant.CandidateLoss is { } candidateLoss)
        {
            <table class="table">
                <thead>
                    <tr><th>File</th><th>Cross-entropy</th><th>Perplexity</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="mono">@Path.GetFileName(_referencePath)</td>
                        <td class="mono">@referenceLoss.ToString("F4")</td>
                        <td class="mono">@Math.Exp(referenceLoss).ToString("F2")</td>
                    </tr>
                    <tr>
                        <td class="mono">@Path.GetFileName(_candidatePath)</td>
                        <td class="mono">@candidateLoss.ToString("F4")</td>
                        <td class="mono">@Math.Exp(candidateLoss).ToString("F2")</td>
                    </tr>
                </tbody>
            </table>
            <div class="small faint">
                @Quant.LossTokens prediction tokens · candidate delta
                @(Quant.LossDelta?.ToString("+0.0000;-0.0000;0.0000") ?? "0.0000") nats.
            </div>
        }
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Actual quantization</div>
            <h2>Write a smaller GGUF</h2>
        </div>
        <span class="faint small mono">fixed, per-role blend or a byte budget</span>
    </div>
    <div class="panel-body stack">
        <div class="row">
            <div class="field grow">
                <span class="field-label">Source model</span>
                <div class="mono">@(string.IsNullOrWhiteSpace(_referencePath) ? "none" : Path.GetFileName(_referencePath))</div>
            </div>
            <div class="field">
                <label class="field-label">Target</label>
                <select class="input" @bind="_quantizeTarget" disabled="@(Quant.IsQuantizing || Quant.IsRunning)">
                    <option value="q4k">Q4_K</option>
                    <option value="q5k">Q5_K</option>
                    <option value="q6k">Q6_K</option>
                    <option value="q8k">Q8_K</option>
                    <option value="q8_0">Q8_0</option>
                    <option value="q4_0">Q4_0</option>
                    <option value="q3k">Q3_K</option>
                    <option value="q2k">Q2_K</option>
                    <option value="f16">F16</option>
                    <option value="blend">Blend (emb/head Q8_K, rest Q4_K)</option>
                </select>
            </div>
            <div class="field">
                <label class="field-label">Budget MB (0 = fixed)</label>
                <input class="input" type="number" min="0" @bind="_quantizeBudgetMb"
                       disabled="@(Quant.IsQuantizing || Quant.IsRunning)" />
            </div>
            <button type="button" class="button primary" @onclick="RunQuantizeAsync"
                    disabled="@(Quant.IsQuantizing || Quant.IsRunning || _models.Count == 0 ||
                                string.IsNullOrWhiteSpace(_referencePath) ||
                                !_referencePath.EndsWith(".gguf", StringComparison.OrdinalIgnoreCase))">
                @(Quant.IsQuantizing ? "Quantizing..." : "Quantize")
            </button>
            <span class="status-line">@Quant.QuantizeStatus</span>
        </div>

        @if (Quant.QuantizeError is { } quantizeError)
        {
            <div class="error-line">@quantizeError</div>
        }

        @if (Quant.QuantizeResult is { } quantized)
        {
            <table class="table">
                <thead>
                    <tr><th>File</th><th>Size</th><th>Tensors</th><th>Requantized</th><th>Copied</th><th>Dtypes</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="mono">@Path.GetFileName(quantized.Path)</td>
                        <td class="mono">@((quantized.Bytes / (1024.0 * 1024.0)).ToString("F1")) MB</td>
                        <td class="mono">@quantized.Tensors</td>
                        <td class="mono">@quantized.Requantized</td>
                        <td class="mono">@quantized.Copied</td>
                        <td class="mono">
                            @string.Join(", ", quantized.Counts.OrderBy(pair => pair.Key)
                                .Select(pair => $"{pair.Key}:{pair.Value}"))
                        </td>
                    </tr>
                </tbody>
            </table>
            <div class="small mono">@quantized.Path</div>
            <div class="small faint">
                @((100.0 * quantized.Bytes / Math.Max(1, quantized.SourceBytes)).ToString("F1"))%
                of the source size. The new file is next to the source; refresh the model list
                to open it.
            </div>
        }

        <div class="small faint">
            A budget switches to variable quantization: the plan picks the coarsest K-quant
            that fits. K-quant rows are written row-padded, and the engine pads the input
            rows at inference so models whose hidden size is not 256-aligned (for example
            Qwen2-0.5B at 896) run the full quantization instead of a fallback.
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<ModelDescriptor> _models = [];
    private string _referencePath = "";
    private string _candidatePath = "";
    private string _filter = "";
    private int _maxTensors = 0;
    private string _calibration =
        "The quick brown fox jumps over the lazy dog. A quantization should preserve the next-token distribution.";
    private int _lossTokens = 64;
    private string _quantizeTarget = "q4k";
    private int _quantizeBudgetMb;
    private QuantizationCompatibility? _compatibility;
    private bool _checkingCompatibility;

    protected override async Task OnInitializedAsync()
    {
        Quant.Changed += OnQuantChanged;
        await LoadModelsAsync();
    }

    public void Dispose() => Quant.Changed -= OnQuantChanged;

    private void OnQuantChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task LoadModelsAsync()
    {
        _models = [.. (await Catalog.RefreshAsync())
            .Where(model => model.Path.EndsWith(".gguf", StringComparison.OrdinalIgnoreCase))];
        _referencePath = _models.Any(model => model.Path == Theme.LastChatModel)
            ? Theme.LastChatModel!
            : _models.FirstOrDefault()?.Path ?? "";
        _candidatePath = _models
            .FirstOrDefault(model => !string.Equals(model.Path, _referencePath, StringComparison.OrdinalIgnoreCase))?
            .Path ?? _referencePath;
        await CheckCompatibilityAsync();
    }

    private async Task OnReferenceChangedAsync()
    {
        if (!string.IsNullOrWhiteSpace(_referencePath))
            await Theme.SetLastChatModelAsync(_referencePath);
        await CheckCompatibilityAsync();
    }

    private async Task CheckCompatibilityAsync()
    {
        _compatibility = null;
        if (string.IsNullOrWhiteSpace(_referencePath) ||
            string.IsNullOrWhiteSpace(_candidatePath) ||
            _referencePath == _candidatePath)
        {
            _checkingCompatibility = false;
            return;
        }

        _checkingCompatibility = true;
        try
        {
            string reference = _referencePath;
            string candidate = _candidatePath;
            QuantizationCompatibility result = await Task.Run(() =>
                QuantizationAnalyzer.CheckModelCompatibility(reference, candidate));
            if (_referencePath == reference && _candidatePath == candidate)
                _compatibility = result;
        }
        catch (Exception ex)
        {
            _compatibility = new QuantizationCompatibility(
                false, $"{ex.GetType().Name}: {ex.Message}", []);
        }
        finally
        {
            _checkingCompatibility = false;
        }
    }

    private async Task RunAsync()
    {
        string? filter = string.IsNullOrWhiteSpace(_filter) ? null : _filter.Trim();
        await Quant.RunAsync(_referencePath, _candidatePath, filter, Math.Max(0, _maxTensors));
    }

    private async Task RunLossAsync()
    {
        ModelDescriptor? reference = _models.FirstOrDefault(model => model.Path == _referencePath);
        ModelDescriptor? candidate = _models.FirstOrDefault(model => model.Path == _candidatePath);
        if (reference is null || candidate is null) return;
        await Quant.RunLossAsync(reference, candidate, _calibration, Math.Clamp(_lossTokens, 8, 512));
    }

    private async Task RunQuantizeAsync()
    {
        ModelDescriptor? source = _models.FirstOrDefault(model => model.Path == _referencePath);
        if (source is null) return;
        await Quant.QuantizeAsync(source, _quantizeTarget, Math.Max(0, _quantizeBudgetMb));
    }

    private double BarWidth(double relativeL2)
    {
        double max = Quant.Report?.Tensors.Max(tensor => tensor.RelativeL2) ?? 0;
        if (max <= 1e-12) return 0;
        return Math.Clamp(relativeL2 / max * 100, 1, 100);
    }
}
