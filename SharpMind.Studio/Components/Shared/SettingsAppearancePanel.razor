@using SharpMind.Studio.Services
@implements IDisposable
@inject ThemeService Theme

<details class="panel settings-collapsible">
    <summary class="panel-head">
        <div>
            <div class="eyebrow">UI &amp; Appearance</div>
            <h2>Light or dark</h2>
        </div>
        <span class="faint small mono">@ThemeService.LabelAppearance(Theme.Appearance)</span>
    </summary>
    <div class="panel-body stack">
        <div class="segmented appearance-toggle" role="group" aria-label="Appearance">
            @foreach (string appearance in ThemeService.AvailableAppearances)
            {
                <button type="button"
                        class="segmented-option @(Theme.Appearance == appearance ? "active" : "")"
                        @onclick="() => SetAppearanceAsync(appearance)">
                    @ThemeService.LabelAppearance(appearance)
                </button>
            }
        </div>
        <span class="small faint">
            A custom accent is kept inside the range that stays readable for the appearance:
            near-white is not allowed on a light surface and near-black is not allowed on a dark one.
            An existing choice outside the range is moved to the nearest allowed colour.
        </span>
    </div>
</details>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">UI &amp; Appearance</div>
            <h2>Accent colour</h2>
        </div>
        <span class="faint small mono">@ThemeService.Label(Theme.Theme)</span>
    </summary>
    <div class="panel-body stack">
        <div class="theme-grid">
            @foreach (string theme in new[] { "green", "blue", "purple", "red" })
            {
                <a class="theme-option @(Theme.Theme == theme ? "selected" : "")"
                   href="/settings?tab=appearance&theme=@theme"
                   data-enhance-nav="false">
                    <span class="theme-swatch @theme"></span>
                    <span>@ThemeService.Label(theme)</span>
                </a>
            }

            <a class="theme-option theme-option-custom @(Theme.Theme == "custom" ? "selected" : "")"
               href="/settings?tab=appearance&theme=custom"
               data-enhance-nav="false">
                <span class="theme-swatch custom" style="background:@Theme.CustomColor"></span>
                <span>Custom</span>
            </a>
        </div>

        <div class="custom-color-row">
            <div class="field">
                <label class="field-label" for="custom-color">Custom accent</label>
                <input id="custom-color" class="color-input" type="color"
                       value="@Theme.CustomColor" title="Custom accent"
                       @onchange="ApplyCustomColorAsync" />
            </div>
            <span class="small faint">Choosing a custom colour switches the theme to Custom.</span>
        </div>
    </div>
</details>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">UI &amp; Appearance</div>
            <h2>Agent interfaces</h2>
        </div>
        <span class="faint small mono">@(Theme.A2uiEnabled ? "On" : "Off")</span>
    </summary>
    <div class="panel-body stack">
        <label class="field grow">
            <span class="field-label">A2UI interfaces in Chat and Work</span>
            <input type="checkbox" checked="@Theme.A2uiEnabled" @onchange="SetA2uiAsync" />
        </label>
        <span class="small faint">
            Agents can render small forms, choice cards and structured results with
            native widgets. The payload is declarative and cannot execute code; a
            button only sends an event back to the agent. Turn this off to keep every
            reply text-only. Existing surfaces remain readable.
        </span>
    </div>
</details>

@code {
    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SetAppearanceAsync(string appearance) =>
        Theme.SetThemeAsync(Theme.Theme, Theme.CustomColor, appearance);

    private Task SetA2uiAsync(ChangeEventArgs args) =>
        Theme.SetA2uiEnabledAsync(args.Value is bool enabled && enabled);

    private async Task ApplyCustomColorAsync(ChangeEventArgs args)
    {
        string? color = ThemeService.NormalizeColor(args.Value?.ToString());
        if (color is null) return;
        await Theme.SetThemeAsync("custom", color, Theme.Appearance);
    }
}
