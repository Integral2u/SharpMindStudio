@using SharpMind.Studio.Services
@implements IDisposable
@inject StudioWorkspaceService Workspace
@inject IJSRuntime JS

<details class="panel settings-collapsible">
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Recovery</div>
            <h2>Archived projects</h2>
        </div>
        <span class="faint small mono">@Workspace.ArchivedProjects.Count archived</span>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            Archiving a Work project moves its entire folder here. Recovering returns it to
            Workspaces; deleting here removes the archived folder permanently.
        </p>
        @if (Workspace.ArchivedProjects.Count == 0)
        {
            <div class="small faint">No archived projects.</div>
        }
        else
        {
            @foreach (StudioProjectInfo project in Workspace.ArchivedProjects)
            {
                <div class="work-context" style="align-items:flex-start;">
                    <div style="flex:1;">
                        <strong>@project.Name</strong>
                        <div class="small faint mono">@project.Path</div>
                    </div>
                    <div class="row" style="gap:.35rem;">
                        <button type="button" class="button" @onclick="() => RecoverAsync(project)">
                            Recover
                        </button>
                        <button type="button" class="button danger" @onclick="() => DeleteAsync(project)">
                            Delete
                        </button>
                    </div>
                </div>
            }
        }
        <div class="small faint">@_status</div>
    </div>
</details>

@code {
    private string _status = "";

    protected override void OnInitialized() => Workspace.ProjectChanged += OnProjectChanged;

    public void Dispose() => Workspace.ProjectChanged -= OnProjectChanged;

    private void OnProjectChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task RecoverAsync(StudioProjectInfo project)
    {
        try
        {
            var restored = Workspace.RestoreArchivedProject(project.Path);
            Workspace.SwitchProject(restored.Root);
            _status = $"Recovered {project.Name}.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }

        await Task.CompletedTask;
    }

    private async Task DeleteAsync(StudioProjectInfo project)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Permanently delete the archived project '{project.Name}' and every file under:\n\n"
            + $"{project.Path}\n\nThis cannot be undone.");
        if (!confirmed) return;

        try
        {
            Workspace.DeleteArchivedProject(project.Path);
            _status = $"Deleted archived project {project.Name}.";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }
}
