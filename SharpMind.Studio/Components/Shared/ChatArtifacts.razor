@using SharpMind.Inference.Chat

@if (Artifacts is { Length: > 0 })
{
    <div class="chat-artifacts">
        @foreach (ChatArtifact artifact in Artifacts)
        {
            if (IsImage(artifact))
            {
                <img class="chat-artifact-image" src="@DataUrl(artifact)"
                     alt="@(artifact.FileName ?? "image")" />
            }
            else if (IsAudio(artifact))
            {
                <audio class="chat-artifact-audio" controls src="@DataUrl(artifact)"></audio>
            }
            else if (IsText(artifact))
            {
                <pre class="chat-artifact-text">@Text(artifact)</pre>
            }
            else
            {
                <a class="button chat-artifact-file" download="@(artifact.FileName ?? "artifact")"
                   href="@DataUrl(artifact)">
                    @(artifact.FileName ?? $"Download {artifact.Type}")
                </a>
            }
        }
    </div>
}

@code {
    [Parameter] public ChatArtifact[]? Artifacts { get; set; }

    private static bool IsImage(ChatArtifact artifact) =>
        artifact.Type.Contains("image", StringComparison.OrdinalIgnoreCase);

    private static bool IsAudio(ChatArtifact artifact) =>
        artifact.Type.Contains("audio", StringComparison.OrdinalIgnoreCase);

    private static bool IsText(ChatArtifact artifact) =>
        artifact.Type.Contains("text", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("code", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("json", StringComparison.OrdinalIgnoreCase);

    private static string DataUrl(ChatArtifact artifact) =>
        $"data:{Mime(artifact)};base64,{Convert.ToBase64String(artifact.Content)}";

    private static string Text(ChatArtifact artifact) =>
        System.Text.Encoding.UTF8.GetString(artifact.Content);

    private static string Mime(ChatArtifact artifact)
    {
        if (artifact.Type.Contains('/')) return artifact.Type;
        string extension = Path.GetExtension(artifact.FileName ?? "").ToLowerInvariant();
        return artifact.Type.ToLowerInvariant() switch
        {
            "image" => extension switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                _ => "image/png",
            },
            "audio" => extension switch
            {
                ".mp3" => "audio/mpeg",
                ".wav" => "audio/wav",
                ".ogg" => "audio/ogg",
                ".m4a" => "audio/mp4",
                _ => "audio/wav",
            },
            "json" => "application/json",
            "code" or "text" => "text/plain;charset=utf-8",
            _ => "application/octet-stream",
        };
    }
}
