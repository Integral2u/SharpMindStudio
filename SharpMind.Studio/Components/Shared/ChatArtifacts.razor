@using SharpMind.Inference.Chat

@if (Artifacts is { Length: > 0 })
{
    <div class="chat-artifacts">
        @foreach (ChatArtifact artifact in Artifacts)
        {
            string url = DataUrl(artifact);
            string name = artifact.FileName ?? DefaultName(artifact);
            <div class="chat-artifact-card">
                <div class="chat-artifact-head">
                    <span>@Label(artifact) &middot; @(Duration(artifact) is { } duration ? $"{duration} · " : "")@Size(artifact)</span>
                    <span class="chat-artifact-actions">
                        @if (IsImage(artifact))
                        {
                            <a href="@url" target="_blank" rel="noopener">Open</a>
                        }
                        <a href="@url" download="@name">Download</a>
                    </span>
                </div>
                @if (IsImage(artifact))
                {
                    <img class="chat-artifact-image" src="@url" alt="@name" />
                }
                else if (IsAudio(artifact))
                {
                    <audio class="chat-artifact-audio" controls src="@url"></audio>
                }
                else if (IsText(artifact))
                {
                    <pre class="chat-artifact-text">@Text(artifact)</pre>
                }
                else
                {
                    <a class="button chat-artifact-file" download="@name" href="@url">@name</a>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public ChatArtifact[]? Artifacts { get; set; }

    private static bool IsImage(ChatArtifact artifact) =>
        artifact.Type.Contains("image", StringComparison.OrdinalIgnoreCase);

    private static bool IsAudio(ChatArtifact artifact) =>
        artifact.Type.Contains("audio", StringComparison.OrdinalIgnoreCase);

    private static bool IsText(ChatArtifact artifact) =>
        artifact.Type.Contains("text", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("code", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("json", StringComparison.OrdinalIgnoreCase);

    private static string Label(ChatArtifact artifact) =>
        IsImage(artifact) ? "Image"
        : IsAudio(artifact) ? "Audio"
        : artifact.Type.Contains("json", StringComparison.OrdinalIgnoreCase) ? "JSON"
        : IsText(artifact) ? "Text"
        : "File";

    private static string DefaultName(ChatArtifact artifact) =>
        artifact.Type.ToLowerInvariant() switch
        {
            "image" => "image.png",
            "audio" => "audio.wav",
            "json" => "response.json",
            "code" => "response.txt",
            "text" => "response.txt",
            _ => "artifact.bin",
        };

    private static string Size(ChatArtifact artifact)
    {
        long bytes = artifact.Content.LongLength;
        return bytes < 1024 ? $"{bytes} B"
            : bytes < 1024 * 1024 ? $"{bytes / 1024.0:F1} KB"
            : $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    /// <summary>
    /// Reads the duration out of a RIFF/WAVE header. Short synthesized clips are
    /// otherwise indistinguishable from an empty one in the HTML player (which
    /// rounds anything under a second to 0:00).
    /// </summary>
    private static string? Duration(ChatArtifact artifact)
    {
        if (!IsAudio(artifact)) return null;
        byte[] bytes = artifact.Content;
        if (bytes.Length < 44 ||
            bytes[0] != (byte)'R' || bytes[1] != (byte)'I' ||
            bytes[2] != (byte)'F' || bytes[3] != (byte)'F' ||
            bytes[8] != (byte)'W' || bytes[9] != (byte)'A' ||
            bytes[10] != (byte)'V' || bytes[11] != (byte)'E')
            return null;

        int sampleRate = 0, channels = 0, bits = 0, dataSize = 0;
        int position = 12;
        while (position + 8 <= bytes.Length)
        {
            string id = System.Text.Encoding.ASCII.GetString(bytes, position, 4);
            int size = BitConverter.ToInt32(bytes, position + 4);
            if (size < 0) break;

            if (id == "fmt " && position + 24 <= bytes.Length)
            {
                channels = BitConverter.ToUInt16(bytes, position + 10);
                sampleRate = BitConverter.ToInt32(bytes, position + 12);
                bits = BitConverter.ToUInt16(bytes, position + 22);
            }
            else if (id == "data")
            {
                dataSize = Math.Min(size, bytes.Length - position - 8);
                break;
            }

            position += 8 + size + (size & 1);
        }

        if (sampleRate <= 0 || channels <= 0 || bits <= 0 || dataSize <= 0) return null;
        double seconds = (double)dataSize / (sampleRate * channels * (bits / 8));
        return seconds < 60
            ? $"{seconds:0.0} s"
            : $"{(int)(seconds / 60)}:{(int)(seconds % 60):00}";
    }

    private static string DataUrl(ChatArtifact artifact) =>
        $"data:{Mime(artifact)};base64,{Convert.ToBase64String(artifact.Content)}";

    private static string Text(ChatArtifact artifact) =>
        System.Text.Encoding.UTF8.GetString(artifact.Content);

    private static string Mime(ChatArtifact artifact)
    {
        if (artifact.Type.Contains('/')) return artifact.Type;
        string extension = Path.GetExtension(artifact.FileName ?? "").ToLowerInvariant();
        return artifact.Type.ToLowerInvariant() switch
        {
            "image" => extension switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                _ => "image/png",
            },
            "audio" => extension switch
            {
                ".mp3" => "audio/mpeg",
                ".wav" => "audio/wav",
                ".ogg" => "audio/ogg",
                ".m4a" => "audio/mp4",
                _ => "audio/wav",
            },
            "json" => "application/json",
            "code" or "text" => "text/plain;charset=utf-8",
            _ => "application/octet-stream",
        };
    }
}
