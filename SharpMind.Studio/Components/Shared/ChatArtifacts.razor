@using SharpMind.Inference.Chat

@if (Artifacts is { Length: > 0 })
{
    ChatArtifact[] items = Artifacts;
    ChatArtifact? image = items.FirstOrDefault(IsImage);
    ChatArtifact? audio = items.FirstOrDefault(IsAudio);

    <div class="reply-artifacts">
        @if (image is not null)
        {
            <a class="reply-thumb" href="@DataUrl(image)" target="_blank" rel="noopener"
               title="Open @Name(image)">
                <img src="@DataUrl(image)" alt="@Name(image)" />
            </a>
        }

        <div class="reply-chip-row">
            @foreach (ChatArtifact artifact in items.Take(3))
            {
                <span class="reply-chip" title="@Name(artifact)">
                    <span class="kind">@Kind(artifact)</span>
                    <span class="name">@Name(artifact)</span>
                    <span class="size">@Size(artifact)</span>
                    @if (CanOpen(artifact))
                    {
                        <a href="@DataUrl(artifact)" target="_blank" rel="noopener" title="Open">&#8599;</a>
                    }
                    <a href="@DataUrl(artifact)" download="@Name(artifact)" title="Download">&#8595;</a>
                </span>
            }
            @if (items.Length > 3)
            {
                <button type="button" class="composer-overflow"
                        title="More items" @onclick="() => _expanded = !_expanded">
                    @(_expanded ? "−" : "…")
                </button>
            }
        </div>

        @if (_expanded && items.Length > 3)
        {
            <div class="reply-chip-row reply-overflow-list">
                @foreach (ChatArtifact artifact in items.Skip(3))
                {
                    <span class="reply-chip" title="@Name(artifact)">
                        <span class="kind">@Kind(artifact)</span>
                        <span class="name">@Name(artifact)</span>
                        <span class="size">@Size(artifact)</span>
                        @if (CanOpen(artifact))
                        {
                            <a href="@DataUrl(artifact)" target="_blank" rel="noopener" title="Open">&#8599;</a>
                        }
                        <a href="@DataUrl(artifact)" download="@Name(artifact)" title="Download">&#8595;</a>
                    </span>
                }
            </div>
        }

        @if (audio is not null)
        {
            <audio class="chat-artifact-audio" controls src="@DataUrl(audio)"></audio>
        }
    </div>
}

@code {
    [Parameter] public ChatArtifact[]? Artifacts { get; set; }

    private bool _expanded;

    private static bool IsImage(ChatArtifact artifact) =>
        artifact.Type.Contains("image", StringComparison.OrdinalIgnoreCase);

    private static bool IsAudio(ChatArtifact artifact) =>
        artifact.Type.Contains("audio", StringComparison.OrdinalIgnoreCase);

    private static bool IsText(ChatArtifact artifact) =>
        artifact.Type.Contains("text", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("code", StringComparison.OrdinalIgnoreCase)
        || artifact.Type.Contains("json", StringComparison.OrdinalIgnoreCase);

    private static bool CanOpen(ChatArtifact artifact) =>
        IsImage(artifact) || IsText(artifact)
        || (artifact.MimeType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase);

    private static string Kind(ChatArtifact artifact) =>
        IsImage(artifact) ? "IMG"
        : IsAudio(artifact) ? "AUD"
        : artifact.Type.Contains("json", StringComparison.OrdinalIgnoreCase) ? "JSON"
        : artifact.Type.Contains("code", StringComparison.OrdinalIgnoreCase) ? "CODE"
        : IsText(artifact) ? "TXT"
        : (artifact.MimeType ?? "").Contains("pdf", StringComparison.OrdinalIgnoreCase) ? "PDF"
        : (artifact.MimeType ?? "").Contains("zip", StringComparison.OrdinalIgnoreCase) ? "ZIP"
        : "FILE";

    private static string Name(ChatArtifact artifact) =>
        artifact.FileName ?? artifact.Type.ToLowerInvariant() switch
        {
            "image" => "image.png",
            "audio" => "audio.wav",
            "json" => "response.json",
            "code" => "response.txt",
            "text" => "response.txt",
            _ => "artifact.bin",
        };

    private static string Size(ChatArtifact artifact)
    {
        long bytes = artifact.Content.LongLength;
        return bytes < 1024 ? $"{bytes} B"
            : bytes < 1024 * 1024 ? $"{bytes / 1024.0:F0} KB"
            : $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    private static string DataUrl(ChatArtifact artifact) =>
        $"data:{Mime(artifact)};base64,{Convert.ToBase64String(artifact.Content)}";

    private static string Mime(ChatArtifact artifact)
    {
        if (!string.IsNullOrWhiteSpace(artifact.MimeType)) return artifact.MimeType!;
        if (artifact.Type.Contains('/')) return artifact.Type;

        string extension = Path.GetExtension(artifact.FileName ?? "").ToLowerInvariant();
        return artifact.Type.ToLowerInvariant() switch
        {
            "image" => extension switch
            {
                ".jpg" or ".jpeg" => "image/jpeg",
                ".gif" => "image/gif",
                ".webp" => "image/webp",
                _ => "image/png",
            },
            "audio" => extension switch
            {
                ".mp3" => "audio/mpeg",
                ".wav" => "audio/wav",
                ".ogg" => "audio/ogg",
                ".m4a" => "audio/mp4",
                _ => "audio/wav",
            },
            "json" => "application/json",
            "code" or "text" => "text/plain;charset=utf-8",
            _ => "application/octet-stream",
        };
    }
}
