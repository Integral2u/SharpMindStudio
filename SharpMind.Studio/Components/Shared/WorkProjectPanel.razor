    private async Task AddSkillAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSkillName)) return;
        var next = Repo.Skills.Append(new WorkSkill
        {
            Id = "",
            Name = _newSkillName.Trim(),
            Content = _newSkillContent.Trim(),
            DefaultEnabled = true,
        }).ToList();
        Repo.Save(next);
        var created = Repo.Skills.LastOrDefault(skill =>
            skill.Name.Equals(_newSkillName.Trim(), StringComparison.OrdinalIgnoreCase));
        if (created is not null)
        {
            _disabledSystemSkills.Remove(created.Id);
            _enabledSystemSkills.Remove(created.Id);
        }
        _newSkillName = "";
        _newSkillContent = "";
        _showAddSkill = false;
        Work.Reload();
        LoadFields();
        await ChatService.ReloadWorkContextAsync();
    }
    private async Task AddContextAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.Folder,
            Work.ProjectRoot,
            "Choose a context folder");
        if (selection?.Path is not { Length: > 0 } path) return;

        _contexts.Add(new ContextDraft
        {
            Id = Guid.NewGuid().ToString("n"),
            Path = RelativeToProject(path),
        });
    }

    private string RelativeToProject(string path)
    {
        try
        {
            string root = Path.GetFullPath(Work.ProjectRoot);
            string full = Path.GetFullPath(path);
            string prefix = root.TrimEnd(Path.DirectorySeparatorChar) + Path.DirectorySeparatorChar;
            if (full.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                return Path.GetRelativePath(root, full);
        }
        catch
        {
        }
        return path;
    }

    private void RemoveContext(ContextDraft context)
    {
        if (_contexts.Count <= 1) return;
        _contexts.Remove(context);
        _ = AutoSaveAsync();
    }

    /// <summary>
    /// Settings save themselves: every changed field, toggle and segmented
    /// control commits immediately. Free-text fields fire on blur, so a save
    /// never runs halfway through a word.
    /// </summary>
    private string ResolvedCommandPath(AllowedCommand command)
    {
        string? resolved = McpCommandResolver.Resolve(command.Executable);
        return resolved is null ? "not found in PATH" : resolved;
    }

    private static string CapabilityLabel(AllowedCommand command)
    {
        var parts = new List<string>();
        if (command.UsesNetwork) parts.Add("network");
        if (command.Destructive) parts.Add("destructive");
        if (command.AllowInterpreter) parts.Add("interpreter");
        return parts.Count == 0 ? "local only" : string.Join(" · ", parts);
    }

    private async Task SetCommandAccessAsync(CommandAccessMode mode)
    {
        if (_commandAccess == mode) return;

        if (mode == CommandAccessMode.Unrestricted)
        {
            bool confirmed = await JS.InvokeAsync<bool>(
                "confirm",
                "Unrestricted lets RunProcess start any program with your account "
                + "permissions. The softshell stays off. Continue?");
            if (!confirmed) return;
        }

        _commandAccess = mode;
        await SaveAsync();
    }

