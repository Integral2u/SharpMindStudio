    {
        Work.ResetShellDirectory(ChatService.Document?.Id);
        _status = "Shell directory reset to the project root.";
        StateHasChanged();
    }

    private async Task AddCommandAsync()
    {
        string executable = _newCommand.Trim();
        if (executable.Length == 0) return;

        string? resolved = McpCommandResolver.Resolve(executable);
        if (resolved is null)
        {
            _commandStatus = $"'{executable}' was not found in PATH.";
            return;
        }

        if (Path.GetExtension(resolved).ToLowerInvariant() is ".cmd" or ".bat" or ".ps1")
        {
            _commandStatus = $"'{executable}' is a batch or PowerShell shim; allow its native executable instead.";
            return;
        }

        string name = _newCommandAlias.Trim();
        if (name.Length == 0) name = Path.GetFileNameWithoutExtension(executable);
        if (name.Length == 0) name = executable;
        if (HasCommand(name))
        {
            _commandStatus = $"{name} is already allowed.";
            return;
        }

        _allowedCommands.Add(new AllowedCommand
        {
            Name = name,
            Executable = executable,
            ArgumentsPrefix = SplitArguments(_newCommandArgs),
            UsesNetwork = _newCommandNetwork,
            Destructive = _newCommandDestructive,
            AllowInterpreter = _newCommandInterpreter,
        });

        _newCommand = "";
        _newCommandAlias = "";
        _newCommandArgs = "";
        _newCommandNetwork = false;
        _newCommandDestructive = false;
        _newCommandInterpreter = false;
        _commandStatus = $"Added {name}.";
        await AutoSaveAsync();
    }

    private async Task AddPresetAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedPreset)) return;
        AllowedCommand? preset = AllowedCommandPresets.Find(_selectedPreset);
        _selectedPreset = "";
        if (preset is null) return;

        string? resolved = McpCommandResolver.Resolve(preset.Executable);
        if (HasCommand(preset.Name))
        {
            _commandStatus = $"{preset.Name} is already allowed.";
            return;
        }

        _allowedCommands.Add(preset with
        {
            ArgumentsPrefix = [.. preset.ArgumentsPrefix],
        });
        _commandStatus = resolved is null
            ? $"{preset.Name} added, but it is not installed yet."
            : $"Added {preset.Name}.";
        await AutoSaveAsync();
    }

    private async Task RemoveCommandAsync(AllowedCommand command)
    {
        _allowedCommands.Remove(command);
        _commandStatus = $"{command.Name} removed.";
        await AutoSaveAsync();
    }

    private bool HasCommand(string name)
    {
        foreach (AllowedCommand existing in _allowedCommands)
        {
            if (existing.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
                return true;
        }
        return false;
    }

    private static List<string> SplitArguments(string text)
    {
        var values = new List<string>();
        var current = new System.Text.StringBuilder();
        bool quoted = false;

        foreach (char character in text ?? "")
        {
            if (character == '"')
            {
                quoted = !quoted;
                continue;
            }

            if (!quoted && char.IsWhiteSpace(character))
            {
                if (current.Length == 0) continue;
                values.Add(current.ToString());
                current.Clear();
                continue;
            }

            current.Append(character);
        }

        if (current.Length > 0) values.Add(current.ToString());
        return values;
    }

    private async Task AutoSaveAsync()
    {
        if (_saving) return;
        if (ChatService.IsStreaming || ChatService.IsLoading)
        {
            _status = "Finish the current reply to apply settings.";
            return;
        }

        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _status = "Saving...";
        try
        {
            var skillIds = Repo.Skills.Select(skill => skill.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

            var projectSkillNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (ProjectSkillDraft skill in _projectSkills)
            {
                if (string.IsNullOrWhiteSpace(skill.Name))
                {
                    // An untouched "Add project skill" row is not an error.
                    if (string.IsNullOrWhiteSpace(skill.Content)) continue;
                    _status = "Project skills need a name.";
                    return;
                }
                if (!projectSkillNames.Add(skill.Name.Trim()))
                {
                    _status = $"Project skill '{skill.Name.Trim()}' appears more than once.";
                    return;
                }
            }

            WorkSkill[] projectSkills = [.. _projectSkills
                .Where(skill => !string.IsNullOrWhiteSpace(skill.Name))
                .Select(skill => new WorkSkill
                {
                    Id = skill.Id,
                    Name = skill.Name.Trim(),
                    Content = skill.Content.Trim(),
                    DefaultEnabled = true,
                })];
            List<string> disabledProjectSkills = [.. _projectSkills
                .Where(skill => !skill.Enabled)
                .Select(skill => skill.Id)];

            WorkContext[] contexts = [.. _contexts.Select(context => new WorkContext
            {
                Id = context.Id,
                Path = string.IsNullOrWhiteSpace(context.Path) ? "." : context.Path.Trim(),
                Permissions = new WorkPermissions
                {
                    Read = context.Read,
                    Write = context.Write,
                    Delete = context.Delete,
                    Execute = context.Execute,
                    Web = WorkPermission.Never,
                },
            })];
            if (contexts.Length == 0)
                contexts = [new WorkContext { Id = "project-root", Path = "." }];

            string? contextError = WorkContextValidation.Validate(
                contexts, Work.ProjectRoot, out IReadOnlyList<string> contextWarnings);
            if (contextError is not null)
            {
                _status = contextError;
                return;
            }

            Work.Save(
                Work.Settings with
                {
                    SystemPrompt = string.IsNullOrWhiteSpace(_systemPrompt) ? null : _systemPrompt.Trim(),
                    Permissions = Work.Settings.Permissions with { Web = _web },
                    DisabledSystemSkills = [.. _disabledSystemSkills.Where(id => skillIds.Contains(id))],
                    EnabledSystemSkills = [.. _enabledSystemSkills.Where(id => skillIds.Contains(id))],
                    Skills = [.. projectSkills],
                    DisabledProjectSkills = disabledProjectSkills,
                    Contexts = [.. contexts],
                    CommandAccess = _commandAccess,
                    AllowedCommands = [.. _allowedCommands],
                    ToolPermissions = _toolPermissions,
                    DisabledTools = [.. _toolPermissions.Tools
                        .Where(pair => pair.Value == WorkToolPermission.Off)
                        .Select(pair => pair.Key)],
                    EnabledTools = [.. _toolPermissions.Tools
                        .Where(pair => pair.Value != WorkToolPermission.Off)
                        .Select(pair => pair.Key)],
                },
                _memory);

            await ChatService.ReloadWorkContextAsync();
            LoadFields();
            _status = contextWarnings.Count == 0
                ? "Project settings applied."
                : "Project settings applied. " + string.Join(" ", contextWarnings);
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
