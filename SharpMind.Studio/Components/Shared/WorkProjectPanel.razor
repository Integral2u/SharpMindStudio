@using SharpMind.Studio.Services
@using SharpMind.Studio.Core.Mcp
@using SharpMind.Studio.Core.Work
@implements IDisposable
@inject StudioWorkspaceService Workspace
@inject StudioWorkService Work
@inject StudioChatService ChatService
@inject SystemWorkSkillsService Repo
@inject WorkToolService ToolCatalog
@inject StudioDeviceAccess DeviceAccess
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PathPickerService Picker

<div class="work-project panel">
    <div class="work-project-head">
        <div class="work-project-identity">
            <div class="eyebrow">Work project</div>
            <strong>@Workspace.Project.Document.Name</strong>
            <span class="mono">@Workspace.Project.Root</span>
            @if (!string.IsNullOrWhiteSpace(_status))
            {
                <span class="small faint work-project-status">@_status</span>
            }
        </div>
        @if (!DeviceAccess.IsMobile)
        {
            <div class="work-project-actions">
                <select class="input work-project-select" value="@_projectPath" @onchange="SwitchProjectAsync"
                        title="Switch project">
                    @foreach (var project in _projects)
                    {
                        <option value="@project.Path">@project.Name@(project.IsDefault ? " (default)" : "")</option>
                    }
                </select>
                <button type="button" class="button" @onclick="CreateProjectAsync">New project</button>
                <button type="button" class="button" @onclick="NewChatAsync"
                        disabled="@(ChatService.IsStreaming || ChatService.IsLoading)">
                    New chat
                </button>
                <button type="button" class="button @(_showSettings ? "primary" : "")" @onclick="ToggleSettings">
                    @(_showSettings ? "Hide settings" : "Project settings")
                </button>
                <WikiGuideLink Page="work" Label="Work guide" />
            </div>
        }
    </div>

    @if (_showSettings && !DeviceAccess.IsMobile)
    {
        <div class="work-project-body" @onchange="AutoSaveAsync">
            <div class="work-project-grid">
                <div class="field">
                    <label class="field-label" for="work-system-prompt">Project instructions</label>
                    <textarea id="work-system-prompt" class="textarea work-textarea"
                              @bind="_systemPrompt" @bind:event="oninput"
                              placeholder="How should the agent work in this project?"></textarea>
                </div>
                <div class="field">
                    <label class="field-label" for="work-memory">Memory</label>
                    <textarea id="work-memory" class="textarea work-textarea"
                              @bind="_memory" @bind:event="oninput"
                              placeholder="Facts and decisions the agent should remember."></textarea>
                    <div class="small faint mono">@Work.MemoryFile</div>
                </div>
            </div>

            <div class="work-settings-section">
                <div class="spread">
                    <div>
                        <div class="eyebrow">Skills</div>
                        <h3>Project skills</h3>
                    </div>
                    <button type="button" class="button" @onclick="AddProjectSkill">Add project skill</button>
                    <button type="button" class="button" @onclick="ImportProjectSkillsAsync">Import .md</button>
                </div>
                <p class="small faint">
                    These live in this project's <span class="mono">work.json</span>, not the shared repository.
                    A project skill with the same name as a repository skill overrides it here.
                </p>
                @if (_projectSkills.Count == 0)
                {
                    <div class="small faint">No project skills yet.</div>
                }
                else
                {
                    @foreach (ProjectSkillDraft skill in _projectSkills)
                    {
                        <div class="work-skill-card">
                            <div class="row">
                                <input class="input" @bind="skill.Name" placeholder="Skill name" />
                                <label class="tool-toggle">
                                    <input type="checkbox" @bind="skill.Enabled" />
                                    <span>Enabled</span>
                                </label>
                                <button type="button" class="button danger"
                                        @onclick="() => RemoveProjectSkill(skill)">
                                    Delete
                                </button>
                            </div>
                            <textarea class="textarea work-textarea" @bind="skill.Content"
                                      placeholder="Instructions the agent should follow."></textarea>
                            @if (OverridesRepositorySkill(skill))
                            {
                                <span class="small faint">Overrides the repository skill with the same name.</span>
                            }
                        </div>
                    }
                }
            </div>

            <div class="work-settings-section">
                <div class="spread">
                    <div>
                        <div class="eyebrow">Skills</div>
                        <h3>Repository skills</h3>
                    </div>
                    <div class="row">
                        <button type="button" class="button" @onclick="RefreshSkills">Refresh</button>
                        <button type="button" class="button" @onclick="ToggleAddSkill">Add skill</button>
                        <button type="button" class="button" @onclick="ImportRepositorySkillsAsync">Import .md</button>
                    </div>
                </div>
                <p class="small faint">
                    One shared Skills folder. Check the skills this project uses. New projects start from the system defaults. Manage or delete skills in <a href="/settings?tab=system" data-enhance-nav="false">Settings &gt; System</a>.
                </p>
                @if (Repo.Skills.Count == 0)
                {
                    <div class="small faint">No skills in the repository yet. Add one here or copy .md files into @Repo.Folder.</div>
                }
                else
                {
                    <div class="row work-skill-filter">
                        <input class="input" @bind="_skillFilter" @bind:event="oninput"
                               placeholder="Filter skills" />
                        <button type="button" class="button" @onclick="() => SetSkillGroup(true)">All</button>
                        <button type="button" class="button" @onclick="() => SetSkillGroup(false)">None</button>
                    </div>
                    @if (FilteredSkills.Count == 0)
                    {
                        <div class="small faint">No skills match "@_skillFilter".</div>
                    }
                    else
                    {
                        <div class="work-system-skills">
                            @foreach (WorkSkill skill in FilteredSkills)
                            {
                                bool enabled = !_disabledSystemSkills.Contains(skill.Id) &&
                                               (skill.DefaultEnabled || _enabledSystemSkills.Contains(skill.Id));
                                <div class="work-system-skill-block">
                                    <label class="work-system-skill">
                                        <input type="checkbox" checked="@enabled"
                                               @onchange="e => ToggleSystemSkill(skill, e.Value)" />
                                        <strong>@skill.Name</strong>
                                        <span class="small faint">@(skill.DefaultEnabled ? "default on" : "default off")</span>
                                    </label>
                                    <details class="work-skill-details">
                                        <summary class="small faint">Preview</summary>
                                        <pre class="work-skill-preview">@skill.Content</pre>
                                    </details>
                                </div>
                            }
                        </div>
                    }
                }
                @if (_showAddSkill)
                {
                    <div class="work-skill-card">
                        <input class="input" @bind="_newSkillName" placeholder="Skill name" />
                        <textarea class="textarea work-textarea" @bind="_newSkillContent"
                                  placeholder="Instructions the agent should follow."></textarea>
                        <div class="row">
                            <button type="button" class="button primary" @onclick="AddSkillAsync"
                                    disabled="@string.IsNullOrWhiteSpace(_newSkillName)">Add to repository</button>
                            <button type="button" class="button" @onclick="ToggleAddSkill">Cancel</button>
                        </div>
                    </div>
                }
            </div>


            <div class="work-settings-section">
                <div>
                    <div class="eyebrow">Access</div>
                    <h3>Context locations</h3>
                </div>
                <p class="small faint">
                    Each folder has its own read, write and delete permission. Paths may be relative to the project or absolute. Tools are available in Work only.
                </p>
                <div class="work-contexts">
                    @foreach (ContextDraft context in _contexts)
                    {
                        <div class="work-context">
                            <input class="input" @bind="context.Path" placeholder="." title="Context path" />
                            <select class="input" @bind="context.Read" title="Read permission">
                                <option value="Ask">Read: Ask</option>
                                <option value="Always">Read: Always</option>
                                <option value="Never">Read: Never</option>
                            </select>
                            <select class="input" @bind="context.Write" title="Write permission">
                                <option value="Ask">Write: Ask</option>
                                <option value="Always">Write: Always</option>
                                <option value="Never">Write: Never</option>
                            </select>
                            <select class="input" @bind="context.Delete" title="Delete permission">
                                <option value="Never">Delete: Never</option>
                                <option value="Ask">Delete: Ask</option>
                                <option value="Always">Delete: Always</option>
                            </select>
                            <select class="input" @bind="context.Execute" title="Run permission">
                                <option value="Never">Run: Never</option>
                                <option value="Ask">Run: Ask</option>
                                <option value="Always">Run: Always</option>
                            </select>
                            <button type="button" class="button danger" @onclick="() => RemoveContext(context)"
                                    disabled="@(_contexts.Count <= 1)">Remove</button>
                        </div>
                    }
                </div>
                <div class="row" style="margin-top: .5rem;">
                    <button type="button" class="button" @onclick="AddContextAsync">Add context</button>
                </div>
            </div>

            <div class="work-settings-section">
                <div class="spread">
                    <div>
                        <div class="eyebrow">Access</div>
                        <h3>Web</h3>
                    </div>
                    <select class="input work-web-select" @bind="_web">
                        <option value="Never">Never</option>
                        <option value="Ask">Ask</option>
                        <option value="Always">Always</option>
                    </select>
                </div>
                <div class="small faint">Web access applies to the whole project and is separate from file contexts.</div>
            </div>

            <div class="work-settings-section">
                <div class="spread">
                    <div>
                        <div class="eyebrow">Execution</div>
                        <h3>Command line</h3>
                    </div>
                    <span class="small faint">
                        @(Unrestricted ? "allowlist off" : $"{_allowedCommands.Count} allowed")
                    </span>
                </div>

                <div class="row" style="margin-top:.35rem;align-items:center;gap:.4rem;">
                    <span class="small faint">Command access</span>
                    <button type="button"
                            class="button @(_commandAccess == CommandAccessMode.Restricted ? "primary" : "")"
                            @onclick="() => SetCommandAccessAsync(CommandAccessMode.Restricted)">
                        Restricted
                    </button>
                    <button type="button"
                            class="button @(_commandAccess == CommandAccessMode.Unrestricted ? "primary" : "")"
                            @onclick="() => SetCommandAccessAsync(CommandAccessMode.Unrestricted)">
                        Unrestricted
                    </button>
                </div>

                <p class="small faint">
                    Restricted runs only the commands listed here. The softshell parses pipes,
                    redirection and <span class="mono">&amp;&amp;</span>/<span class="mono">||</span>
                    itself and never starts PowerShell or cmd. This is a guardrail, not a
                    sandbox: an allowed program still has your account permissions. A command
                    also needs <strong>Run</strong> permission on the context and
                    <strong>Ask</strong> or <strong>Always</strong> on the command tool.
                </p>

                @if (_allowedCommands.Count > 0 && NoContextCanRun)
                {
                    <div class="note">
                        <strong>No context has Run permission.</strong> Set Execute to Ask or
                        Always on at least one context, or every allowlisted command will be refused.
                    </div>
                }
                @if (_allowedCommands.Count > 0 && RunShellIsNever)
                {
                    <div class="note">
                        <strong>RunShell is set to Never.</strong> Change it to Ask or Always under
                        Enabled tools, or the softshell will refuse every command.
                    </div>
                }

                @if (Unrestricted)
                {
                    <div class="note">
                        <strong>Unrestricted.</strong> RunProcess may start any program with your
                        account permissions, and the allowlist is ignored. The softshell is off
                        because it requires an allowlist. CLI wrappers remain available when
                        installed; turn individual wrappers off under Enabled tools.
                    </div>
                }

                <div class="row" style="margin-top:.45rem;align-items:center;gap:.5rem;">
                    <span class="small faint">Shell directory</span>
                    <span class="mono small" style="flex:1;overflow-wrap:anywhere;">@ShellDirectory</span>
                    <button type="button" class="button" @onclick="ResetShellDirectory"
                            disabled="@(string.Equals(ShellDirectory, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase))">
                        Reset
                    </button>
                </div>
                <div class="small faint">
                    cd persists across RunShell calls in this session. A new session starts at the
                    project root.
                </div>

                @if (_allowedCommands.Count == 0)
                {
                    <div class="small faint" style="margin-top:.45rem;">
                        @(Unrestricted
                            ? "No commands are listed. RunProcess is unrestricted anyway."
                            : "No commands allowed. RunProcess and the softshell refuse external commands.")
                    </div>
                }
                else
                {
                    <div class="work-contexts" style="margin-top:.45rem;@(Unrestricted ? "opacity:.55;" : "")">
                        @foreach (AllowedCommand command in _allowedCommands)
                        {
                            <div class="work-context" style="align-items:flex-start;">
                                <div style="flex:1;">
                                    <strong class="mono">@command.Name</strong>
                                    <span class="small faint mono">@command.Executable</span>
                                    <div class="small faint">@ResolvedCommandPath(command)</div>
                                    @if (!string.IsNullOrWhiteSpace(command.Description))
                                    {
                                        <div class="small faint">@command.Description</div>
                                    }
                                    <div class="small faint">@CapabilityLabel(command)</div>
                                </div>
                                <button type="button" class="button danger"
                                        @onclick="() => RemoveCommandAsync(command)"
                                        disabled="@Unrestricted">
                                    Remove
                                </button>
                            </div>
                        }
                    </div>
                }
                <div class="row" style="margin-top:.5rem;align-items:center;gap:.4rem;">
                    <input class="input" style="max-width:11rem;" placeholder="git"
                           @bind="_newCommand" disabled="@Unrestricted" />
                    <input class="input" style="max-width:9rem;" placeholder="alias (optional)"
                           @bind="_newCommandAlias" disabled="@Unrestricted" />
                    <input class="input" style="max-width:14rem;" placeholder="fixed arguments"
                           @bind="_newCommandArgs" disabled="@Unrestricted" />
                    <button type="button" class="button" @onclick="AddCommandAsync"
                            disabled="@(Unrestricted || string.IsNullOrWhiteSpace(_newCommand))">
                        Add command
                    </button>
                </div>
                <div class="row" style="margin-top:.35rem;align-items:center;gap:.6rem;">
                    <label class="small faint">
                        <input type="checkbox" @bind="_newCommandNetwork" disabled="@Unrestricted" /> network
                    </label>
                    <label class="small faint">
                        <input type="checkbox" @bind="_newCommandDestructive" disabled="@Unrestricted" /> destructive
                    </label>
                    <label class="small faint">
                        <input type="checkbox" @bind="_newCommandInterpreter" disabled="@Unrestricted" /> interpreter
                    </label>
                </div>
                <div class="row" style="margin-top:.35rem;align-items:center;gap:.5rem;">
                    <label class="small faint" for="command-preset">Start from a preset</label>
                    <select id="command-preset" class="input" style="max-width:12rem;"
                            @bind="_selectedPreset" @bind:after="AddPresetAsync"
                            disabled="@Unrestricted">
                        <option value="">Choose...</option>
                        @foreach (AllowedCommand preset in AllowedCommandPresets.All)
                        {
                            <option value="@preset.Name">@preset.Name</option>
                        }
                    </select>
                    <span class="small faint">@_commandStatus</span>
                </div>
            </div>

            <div class="work-settings-section">
                <div class="spread">
                    <div>
                        <div class="eyebrow">Tools</div>
                        <h3>Enabled tools</h3>
                    </div>
                    <button type="button" class="button" @onclick="RefreshTools">Refresh plugins</button>
                </div>
                <p class="small faint">
                    Tools are registered in Work only; Chat sessions never receive them.
                    <strong>Off</strong> hides a tool from the model, <strong>Never</strong> keeps it visible but
                    refuses every call, <strong>Ask</strong> prompts, and <strong>Always</strong> permits.
                    A context folder set to <strong>Never</strong> still refuses whatever the tool says.
                    Unset tools inherit from System; choose <strong>Inherit</strong> to clear an override.
                    Changes save automatically.
                </p>
                <ToolPermissionEditor Value="_toolPermissions" ValueChanged="OnToolPermissionsChanged"
                                      AllowInherit="true" Effective="ProjectToolsEffective" />
                <p class="small faint">
                    <strong>Internal</strong> tools ship with Studio and honour the project gate.
                    <strong>Plugin</strong> tools run their own code: Studio can hide them and can
                    block the file and web calls they route through the gate, but it cannot sandbox
                    a process a plugin starts itself.
                </p>
            </div>
            <div class="row work-project-save">
                <span class="status-line">@(_saving ? "Saving..." : _status)</span>
            </div>
        </div>
    }
</div>

@code {
    private sealed class ContextDraft
    {
        public string Id { get; set; } = "";
        public string Path { get; set; } = ".";
        public WorkPermission Read { get; set; } = WorkPermission.Ask;
        public WorkPermission Write { get; set; } = WorkPermission.Ask;
        public WorkPermission Delete { get; set; } = WorkPermission.Never;
        public WorkPermission Execute { get; set; } = WorkPermission.Never;
    }

    private sealed class ProjectSkillDraft
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Content { get; set; } = "";
        public bool Enabled { get; set; } = true;
    }

    private IReadOnlyList<StudioProjectInfo> _projects = [];
    private string _projectPath = "";
    private bool _showSettings;
    private bool _saving;
    private string _status = "";
    private string _systemPrompt = "";
    private string _memory = "";
    private List<ContextDraft> _contexts = [];
    private List<ProjectSkillDraft> _projectSkills = [];
    private bool _showAddSkill;
    private string _newSkillName = "";
    private string _newSkillContent = "";
    private string _skillFilter = "";
    private HashSet<string> _disabledSystemSkills = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _enabledSystemSkills = new(StringComparer.OrdinalIgnoreCase);
    private ToolPermissionSet _toolPermissions = new();
    private WorkPermission _web = WorkPermission.Never;
    private CommandAccessMode _commandAccess = CommandAccessMode.Restricted;
    private List<AllowedCommand> _allowedCommands = [];
    private string _newCommand = "";
    private string _newCommandAlias = "";
    private string _newCommandArgs = "";
    private bool _newCommandNetwork;
    private bool _newCommandDestructive;
    private bool _newCommandInterpreter;
    private string _selectedPreset = "";
    private string? _commandStatus;

    private bool Unrestricted => _commandAccess == CommandAccessMode.Unrestricted;

    private bool NoContextCanRun =>
        _contexts.Count > 0 && _contexts.All(context => context.Execute == WorkPermission.Never);

    private bool RunShellIsNever =>
        Work.ProjectToolPermission("RunShell") == WorkToolPermission.Never;

    private string ShellDirectory => Work.GetShellDirectory(ChatService.Document?.Id);

    protected override void OnInitialized()
    {
        Workspace.ProjectChanged += OnProjectChanged;
        Work.Changed += OnWorkChanged;
        ChatService.Changed += OnChatChanged;
        LoadFields();
    }

    public void Dispose()
    {
        Workspace.ProjectChanged -= OnProjectChanged;
        Work.Changed -= OnWorkChanged;
        ChatService.Changed -= OnChatChanged;
    }

    /// <summary>
    /// Sending a prompt should show the conversation, not the settings form.
    /// </summary>
    private void OnChatChanged() => _ = InvokeAsync(() =>
    {
        if (ChatService.IsStreaming && _showSettings)
        {
            _showSettings = false;
            StateHasChanged();
        }
    });

    /// <summary>
    /// "Always allow" from a permission prompt raises the project's tool entry.
    /// Reflect that in the panel without discarding an unsaved prompt edit.
    /// </summary>
    private void OnWorkChanged() => _ = InvokeAsync(() =>
    {
        _toolPermissions = new ToolPermissionSet
        {
            Tools = new Dictionary<string, WorkToolPermission>(
                Work.Settings.ToolPermissions.Tools, StringComparer.OrdinalIgnoreCase),
            Groups = new Dictionary<string, WorkToolPermission>(
                Work.Settings.ToolPermissions.Groups, StringComparer.OrdinalIgnoreCase),
        };
        StateHasChanged();
    });

    private void OnProjectChanged() => _ = InvokeAsync(() =>
    {
        LoadFields();
        StateHasChanged();
    });

    private void LoadFields()
    {
        _projects = Workspace.Projects;
        _projectPath = Workspace.Project.Root;
        _systemPrompt = Work.Settings.SystemPrompt ?? "";
        _memory = Work.Memory;
        _web = Work.Settings.Permissions.Web;
        _commandAccess = Work.Settings.CommandAccess;
        _allowedCommands = [.. Work.Settings.AllowedCommands];
        _disabledSystemSkills = new HashSet<string>(
            Work.Settings.DisabledSystemSkills, StringComparer.OrdinalIgnoreCase);
        _enabledSystemSkills = new HashSet<string>(
            Work.Settings.EnabledSystemSkills, StringComparer.OrdinalIgnoreCase);
        _toolPermissions = new ToolPermissionSet
        {
            Tools = new Dictionary<string, WorkToolPermission>(
                Work.Settings.ToolPermissions.Tools, StringComparer.OrdinalIgnoreCase),
            Groups = new Dictionary<string, WorkToolPermission>(
                Work.Settings.ToolPermissions.Groups, StringComparer.OrdinalIgnoreCase),
        };
        _projectSkills = [.. Work.Settings.Skills.Select(skill => new ProjectSkillDraft
        {
            Id = string.IsNullOrWhiteSpace(skill.Id) ? Guid.NewGuid().ToString("n") : skill.Id,
            Name = skill.Name,
            Content = skill.Content,
            Enabled = Work.IsProjectSkillEnabled(skill),
        })];
        _contexts = [.. Work.Settings.Contexts.Select(context => new ContextDraft
        {
            Id = context.Id,
            Path = context.Path,
            Read = context.Permissions.Read,
            Write = context.Permissions.Write,
            Delete = context.Permissions.Delete,
            Execute = context.Permissions.Execute,
        })];
        if (_contexts.Count == 0)
            _contexts.Add(new ContextDraft { Id = Guid.NewGuid().ToString("n") });
    }

    private void ToggleSettings()
    {
        _showSettings = !_showSettings;
        if (_showSettings) LoadFields();
    }

    private async Task SwitchProjectAsync(ChangeEventArgs args)
    {
        string path = args.Value?.ToString() ?? "";
        if (string.IsNullOrWhiteSpace(path) || path == Workspace.Project.Root) return;

        if (ChatService.IsStreaming || ChatService.IsLoading)
        {
            bool proceed = await JS.InvokeAsync<bool>(
                "confirm", "Switching projects will stop the current Work chat. Continue?");
            if (!proceed)
            {
                LoadFields();
                return;
            }
            ChatService.Stop();
        }

        try
        {
            await ChatService.CloseAsync();
            Workspace.SwitchProject(path);
            await ChatService.UseProjectAsync();
            Work.Reload();
            LoadFields();
            _status = "Project opened.";
            Nav.NavigateTo("/work");
        }
        catch (Exception ex)
        {
            _status = ex.Message;
            LoadFields();
        }
    }

    private async Task NewChatAsync()
    {
        if (ChatService.IsStreaming || ChatService.IsLoading) return;
        ChatService.Stop();
        await ChatService.CloseAsync();
        Nav.NavigateTo("/work");
    }

    private async Task CreateProjectAsync()
    {
        string? name = await JS.InvokeAsync<string?>("prompt", "New Work project name", "New project");
        if (string.IsNullOrWhiteSpace(name)) return;

        try
        {
            await ChatService.CloseAsync();
            var project = Workspace.CreateProject(name);
            Workspace.SwitchProject(project.Root);
            await ChatService.UseProjectAsync();
            Work.Reload();
            LoadFields();
            _showSettings = true;
            _status = $"Created {project.Document.Name}.";
            Nav.NavigateTo("/work");
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private void OnToolPermissionsChanged(ToolPermissionSet permissions)
    {
        _toolPermissions = permissions;
        _ = AutoSaveAsync();
    }

    private ToolPermissionValue ProjectToolsEffective(string tool, string? group) =>
        Work.SystemToolPermission(tool, group);

    private IReadOnlyList<WorkSkill> FilteredSkills
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_skillFilter)) return Repo.Skills;
            string filter = _skillFilter.Trim();
            return [.. Repo.Skills.Where(skill =>
                skill.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
                || skill.Content.Contains(filter, StringComparison.OrdinalIgnoreCase))];
        }
    }

    private void ToggleSystemSkill(WorkSkill skill, object? enabled)
        => SetSkill(skill, enabled is true);

    private void SetSkill(WorkSkill skill, bool enabled)
    {
        if (enabled)
        {
            _disabledSystemSkills.Remove(skill.Id);
            if (!skill.DefaultEnabled) _enabledSystemSkills.Add(skill.Id);
        }
        else
        {
            _disabledSystemSkills.Add(skill.Id);
            _enabledSystemSkills.Remove(skill.Id);
        }
    }

    private void SetSkillGroup(bool enabled)
    {
        foreach (WorkSkill skill in FilteredSkills)
            SetSkill(skill, enabled);
    }

    private void AddProjectSkill()
        => _projectSkills.Add(new ProjectSkillDraft { Id = Guid.NewGuid().ToString("n") });

    private async Task ImportProjectSkillsAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.MultiFile,
            Work.ProjectRoot,
            "Import project skills",
            "*.md");
        if (selection is null) return;

        int imported = 0;
        foreach (string file in selection.All)
        {
            try
            {
                string name = UniqueName(
                    Path.GetFileNameWithoutExtension(file),
                    _projectSkills.Select(skill => skill.Name));
                _projectSkills.Add(new ProjectSkillDraft
                {
                    Id = Guid.NewGuid().ToString("n"),
                    Name = name,
                    Content = await File.ReadAllTextAsync(file),
                    Enabled = true,
                });
                imported++;
            }
            catch (Exception ex)
            {
                _status = $"Could not import {Path.GetFileName(file)}: {ex.Message}";
            }
        }

        if (imported > 0)
        {
            _status = $"Imported {imported} project skill(s).";
            await AutoSaveAsync();
        }
    }

    private async Task ImportRepositorySkillsAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.MultiFile,
            Repo.Folder,
            "Import repository skills",
            "*.md");
        if (selection is null) return;

        var next = Repo.Skills.ToList();
        int imported = 0;
        foreach (string file in selection.All)
        {
            try
            {
                string name = UniqueName(
                    Path.GetFileNameWithoutExtension(file),
                    next.Select(skill => skill.Name));
                next.Add(new WorkSkill
                {
                    Id = "",
                    Name = name,
                    Content = await File.ReadAllTextAsync(file),
                    DefaultEnabled = true,
                });
                imported++;
            }
            catch (Exception ex)
            {
                _status = $"Could not import {Path.GetFileName(file)}: {ex.Message}";
            }
        }

        if (imported == 0) return;

        Repo.Save(next);
        Repo.Reload();
        LoadFields();
        await ChatService.ReloadWorkContextAsync();
        _status = $"Imported {imported} repository skill(s).";
    }

    private static string UniqueName(string? name, IEnumerable<string> existing)
    {
        string baseName = string.IsNullOrWhiteSpace(name) ? "Imported skill" : name.Trim();
        var taken = new HashSet<string>(existing, StringComparer.OrdinalIgnoreCase);
        if (!taken.Contains(baseName)) return baseName;

        for (int suffix = 2; ; suffix++)
        {
            string candidate = $"{baseName} ({suffix})";
            if (!taken.Contains(candidate)) return candidate;
        }
    }

