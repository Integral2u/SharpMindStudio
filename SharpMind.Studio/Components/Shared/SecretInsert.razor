@using SharpMind.Studio.Core.Vault
@inject VaultStore Vault

<div class="row" style="margin-top:.35rem;align-items:center;gap:.4rem;">
    @if (NeedsName)
    {
        <input class="input" style="max-width:12rem;" placeholder="@(HeaderMode ? "Header name" : "VARIABLE")"
               title="@(HeaderMode ? "HTTP header name, for example Authorization." : "Environment variable name, for example GITHUB_TOKEN.")"
               @bind="_variable" @bind:event="oninput" />
    }
    <select class="input" style="max-width:14rem;" @bind="_secret"
            title="Insert a Vault reference. Studio reads the value only when the command runs.">
        <option value="">Choose a secret...</option>
        @foreach (VaultSecretInfo secret in Vault.Secrets)
        {
            <option value="@secret.Name">@secret.Name</option>
        }
    </select>
    <button type="button" class="button" @onclick="InsertAsync"
            disabled="@(!CanInsert)">
        Add
    </button>
</div>
@if (Vault.Secrets.Count == 0)
{
    <div class="small faint">
        No secrets yet.
        <a href="/settings?tab=vault" target="_blank" rel="noopener">Add one in Vault</a>.
    </div>
}

@code {
    /// <summary>When true the helper asks for a variable name and inserts KEY=reference.</summary>
    [Parameter] public bool EnvMode { get; set; }

    /// <summary>When true the helper asks for a header name and inserts Name: reference.</summary>
    [Parameter] public bool HeaderMode { get; set; }

    [Parameter] public EventCallback<string> OnInsert { get; set; }

    private string _variable = "";
    private string _secret = "";

    private bool NeedsName => EnvMode || HeaderMode;

    private bool CanInsert =>
        !string.IsNullOrWhiteSpace(_secret) &&
        (!NeedsName || !string.IsNullOrWhiteSpace(_variable));

    private async Task InsertAsync()
    {
        string reference = $"%vault:{_secret}%";
        string text = EnvMode
            ? $"{_variable.Trim()}={reference}"
            : HeaderMode
                ? $"{_variable.Trim()}: {reference}"
                : reference;

        await OnInsert.InvokeAsync(text);
    }
}
