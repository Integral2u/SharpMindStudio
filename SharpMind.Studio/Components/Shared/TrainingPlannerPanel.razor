@using SharpMind.Studio.Core.Training
@using SharpMind.Studio.Services
@inject StudioTrainingService Lab

<section class="panel training-planner">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Build map</div>
            <h2>Plan the work</h2>
        </div>
        <span class="faint small mono">rules, not guesses</span>
    </div>

    <div class="panel-body stack">
        <p class="small faint">
            Pick where you are and what should change. The planner proposes three paths,
            shows why each move is there, and marks moves the engine cannot run yet instead
            of hiding them. Using a plan fills the editor or the fine-tune form.
        </p>

        <div class="training-form">
            <div class="field">
                <label class="field-label" for="planner-start">Start from</label>
                <select id="planner-start" class="input" @bind="StartValue">
                    @foreach (PlannerStart start in Enum.GetValues<PlannerStart>())
                    {
                        <option value="@start">@StartLabel(start)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="planner-task">What should it do?</label>
                <select id="planner-task" class="input" @bind="TaskValue">
                    @foreach (PlannerTask task in Enum.GetValues<PlannerTask>())
                    {
                        <option value="@task">@TaskLabel(task)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="planner-runtime">Where will it run?</label>
                <select id="planner-runtime" class="input" @bind="RuntimeValue">
                    @foreach (PlannerRuntime runtime in Enum.GetValues<PlannerRuntime>())
                    {
                        <option value="@runtime">@RuntimeLabel(runtime)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="planner-data">What data exists?</label>
                <select id="planner-data" class="input" @bind="DataValue">
                    @foreach (PlannerDataShape data in Enum.GetValues<PlannerDataShape>())
                    {
                        <option value="@data">@DataLabel(data)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="planner-effort">How much time?</label>
                <select id="planner-effort" class="input" @bind="EffortValue">
                    @foreach (PlannerEffort effort in Enum.GetValues<PlannerEffort>())
                    {
                        <option value="@effort">@EffortLabel(effort)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="planner-constraint">Constraints</label>
                <select id="planner-constraint" class="input" @bind="ConstraintValue">
                    @foreach (PlannerConstraint constraint in Enum.GetValues<PlannerConstraint>())
                    {
                        <option value="@constraint">@ConstraintLabel(constraint)</option>
                    }
                </select>
            </div>
            <div class="field training-form-wide">
                <label class="field-label" for="planner-good">What does "good" look like?</label>
                <input id="planner-good" class="input" @bind="GoodLooksLike"
                       placeholder="e.g. answers customer questions from these documents" />
            </div>
            <div class="field training-form-wide">
                <label class="field-label">Goals</label>
                <div class="training-goals">
                    @foreach (PlannerGoal goal in Enum.GetValues<PlannerGoal>())
                    {
                        <button type="button"
                                class="training-chip @(Lab.PlannerGoals.Contains(goal) ? "live" : "")"
                                @onclick="() => ToggleGoal(goal)">
                            @GoalLabel(goal)
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="training-grid training-plans">
            @foreach (TrainingPlan plan in Plans)
            {
                <div class="training-plan">
                    <div class="spread training-plan-head">
                        <div>
                            <div class="eyebrow">@plan.Name</div>
                            <h3>@plan.Summary</h3>
                        </div>
                        <button type="button" class="button primary"
                                @onclick="() => UsePlan.InvokeAsync(plan)">
                            Use plan
                        </button>
                    </div>

                    <ol class="training-plan-moves">
                        @foreach (PlannerMove move in plan.Moves)
                        {
                            <li class="training-plan-move @(move.Status == PlannerMoveStatus.Ready ? "ready" : "blocked")">
                                <div class="spread">
                                    <strong>@move.Title</strong>
                                    <span class="training-chip @(move.Status == PlannerMoveStatus.Ready ? "live" : "")">
                                        @(move.Status == PlannerMoveStatus.Ready ? "ready" : "blocked")
                                    </span>
                                </div>
                                <div class="small faint">@move.Detail</div>
                                <div class="small">@move.Reason</div>
                                @if (move.Status == PlannerMoveStatus.Blocked)
                                {
                                    <div class="small faint">Why not: @move.BlockedReason</div>
                                    @if (move.Alternative is { } alternative)
                                    {
                                        <div class="small faint">Instead: @alternative</div>
                                    }
                                }
                            </li>
                        }
                    </ol>

                    @if (plan.Estimate is { } estimate)
                    {
                        <div class="small faint">@estimate</div>
                    }
                    @foreach (string risk in plan.Risks)
                    {
                        <div class="small faint">- @risk</div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public TrainingJobSettings Job { get; set; } = new();
    [Parameter] public EventCallback<TrainingPlan> UsePlan { get; set; }

    private string StartValue
    {
        get => Lab.PlannerStart.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerStart start)) Lab.PlannerStart = start;
        }
    }

    private IReadOnlyList<TrainingPlan> Plans => TrainingPlanner.Plan(new PlannerInput
    {
        Start = Lab.PlannerStart,
        Goals = Lab.PlannerGoals,
        Intake = Lab.Intake,
        HasData = Job.Sources.Any(source =>
            source.Component.Args.TryGetValue("path", out string? path)
            && !string.IsNullOrWhiteSpace(path)),
        // The formatter designer and quantized-only intake are not connected yet;
        // the planner marks their moves blocked rather than assuming they exist.
        HasFormatter = false,
        IsQuantizedOnly = false,
        ParameterCount = Lab.PlannerStart == PlannerStart.Nothing
            ? TrainingJobValidation.ParameterCount(Job)
            : null,
    });

    private void ToggleGoal(PlannerGoal goal)
    {
        if (!Lab.PlannerGoals.Add(goal)) Lab.PlannerGoals.Remove(goal);
    }

    private static string StartLabel(PlannerStart start) => start switch
    {
        PlannerStart.Nothing => "Nothing (from scratch)",
        PlannerStart.BaseModel => "A base model",
        PlannerStart.MyModel => "My model",
        PlannerStart.Checkpoint => "A checkpoint",
        PlannerStart.Playbook => "A playbook",
        PlannerStart.PreviousRun => "A previous run",
        _ => start.ToString(),
    };

    private string TaskValue
    {
        get => Lab.Intake.Task.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerTask task))
                Lab.Intake = Lab.Intake with { Task = task };
        }
    }

    private string RuntimeValue
    {
        get => Lab.Intake.Runtime.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerRuntime runtime))
                Lab.Intake = Lab.Intake with { Runtime = runtime };
        }
    }

    private string DataValue
    {
        get => Lab.Intake.Data.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerDataShape data))
                Lab.Intake = Lab.Intake with { Data = data };
        }
    }

    private string EffortValue
    {
        get => Lab.Intake.Effort.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerEffort effort))
                Lab.Intake = Lab.Intake with { Effort = effort };
        }
    }

    private string ConstraintValue
    {
        get => Lab.Intake.Constraint.ToString();
        set
        {
            if (Enum.TryParse(value, out PlannerConstraint constraint))
                Lab.Intake = Lab.Intake with { Constraint = constraint };
        }
    }

    private string GoodLooksLike
    {
        get => Lab.Intake.GoodLooksLike ?? "";
        set => Lab.Intake = Lab.Intake with
        {
            GoodLooksLike = string.IsNullOrWhiteSpace(value) ? null : value.Trim(),
        };
    }

    private static string TaskLabel(PlannerTask task) => task switch
    {
        PlannerTask.NarrowEdge => "Narrow edge model",
        PlannerTask.ChatAssistant => "Chat assistant",
        PlannerTask.DomainExpert => "Domain expert",
        PlannerTask.ToolUser => "Tool-using agent",
        PlannerTask.Classifier => "Classifier / router",
        _ => task.ToString(),
    };

    private static string RuntimeLabel(PlannerRuntime runtime) => runtime switch
    {
        PlannerRuntime.ThisPc => "This PC",
        PlannerRuntime.PhoneEdge => "Phone / edge",
        PlannerRuntime.ServerGpu => "Server / GPU",
        _ => "Not sure",
    };

    private static string DataLabel(PlannerDataShape data) => data switch
    {
        PlannerDataShape.None => "None yet",
        PlannerDataShape.SmallCorpus => "Small corpus (<10 MB)",
        PlannerDataShape.LargeCorpus => "Larger corpus (10 MB+)",
        PlannerDataShape.InstructionData => "Instruction / chat data",
        _ => data.ToString(),
    };

    private static string EffortLabel(PlannerEffort effort) => effort switch
    {
        PlannerEffort.Minutes => "Minutes",
        PlannerEffort.Hours => "A few hours",
        PlannerEffort.Overnight => "Overnight or longer",
        _ => effort.ToString(),
    };

    private static string ConstraintLabel(PlannerConstraint constraint) => constraint switch
    {
        PlannerConstraint.Public => "Public data",
        PlannerConstraint.Internal => "Internal only",
        PlannerConstraint.Regulated => "Regulated / PII",
        _ => "Not sure",
    };

    private static string GoalLabel(PlannerGoal goal) => goal switch
    {
        PlannerGoal.Knowledge => "New knowledge",
        PlannerGoal.Behaviour => "Behaviour or style",
        PlannerGoal.Improve => "Better at its job",
        PlannerGoal.Smaller => "Smaller",
        PlannerGoal.FitDevice => "Fit a device",
        PlannerGoal.Capability => "New capability",
        PlannerGoal.Architecture => "Change architecture",
        _ => goal.ToString(),
    };
}
