@using SharpMind.Inference.Chat
@using SharpMind.Studio.Core.Agents
@using SharpMind.Studio.Core.Chat
@using SharpMind.Studio.Core.Compute
@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Core.Work
@using SharpMind.Studio.Services
@inject StudioWorkService Work
@inject StudioChatService Chat
@inject StudioWorkspaceService Workspace
@inject StudioAgentService Agents
@inject ModelCatalogService Catalog
@inject OpenRouterSettingsService OpenRouter
@inject ComputeProviderService Compute
@implements IDisposable

<div class="page-head">
    <div>
        <div class="eyebrow">Orchestration</div>
        <h1>Agents</h1>
        <p class="faint">
            You are the CEO. The work agent delegates one self-contained task at a time to the
            specialists below, following the project's system prompt and memory. Define each
            specialist's purpose, rules, model fallback chain, tools and permissions.
        </p>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Agent</div>
            <h2>@Workspace.Project.Document.Name</h2>
        </div>
        <span class="faint small mono">
            @(Chat.Document?.Mode ?? "no chat") · @(Chat.Model?.FileName ?? "no local model") ·
            @Chat.DisplayMessages.Count messages
        </span>
    </div>
    <div class="panel-body row">
        <div class="field grow">
            <span class="field-label">Tools</span>
            <strong>@Work.Tools.Count</strong>
            <span class="faint small"> (@Work.Tools.Count(tool => Work.IsToolEnabled(tool.Name)) enabled)</span>
        </div>
        <div class="field grow">
            <span class="field-label">Skills</span>
            <strong>@Work.SystemSkills.Count + @Work.ProjectSkills.Count</strong>
            <span class="faint small"> (system + project)</span>
        </div>
        <div class="field grow">
            <span class="field-label">Delegated turns</span>
            <strong>@Chat.DisplayMessages.Count(message => message.Role == ChatRole.Agent && message.Name is not null)</strong>
        </div>
        <div class="field grow">
            <span class="field-label">Tool results</span>
            <strong>@Chat.DisplayMessages.Count(message => message.Role == ChatRole.Tool)</strong>
        </div>
    </div>
</section>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Definitions</div>
            <h2>Specialist agents</h2>
        </div>
        <span class="faint small mono">@Agents.Agents.Count defined</span>
    </summary>
    <div class="panel-body stack">
        <div class="row">
            <button type="button" class="button" @onclick="NewAgent">New agent</button>
            <button type="button" class="button" @onclick="Agents.Reload">Reload</button>
        </div>

        <div class="agent-tool-notes">
            <div>
                <strong class="mono">delegate</strong>
                <span class="faint small">
                    The model picks one of the saved agents below by name. That agent's own rules,
                    model chain, allowed tools and permissions are used, and it disappears when
                    the task finishes. Nothing is added to the project.
                </span>
            </div>
            <div>
                <strong class="mono">spawn_agent</strong>
                <span class="faint small">
                    The model creates a temporary specialist from parameters in the call: name,
                    rules, optional model and optional tool list. It is not saved, uses the same
                    Ask permission defaults, and is discarded after the task.
                </span>
            </div>
            <div>
                <strong class="mono">model chain</strong>
                <span class="faint small">
                    Targets are tried in order. Inherit uses the parent model; Local uses a
                    catalog model that still exists; Remote and Compute use the selected host and
                    model. A missing local file falls through to the next target instead of making
                    the agent unavailable.
                </span>
            </div>
        </div>

        <div class="row">
            <div class="field">
                <label class="field-label">Max delegation depth</label>
                <input class="input" type="number" min="1" max="8" value="@Agents.MaxDepth"
                       @onchange="SetMaxDepth" />
            </div>
        </div>

        @if (Agents.Agents.Count == 0)
        {
            <div class="small faint">No specialist agents defined yet.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>Name</th><th>Purpose</th><th>Model chain</th><th>Available</th><th>TTL</th><th>Enabled</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (StudioAgentDefinition agent in Agents.Agents)
                    {
                        <tr>
                            <td class="mono">@agent.Name</td>
                            <td>@agent.Description</td>
                            <td class="mono small">@ChainLabel(agent)</td>
                            <td class="mono small">@AvailabilityLabel(agent)</td>
                            <td class="mono">@(agent.TtlMinutes == 0 ? "default" : $"{agent.TtlMinutes}m")</td>
                            <td>@(agent.Enabled ? "yes" : "no")</td>
                            <td class="row">
                                <button type="button" class="button" @onclick="() => EditAgent(agent)">Edit</button>
                                <button type="button" class="button danger" @onclick="() => Agents.Delete(agent.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_editing is { } editing)
        {
            <div class="panel-head" style="margin-top:.75rem">
                <div>
                    <div class="eyebrow">@(string.IsNullOrWhiteSpace(editing.Id) ? "New" : "Edit")</div>
                    <h2>@(string.IsNullOrWhiteSpace(editing.Name) ? "Agent" : editing.Name)</h2>
                </div>
            </div>
            <div class="row">
                <div class="field grow">
                    <label class="field-label">Name</label>
                    <input class="input" value="@editing.Name"
                           @onchange="e => _editing = editing with { Name = e.Value?.ToString() ?? string.Empty }" />
                </div>
                <div class="field grow">
                    <label class="field-label">Purpose (shown to the parent model)</label>
                    <input class="input" value="@editing.Description"
                           @onchange="e => _editing = editing with { Description = e.Value?.ToString() ?? string.Empty }" />
                </div>
            </div>
            <div class="field">
                <label class="field-label">Rules / system prompt</label>
                <textarea class="input" rows="4" value="@editing.Rules"
                          @onchange="e => _editing = editing with { Rules = e.Value?.ToString() ?? string.Empty }"></textarea>
            </div>
            <div class="field">
                <div class="spread">
                    <label class="field-label">Model chain (first available target wins)</label>
                    <span class="small faint">missing local models fall through</span>
                </div>
                @{
                    IReadOnlyList<AgentModelChoice> chain = Chain(editing);
                }
                <div class="agent-chain">
                    @for (int chainIndex = 0; chainIndex < chain.Count; chainIndex++)
                    {
                        int index = chainIndex;
                        AgentModelChoice choice = chain[chainIndex];
                        <div class="agent-chain-row">
                            <span class="agent-chain-order mono">@(index + 1)</span>
                            <select class="input" value="@choice.Kind"
                                    @onchange="e => _editing = SetChainKind(editing, index, ParseKind(e.Value))">
                                <option value="Inherit">Inherit</option>
                                <option value="Local">Local</option>
                                <option value="Remote">Remote</option>
                                <option value="Compute">Compute</option>
                            </select>

                            @if (choice.Kind == AgentModelKind.Local)
                            {
                                <select class="input" value="@(choice.Model ?? string.Empty)"
                                        @onchange="e => _editing = SetChainModel(editing, index, e.Value?.ToString())">
                                    @foreach (ModelDescriptor model in _models)
                                    {
                                        <option value="@model.Path">@model.FileName</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(choice.Model) &&
                                         !_models.Any(model => string.Equals(model.Path, choice.Model, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@choice.Model">@Path.GetFileName(choice.Model) (missing)</option>
                                    }
                                </select>
                            }
                            else if (choice.Kind == AgentModelKind.Remote)
                            {
                                <select class="input" value="@(choice.ProviderId ?? RemoteProviders.OpenRouter)"
                                        @onchange="e => _editing = SetChainProvider(editing, index, e.Value?.ToString())">
                                    @foreach (RemoteProviderPreset provider in RemoteProviders.All)
                                    {
                                        <option value="@provider.Id">@provider.Name</option>
                                    }
                                </select>
                                <select class="input" value="@(choice.Model ?? string.Empty)"
                                        @onchange="e => _editing = SetChainModel(editing, index, e.Value?.ToString())">
                                    @foreach (string model in OpenRouter.ActiveModelsFor(choice.ProviderId))
                                    {
                                        <option value="@model">@model</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(choice.Model) &&
                                         !OpenRouter.ActiveModelsFor(choice.ProviderId).Contains(choice.Model, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@choice.Model">@choice.Model</option>
                                    }
                                </select>
                            }
                            else if (choice.Kind == AgentModelKind.Compute)
                            {
                                <select class="input" value="@(choice.ProviderId ?? string.Empty)"
                                        @onchange="e => _editing = SetChainProvider(editing, index, e.Value?.ToString())">
                                    @foreach (ComputeProviderSettings host in Compute.Providers)
                                    {
                                        <option value="@host.Id">@host.Name</option>
                                    }
                                </select>
                                <select class="input" value="@(choice.Model ?? string.Empty)"
                                        @onchange="e => _editing = SetChainModel(editing, index, e.Value?.ToString())">
                                    @foreach (string model in ComputeModels(choice.ProviderId))
                                    {
                                        <option value="@model">@model</option>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(choice.Model) &&
                                         !ComputeModels(choice.ProviderId).Contains(choice.Model, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <option value="@choice.Model">@choice.Model</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="small faint">Use the chat's current model</span>
                            }

                            <div class="row" style="gap:.25rem; flex-wrap:nowrap;">
                                <button type="button" class="button" title="Move up" @onclick="() => _editing = MoveChain(editing, index, -1)"
                                        disabled="@(index == 0)">&#9650;</button>
                                <button type="button" class="button" title="Move down" @onclick="() => _editing = MoveChain(editing, index, 1)"
                                        disabled="@(index == chain.Count - 1)">&#9660;</button>
                                <button type="button" class="button danger" title="Remove" @onclick="() => _editing = RemoveChain(editing, index)">Remove</button>
                            </div>
                        </div>
                    }
                </div>
                @{
                    IReadOnlyList<string> agentVoices = AgentVoiceOptions(editing);
                    string? agentVoice = editing.TtsVoice is { Length: > 0 } configured &&
                        agentVoices.Contains(configured, StringComparer.Ordinal)
                            ? configured
                            : null;
                }
                @if (agentVoices.Count > 0)
                {
                    <div class="field" style="margin-top:.35rem;">
                        <label class="field-label" for="agent-voice">Voice for spoken replies</label>
                        <select id="agent-voice" class="input" value="@(agentVoice ?? "")"
                                @onchange="e => _editing = editing with { TtsVoice = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString() }">
                            <option value="">Inherit chat voice</option>
                            @foreach (string voice in agentVoices)
                            {
                                <option value="@voice">@voice</option>
                            }
                        </select>
                        <span class="small faint">
                            Adds a WAV copy of the agent's reply to the chat when this speech
                            model is the loaded chat model.
                        </span>
                    </div>
                }
                else
                {
                    <div class="small faint" style="margin-top:.35rem;">
                        This agent has no local speech model in its chain. Delegated agents
                        return text to the parent chat; choose a speech model here to add a
                        voice chooser, or use the Chat/Work header voice.
                    </div>
                }
                <div class="row" style="margin-top:.35rem;">
                    <button type="button" class="button" @onclick="() => _editing = AddChain(editing, AgentModelKind.Inherit)">Add inherit</button>
                    <button type="button" class="button" @onclick="() => _editing = AddChain(editing, AgentModelKind.Local)">Add local</button>
                    <button type="button" class="button" @onclick="() => _editing = AddChain(editing, AgentModelKind.Remote)">Add remote</button>
                    <button type="button" class="button" @onclick="() => _editing = AddChain(editing, AgentModelKind.Compute)">Add compute</button>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label class="field-label">Temperature (blank = inherited)</label>
                    <input class="input" type="number" min="0" max="3" step="0.05"
                           value="@editing.Temperature"
                           @onchange="e => _editing = editing with { Temperature = float.TryParse(e.Value?.ToString(), out float value) ? value : null }" />
                </div>
                <div class="field">
                    <label class="field-label">Seed (blank = random)</label>
                    <input class="input" type="number" value="@editing.Seed"
                           @onchange="e => _editing = editing with { Seed = int.TryParse(e.Value?.ToString(), out int value) ? value : null }" />
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label class="field-label">TTL minutes (0 = host default)</label>
                    <input class="input" type="number" min="0" max="1440" value="@editing.TtlMinutes"
                           @onchange="e => _editing = editing with { TtlMinutes = int.TryParse(e.Value?.ToString(), out int value) ? value : 0 }" />
                </div>
                <div class="field">
                    <label class="field-label">Max tool calls (0 = unrestricted)</label>
                    <input class="input" type="number" min="0" max="1000" value="@editing.MaxToolCalls"
                           @onchange="e => _editing = editing with { MaxToolCalls = int.TryParse(e.Value?.ToString(), out int value) ? Math.Clamp(value, 0, 1000) : 10 }" />
                </div>
                <label class="field grow">
                    <span class="field-label">Enabled</span>
                    <input type="checkbox" checked="@editing.Enabled"
                           @onchange="e => _editing = editing with { Enabled = e.Value is bool enabled && enabled }" />
                </label>
                <label class="field grow">
                    <span class="field-label">Available in Chat</span>
                    <input type="checkbox" checked="@editing.AvailableInChat"
                           @onchange="e => _editing = editing with { AvailableInChat = e.Value is bool chat && chat }" />
                </label>
                <label class="field grow">
                    <span class="field-label">Available in Work</span>
                    <input type="checkbox" checked="@editing.AvailableInWork"
                           @onchange="e => _editing = editing with { AvailableInWork = e.Value is bool work && work }" />
                </label>
            </div>
            <div class="row">
                <div class="field grow">
                    <label class="field-label">File read</label>
                    <select class="input" value="@editing.Permissions.Read"
                            @onchange="e => _editing = SetPermission(editing, WorkToolCategory.Read, e.Value)">
                        @foreach (WorkPermission permission in PermissionOptions)
                        {
                            <option value="@permission">@PermissionLabel(permission)</option>
                        }
                    </select>
                </div>
                <div class="field grow">
                    <label class="field-label">File write</label>
                    <select class="input" value="@editing.Permissions.Write"
                            @onchange="e => _editing = SetPermission(editing, WorkToolCategory.Write, e.Value)">
                        @foreach (WorkPermission permission in PermissionOptions)
                        {
                            <option value="@permission">@PermissionLabel(permission)</option>
                        }
                    </select>
                </div>
                <div class="field grow">
                    <label class="field-label">File delete</label>
                    <select class="input" value="@editing.Permissions.Delete"
                            @onchange="e => _editing = SetPermission(editing, WorkToolCategory.Delete, e.Value)">
                        @foreach (WorkPermission permission in PermissionOptions)
                        {
                            <option value="@permission">@PermissionLabel(permission)</option>
                        }
                    </select>
                </div>
                <div class="field grow">
                    <label class="field-label">Web access</label>
                    <select class="input" value="@editing.Permissions.Web"
                            @onchange="e => _editing = SetPermission(editing, WorkToolCategory.Web, e.Value)">
                        @foreach (WorkPermission permission in PermissionOptions)
                        {
                            <option value="@permission">@PermissionLabel(permission)</option>
                        }
                    </select>
                </div>
            </div>
            <div class="field">
                <div class="spread">
                    <label class="field-label">Tool permissions</label>
                    <span class="small faint">unset tools inherit from the session, model, family, project and system layers</span>
                </div>
                @if (editing.AllowedTools.Count > 0 || !editing.InheritTools)
                {
                    <div class="note">
                        <strong>Legacy tool list.</strong>
                        This agent still carries the older allowed-tools list. The four-state
                        controls below are the current model; clear the legacy list to use them
                        without the old filter.
                        <button type="button" class="button"
                                @onclick="() => _editing = editing with { AllowedTools = [], InheritTools = true }">
                            Clear legacy list
                        </button>
                    </div>
                }
                <ToolPermissionEditor Value="editing.ToolPermissions"
                                      ValueChanged="p => _editing = editing with { ToolPermissions = p }"
                                      AllowInherit="true" />
            </div>
            <div class="row">
                <button type="button" class="button primary" @onclick="SaveAgent"
                        disabled="@string.IsNullOrWhiteSpace(_editing?.Name)">Save agent</button>
                <button type="button" class="button" @onclick="() => _editing = null">Cancel</button>
            </div>
        }
    </div>
</details>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Toolbox</div>
            <h2>Project tools</h2>
        </div>
        <span class="faint small mono">@Work.Tools.Count tools</span>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            The same tool registry and four-state permissions as
            <strong>Settings &gt; System</strong> and <strong>Settings &gt; Project</strong>.
            System tools sets the defaults; the controls here override a tool for this project.
            <strong>Off</strong> hides a tool from the model, <strong>Never</strong> keeps it            visible but refuses every call, <strong>Ask</strong> prompts, and
            <strong>Always</strong> permits. Choose <strong>Inherit</strong> to clear an override
            and follow the System default. Changes save automatically.
        </p>
        <ToolPermissionEditor Value="_projectTools" ValueChanged="SaveProjectTools"
                              AllowInherit="true" Effective="ProjectToolsEffective" />
        <p class="small faint">
            <strong>Internal</strong> tools ship with Studio and honour the project gate.
            <strong>Plugin</strong> tools run their own code: Studio can hide them and can block
            the file and web calls they route through the gate, but it cannot sandbox a process a
            plugin starts itself.
        </p>
    </div>
</details>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Instructions</div>
            <h2>Skills</h2>
        </div>
        <span class="faint small mono">@(Work.SystemSkills.Count + Work.ProjectSkills.Count)</span>
    </summary>
    <div class="panel-body">
        <table class="table">
            <thead>
                <tr><th>Name</th><th>Scope</th><th>Enabled</th></tr>
            </thead>
            <tbody>
                @foreach (WorkSkill skill in Work.SystemSkills)
                {
                    <tr>
                        <td>@skill.Name</td>
                        <td>system</td>
                        <td>@(Work.IsSystemSkillEnabled(skill) ? "yes" : "no")</td>
                    </tr>
                }
                @foreach (WorkSkill skill in Work.ProjectSkills)
                {
                    <tr>
                        <td>@skill.Name</td>
                        <td>project</td>
                        <td>@(Work.IsProjectSkillEnabled(skill) ? "yes" : "no")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</details>

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Trace</div>
            <h2>Current transcript</h2>
        </div>
        <span class="faint small mono">@Chat.DisplayMessages.Count messages</span>
    </summary>
    <div class="panel-body stack">
        <div class="row">
            <button type="button" class="button" @onclick="Refresh">Refresh</button>
        </div>
        @if (Chat.DisplayMessages.Count == 0)
        {
            <p class="faint">Open a chat or send a turn to populate the trace.</p>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr><th>#</th><th>Time</th><th>Role</th><th>Name</th><th>Artifacts</th><th>Content</th></tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < Chat.DisplayMessages.Count; index++)
                    {
                        ChatMessage message = Chat.DisplayMessages[index];
                        <tr class="@(message.Role == ChatRole.Tool ? "lab-least" : "")">
                            <td class="mono">@index</td>
                            <td class="mono">@message.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                            <td>@message.Role</td>
                            <td>@(message.Name ?? "")</td>
                            <td class="mono">@(message.Artifacts?.Length ?? 0)</td>
                            <td>@Preview(message.Content)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</details>

@code {
    private StudioAgentDefinition? _editing;
    private IReadOnlyList<ModelDescriptor> _models = [];
    private readonly Dictionary<string, IReadOnlyList<string>> _voiceCache =
        new(StringComparer.OrdinalIgnoreCase);
    private ToolPermissionSet _projectTools = new();

    protected override async Task OnInitializedAsync()
    {
        Chat.Changed += OnChanged;
        Work.Changed += OnWorkChanged;
        Agents.Changed += OnChanged;
        LoadProjectTools();
        _models = await Catalog.RefreshAsync();
    }

    public void Dispose()
    {
        Chat.Changed -= OnChanged;
        Work.Changed -= OnWorkChanged;
        Agents.Changed -= OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// Another panel can raise a project tool, for example when a permission prompt
    /// chooses "Always allow". Mirror that in the editor.
    /// </summary>
    private void OnWorkChanged() => _ = InvokeAsync(() =>
    {
        LoadProjectTools();
        StateHasChanged();
    });

    private void LoadProjectTools() => _projectTools = new ToolPermissionSet
    {
        Tools = new Dictionary<string, WorkToolPermission>(
            Work.Settings.ToolPermissions.Tools, StringComparer.OrdinalIgnoreCase),
        Groups = new Dictionary<string, WorkToolPermission>(
            Work.Settings.ToolPermissions.Groups, StringComparer.OrdinalIgnoreCase),
    };

    private ToolPermissionValue ProjectToolsEffective(string tool, string? group) =>
        Work.SystemToolPermission(tool, group);

    private void SaveProjectTools(ToolPermissionSet permissions)
    {
        _projectTools = permissions;
        Work.Save(
            Work.Settings with
            {
                ToolPermissions = permissions,
                DisabledTools = [.. permissions.Tools
                    .Where(pair => pair.Value == WorkToolPermission.Off)
                    .Select(pair => pair.Key)],
                EnabledTools = [.. permissions.Tools
                    .Where(pair => pair.Value != WorkToolPermission.Off)
                    .Select(pair => pair.Key)],
            },
            Work.Memory);
        _ = Chat.ReloadWorkContextAsync();
    }

    private void Refresh() => StateHasChanged();

    private void NewAgent() => _editing = new StudioAgentDefinition
    {
        ModelChain = [new AgentModelChoice { Kind = AgentModelKind.Inherit }],
    };

    private void EditAgent(StudioAgentDefinition agent) => _editing = agent with
    {
        ModelChain = [.. Chain(agent)],
    };

    private static IReadOnlyList<AgentModelChoice> Chain(StudioAgentDefinition agent) =>
        agent.ModelChain.Count > 0 ? agent.ModelChain : [.. agent.EffectiveModelChain()];

    /// <summary>
    /// Voices available to an agent come from the first local speech model in
    /// its chain, or from an inherited local chat model.
    /// </summary>
    private IReadOnlyList<string> AgentVoiceOptions(StudioAgentDefinition agent)
    {
        (string? path, string? architecture) = AgentVoiceModel(agent);
        if (string.IsNullOrWhiteSpace(path) ||
            !Chat.SupportsTtsFor(path, architecture))
        {
            return [];
        }

        string key = $"{path}|{architecture}";
        if (!_voiceCache.TryGetValue(key, out IReadOnlyList<string>? voices))
        {
            voices = Chat.TtsVoiceOptionsFor(path, architecture);
            _voiceCache[key] = voices;
        }

        return voices;
    }

    private (string? Path, string? Architecture) AgentVoiceModel(
        StudioAgentDefinition agent)
    {
        foreach (AgentModelChoice choice in Chain(agent))
        {
            if (choice.Kind == AgentModelKind.Local &&
                !string.IsNullOrWhiteSpace(choice.Model))
            {
                ModelDescriptor? local = _models.FirstOrDefault(model =>
                    string.Equals(model.Path, choice.Model, StringComparison.OrdinalIgnoreCase));
                return (choice.Model, local?.Architecture);
            }

            if (choice.Kind == AgentModelKind.Inherit &&
                !string.IsNullOrWhiteSpace(Chat.Document?.ModelPath) &&
                string.Equals(Chat.Document.Provider, "local", StringComparison.OrdinalIgnoreCase))
            {
                string path = Chat.Document.ModelPath;
                ModelDescriptor? local = _models.FirstOrDefault(model =>
                    string.Equals(model.Path, path, StringComparison.OrdinalIgnoreCase));
                if (Chat.SupportsTtsFor(path, local?.Architecture))
                    return (path, local?.Architecture);
            }
        }

        return (null, null);
    }

    private static AgentModelKind ParseKind(object? value) =>
        Enum.TryParse(value?.ToString(), out AgentModelKind kind)
            ? kind
            : AgentModelKind.Inherit;

    private StudioAgentDefinition AddChain(StudioAgentDefinition agent, AgentModelKind kind)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        chain.Add(NewChoice(kind));
        return agent with { ModelChain = chain };
    }

    private StudioAgentDefinition SetChainKind(
        StudioAgentDefinition agent, int index, AgentModelKind kind)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        if (index < 0 || index >= chain.Count) return agent;
        if (chain[index].Kind == kind) return agent;
        chain[index] = NewChoice(kind);
        return agent with { ModelChain = chain };
    }

    private StudioAgentDefinition SetChainProvider(
        StudioAgentDefinition agent, int index, string? providerId)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        if (index < 0 || index >= chain.Count) return agent;
        AgentModelChoice choice = chain[index];
        string? provider = string.IsNullOrWhiteSpace(providerId) ? null : providerId.Trim();
        string? model = choice.Kind switch
        {
            AgentModelKind.Remote => OpenRouter.ActiveModelsFor(provider).FirstOrDefault(),
            AgentModelKind.Compute => ComputeModels(provider).FirstOrDefault(),
            _ => null,
        };
        chain[index] = choice with { ProviderId = provider, Model = model };
        return agent with { ModelChain = chain };
    }

    private StudioAgentDefinition SetChainModel(
        StudioAgentDefinition agent, int index, string? model)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        if (index < 0 || index >= chain.Count) return agent;
        chain[index] = chain[index] with
        {
            Model = string.IsNullOrWhiteSpace(model) ? null : model.Trim(),
        };
        return agent with { ModelChain = chain };
    }

    private StudioAgentDefinition MoveChain(
        StudioAgentDefinition agent, int index, int offset)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        int target = index + offset;
        if (index < 0 || index >= chain.Count || target < 0 || target >= chain.Count)
            return agent;
        (chain[index], chain[target]) = (chain[target], chain[index]);
        return agent with { ModelChain = chain };
    }

    private StudioAgentDefinition RemoveChain(StudioAgentDefinition agent, int index)
    {
        var chain = new List<AgentModelChoice>(Chain(agent));
        if (index < 0 || index >= chain.Count || chain.Count == 1) return agent;
        chain.RemoveAt(index);
        return agent with { ModelChain = chain };
    }

    private AgentModelChoice NewChoice(AgentModelKind kind)
    {
        switch (kind)
        {
            case AgentModelKind.Local:
                return new AgentModelChoice
                {
                    Kind = AgentModelKind.Local,
                    Model = _models.FirstOrDefault()?.Path,
                };

            case AgentModelKind.Remote:
            {
                string provider = RemoteProviders.All
                    .FirstOrDefault(item => OpenRouter.HasApiKeyFor(item.Id))?.Id
                    ?? RemoteProviders.OpenRouter;
                return new AgentModelChoice
                {
                    Kind = AgentModelKind.Remote,
                    ProviderId = provider,
                    Model = OpenRouter.ActiveModelsFor(provider).FirstOrDefault(),
                };
            }

            case AgentModelKind.Compute:
            {
                ComputeProviderSettings? host = Compute.Providers
                    .FirstOrDefault(item => item.Models.Count > 0)
                    ?? Compute.Providers.FirstOrDefault();
                return new AgentModelChoice
                {
                    Kind = AgentModelKind.Compute,
                    ProviderId = host?.Id,
                    Model = host?.Models.FirstOrDefault(),
                };
            }

            default:
                return new AgentModelChoice { Kind = AgentModelKind.Inherit };
        }
    }

    private IReadOnlyList<string> ComputeModels(string? providerId) =>
        Compute.Providers.FirstOrDefault(provider =>
            string.Equals(provider.Id, providerId, StringComparison.OrdinalIgnoreCase))?
            .Models ?? [];

    private string ChainLabel(StudioAgentDefinition agent) =>
        string.Join(" -> ", Chain(agent).Select(ChoiceLabel));

    private static string AvailabilityLabel(StudioAgentDefinition agent) =>
        (agent.AvailableInChat, agent.AvailableInWork) switch
        {
            (true, true) => "chat + work",
            (true, false) => "chat",
            (false, true) => "work",
            _ => "off",
        };

    private string ChoiceLabel(AgentModelChoice choice) => choice.Kind switch
    {
        AgentModelKind.Inherit => "inherit",
        AgentModelKind.Local => LocalLabel(choice.Model),
        AgentModelKind.Remote =>
            $"{RemoteProviders.Find(choice.ProviderId).Name}/{choice.Model}",
        AgentModelKind.Compute =>
            $"{Compute.Providers.FirstOrDefault(provider =>
                string.Equals(provider.Id, choice.ProviderId, StringComparison.OrdinalIgnoreCase))?.Name
                ?? choice.ProviderId}/{choice.Model}",
        _ => choice.Kind.ToString(),
    };

    private string LocalLabel(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "local (missing)";
        ModelDescriptor? model = _models.FirstOrDefault(item =>
            string.Equals(item.Path, path, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(item.FileName, path, StringComparison.OrdinalIgnoreCase));
        if (model is not null && File.Exists(model.Path)) return model.FileName;
        return $"{Path.GetFileName(path)} (missing)";
    }

    private void SetMaxDepth(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int value))
            Agents.SetMaxDepth(value);
    }

    private void SaveAgent()
    {
        if (_editing is not { } agent || string.IsNullOrWhiteSpace(agent.Name)) return;
        Agents.Upsert(agent);
        _editing = null;
    }

    private static readonly WorkPermission[] PermissionOptions =
        [WorkPermission.Ask, WorkPermission.Always, WorkPermission.Never];

    private static string PermissionLabel(WorkPermission permission) => permission switch
    {
        WorkPermission.Always => "Allow",
        WorkPermission.Never => "Deny",
        _ => "Ask",
    };

    private static StudioAgentDefinition SetPermission(
        StudioAgentDefinition agent, WorkToolCategory category, object? value)
    {
        WorkPermission permission = Enum.TryParse(value?.ToString(), out WorkPermission parsed)
            ? parsed
            : WorkPermission.Ask;
        WorkPermissions permissions = agent.Permissions;
        WorkPermissions next = category switch
        {
            WorkToolCategory.Read => permissions with { Read = permission },
            WorkToolCategory.Write => permissions with { Write = permission },
            WorkToolCategory.Delete => permissions with { Delete = permission },
            WorkToolCategory.Web => permissions with { Web = permission },
            _ => permissions,
        };
        return agent with { Permissions = next };
    }

    private static string Preview(string content)
    {
        string text = content.Replace('\n', ' ').Replace('\r', ' ').Trim();
        return text.Length <= 140 ? text : text[..140] + "…";
    }
}
