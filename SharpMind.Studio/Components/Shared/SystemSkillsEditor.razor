@using SharpMind.Studio.Services
@using SharpMind.Studio.Core.Work
@inject SystemWorkSkillsService Skills
@inject StudioChatService ChatService
@inject PathPickerService Picker

<details class="panel settings-collapsible">
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Work inheritance</div>
            <h2>System skills</h2>
        </div>
        <span class="faint small mono">@Skills.Folder</span>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            These skills live in the shared Skills folder. Each project chooses which ones to use; a project can override the defaults. You can add skills here or copy .md files into the folder.
        </p>

        @if (_drafts.Count == 0)
        {
            <div class="empty">No system skills yet.</div>
        }

        @foreach (SkillDraft skill in _drafts)
        {
            <div class="work-skill-card">
                <div class="row">
                    <label class="tool-toggle">
                        <input type="checkbox" @bind="skill.DefaultEnabled" />
                        <span>On by default</span>
                    </label>
                    <input class="input" @bind="skill.Name" placeholder="Skill name" />
                    <button type="button" class="button danger" @onclick="() => Remove(skill)">Delete</button>
                </div>
                <textarea class="textarea work-textarea" @bind="skill.Content"
                          placeholder="Instructions the agent should follow."></textarea>
            </div>
        }

        <div class="row">
            <button type="button" class="button" @onclick="Add">Add skill</button>
            <button type="button" class="button" @onclick="ImportAsync">Import .md</button>
            <button type="button" class="button" @onclick="Refresh">Refresh folder</button>
            <button type="button" class="button primary" @onclick="SaveAsync">Save system skills</button>
            <span class="status-line">@_status</span>
        </div>
    </div>
</details>

@code {
    private sealed class SkillDraft
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Content { get; set; } = "";
        public bool DefaultEnabled { get; set; } = true;
    }

    private List<SkillDraft> _drafts = [];
    private string _status = "";

    protected override void OnInitialized() => Load();

    private void Load()
    {
        _drafts = [.. Skills.Skills.Select(skill => new SkillDraft
        {
            Id = skill.Id,
            Name = skill.Name,
            Content = skill.Content,
            DefaultEnabled = skill.DefaultEnabled,
        })];
    }

    private void Refresh()
    {
        Skills.Reload();
        Load();
        _status = $"Loaded {_drafts.Count} skill(s) from {Skills.Folder}.";
    }

    private void Add()
    {
        _drafts.Add(new SkillDraft { Id = Guid.NewGuid().ToString("n"), DefaultEnabled = true });
        _status = "";
    }

    private async Task ImportAsync()
    {
        PathPickerSelection? selection = await Picker.PickAsync(
            PathPickerMode.MultiFile,
            Skills.Folder,
            "Import system skills",
            "*.md");
        if (selection is null) return;

        int imported = 0;
        foreach (string file in selection.All)
        {
            try
            {
                string name = UniqueName(
                    Path.GetFileNameWithoutExtension(file),
                    _drafts.Select(skill => skill.Name));
                _drafts.Add(new SkillDraft
                {
                    Id = Guid.NewGuid().ToString("n"),
                    Name = name,
                    Content = await File.ReadAllTextAsync(file),
                    DefaultEnabled = true,
                });
                imported++;
            }
            catch (Exception ex)
            {
                _status = $"Could not import {Path.GetFileName(file)}: {ex.Message}";
            }
        }

        if (imported > 0) _status = $"Imported {imported} skill(s). Save system skills to apply.";
    }

    private static string UniqueName(string? name, IEnumerable<string> existing)
    {
        string baseName = string.IsNullOrWhiteSpace(name) ? "Imported skill" : name.Trim();
        var taken = new HashSet<string>(existing, StringComparer.OrdinalIgnoreCase);
        if (!taken.Contains(baseName)) return baseName;

        for (int suffix = 2; ; suffix++)
        {
            string candidate = $"{baseName} ({suffix})";
            if (!taken.Contains(candidate)) return candidate;
        }
    }

    private void Remove(SkillDraft skill)
    {
        _drafts.Remove(skill);
        _status = "";
    }

    private async Task SaveAsync()
    {
        try
        {
            Skills.Save(_drafts.Select(skill => new WorkSkill
            {
                Id = skill.Id,
                Name = skill.Name,
                Content = skill.Content,
                DefaultEnabled = skill.DefaultEnabled,
            }));
            Load();
            await ChatService.ReloadWorkContextAsync();
            _status = $"Saved {_drafts.Count} system skill(s).";
        }
        catch (Exception ex)
        {
            _status = $"{ex.GetType().Name}: {ex.Message}";
        }
    }
}


