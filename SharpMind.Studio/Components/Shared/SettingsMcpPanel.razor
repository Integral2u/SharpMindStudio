@using SharpMind.Studio.Core.Mcp
@using SharpMind.Studio.Core.Work
@using SharpMind.Studio.Services
@implements IDisposable
@inject McpSettingsStore Store
@inject McpServerHost Host
@inject WorkToolService ToolCatalog
@inject StudioWorkService Work

<details class="panel settings-collapsible" open>
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Tools</div>
            <h2>MCP servers</h2>
        </div>
        <span class="faint small mono">@Store.Servers.Count configured</span>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            An MCP server is a local process or an HTTP endpoint that publishes tools. Studio adds
            them to the project's tool list, so they sit beside the built-in and plugin tools.
            Adding a server does not start it: <strong>Connect</strong> starts the process or opens
            the HTTP session and asks for this project's <strong>Run</strong> permission first.
            Each tool stays <strong>Off</strong> until you allow it below.
        </p>

        @if (Store.Servers.Count == 0)
        {
            <div class="small faint">No servers yet. Add one at the bottom of this panel.</div>
        }

        @foreach (McpServerSettings server in Store.Servers)
        {
            bool running = Host.IsRunning(server.Id);
            IReadOnlyList<McpToolInfo> tools = ToolsFor(server.Id);

            <div class="settings-subgroup" style="padding:.7rem;">
                <div class="spread" style="align-items:flex-start;gap:1rem;">
                    <div>
                        <strong>@server.Name</strong>
                        <div class="small faint mono">
                            @(server.IsHttp
                                ? server.Url
                                : $"{server.Command} {string.Join(" ", server.Args)}")
                        </div>
                        <div class="small faint">
                            @(server.IsHttp ? "HTTP" : "local process") -
                            @(running ? $"connected - {tools.Count} tool(s)" : "stopped")
                            @if (!server.Enabled) { <text> - disabled</text> }
                        </div>
                        <div class="row" style="margin-top:.4rem;align-items:center;gap:.4rem;">
                            <label class="small faint" for="mcp-idle-@server.Id">Stop when idle</label>
                            <select id="mcp-idle-@server.Id" class="input" style="width:auto;"
                                    title="Studio stops the process or session after the selected idle time. Never keeps it running until Studio exits."
                                    value="@server.IdleSeconds"
                                    @onchange="args => SetIdle(server, args)">
                                @foreach ((int seconds, string label) in IdleOptions)
                                {
                                    <option value="@seconds">@label</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <button type="button" class="button" @onclick="() => BeginEdit(server)">
                            Edit
                        </button>
                        <button type="button" class="button" @onclick="() => ConnectAsync(server)"
                                disabled="@running">
                            Connect
                        </button>
                        <button type="button" class="button" @onclick="() => DisconnectAsync(server)"
                                disabled="@(!running)">
                            Disconnect
                        </button>
                        <button type="button" class="button danger" @onclick="() => RemoveAsync(server)">
                            Remove
                        </button>
                    </div>
                </div>

                @if (running)
                {
                    @if (tools.Count == 0)
                    {
                        <div class="small faint" style="margin-top:.5rem;">
                            The server advertised no tools.
                        </div>
                    }
                    else
                    {
                        <div class="spread" style="margin:.6rem 0 .3rem;">
                            <span class="small faint">Tools from this server, for this project</span>
                            <button type="button" class="button" @onclick="() => AllowAll(server.Id, tools)"
                                    title="Set every tool from this server to Ask. Each call still asks before it runs.">
                                Allow all (Ask)
                            </button>
                        </div>
                        <div class="work-tools">
                            @foreach (McpToolInfo tool in tools)
                            {
                                string name = $"mcp__{server.Id}__{tool.Name}";
                                WorkToolPermission current = Permission(name);
                                <div class="work-tool-row" title="@tool.Description">
                                    <span class="work-tool-name">@tool.Name</span>
                                    <div class="segmented" role="group" aria-label="@name permission">
                                        @foreach (WorkToolPermission option in ToolOptions)
                                        {
                                            <button type="button"
                                                    class="segmented-option @(current == option ? "active" : "") @Class(option)"
                                                    title="@Explain(option)"
                                                    @onclick="() => SetToolPermission(name, option)">
                                                @Label(option)
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        <div class="settings-subgroup" style="padding:.7rem;">
            <div class="eyebrow">@(_editingId is null ? "Add a server" : $"Edit {_name}")</div>
            <div class="field">
                <label class="field-label" for="mcp-preset">Start from a preset</label>
                <select id="mcp-preset" class="input" @bind="_presetId" @bind:after="ApplyPreset">
                    @foreach (McpServerPreset preset in McpServerPresets.All)
                    {
                        <option value="@preset.Id">@preset.Name</option>
                    }
                </select>
                @if (_presetRequires is { Length: > 0 })
                {
                    <div class="small faint">
                        Requires @_presetRequires. Studio does not install it.
                    </div>
                }
            </div>
            <div class="field">
                <label class="field-label" for="mcp-transport">Server type</label>
                <select id="mcp-transport" class="input" @bind="_transport">
                    <option value="@McpTransports.Stdio">Local process (stdio)</option>
                    <option value="@McpTransports.Http">HTTP server</option>
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="mcp-id">Id</label>
                <input id="mcp-id" class="input" @bind="_id" placeholder="files"
                       disabled="@(_editingId is not null)" />
                @if (_editingId is not null)
                {
                    <div class="small faint">The id is fixed once a server exists.</div>
                }
            </div>
            <div class="field">
                <label class="field-label" for="mcp-name">Name</label>
                <input id="mcp-name" class="input" @bind="_name" placeholder="Files" />
            </div>

            @if (!IsHttp)
            {
                <div class="field">
                    <label class="field-label" for="mcp-command">Command</label>
                    <input id="mcp-command" class="input" @bind="_command" placeholder="npx" />
                    <SecretInsert OnInsert="InsertCommand" />
                </div>
                <div class="field">
                    <label class="field-label" for="mcp-args">Arguments, one per line</label>
                    <textarea id="mcp-args" class="textarea work-textarea" @bind="_args"
                              placeholder="-y&#10;@@modelcontextprotocol/server-filesystem&#10;C:\work"></textarea>
                    <SecretInsert OnInsert="InsertArgument" />
                </div>
                <div class="field">
                    <label class="field-label" for="mcp-env">Environment, KEY=value per line</label>
                    <textarea id="mcp-env" class="textarea work-textarea" @bind="_environment"></textarea>
                    <SecretInsert EnvMode="true" OnInsert="InsertEnvironment" />
                    <div class="small faint">
                        Plain values here are stored in <span class="mono">mcp.json</span>.
                        Use <span class="mono">%vault:NAME%</span> for anything private.
                    </div>
                </div>
            }
            else
            {
                <div class="field">
                    <label class="field-label" for="mcp-url">Server URL</label>
                    <input id="mcp-url" class="input" @bind="_url"
                           placeholder="https://example.com/mcp" />
                    <div class="small faint">
                        Streamable HTTP. Use https unless the endpoint is on this machine.
                    </div>
                </div>
                <div class="field">
                    <label class="field-label" for="mcp-headers">Headers, Name: value per line</label>
                    <textarea id="mcp-headers" class="textarea work-textarea" @bind="_headers"
                              placeholder="Authorization: Bearer %vault:MCP_TOKEN%"></textarea>
                    <SecretInsert HeaderMode="true" OnInsert="InsertHeader" />
                    <div class="small faint">
                        Plain values are stored in <span class="mono">mcp.json</span>. The remote
                        server receives these headers; use <span class="mono">%vault:NAME%</span>
                        for a token.
                    </div>
                </div>
            }

            <div class="field">
                <label class="field-label" for="mcp-idle-new">Stop when idle</label>
                <select id="mcp-idle-new" class="input" @bind="_idleSeconds"
                        title="Studio stops the process or session after this much idle time. Never keeps it running until Studio exits.">
                    @foreach ((int seconds, string label) in IdleOptions)
                    {
                        <option value="@seconds">@label</option>
                    }
                </select>
            </div>
            <div class="row" style="margin-top:.5rem;">
                <button type="button" class="button primary" @onclick="Save"
                        disabled="@(!CanSave)">
                    @(_editingId is null ? "Add server" : "Save changes")
                </button>
                @if (_editingId is not null)
                {
                    <button type="button" class="button" @onclick="CancelEdit">Cancel</button>
                }
                <span class="status-line">@_status</span>
            </div>
        </div>
    </div>
</details>

@code {
    private static readonly WorkToolPermission[] ToolOptions =
    [
        WorkToolPermission.Off,
        WorkToolPermission.Never,
        WorkToolPermission.Ask,
        WorkToolPermission.Always,
    ];

    private static readonly (int Seconds, string Label)[] IdleOptions =
    [
        (300, "5 minutes"),
        (900, "15 minutes"),
        (1800, "30 minutes"),
        (3600, "60 minutes"),
        (0, "Never"),
    ];

    private string _id = "";
    private string _name = "";
    private string _transport = McpTransports.Stdio;
    private string _command = "";
    private string _args = "";
    private string _environment = "";
    private string _url = "";
    private string _headers = "";
    private string? _status;
    private string? _editingId;
    private string _presetId = McpServerPresets.Custom;
    private string? _presetRequires;
    private int _idleSeconds = 300;

    private bool IsHttp => McpTransports.IsHttp(_transport);

    private bool CanSave => IsHttp
        ? Uri.TryCreate(_url.Trim(), UriKind.Absolute, out Uri? uri) &&
          uri.Scheme is "http" or "https"
        : !string.IsNullOrWhiteSpace(_command);

    protected override void OnInitialized() => ToolCatalog.Changed += OnCatalogChanged;

    private void OnCatalogChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ToolCatalog.Changed -= OnCatalogChanged;

    private IReadOnlyList<McpToolInfo> ToolsFor(string serverId) =>
        Host.Connected
            .FirstOrDefault(entry =>
                entry.ServerId.Equals(serverId, StringComparison.OrdinalIgnoreCase))
            ?.Tools ?? [];

    private WorkToolPermission Permission(string name) =>
        Work.Settings.ToolPermissions.TryTool(name, out WorkToolPermission value)
            ? value
            : WorkToolPermission.Off;

    private void SetToolPermission(string name, WorkToolPermission permission)
    {
        SaveTools(tools => tools[name] = permission);
        _status = permission == WorkToolPermission.Off
            ? $"{name}: off."
            : $"{name}: {Label(permission)}.";
    }

    private void AllowAll(string serverId, IReadOnlyList<McpToolInfo> tools)
    {
        SaveTools(entries =>
        {
            foreach (McpToolInfo tool in tools)
                entries[$"mcp__{serverId}__{tool.Name}"] = WorkToolPermission.Ask;
        });
        _status = $"{tools.Count} tool(s) from {serverId} set to Ask.";
    }

    /// <summary>Writes the project tool layer; this is the consent a session reads.</summary>
    private void SaveTools(Action<Dictionary<string, WorkToolPermission>> change)
    {
        var tools = new Dictionary<string, WorkToolPermission>(
            Work.Settings.ToolPermissions.Tools, StringComparer.OrdinalIgnoreCase);
        var groups = new Dictionary<string, WorkToolPermission>(
            Work.Settings.ToolPermissions.Groups, StringComparer.OrdinalIgnoreCase);
        change(tools);

        Work.Save(
            Work.Settings with
            {
                ToolPermissions = new ToolPermissionSet { Tools = tools, Groups = groups },
            },
            Work.Memory);
    }

    private void SetIdle(McpServerSettings server, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out int seconds)) return;

        try
        {
            McpServerSettings updated = server with { IdleSeconds = seconds };
            Store.Save(updated);
            // A running server keeps its process or session; only the timeout changes.
            Host.UpdateSettings(updated);
            _status = seconds == 0
                ? $"{server.Name} stays running until Studio exits."
                : $"{server.Name} stops after {IdleLabel(seconds)} idle.";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private static string IdleLabel(int seconds) =>
        IdleOptions.FirstOrDefault(option => option.Seconds == seconds).Label ?? $"{seconds} seconds";

    private void ApplyPreset()
    {
        McpServerPreset preset = McpServerPresets.Find(_presetId);
        _transport = preset.Transport;
        _command = preset.Command;
        _args = string.Join("\n", preset.Args);
        _url = preset.Url;
        _headers = FormatHeaders(preset.Headers);
        _environment = FormatEnvironment(preset.Environment);
        _presetRequires = preset.Requires;

        bool presetName = McpServerPresets.All.Any(candidate =>
            candidate.Name.Equals(_name.Trim(), StringComparison.OrdinalIgnoreCase));
        if (preset.Id != McpServerPresets.Custom &&
            (string.IsNullOrWhiteSpace(_name) || presetName))
        {
            _name = preset.Name;
        }

        _status = null;
    }

    private void BeginEdit(McpServerSettings server)
    {
        _editingId = server.Id;
        _id = server.Id;
        _name = server.Name;
        _transport = McpTransports.Normalize(server.Transport);
        _command = server.Command;
        _args = string.Join("\n", server.Args);
        _environment = FormatEnvironment(server.Environment);
        _url = server.Url;
        _headers = FormatHeaders(server.Headers);
        _presetId = McpServerPresets.Custom;
        _presetRequires = null;
        _idleSeconds = server.IdleSeconds;
        _status = $"Editing {server.Name}.";
    }

    private void CancelEdit()
    {
        _editingId = null;
        ClearForm();
        _status = null;
    }

    private void ClearForm()
    {
        _id = _name = _command = _args = _environment = _url = _headers = "";
        _transport = McpTransports.Stdio;
        _presetId = McpServerPresets.Custom;
        _presetRequires = null;
        _idleSeconds = 300;
    }

    private void InsertCommand(string reference) =>
        _command = string.IsNullOrWhiteSpace(_command)
            ? reference
            : $"{_command.TrimEnd()} {reference}";

    private void InsertArgument(string reference) =>
        _args = string.IsNullOrWhiteSpace(_args)
            ? reference
            : $"{_args.TrimEnd()}\n{reference}";

    private void InsertEnvironment(string entry) =>
        _environment = string.IsNullOrWhiteSpace(_environment)
            ? entry
            : $"{_environment.TrimEnd()}\n{entry}";

    private void InsertHeader(string entry) =>
        _headers = string.IsNullOrWhiteSpace(_headers)
            ? entry
            : $"{_headers.TrimEnd()}\n{entry}";

    private void Save()
    {
        try
        {
            bool editing = _editingId is not null;
            string transport = McpTransports.Normalize(_transport);
            bool http = McpTransports.IsHttp(transport);
            string id = _editingId
                ?? (string.IsNullOrWhiteSpace(_id) ? Slug(_name.Length > 0 ? _name : _command) : _id.Trim());
            var server = new McpServerSettings
            {
                Id = id,
                Name = string.IsNullOrWhiteSpace(_name) ? id : _name.Trim(),
                Transport = transport,
                Command = http ? "" : _command.Trim(),
                Args = http ? [] : [.. Lines(_args)],
                Environment = http ? [] : ParseEnvironment(_environment),
                Url = http ? _url.Trim() : "",
                Headers = http ? ParseHeaders(_headers) : [],
                IdleSeconds = _idleSeconds,
            };

            bool running = Host.IsRunning(id);
            Store.Save(server);
            if (running) Host.UpdateSettings(server);

            _status = editing
                ? $"Saved {server.Name}." + (running
                    ? " Disconnect and Connect to apply a changed command, URL, header or environment."
                    : "")
                : $"Added {server.Name}. Connect it to see its tools.";

            _editingId = null;
            ClearForm();
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private async Task ConnectAsync(McpServerSettings server)
    {
        try
        {
            bool allowed = await Work.CheckAccessAsync(new WorkToolAccess(
                $"mcp:{server.Id}",
                WorkToolCategory.Execute,
                Work.ProjectRoot));

            if (!allowed)
            {
                _status = "Run permission denied for this project.";
                return;
            }

            IReadOnlyList<McpToolInfo> tools = await Host.EnsureStartedAsync(
                server, () => Task.FromResult(true));

            ToolCatalog.RegisterMcpTools(server.Id, server.Name, tools);
            _status = tools.Count == 0
                ? $"{server.Name}: no tools advertised."
                : $"{server.Name}: {tools.Count} tool(s). Allow the ones you want below.";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private async Task DisconnectAsync(McpServerSettings server)
    {
        try
        {
            await Host.StopAsync(server.Id);
            ToolCatalog.ClearMcpTools(server.Id);
            _status = $"{server.Name} stopped.";
        }
        catch (Exception ex)
        {
            _status = ex.Message;
        }
    }

    private async Task RemoveAsync(McpServerSettings server)
    {
        await DisconnectAsync(server);
        Store.Remove(server.Id);
        if (_editingId == server.Id) CancelEdit();
        _status = $"{server.Name} removed.";
    }

    private static string Label(WorkToolPermission value) => value switch
    {
        WorkToolPermission.Off => "Off",
        WorkToolPermission.Never => "Never",
        WorkToolPermission.Ask => "Ask",
        _ => "Always",
    };

    private static string Class(WorkToolPermission value) =>
        "is-" + Label(value).ToLowerInvariant();

    private static string Explain(WorkToolPermission value) => value switch
    {
        WorkToolPermission.Off => "Off: the model never sees this tool.",
        WorkToolPermission.Never => "Never: the tool is visible but every call is refused.",
        WorkToolPermission.Ask => "Ask: the tool is visible and each call asks first.",
        _ => "Always: the tool runs without asking.",
    };

    private static IEnumerable<string> Lines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static Dictionary<string, string> ParseEnvironment(string text)
    {
        var environment = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string line in Lines(text))
        {
            int equals = line.IndexOf('=');
            if (equals <= 0) continue;
            environment[line[..equals].Trim()] = line[(equals + 1)..];
        }
        return environment;
    }

    private static Dictionary<string, string> ParseHeaders(string text)
    {
        var headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (string line in Lines(text))
        {
            int colon = line.IndexOf(':');
            if (colon <= 0) continue;
            headers[line[..colon].Trim()] = line[(colon + 1)..].Trim();
        }
        return headers;
    }

    private static string FormatHeaders(IReadOnlyDictionary<string, string> headers) =>
        string.Join("\n", headers.Select(pair => $"{pair.Key}: {pair.Value}"));

    private static string FormatHeaders(IReadOnlyList<McpPresetPair> headers) =>
        string.Join("\n", headers.Select(pair => $"{pair.Name}: {pair.Value}"));

    private static string FormatEnvironment(IReadOnlyDictionary<string, string> environment) =>
        string.Join("\n", environment.Select(pair => $"{pair.Key}={pair.Value}"));

    private static string FormatEnvironment(IReadOnlyList<McpPresetPair> environment) =>
        string.Join("\n", environment.Select(pair => $"{pair.Name}={pair.Value}"));

    private static string Slug(string value)
    {
        var slug = new System.Text.StringBuilder();
        foreach (char character in value.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(character)) slug.Append(character);
            else if (slug.Length > 0 && slug[^1] != '-') slug.Append('-');
        }
        return slug.ToString().Trim('-');
    }
}
