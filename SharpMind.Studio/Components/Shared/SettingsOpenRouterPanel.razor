@using SharpMind.Studio.Core.OpenRouter
@using SharpMind.Studio.Core.Storage
@using SharpMind.Studio.Services
@inject OpenRouterSettingsService OpenRouter
@inject IJSRuntime JS

<details class="settings-subgroup">
    <summary class="settings-subgroup-head">
        <div>
            <div class="eyebrow">Model providers</div>
            <h3>Remote providers</h3>
        </div>
        <div class="row" style="align-items:center; gap:.45rem;">
            <span class="provider-dot @(OpenRouter.HasApiKeyFor(_providerId) ? "on" : "off")"></span>
            <span class="faint small mono">@(OpenRouter.HasApiKeyFor(_providerId) ? "key configured" : "no key")</span>
        </div>
    </summary>
    <div class="settings-subgroup-body stack">
        <p class="small faint">
            Chat and Work can use a remote provider. Each provider keeps its own encrypted
            key, base URL and model list. Leave the key field blank to keep the existing key.
        </p>

        <div class="field">
            <label class="field-label" for="remote-provider">Provider</label>
            <div class="row" style="gap:.5rem;">
                <select id="remote-provider" class="input" style="max-width: 18rem;"
                        @bind="_providerId" @bind:after="OnProviderChanged">
                    @foreach (RemoteProviderPreset provider in RemoteProviders.All)
                    {
                        <option value="@provider.Id">@provider.Name@(provider.Beta ? " (beta)" : "")</option>
                    }
                </select>
                @if (_preset.Beta)
                {
                    <span class="beta-pill">beta</span>
                }
                @if (_preset.HasSignup)
                {
                    <a class="button" href="@_preset.SignupUrl" target="_blank"
                       rel="sponsored noopener">Sign up</a>
                }
            </div>
        </div>

        <div class="training-form">
            <div class="field training-form-wide">
                <label class="field-label" for="remote-key">API key</label>
                <input id="remote-key" class="input" type="password" @bind="_key"
                       placeholder="@_preset.KeyHint (leave blank to keep)" autocomplete="off" />
                <span class="small faint">Stored encrypted under <span class="mono">@StudioPaths.OpenRouterFile</span>.</span>
            </div>
            <div class="field training-form-wide">
                <label class="field-label" for="remote-base">Base URL</label>
                <input id="remote-base" class="input" @bind="_baseUrl" />
            </div>
        </div>
        <div class="row">
            <button type="button" class="button primary" @onclick="Save">Save</button>
            <button type="button" class="button" @onclick="FetchModelsAsync"
                    disabled="@_testing">
                @(_testing ? "Fetching..." : "Fetch models")
            </button>
            <button type="button" class="button" @onclick="TestKeyAsync"
                    disabled="@(_testing || !OpenRouter.HasApiKeyFor(_providerId))">
                Test key
            </button>
            <button type="button" class="button danger" @onclick="DeleteKeyAsync">Delete key</button>
        </div>
        @if (_status is { Length: > 0 })
        {
            <div class="status-line">@_status</div>
        }
        @if (_error is not null)
        {
            <div class="error-line">@_error</div>
        }

        <div class="training-subsection">
            <div class="training-subsection-head">
                <label class="field-label">Active models</label>
                <span class="faint small">@OpenRouter.ActiveModelsFor(_providerId).Count model(s)</span>
            </div>
            @if (OpenRouter.ActiveModelsFor(_providerId).Count == 0)
            {
                <div class="small faint">No active models yet. Fetch models and add some below.</div>
            }
            else
            {
                @foreach (string model in OpenRouter.ActiveModelsFor(_providerId))
                {
                    <div class="spread">
                        <span class="mono small">@model</span>
                        <button type="button" class="button danger"
                                @onclick="() => RemoveActiveModel(model)">Remove</button>
                    </div>
                }
            }
            <div class="field">
                <label class="field-label" for="remote-default">Default model</label>
                <select id="remote-default" class="input" @bind="_model"
                        @bind:after="SaveDefaultModel">
                    @foreach (string model in OpenRouter.ActiveModelsFor(_providerId))
                    {
                        <option value="@model">@model</option>
                    }
                </select>
            </div>
        </div>

        <div class="training-subsection">
            <div class="training-subsection-head">
                <label class="field-label">Fetched models</label>
                <div class="row">
                    <button type="button" class="button" @onclick="FetchModelsAsync"
                            disabled="@_testing">Fetch</button>
                    <button type="button" class="button" @onclick="AddAllFreeModelsAsync"
                            disabled="@_testing">Add All Free</button>
                </div>
            </div>
            <div class="field">
                <label class="field-label" for="remote-fetched">Add a fetched model</label>
                <select id="remote-fetched" class="input" @bind="_fetchedModelChoice"
                        @bind:after="AddFetchedModel" @onfocus="EnsureFetchedModelsAsync">
                    <option value="">@(_models.Count == 0 ? "Open to load models..." : "Choose a model...")</option>
                    @foreach (OpenRouterModel model in _models
                        .Where(model => !IsActiveModel(model.Id))
                        .Take(400))
                    {
                        <option value="@model.Id">
                            @model.Id@(model.IsFree ? " (Free)" : "")@(model.SupportsTools ? " (tools)" : "")@(model.ContextLength is { } context ? $" - {context:N0} ctx" : "")
                        </option>
                    }
                </select>
                <span class="small faint">
                    Free models are listed first. Choosing one adds it to Active models.
                </span>
            </div>
        </div>
    </div>
</details>

@code {
    private string _providerId = RemoteProviders.OpenRouter;
    private string _key = "";
    private string _baseUrl = "";
    private string _model = "";
    private string? _status;
    private string? _error;
    private bool _testing;
    private IReadOnlyList<OpenRouterModel> _models = [];
    private string? _fetchedModelChoice;

    private RemoteProviderPreset _preset => RemoteProviders.Find(_providerId);

    protected override void OnInitialized() => LoadProfile();

    private void LoadProfile()
    {
        _baseUrl = OpenRouter.BaseUrlFor(_providerId);
        _model = OpenRouter.DefaultModelFor(_providerId) ?? "";
    }

    private void OnProviderChanged()
    {
        _key = "";
        _models = [];
        _fetchedModelChoice = null;
        _status = null;
        _error = null;
        LoadProfile();
    }

    private void Save()
    {
        try
        {
            OpenRouter.SaveFor(
                _providerId,
                string.IsNullOrWhiteSpace(_key) ? null : _key,
                _baseUrl,
                _model);
            _key = "";
            _status = $"{_preset.Name} settings saved.";
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void SaveDefaultModel()
    {
        OpenRouter.SetDefaultModelFor(_providerId, _model);
        _status = $"Default model set to {_model}.";
    }

    private bool IsActiveModel(string modelId) =>
        OpenRouter.ActiveModelsFor(_providerId).Any(value =>
            value.Equals(modelId, StringComparison.OrdinalIgnoreCase));

    private async Task FetchModelsAsync()
    {
        _error = null;
        _status = "";
        _testing = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _models = await OpenRouter.FetchModelsForAsync(_providerId, timeout.Token);
            int free = _models.Count(model => model.IsFree);
            _status = $"Fetched {_models.Count:N0} model(s), {free:N0} free.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task TestKeyAsync()
    {
        _error = null;
        _status = "";
        _testing = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            RemoteKeyInfo info = await OpenRouter.TestKeyAsync(_providerId, timeout.Token);
            string label = info.Label ?? info.Name ?? "key";
            string limit = info.Remaining is { } remaining
                ? $", {remaining:0.##}{CurrencySuffix(info)} remaining"
                : "";
            string usage = info.Usage is { } used
                ? $", {used:0.##}{CurrencySuffix(info)} used"
                : "";
            _status = $"{_preset.Name} key '{label}' is valid{limit}{usage}.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _testing = false;
        }
    }

    private string CurrencySuffix(RemoteKeyInfo info) =>
        !string.IsNullOrWhiteSpace(info.Currency)
            ? " " + info.Currency
            : _providerId == RemoteProviders.EuroRouter ? " EUR" : "";

    private async Task EnsureFetchedModelsAsync()
    {
        if (_models.Count > 0 || _testing) return;
        await FetchModelsAsync();
    }

    private void AddFetchedModel()
    {
        if (string.IsNullOrWhiteSpace(_fetchedModelChoice)) return;
        string model = _fetchedModelChoice;
        _fetchedModelChoice = "";
        if (OpenRouter.AddActiveModelFor(_providerId, model))
            _status = $"Added {model} to active models.";
        else
            _status = $"{model} is already active.";
        if (string.IsNullOrWhiteSpace(_model))
            _model = model;
    }

    private async Task AddAllFreeModelsAsync()
    {
        _error = null;
        _testing = true;
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            _models = await OpenRouter.FetchModelsForAsync(_providerId, timeout.Token);
            int added = OpenRouter.AddActiveModelsFor(_providerId,
                _models.Where(model => model.IsFree).Select(model => model.Id));
            OpenRouter.MarkFreeModelsSeededFor(_providerId);
            _status = added == 0
                ? "All free models are already active."
                : $"Added {added:N0} free model(s) to active models.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _testing = false;
        }
    }

    private void RemoveActiveModel(string model)
    {
        if (!OpenRouter.RemoveActiveModelFor(_providerId, model)) return;
        if (string.Equals(_model, model, StringComparison.OrdinalIgnoreCase))
            _model = OpenRouter.DefaultModelFor(_providerId) ?? "";
        _status = $"Removed {model} from active models.";
    }

    private async Task DeleteKeyAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete the saved {_preset.Name} API key?");
        if (!confirmed) return;

        OpenRouter.ClearApiKeyFor(_providerId);
        _key = "";
        _status = $"{_preset.Name} API key deleted.";
        _error = null;
    }
}
