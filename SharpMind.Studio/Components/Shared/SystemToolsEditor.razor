@using SharpMind.Studio.Core.Work
@using SharpMind.Studio.Services
@inject WorkToolService Tools
@inject StudioPluginService Plugins
@inject StudioChatService ChatService
@inject InferenceSettingsService Inference

<details class="panel settings-collapsible">
    <summary class="panel-head">
        <div>
            <div class="eyebrow">Work inheritance</div>
            <h2>System tools</h2>
        </div>
        <button type="button" class="button settings-refresh-button" @onclick="Refresh">Refresh plugins</button>
    </summary>
    <div class="panel-body stack">
        <p class="small faint">
            These defaults apply to every model and to new Work projects. A project can override
            an individual tool afterwards. Chat has no tools. Unset tools use <strong>Ask</strong>.
            Plugin tools are loaded from <span class="mono">@Tools.Folder</span>.
        </p>
        <ToolPermissionEditor Value="Inference.SystemTools" ValueChanged="SaveSystemTools" />
        @if (Tools.Warnings.Count > 0)
        {
            <div class="small faint">
                @foreach (string warning in Tools.Warnings)
                {
                    <div>@warning</div>
                }
            </div>
        }
    </div>
</details>

@code {
    private async Task SaveSystemTools(ToolPermissionSet permissions)
    {
        Inference.SetSystemTools(permissions);
        await ChatService.ReloadWorkContextAsync();
    }

    private void Refresh()
    {
        Tools.Reload();
        Plugins.Reload();
        StateHasChanged();
    }
}
