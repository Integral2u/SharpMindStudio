@using SharpMind.Studio.Services
@inject WorkToolService Tools
@inject StudioChatService ChatService

<section class="panel">
    <div class="panel-head">
        <div>
            <div class="eyebrow">Work inheritance</div>
            <h2>System tools</h2>
        </div>
        <button type="button" class="button" @onclick="Refresh">Refresh plugins</button>
    </div>
    <div class="panel-body stack">
        <p class="small faint">
            These defaults apply to new Work projects. A project can enable or disable individual tools afterwards. Chat has no tools.
            Plugin tools are loaded from <span class="mono">@Tools.Folder</span>.
        </p>
        <div class="work-tools">
            @foreach (WorkToolInfo tool in Tools.Tools)
            {
                <label class="work-tool" title="@tool.Source">
                    <input type="checkbox" checked="@Tools.IsDefaultEnabled(tool.Name)"
                           @onchange="e => SetDefaultAsync(tool, e.Value)" />
                    <span>@tool.Name</span>
                    @if (tool.IsPlugin)
                    {
                        <span class="small faint">plugin</span>
                    }
                </label>
            }
        </div>
        @if (Tools.Warnings.Count > 0)
        {
            <div class="small faint">
                @foreach (string warning in Tools.Warnings)
                {
                    <div>@warning</div>
                }
            </div>
        }
    </div>
</section>

@code {
    private async Task SetDefaultAsync(WorkToolInfo tool, object? enabled)
    {
        Tools.SetDefault(tool.Name, enabled is true);
        await ChatService.ReloadWorkContextAsync();
    }

    private void Refresh()
    {
        Tools.Reload();
        StateHasChanged();
    }
}



