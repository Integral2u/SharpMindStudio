@inherits LayoutComponentBase
@implements IDisposable
@inject SharpMind.Studio.Services.StudioWorkspaceService Workspace
@inject SharpMind.Studio.Services.ThemeService Theme
@inject SharpMind.Studio.Services.StudioActivityService Activity
@inject SharpMind.Studio.Services.StudioChatService ChatService
@inject SharpMind.Studio.Services.StudioTrainingService Training
@inject SharpMind.Studio.Services.StudioRehearsalService Rehearsal
@inject SharpMind.Studio.Services.StudioExamService Exam
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject SharpMind.Studio.Services.StudioDeviceAccess DeviceAccess

<div class="studio-root" data-theme="@Theme.Theme" style="@Theme.CssVariables">
    <canvas class="firefly-canvas" aria-hidden="true"></canvas>

    <div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-art" aria-hidden="true">
            <div class="wave"></div>
            <div class="wave"></div>
            <div class="wave"></div>
        </div>

        <div class="brand">
            <div class="brand-copy">
                <strong>SharpMind</strong>
                <span>Studio</span>
            </div>
        </div>

        <nav class="nav">
            @if (!DeviceAccess.IsMobile)
            {
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-index">01</span> Home
                </NavLink>
            }

            @if (!DeviceAccess.IsMobile)
            {
                <NavLink class="nav-link" href="test">
                    <span class="nav-index">02</span> Tests
                    @if (Activity.IsBusy)
                    {
                        <span class="spinner-ring" title="Canary running"></span>
                    }
                </NavLink>
            }

            <div class="nav-chat-row">
                <NavLink class="nav-link" href="chat">
                    <span class="nav-index">03</span> Chat
                    @if (ChatService.IsChatActive)
                    {
                        <span class="spinner-ring" title="Chat active"></span>
                    }
                </NavLink>
                <button type="button" class="nav-expand" @onclick="ToggleChats"
                        title="@(_chatsExpanded ? "Hide chats" : "Show chats")"
                        aria-label="@(_chatsExpanded ? "Hide chats" : "Show chats")">
                    @(_chatsExpanded ? "-" : "+")
                </button>
            </div>

            @if (_chatsExpanded)
            {
                <div class="nav-chats">
                    <input type="search" class="nav-chat-search" value="@_chatQuery"
                           placeholder="Search chat history..." @oninput="OnChatSearch" />
                    @if (ChatOnly.Count == 0)
                    {
                        <div class="nav-chat-empty">@(string.IsNullOrWhiteSpace(_chatQuery) ? "No chats yet" : "No matching chats")</div>
                    }
                    else
                    {
                        @foreach (var chat in ChatOnly)
                        {
                            <div class="nav-chat-item">
                                <a href="@ChatHref(chat)" class="nav-chat-link" title="@chat.Name">@chat.Name@(chat.Mode == "work" ? " / work" : "")@(chat.Provider == "openrouter" ? " / remote" : "")</a>
                                <button type="button" class="nav-chat-rename" @onclick="() => RenameChatAsync(chat)"
                                        title="Rename chat" aria-label="Rename chat">&#9998;</button>
                                <button type="button" class="nav-chat-delete" @onclick="() => DeleteChatAsync(chat)"
                                        title="Delete chat" aria-label="Delete chat">&times;</button>
                            </div>
                        }
                    }
                    <button type="button" class="nav-chat-clear" @onclick="ClearChatsAsync">
                        Clear all chats
                    </button>
                </div>
            }

            <div class="nav-chat-row">
                <NavLink class="nav-link" href="work">
                    <span class="nav-index">04</span> Work
                    @if (ChatService.IsWorkActive)
                    {
                        <span class="spinner-ring" title="Work active"></span>
                    }
                </NavLink>
                <button type="button" class="nav-expand" @onclick="ToggleWorkChats"
                        title="@(_workChatsExpanded ? "Hide work sessions" : "Show work sessions")"
                        aria-label="@(_workChatsExpanded ? "Hide work sessions" : "Show work sessions")">
                    @(_workChatsExpanded ? "-" : "+")
                </button>
            </div>

            @if (_workChatsExpanded)
            {
                <div class="nav-chats">
                    <input type="search" class="nav-chat-search" value="@_workQuery"
                           placeholder="Search work sessions..." @oninput="OnWorkSearch" />
                    @if (WorkOnly.Count == 0)
                    {
                        <div class="nav-chat-empty">@(string.IsNullOrWhiteSpace(_workQuery) ? "No work sessions yet" : "No matching work sessions")</div>
                    }
                    else
                    {
                        @foreach (var chat in WorkOnly)
                        {
                            <div class="nav-chat-item">
                                <a href="@ChatHref(chat)" class="nav-chat-link" title="@chat.Name">@chat.Name@(chat.Provider == "openrouter" ? " / remote" : "")</a>
                                <button type="button" class="nav-chat-rename" @onclick="() => RenameChatAsync(chat)"
                                        title="Rename work session" aria-label="Rename work session">&#9998;</button>
                                <button type="button" class="nav-chat-delete" @onclick="() => DeleteChatAsync(chat)"
                                        title="Delete work session" aria-label="Delete work session">&times;</button>
                            </div>
                        }
                    }
                    <button type="button" class="nav-chat-clear" @onclick="ClearChatsAsync">
                        Clear all chats
                    </button>
                </div>
            }

            @if (!DeviceAccess.IsMobile)
            {
                <NavLink class="nav-link" href="training">
                    <span class="nav-index">05</span> Training
                    @if (Training.IsRunning || Rehearsal.IsRunning || Exam.IsRunning)
                    {
                        <span class="spinner-ring" title="Training active"></span>
                    }
                </NavLink>
                @if (LayerLabAvailable)
                {
                    <NavLink class="nav-link" href="lab">
                        <span class="nav-index">06</span> Labs
                    </NavLink>
                }
                <NavLink class="nav-link" href="settings">
                    <span class="nav-index">07</span> Settings
                </NavLink>
            }        </nav>

        @if (!DeviceAccess.IsMobile)
        {
            <div class="sidebar-foot">
                <div class="eyebrow">Project</div>
                <div class="project-name">@Workspace.Project.Document.Name</div>
                <NavLink class="sidebar-workspaces" href="work"
                         title="Switch or create a workspace">
                    Workspaces
                </NavLink>
                <div class="local-pill">local-first</div>
                <div class="studio-version">
                    v@(typeof(SharpMind.Studio.Components.Layout.MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.1.0")
                    · <a href="https://github.com/Integral2u/SharpMindStudio/releases/latest"
                         target="_blank" rel="noopener">Check for updates</a>
                </div>
            </div>
        }
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-meta">
                @if (Activity.IsBusy)
                {
                    <span class="spinner-ring"></span>
                    <span>@Activity.Status</span>
                }
                @if (!DeviceAccess.IsMobile)
                {
                    <span class="dot"></span>
                    <span title="@EndpointDetail">@EndpointLabel</span>
                }
            </div>
            <div class="topbar-links">
                <a class="powered" href="https://github.com/Integral2u/SharpMind"
                   target="_blank" rel="noopener">Powered by SharpMind</a>
                <a class="sponsor" href="https://github.com/sponsors/Integral2u"
                   target="_blank" rel="noopener" title="Sponsor SharpMind on GitHub">&#9829; Sponsor</a>
            </div>
        </header>

        <div class="page">
            @if (DeviceAccess.IsMobile && !MobileAllows(Nav.ToBaseRelativePath(Nav.Uri)))
            {
                <section class="panel"><div class="panel-body"><div class="eyebrow">Mobile</div><h2>Not available on this device</h2><p>This paired phone only has Chat and Work.</p></div></section>
            }
            else
            {
                @Body
            }
        </div>
    </main>
    </div>
    <PathPickerDialog />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        DeviceAccess.SetFrom(auth.User);
        Theme.Changed += OnThemeChanged;
        Activity.Changed += OnActivityChanged;
        ChatService.Changed += OnChatServiceChanged;
        Training.Changed += OnBackgroundChanged;
        Rehearsal.Changed += OnBackgroundChanged;
        Exam.Changed += OnBackgroundChanged;
        Workspace.ProjectChanged += OnWorkspaceChanged;
        Nav.LocationChanged += OnLocationChanged;
        LoadChats();
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Activity.Changed -= OnActivityChanged;
        ChatService.Changed -= OnChatServiceChanged;
        Training.Changed -= OnBackgroundChanged;
        Rehearsal.Changed -= OnBackgroundChanged;
        Exam.Changed -= OnBackgroundChanged;
        Workspace.ProjectChanged -= OnWorkspaceChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

#if SHARPMIND_SOURCE
    private const bool LayerLabAvailable = true;
#else
    private const bool LayerLabAvailable = false;
#endif

    private bool _chatsExpanded;
    private bool _workChatsExpanded;
    private string _chatQuery = "";
    private string _workQuery = "";
    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> _chats = [];
    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> _chatResults = [];
    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> _workResults = [];

    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> ChatOnly =>
        Filter(_chatQuery, _chatResults, work: false);

    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> WorkOnly =>
        Filter(_workQuery, _workResults, work: true);

    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> Filter(
        string query,
        IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> results,
        bool work)
    {
        IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> source =
            string.IsNullOrWhiteSpace(query) ? _chats : results;
        return [.. source.Where(chat =>
            string.Equals(chat.Mode, "work", StringComparison.OrdinalIgnoreCase) == work)];
    }

    private void OnChatSearch(ChangeEventArgs args)
    {
        _chatQuery = args.Value?.ToString() ?? "";
        _chatResults = string.IsNullOrWhiteSpace(_chatQuery)
            ? []
            : ChatService.SearchSessions(_chatQuery);
    }

    private void OnWorkSearch(ChangeEventArgs args)
    {
        _workQuery = args.Value?.ToString() ?? "";
        _workResults = string.IsNullOrWhiteSpace(_workQuery)
            ? []
            : ChatService.SearchSessions(_workQuery);
    }

    private void ToggleChats()
    {
        _chatsExpanded = !_chatsExpanded;
        if (_chatsExpanded) LoadChats();
    }

    private void ToggleWorkChats()
    {
        _workChatsExpanded = !_workChatsExpanded;
        if (_workChatsExpanded) LoadChats();
    }

    private void LoadChats()
    {
        _chats = ChatService.Sessions;
        if (!string.IsNullOrWhiteSpace(_chatQuery))
            _chatResults = ChatService.SearchSessions(_chatQuery);
        if (!string.IsNullOrWhiteSpace(_workQuery))
            _workResults = ChatService.SearchSessions(_workQuery);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            if (_chatsExpanded || _workChatsExpanded) LoadChats();
            StateHasChanged();
        });

    private async Task RenameChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        string? name = await JS.InvokeAsync<string?>("prompt", "Rename chat", chat.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        await ChatService.RenameAsync(chat.Id, name);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearChatsAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", "Delete all saved chats? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.ClearAllAsync();
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete chat \"{chat.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.DeleteAsync(chat.Id);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnBackgroundChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnWorkspaceChanged() => _ = InvokeAsync(() =>
    {
        if (_chatsExpanded || _workChatsExpanded) LoadChats();
        StateHasChanged();
    });

    private void OnChatServiceChanged() => _ = InvokeAsync(() =>
    {
        if (_chatsExpanded || _workChatsExpanded) LoadChats();
        StateHasChanged();
    });

    private static bool MobileAllows(string relative) =>
        relative.Equals("chat", StringComparison.OrdinalIgnoreCase) ||
        relative.StartsWith("chat/", StringComparison.OrdinalIgnoreCase) ||
        relative.Equals("work", StringComparison.OrdinalIgnoreCase) ||
        relative.StartsWith("work/", StringComparison.OrdinalIgnoreCase);

    private Uri CurrentUri => Nav.ToAbsoluteUri(Nav.Uri);
    private StudioEndpointKind EndpointKind => StudioEndpoint.Classify(CurrentUri.Host);
    private string EndpointLabel => StudioEndpoint.Label(EndpointKind);
    private string EndpointDetail => CurrentUri.Authority;

    private static string ChatHref(SharpMind.Studio.Core.Chat.ChatSessionSummary chat) =>
        chat.Mode == "work" ? $"/work/{chat.Id}" : $"/chat/{chat.Id}";
}


















