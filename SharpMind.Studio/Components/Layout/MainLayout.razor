@inherits LayoutComponentBase
@implements IDisposable
@inject SharpMind.Studio.Services.StudioWorkspaceService Workspace
@inject SharpMind.Studio.Services.ThemeService Theme
@inject SharpMind.Studio.Services.StudioActivityService Activity
@inject SharpMind.Studio.Services.StudioChatService ChatService
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IJSRuntime JS

<div class="studio-root" data-theme="@Theme.Theme" style="@Theme.CssVariables">
    <canvas class="firefly-canvas" aria-hidden="true"></canvas>

    <div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-art" aria-hidden="true">
            <div class="wave"></div>
            <div class="wave"></div>
            <div class="wave"></div>
        </div>

        <div class="brand">
            <div class="brand-copy">
                <strong>SharpMind</strong>
                <span>Studio</span>
            </div>
        </div>

        <nav class="nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-index">01</span> Home
                @if (Activity.IsBusy)
                {
                    <span class="spinner-ring" title="Canary running"></span>
                }
            </NavLink>

            <div class="nav-chat-row">
                <NavLink class="nav-link" href="chat">
                    <span class="nav-index">02</span> Chat
                    @if (ChatService.IsLoading || ChatService.IsStreaming)
                    {
                        <span class="spinner-ring" title="Chat active"></span>
                    }
                </NavLink>
                <button type="button" class="nav-expand" @onclick="ToggleChats"
                        title="@(_chatsExpanded ? "Hide chats" : "Show chats")"
                        aria-label="@(_chatsExpanded ? "Hide chats" : "Show chats")">
                    @(_chatsExpanded ? "-" : "+")
                </button>
            </div>

            @if (_chatsExpanded)
            {
                <div class="nav-chats">
                    @if (_chats.Count == 0)
                    {
                        <div class="nav-chat-empty">No chats yet</div>
                    }
                    else
                    {
                        @foreach (var chat in _chats)
                        {
                            <div class="nav-chat-item">
                                <a href="/chat/@chat.Id" class="nav-chat-link" title="@chat.Name">@chat.Name</a>
                                <button type="button" class="nav-chat-rename" @onclick="() => RenameChatAsync(chat)"
                                        title="Rename chat" aria-label="Rename chat">&#9998;</button>
                                <button type="button" class="nav-chat-delete" @onclick="() => DeleteChatAsync(chat)"
                                        title="Delete chat" aria-label="Delete chat">&times;</button>
                            </div>
                        }
                    }
                    <button type="button" class="nav-chat-clear" @onclick="ClearChatsAsync">
                        Clear all chats
                    </button>
                </div>
            }

            <NavLink class="nav-link" href="settings">
                <span class="nav-index">03</span> Settings
            </NavLink>        </nav>

        <div class="sidebar-foot">
            <div class="eyebrow">Project</div>
            <div class="project-name">@Workspace.Project.Document.Name</div>
            <div class="project-path">@Workspace.Project.Root</div>
            <div class="local-pill">local only</div>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-meta">
                @if (Activity.IsBusy)
                {
                    <span class="spinner-ring"></span>
                    <span>@Activity.Status</span>
                }
                <span class="dot"></span>
                <span>127.0.0.1</span>
            </div>
        </header>

        <div class="page">
            @Body
        </div>
    </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        Activity.Changed += OnActivityChanged;
        ChatService.Changed += OnChatServiceChanged;
        Nav.LocationChanged += OnLocationChanged;
        LoadChats();
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Activity.Changed -= OnActivityChanged;
        ChatService.Changed -= OnChatServiceChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private bool _chatsExpanded;
    private IReadOnlyList<SharpMind.Studio.Core.Chat.ChatSessionSummary> _chats = [];

    private void ToggleChats()
    {
        _chatsExpanded = !_chatsExpanded;
        if (_chatsExpanded) LoadChats();
    }

    private void LoadChats() => _chats = ChatService.Sessions;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            if (_chatsExpanded) LoadChats();
            StateHasChanged();
        });

    private async Task RenameChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        string? name = await JS.InvokeAsync<string?>("prompt", "Rename chat", chat.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        await ChatService.RenameAsync(chat.Id, name);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearChatsAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", "Delete all saved chats? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.ClearAllAsync();
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete chat \"{chat.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.DeleteAsync(chat.Id);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnChatServiceChanged() => _ = InvokeAsync(StateHasChanged);
}














