@inherits LayoutComponentBase
@implements IDisposable
@inject SharpMind.Studio.Services.StudioWorkspaceService Workspace
@inject SharpMind.Studio.Services.ThemeService Theme
@inject SharpMind.Studio.Services.StudioActivityService Activity
@inject SharpMind.Studio.Services.StudioChatService ChatService
@inject SharpMind.Studio.Services.StudioTrainingService Training
@inject SharpMind.Studio.Services.StudioRehearsalService Rehearsal
@inject SharpMind.Studio.Services.StudioExamService Exam
@inject SharpMind.Studio.Services.ComputeDashboardService Compute
@inject SharpMind.Studio.Services.ComputeIdleService Idle
@using SharpMind.Studio.Core.Compute
@using SharpMind.Studio.Services
@inject SharpMind.Studio.Services.ModelCatalogService Catalog
@inject Microsoft.AspNetCore.Components.NavigationManager Nav
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState
@inject SharpMind.Studio.Services.StudioDeviceAccess DeviceAccess

<div class="studio-root" data-theme="@Theme.Theme" data-appearance="@Theme.Appearance" style="@Theme.CssVariables">
    <canvas class="firefly-canvas" aria-hidden="true"></canvas>

    <div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-art" aria-hidden="true">
            <div class="wave"></div>
            <div class="wave"></div>
            <div class="wave"></div>
        </div>

        <div class="brand">
            <div class="brand-copy">
                <strong>SharpMind</strong>
                <span>Studio</span>
            </div>
        </div>

        <nav class="nav">
            @if (!DeviceAccess.IsMobile)
            {
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-index">01</span> Home
                </NavLink>
            }

            @if (!DeviceAccess.IsMobile)
            {
                <NavLink class="nav-link" href="test">
                    <span class="nav-index">02</span> Tests
                    @if (Activity.IsBusy)
                    {
                        <span class="spinner-ring" title="Canary running"></span>
                    }
                </NavLink>
            }

            <div class="nav-chat-row">
                <NavLink class="nav-link" href="chat">
                    <span class="nav-index">03</span> Chat
                    @if (ChatService.IsChatActive)
                    {
                        <span class="spinner-ring" title="Chat active"></span>
                    }
                </NavLink>
                <button type="button" class="nav-expand" @onclick="ToggleChats"
                        title="@(_chatsExpanded ? "Hide chats" : "Show chats")"
                        aria-label="@(_chatsExpanded ? "Hide chats" : "Show chats")">
                    @(_chatsExpanded ? "-" : "+")
                </button>
            </div>

            @if (_chatsExpanded)
            {
                <div class="nav-chats">
                    <input type="search" class="nav-chat-search" value="@_chatQuery"
                           placeholder="Search chat history..." @oninput="OnChatSearch" />
                    @if (_chatGroups.Count == 0)
                    {
                        <div class="nav-chat-empty">@(string.IsNullOrWhiteSpace(_chatQuery) ? "No chats yet" : "No matching chats")</div>
                    }
                    else
                    {
                        @foreach (NavSessionGroup group in _chatGroups)
                        {
                            <div class="nav-chat-group-item">
                                <button type="button" class="nav-chat-group-toggle" title="@group.Root"
                                        @onclick="() => ToggleGroup(group)">
                                    <span class="nav-chat-caret">@(IsGroupOpen(group) ? "−" : "+")</span>
                                    <span class="nav-chat-group-name">@group.Name</span>
                                    <span class="nav-chat-count">@group.Sessions.Count</span>
                                </button>
                                @if (IsGroupOpen(group))
                                {
                                    @foreach (ChatSessionSummary chat in group.Sessions)
                                    {
                                        <div class="nav-chat-item">
                                            <div class="nav-chat-main">
                                                <button type="button" class="nav-chat-link" title="@chat.Name"
                                                        @onclick="() => OpenSessionAsync(group, chat)">
                                                    @chat.Name@(chat.Provider == "openrouter" ? " / remote" : "")
                                                </button>
                                                @if (!string.IsNullOrWhiteSpace(_chatQuery) && !string.IsNullOrWhiteSpace(chat.Preview))
                                                {
                                                    <div class="nav-chat-preview">@chat.Preview</div>
                                                }
                                            </div>
                                            @if (group.IsCurrent)
                                            {
                                                <button type="button" class="nav-chat-rename" @onclick="() => RenameChatAsync(chat)"
                                                        title="Rename chat" aria-label="Rename chat">&#9998;</button>
                                                <button type="button" class="nav-chat-delete" @onclick="() => DeleteChatAsync(chat)"
                                                        title="Delete chat" aria-label="Delete chat">&times;</button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                    <button type="button" class="nav-chat-clear" @onclick="ClearChatsAsync">
                        Clear this project's chats
                    </button>
                </div>
            }

            <div class="nav-chat-row">
                <NavLink class="nav-link" href="work">
                    <span class="nav-index">04</span> Work
                    @if (ChatService.IsWorkActive)
                    {
                        <span class="spinner-ring" title="Work active"></span>
                    }
                </NavLink>
                <button type="button" class="nav-expand" @onclick="ToggleWorkChats"
                        title="@(_workChatsExpanded ? "Hide work sessions" : "Show work sessions")"
                        aria-label="@(_workChatsExpanded ? "Hide work sessions" : "Show work sessions")">
                    @(_workChatsExpanded ? "-" : "+")
                </button>
            </div>

            @if (_workChatsExpanded)
            {
                <div class="nav-chats">
                    <input type="search" class="nav-chat-search" value="@_workQuery"
                           placeholder="Search work sessions..." @oninput="OnWorkSearch" />
                    @if (_workGroups.Count == 0)
                    {
                        <div class="nav-chat-empty">@(string.IsNullOrWhiteSpace(_workQuery) ? "No work sessions yet" : "No matching work sessions")</div>
                    }
                    else
                    {
                        @foreach (NavSessionGroup group in _workGroups)
                        {
                            <div class="nav-chat-group-item">
                                <div style="display:flex;align-items:center;gap:.2rem;">
                                    <button type="button" class="nav-chat-group-toggle" title="@group.Root"
                                            style="flex:1;"
                                            @onclick="() => ToggleGroup(group)">
                                        <span class="nav-chat-caret">@(IsGroupOpen(group) ? "−" : "+")</span>
                                        <span class="nav-chat-group-name">@group.Name</span>
                                        <span class="nav-chat-count">@group.Sessions.Count</span>
                                    </button>
                                    @if (!group.IsDefault)
                                    {
                                        <button type="button" class="nav-chat-rename"
                                                title="Project actions" aria-label="Project actions"
                                                @onclick="() => ShowProjectActions(group)">
                                            &#8942;
                                        </button>
                                    }
                                </div>
                                @if (IsGroupOpen(group))
                                {
                                    @if (group.Sessions.Count == 0)
                                    {
                                        <div class="nav-chat-empty">No work sessions</div>
                                        <button type="button" class="nav-chat-clear"
                                                @onclick="() => OpenProjectAsync(group)">
                                            Open project
                                        </button>
                                    }
                                    else
                                    {
                                        @foreach (ChatSessionSummary chat in group.Sessions)
                                        {
                                            <div class="nav-chat-item">
                                                <div class="nav-chat-main">
                                                    <button type="button" class="nav-chat-link" title="@chat.Name"
                                                            @onclick="() => OpenSessionAsync(group, chat)">
                                                        @chat.Name@(chat.Provider == "openrouter" ? " / remote" : "")
                                                    </button>
                                                    @if (!string.IsNullOrWhiteSpace(_workQuery) && !string.IsNullOrWhiteSpace(chat.Preview))
                                                    {
                                                        <div class="nav-chat-preview">@chat.Preview</div>
                                                    }
                                                </div>
                                                @if (group.IsCurrent)
                                                {
                                                    <button type="button" class="nav-chat-rename" @onclick="() => RenameChatAsync(chat)"
                                                            title="Rename work session" aria-label="Rename work session">&#9998;</button>
                                                    <button type="button" class="nav-chat-delete" @onclick="() => DeleteChatAsync(chat)"
                                                            title="Delete work session" aria-label="Delete work session">&times;</button>
                                                }
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                        @if (_projectAction is not null)
                        {
                            <div class="nav-project-actions"
                                 style="margin-top:.5rem;padding:.6rem;border:1px solid var(--line);border-radius:.5rem;">
                                <strong>@_projectAction.Name</strong>
                                <div class="small faint" style="margin:.3rem 0 .45rem;">
                                    Archive keeps every file under this project and moves it to
                                    Settings → System → Archived projects. Delete removes
                                    <span class="mono">@_projectAction.Path</span> permanently.
                                </div>
                                <div class="row" style="gap:.35rem;">
                                    <button type="button" class="button" @onclick="ArchiveProjectAsync">
                                        Archive
                                    </button>
                                    <button type="button" class="button danger" @onclick="DeleteProjectAsync">
                                        Delete permanently
                                    </button>
                                    <button type="button" class="button" @onclick="() => _projectAction = null">
                                        Cancel
                                    </button>
                                </div>
                                <div class="small faint">@_projectActionStatus</div>
                            </div>
                        }
                    }
                    <button type="button" class="nav-chat-clear" @onclick="ClearChatsAsync">
                        Clear this project's chats
                    </button>
                </div>
            }

            @if (!DeviceAccess.IsMobile)
            {
                <div class="nav-chat-row">
                    <NavLink class="nav-link" href="compute">
                        <span class="nav-index">05</span> Compute
                        @if (Compute.RunningCount > 0)
                        {
                            <span class="nav-badge" title="@Compute.RunningCount running; billed hourly">
                                @Compute.RunningCount
                            </span>
                        }
                        @if (AnyComputeInUse)
                        {
                            <span class="nav-use-dot" title="Compute in active use"></span>
                        }
                    </NavLink>
                    <button type="button" class="nav-expand" @onclick="ToggleCompute"
                            title="@(_computeExpanded ? "Hide instances" : "Show instances")"
                            aria-label="@(_computeExpanded ? "Hide instances" : "Show instances")">
                        @(_computeExpanded ? "-" : "+")
                    </button>
                </div>

                @if (_computeExpanded)
                {
                    <div class="nav-chats">
                        @if (Compute.Instances.Count == 0)
                        {
                            <div class="nav-chat-empty">No instances yet</div>
                        }
                        else
                        {
                            @foreach (SharpMind.Studio.Core.Compute.VultrComputeInstance instance
                                in Compute.Instances)
                            {
                                string? activity = ComputeActivity(instance);
                                <div class="nav-chat-item">
                                    <div class="nav-chat-main">
                                        <a href="compute" class="nav-chat-link" title="@instance.Label">
                                            @instance.Label
                                        </a>
                                        <div class="nav-chat-preview">
                                            @instance.StatusLabel · $@instance.HourlyCost.ToString("0.000")/h
                                            @if (activity is not null)
                                            {
                                                <span class="nav-use"> · in use: @activity</span>
                                            }
                                        </div>
                                    </div>
                                @if (ComputeTeardown.IsOwned(instance))
                                {
                                    <button type="button" class="nav-instance-stop"
                                            @onclick="() => DestroyFromNavAsync(instance)"
                                            disabled="@(_computeBusy)"
                                            title="@(activity is null
                                                ? "Destroy this instance and stop billing"
                                                : $"In active use ({activity}); destroying interrupts it")">
                                        @(_destroyingId == instance.InstanceId ? "..." : "Destroy")
                                    </button>
                                }
                                else
                                {
                                    <span class="nav-use" title="Not created by this Studio; destroy it in the Vultr console.">
                                        not tracked
                                    </span>
                                }
                                </div>
                            }
                        }
                        @if (_computeError is not null)
                        {
                            <div class="nav-compute-error">@_computeError</div>
                        }
                    </div>
                }
                <NavLink class="nav-link" href="training">
                    <span class="nav-index">06</span> Training
                    @if (Training.IsRunning || Rehearsal.IsRunning || Exam.IsRunning)
                    {
                        <span class="spinner-ring" title="Training active"></span>
                    }
                </NavLink>
                @if (LayerLabAvailable)
                {
                    <NavLink class="nav-link" href="lab">
                        <span class="nav-index">07</span> Labs
                    </NavLink>
                }
                <NavLink class="nav-link" href="settings">
                    <span class="nav-index">08</span> Settings
                </NavLink>
            }        </nav>

        @if (!DeviceAccess.IsMobile)
        {
            <div class="sidebar-foot">
                <div class="eyebrow">Project</div>
                <div class="project-name">@Workspace.Project.Document.Name</div>
                <NavLink class="sidebar-workspaces" href="work"
                         title="Switch or create a workspace">
                    Workspaces
                </NavLink>
                <a class="github-link" href="https://integral2u.github.io/SharpMindStudio/wiki/index.html"
                   target="_blank" rel="noopener">Wiki guide</a>
                <div class="studio-version">
                    v@(typeof(SharpMind.Studio.Components.Layout.MainLayout).Assembly.GetName().Version?.ToString(3) ?? "1.1.0")
                    · <a href="https://apps.microsoft.com/detail/9n792cx03gtv"
                         target="_blank" rel="noopener">Microsoft Store</a>
                </div>
            </div>
        }
    </aside>

    <main class="main">
        <header class="topbar">
            <div class="topbar-meta">
                @if (Activity.IsBusy)
                {
                    <span class="spinner-ring"></span>
                    <span>@Activity.Status</span>
                }
                @if (!DeviceAccess.IsMobile)
                {
                    <span class="dot"></span>
                    <span title="@EndpointDetail">@EndpointLabel</span>
                }
            </div>
            <div class="topbar-links">
                <a class="powered" href="https://github.com/Integral2u/SharpMind"
                   target="_blank" rel="noopener">Powered by SharpMind</a>
                <a class="sponsor" href="https://github.com/sponsors/Integral2u"
                   target="_blank" rel="noopener" title="Sponsor SharpMind on GitHub">&#9829; Sponsor</a>
            </div>
        </header>

        @if (Compute.RunningCount > 0 && !IsComputePage)
        {
            <div class="compute-banner">
                <span class="compute-banner-dot" aria-hidden="true"></span>
                <span>
                    @Compute.RunningCount compute instance@(Compute.RunningCount == 1 ? "" : "s")
                    running &middot; $@Compute.HourlyCost.ToString("0.00")/hour
                    @if (AnyComputeInUse)
                    {
                        <text> &middot; in use</text>
                    }
                    @if (Compute.UntrackedRunningCount > 0)
                    {
                        <text> &middot; @Compute.UntrackedRunningCount untracked</text>
                    }
                </span>
                <a href="compute">Review</a>
            </div>
        }

        @if (Idle.Notices.Count > 0)
        {
            <div class="compute-banner idle-banner">
                <span class="compute-banner-dot" aria-hidden="true"></span>
                <div class="stack" style="gap: .2rem;">
                    @foreach (SharpMind.Studio.Services.ComputeIdleNotice notice in Idle.Notices)
                    {
                        <div class="row" style="align-items: center; gap: .5rem;">
                            <span>
                                @notice.Label is idle. Destroying (disk deleted) in
                                <strong>@SharpMind.Studio.Services.ComputeIdleService.Format(notice.Remaining)</strong>.
                            </span>
                            <button type="button" class="button"
                                    @onclick="() => Idle.Keep(notice.ProviderId)"
                                    title="Reset the idle timer; nothing is destroyed for the full window.">Keep</button>
                            <button type="button" class="button danger"
                                    @onclick="() => DestroyIdleAsync(notice.ProviderId)">Destroy now</button>
                        </div>
                    }
                </div>
            </div>
        }
        @if (Idle.Error is { Length: > 0 } idleError)
        {
            <div class="compute-banner idle-banner">
                <span class="compute-banner-dot" aria-hidden="true"></span>
                <span>@idleError</span>
            </div>
        }

        <div class="page">
            @if (DeviceAccess.IsMobile && !MobileAllows(Nav.ToBaseRelativePath(Nav.Uri)))
            {
                <section class="panel"><div class="panel-body"><div class="eyebrow">Mobile</div><h2>Not available on this device</h2><p>This paired phone only has Chat and Work.</p></div></section>
            }
            else
            {
                @Body
            }
        </div>
    </main>
    </div>
    <PathPickerDialog />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">×</span>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        DeviceAccess.SetFrom(auth.User);
        Theme.Changed += OnThemeChanged;
        Activity.Changed += OnActivityChanged;
        ChatService.Changed += OnChatServiceChanged;
        Training.Changed += OnBackgroundChanged;
        Rehearsal.Changed += OnBackgroundChanged;
        Exam.Changed += OnBackgroundChanged;
        Workspace.ProjectChanged += OnWorkspaceChanged;
        Nav.LocationChanged += OnLocationChanged;
        Compute.Changed += OnComputeChanged;
        Idle.Changed += OnIdleChanged;
        LoadChats();
        _ = Compute.RefreshAsync();
        // Build the model list once at startup; pages read the cache instead of
        // rescanning the Models folder on every navigation.
        _ = Catalog.RefreshAsync();
        _computeRefreshCts = new CancellationTokenSource();
        _ = RefreshComputeLoopAsync(_computeRefreshCts.Token);
    }

    public void Dispose()
    {
        Theme.Changed -= OnThemeChanged;
        Activity.Changed -= OnActivityChanged;
        ChatService.Changed -= OnChatServiceChanged;
        Training.Changed -= OnBackgroundChanged;
        Rehearsal.Changed -= OnBackgroundChanged;
        Exam.Changed -= OnBackgroundChanged;
        Workspace.ProjectChanged -= OnWorkspaceChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Compute.Changed -= OnComputeChanged;
        Idle.Changed -= OnIdleChanged;
        _computeRefreshCts?.Cancel();
        _computeRefreshCts?.Dispose();
        _computeRefreshCts = null;
    }

    /// <summary>
    /// Keeps the sidebar count and the billing banner current without opening
    /// Compute, so an instance created in the Vultr console is noticed too.
    /// </summary>
    private async Task RefreshComputeLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await Compute.RefreshAsync(cancellationToken);
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch
                {
                    // A failed poll must not stop the loop; the page shows the error.
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private bool IsComputePage =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("compute", StringComparison.OrdinalIgnoreCase);

    private void OnComputeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnIdleChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task DestroyIdleAsync(string providerId) => await Idle.DestroyNowAsync(providerId);

#if SHARPMIND_SOURCE
    private const bool LayerLabAvailable = true;
#else
    private const bool LayerLabAvailable = false;
#endif

    private bool _chatsExpanded;
    private bool _workChatsExpanded;
    private bool _computeExpanded;
    private bool _computeBusy;
    private string? _destroyingId;
    private string? _computeError;
    private CancellationTokenSource? _computeRefreshCts;
    private string _chatQuery = "";
    private string _workQuery = "";
    private List<NavSessionGroup> _chatGroups = [];
    private List<NavSessionGroup> _workGroups = [];
    private readonly Dictionary<string, bool> _groupOpen = new(StringComparer.OrdinalIgnoreCase);
    private StudioProjectInfo? _projectAction;
    private string _projectActionStatus = "";

    /// <summary>One project's sessions in the sidebar, expandable as a group.</summary>
    private sealed record NavSessionGroup(
        string Name,
        string Root,
        IReadOnlyList<ChatSessionSummary> Sessions,
        bool IsCurrent,
        bool IsDefault);

    private void OnChatSearch(ChangeEventArgs args)
    {
        _chatQuery = args.Value?.ToString() ?? "";
        _chatGroups = BuildGroups(work: false, _chatQuery);
    }

    private void OnWorkSearch(ChangeEventArgs args)
    {
        _workQuery = args.Value?.ToString() ?? "";
        _workGroups = BuildGroups(work: true, _workQuery);
    }

    private void ToggleChats()
    {
        _chatsExpanded = !_chatsExpanded;
        if (_chatsExpanded) LoadChats();
    }

    private void ToggleCompute()
    {
        _computeExpanded = !_computeExpanded;
        if (_computeExpanded) _ = Compute.RefreshAsync();
    }

    private bool AnyComputeInUse =>
        Compute.Instances.Any(instance => ComputeActivity(instance) is not null);

    private string? ComputeActivity(VultrComputeInstance instance) =>
        ComputeUsage.Activity(
            instance,
            Training.RemoteProviderId,
            Training.IsRunning || Rehearsal.IsRunning || Exam.IsRunning,
            ChatService.IsCompute ? ChatService.ComputeProviderId : null,
            ChatService.IsChatActive || ChatService.IsWorkActive);

    private async Task DestroyFromNavAsync(VultrComputeInstance instance)
    {
        if (_computeBusy) return;

        string? activity = ComputeActivity(instance);
        string message = activity is null
            ? $"Destroy {instance.Label}? The disk is deleted and billing stops. "
              + "Download any exported models first."
            : $"{instance.Label} is in active use ({activity}). Destroying it interrupts that "
              + "work, deletes the disk and stops billing. Destroy anyway?";
        bool confirmed = await JS.InvokeAsync<bool>("confirm", message);
        if (!confirmed) return;

        _computeBusy = true;
        _destroyingId = instance.InstanceId;
        _computeError = null;
        StateHasChanged();
        try
        {
            await Compute.DestroyAsync(instance);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _computeError = $"{instance.Label}: {ex.Message}";
        }
        finally
        {
            _computeBusy = false;
            _destroyingId = null;
            StateHasChanged();
        }
    }

    private void ToggleWorkChats()
    {
        _workChatsExpanded = !_workChatsExpanded;
        if (_workChatsExpanded) LoadChats();
    }

    private void LoadChats()
    {
        _chatGroups = BuildGroups(work: false, _chatQuery);
        _workGroups = BuildGroups(work: true, _workQuery);
    }

    /// <summary>
    /// Every project that has sessions of this kind, newest project first for
    /// the one that is open. A project with no chats folder is skipped instead
    /// of having one created just to look inside it.
    /// </summary>
    private List<NavSessionGroup> BuildGroups(bool work, string query)
    {
        var groups = new List<NavSessionGroup>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (SharpMind.Studio.Services.StudioProjectInfo project in Workspace.Projects)
        {
            // Chat is the default project's conversation list. Sessions saved
            // while a work project was open belong to Work, not here.
            if (!work && !project.IsDefault) continue;

            if (!seen.Add(project.Path)) continue;
            string chats = Path.Combine(project.Path, "chats");
            IReadOnlyList<ChatSessionSummary> sessions = [];
            if (Directory.Exists(chats))
            {
                try
                {
                    var store = new ChatSessionStore(chats);
                    sessions = string.IsNullOrWhiteSpace(query) ? store.List() : store.Search(query);
                }
                catch
                {
                    if (!work) continue;
                }
            }
            else if (!work)
            {
                continue;
            }

            List<ChatSessionSummary> filtered = [.. sessions.Where(session =>
                string.Equals(session.Mode, "work", StringComparison.OrdinalIgnoreCase) == work)];
            if (filtered.Count == 0 && !work) continue;

            groups.Add(new NavSessionGroup(
                project.Name,
                project.Path,
                filtered,
                string.Equals(project.Path, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase),
                project.IsDefault));
        }

        return [.. groups
            .OrderByDescending(group => group.IsCurrent)
            .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)];
    }

    private bool IsGroupOpen(NavSessionGroup group) =>
        _groupOpen.TryGetValue(group.Root, out bool open) ? open : group.IsCurrent;

    private void ToggleGroup(NavSessionGroup group) =>
        _groupOpen[group.Root] = !IsGroupOpen(group);

    /// <summary>
    /// A session belongs to the project that stores it, so opening one from
    /// another group switches projects first. Rename and delete stay on the
    /// current project because they edit the live store.
    /// </summary>
    private async Task OpenSessionAsync(NavSessionGroup group, ChatSessionSummary chat)
    {
        if (!string.Equals(group.Root, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                Workspace.SwitchProject(group.Root);
                await ChatService.UseProjectAsync();
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", ex.Message);
                return;
            }
        }

        Nav.NavigateTo(ChatHref(chat));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            if (_chatsExpanded || _workChatsExpanded) LoadChats();
            StateHasChanged();
        });

    private void ShowProjectActions(NavSessionGroup group)
    {
        _projectAction = new StudioProjectInfo(group.Name, group.Root, group.IsDefault);
        _projectActionStatus = "";
        _groupOpen[group.Root] = true;
    }

    private async Task OpenProjectAsync(NavSessionGroup group)
    {
        try
        {
            if (!string.Equals(group.Root, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase))
            {
                Workspace.SwitchProject(group.Root);
                await ChatService.UseProjectAsync();
            }
            Nav.NavigateTo("/work");
        }
        catch (Exception ex)
        {
            _projectActionStatus = ex.Message;
        }
    }

    private async Task ArchiveProjectAsync()
    {
        StudioProjectInfo? project = _projectAction;
        if (project is null) return;

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Archive '{project.Name}'? Its files move to Workspace Archives and can be "
            + "recovered from Settings > System.");
        if (!confirmed) return;

        bool wasCurrent = string.Equals(
            project.Path, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase);
        try
        {
            Workspace.ArchiveProject(project.Path);
            if (wasCurrent)
            {
                await ChatService.UseProjectAsync();
                Nav.NavigateTo("/work");
            }
            _projectAction = null;
            _projectActionStatus = $"Archived {project.Name}.";
            LoadChats();
        }
        catch (Exception ex)
        {
            _projectActionStatus = ex.Message;
        }
    }

    private async Task DeleteProjectAsync()
    {
        StudioProjectInfo? project = _projectAction;
        if (project is null) return;

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Permanently delete '{project.Name}' and every file under:\n\n{project.Path}\n\n"
            + "This cannot be undone. Use Archive instead if you may want it back.");
        if (!confirmed) return;

        bool wasCurrent = string.Equals(
            project.Path, Workspace.Project.Root, StringComparison.OrdinalIgnoreCase);
        try
        {
            Workspace.DeleteProject(project.Path);
            if (wasCurrent)
            {
                await ChatService.UseProjectAsync();
                Nav.NavigateTo("/work");
            }
            _projectAction = null;
            _projectActionStatus = $"Deleted {project.Name}.";
            LoadChats();
        }
        catch (Exception ex)
        {
            _projectActionStatus = ex.Message;
        }
    }

    private async Task RenameChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        string? name = await JS.InvokeAsync<string?>("prompt", "Rename chat", chat.Name);
        if (string.IsNullOrWhiteSpace(name)) return;

        await ChatService.RenameAsync(chat.Id, name);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearChatsAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", "Delete all saved chats in this project? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.ClearAllAsync();
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private async Task DeleteChatAsync(SharpMind.Studio.Core.Chat.ChatSessionSummary chat)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm", $"Delete chat \"{chat.Name}\"? This cannot be undone.");
        if (!confirmed) return;

        await ChatService.DeleteAsync(chat.Id);
        LoadChats();
        await InvokeAsync(StateHasChanged);
    }
    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        // The body carries the appearance for the very first paint, so keep it in
        // step when the theme changes without a restart.
        try
        {
            await JS.InvokeVoidAsync("studioTheme.apply", Theme.Theme, Theme.Appearance);
        }
        catch
        {
        }
        StateHasChanged();
    });

    private void OnActivityChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnBackgroundChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnWorkspaceChanged() => _ = InvokeAsync(() =>
    {
        if (_chatsExpanded || _workChatsExpanded) LoadChats();
        StateHasChanged();
    });

    private void OnChatServiceChanged() => _ = InvokeAsync(() =>
    {
        if (_chatsExpanded || _workChatsExpanded) LoadChats();
        StateHasChanged();
    });

    private static bool MobileAllows(string relative) =>
        relative.Equals("chat", StringComparison.OrdinalIgnoreCase) ||
        relative.StartsWith("chat/", StringComparison.OrdinalIgnoreCase) ||
        relative.Equals("work", StringComparison.OrdinalIgnoreCase) ||
        relative.StartsWith("work/", StringComparison.OrdinalIgnoreCase);

    private Uri CurrentUri => Nav.ToAbsoluteUri(Nav.Uri);
    private StudioEndpointKind EndpointKind => StudioEndpoint.Classify(CurrentUri.Host);
    private string EndpointLabel => StudioEndpoint.Label(EndpointKind);
    private string EndpointDetail => CurrentUri.Authority;

    private static string ChatHref(SharpMind.Studio.Core.Chat.ChatSessionSummary chat) =>
        chat.Mode == "work" ? $"/work/{chat.Id}" : $"/chat/{chat.Id}";
}


















