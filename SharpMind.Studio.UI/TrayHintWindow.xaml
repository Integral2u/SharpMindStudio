<Window x:Class="SharpMind.Studio.UI.TrayHintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SharpMind Studio"
        Width="390"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#101821"
            BorderBrush="#2A3948"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18">
        <StackPanel>
            <TextBlock Text="SharpMind is still running"
                       Foreground="#E6EDF3"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="The window was closed, so Studio is now in the notification tray. Double-click the tray icon to reopen it."
                       Foreground="#8FA3B8"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Don't show again"
                        Click="OnIgnore"
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderBrush="#2A3948"
                        Foreground="#8FA3B8"
                        Cursor="Hand" />
                <Button Content="OK"
                        Click="OnOk"
                        Padding="18,6"
                        Background="#5EEAD4"
                        BorderBrush="#5EEAD4"
                        Foreground="#06201C"
                        FontWeight="SemiBold"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
