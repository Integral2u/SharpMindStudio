<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>SharpMind.ico</ApplicationIcon>
    <ProjectGuid>{8C2D4E6F-1A3B-4C5D-9E7F-2A4B6C8D0E1F}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Studio.Core\SharpMind.Studio.Core.csproj" />
    <ProjectReference Include="..\SharpMind.Studio\SharpMind.Studio.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SharpMind.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWebView2Loader" AfterTargets="Build"
          Condition="Exists('$(OutDir)runtimes\win-x64\native\WebView2Loader.dll')">
    <Copy SourceFiles="$(OutDir)runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
