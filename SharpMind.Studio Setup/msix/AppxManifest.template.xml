<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for scripts\build-msix.ps1. The script replaces the {{TOKENS}} and
  copies the result to the root of the staging folder as AppxManifest.xml.

  Identity Name and Publisher must match the values Partner Center shows under
  Product identity: a package whose Publisher differs from the reserved identity
  is rejected at submission, and one whose Name differs installs as a separate
  app.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="{{IDENTITY_NAME}}"
      Publisher="{{PUBLISHER}}"
      Version="{{VERSION}}"
      ProcessorArchitecture="{{ARCHITECTURE}}" />

  <Properties>
    <DisplayName>SharpMind Studio</DisplayName>
    <PublisherDisplayName>SharpMind Studio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 2004. The desktop shell is a full-trust Win32 app; the web
         host is a sibling process, exactly as in the MSI layout. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="SharpMindStudio" Executable="SharpMind.Studio.UI.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="SharpMind Studio"
          Description="Local-first workbench for chatting with models, using them on real projects, and building them."
          BackgroundColor="#0C141D"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
            Wide310x150Logo="Assets\Wide310x150Logo.png"
            Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0C141D" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The wrapper launches the web host as a child process and binds loopback
         listeners, so the package must run at full trust. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
