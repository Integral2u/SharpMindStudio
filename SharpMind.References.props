<Project>
  <PropertyGroup>
    <!-- Use the sibling source tree when it exists; fall back to the published packages. -->
    <SharpMindRoot Condition="'$(SharpMindRoot)' == ''">$(MSBuildThisFileDirectory)..\SharpMind\</SharpMindRoot>
    <SharpMindSource Condition="'$(SharpMindSource)' == '' and Exists('$(SharpMindRoot)SharpMind.Core\SharpMind.Core.csproj')">project</SharpMindSource>
    <SharpMindSource Condition="'$(SharpMindSource)' == ''">package</SharpMindSource>
  </PropertyGroup>

  <!-- Local source-tree references: used automatically when the sibling SharpMind checkout exists. -->
  <ItemGroup Condition="'$(SharpMindSource)' == 'project'">
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Core\SharpMind.Core.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Data\SharpMind.Data.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Inference\SharpMind.Inference.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Model\SharpMind.Model.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Tokenization\SharpMind.Tokenization.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
    <ProjectReference Include="$(SharpMindRoot)SharpMind.Training\SharpMind.Training.csproj"
                      SetConfiguration="Configuration=$(Configuration)" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharpMindSource)' == 'package'">
    <PackageReference Include="SharpMind.Core" />
    <PackageReference Include="SharpMind.Data" />
    <PackageReference Include="SharpMind.Inference" />
    <PackageReference Include="SharpMind.Model" />
    <PackageReference Include="SharpMind.Tokenization" />
    <PackageReference Include="SharpMind.Training" />
  </ItemGroup>
</Project>
