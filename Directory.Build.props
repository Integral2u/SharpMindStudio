<Project>
  <PropertyGroup>
    <Version>1.1.3.0</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <Company>SharpMind</Company>
    <Product>SharpMind Studio</Product>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- This branch develops against the sibling SharpMind tree, so the engine
       checkout must be on its own release/1.1.3 branch. main builds the published
       packages instead; pass -p:SharpMindSource=package to do the same here. -->
  <PropertyGroup>
    <SharpMindRoot Condition="'$(SharpMindRoot)' == ''">$(MSBuildThisFileDirectory)..\SharpMind\</SharpMindRoot>
    <SharpMindSource Condition="'$(SharpMindSource)' == ''">project</SharpMindSource>
  </PropertyGroup>
</Project>
