<Project>
  <PropertyGroup>
    <Version>1.1.2.0</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <Company>SharpMind</Company>
    <Product>SharpMind Studio</Product>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- main builds the published SharpMind packages, so a clean clone works with
       no engine checkout. Pass -p:SharpMindSource=project to build against a
       sibling SharpMind tree; release branches default to project instead. -->
  <PropertyGroup>
    <SharpMindRoot Condition="'$(SharpMindRoot)' == ''">$(MSBuildThisFileDirectory)..\SharpMind\</SharpMindRoot>
    <SharpMindSource Condition="'$(SharpMindSource)' == ''">package</SharpMindSource>
  </PropertyGroup>
</Project>
