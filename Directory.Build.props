<Project>
  <PropertyGroup>
    <Version>1.1.1.0</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <Company>SharpMind</Company>
    <Product>SharpMind Studio</Product>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Local development builds the sibling SharpMind projects. The package-only
       solution passes -p:SharpMindSource=package, which wins as a global property. -->
  <PropertyGroup>
    <SharpMindRoot Condition="'$(SharpMindRoot)' == ''">$(MSBuildThisFileDirectory)..\SharpMind\</SharpMindRoot>
    <SharpMindSource Condition="'$(SharpMindSource)' == '' and Exists('$(SharpMindRoot)SharpMind.Core\SharpMind.Core.csproj')">project</SharpMindSource>
    <SharpMindSource Condition="'$(SharpMindSource)' == ''">package</SharpMindSource>
  </PropertyGroup>
</Project>
