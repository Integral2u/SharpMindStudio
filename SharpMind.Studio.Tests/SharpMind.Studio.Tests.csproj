<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMind.Studio.Core\SharpMind.Studio.Core.csproj" />
    <ProjectReference Include="..\SharpMind.Studio\SharpMind.Studio.csproj" />
    <!-- Built but not referenced: the MCP integration tests launch it as a process. -->
    <ProjectReference Include="..\SharpMind.Studio.Tests.FakeMcp\SharpMind.Studio.Tests.FakeMcp.csproj"
                      ReferenceOutputAssembly="false" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Put the fake MCP server next to the tests so the integration tests can
       start it without knowing where bin lives. -->
  <Target Name="CopyFakeMcpServer" AfterTargets="Build">
    <ItemGroup>
      <FakeMcpOutput Include="$(MSBuildThisFileDirectory)..\SharpMind.Studio.Tests.FakeMcp\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FakeMcpOutput)"
          DestinationFiles="@(FakeMcpOutput->'$(OutDir)FakeMcp\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
